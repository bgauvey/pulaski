# Only what the images build from: sources, build settings, the database scripts and the demo setup tool.
.git/
.github/
.vs/
.vscode/
.idea/
docs/
design/
Tests/
tools/*
!tools/Pulaski.DemoSetup/
!tools/Pulaski.ProcessSimulator/

# Build output and local files, wherever they are (after the exception above, so they stay out of it too).
**/bin/
**/obj/
**/TestResults/
**/*.user
**/appsettings.*.local.json
**/pulaski-edge.db*
**/pki/
