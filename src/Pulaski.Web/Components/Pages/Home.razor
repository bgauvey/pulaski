@page "/"
@attribute [RequiresView(PermissionCodes.OverviewView)]
@* The plant overview (design/admin-dashboard-brief.md). In five seconds it answers: which lines
   are running, which are not and why, and what needs a person. Live state, each line's shift so far
   and held lots come from GET /overview (D-070); OEE from the machine report; labor to approve from
   the shift review. *@
@implements IDisposable
@using System.Globalization
@using Pulaski.Contracts.MachineData
@using Pulaski.Web.Services.MachineData
@using Pulaski.Web.Services.Scheduling
@inject PulaskiApiClient Api
@inject CurrentUser User
@inject TimeProvider Time

<PageTitle>@L["Overview"] · Pulaski</PageTitle>

<header class="ov-head">
    <div>
        <h1 class="ov-title">@(Site?.Name ?? L["Overview"])</h1>
        <p class="ov-when">
            <span>@SiteNow.ToString("dddd d MMMM", CultureInfo.CurrentCulture)</span>
            <span class="ov-clock">@L["{0} site time", SiteNow.ToString("HH:mm", CultureInfo.InvariantCulture)]</span>
        </p>
    </div>
    <div class="ov-tools">
        @if (_sites.Count > 1)
        {
            <select class="form-select" aria-label="@L["Site"]" value="@_siteId" @onchange="OnSiteChangedAsync">
                @foreach (var site in _sites)
                {
                    <option value="@site.Id">@site.Code · @site.Name</option>
                }
            </select>
        }
        <span class="ov-live @(IsStale ? "is-stale" : "")" role="status">
            <span class="ov-live-dot" aria-hidden="true"></span>
            @(_loadedAt is null ? L["Connecting…"] : IsStale ? L["Stale since {0}", ScheduleFormat.Time(_loadedAt.Value, Tz)] : L["Live, updated {0}", ScheduleFormat.Time(_loadedAt.Value, Tz)])
        </span>
        <button type="button" class="btn btn-outline-secondary btn-square" aria-label="@L["Refresh now"]" title="@L["Refresh now"]"
                disabled="@_loading" @onclick="RefreshAsync">
            <Icon Name="refresh" Size="18" />
        </button>
    </div>
</header>

<ProblemAlert Error="_error" />

@if (IsStale && _loadedAt is not null)
{
    <div class="ov-stale" role="alert">
        <Icon Name="alert" Size="18" />
        @L["These figures are from {0} and may be out of date: Pulaski can't reach the API. It keeps retrying.", ScheduleFormat.Time(_loadedAt.Value, Tz)]
    </div>
}

@* ---- Needs attention ---- *@
<section class="ov-attention" aria-labelledby="attention-title">
    <h2 id="attention-title" class="visually-hidden">@L["Needs attention"]</h2>
    @foreach (var cell in Attention)
    {
        var tone = cell.IsPlaceholder ? "is-placeholder" : cell.Count > 0 ? $"is-{cell.Tone}" : "is-zero";
        @if (cell.Href is not null && !cell.IsPlaceholder)
        {
            <a class="ov-att @tone" href="@cell.Href" title="@cell.Help">@AttentionBody(cell)</a>
        }
        else
        {
            <div class="ov-att @tone" title="@cell.Help">@AttentionBody(cell)</div>
        }
    }
</section>

@* ---- This shift: OEE is calculated from machine data; other measures remain placeholders. *@
<section class="ov-summary" aria-labelledby="summary-title">
    <div class="ov-summary-head">
        <h2 id="summary-title" class="ov-h2">@L["This shift"]</h2>
        <span class="ov-pending"><Icon Name="plug" Size="16" /> @OeeSummaryNote</span>
    </div>
    <div class="ov-summary-band">
        <div class="ov-sum">
            <span class="ov-sum-label">@L["OEE"]</span>
            <span class="ov-sum-value @(CurrentShiftOee?.OeePct is null ? "is-ghost" : "")">@FormatPct(CurrentShiftOee?.OeePct)</span>
            <div class="ov-apq" aria-label="@OeeSummaryLabel">
                @foreach (var part in OeeParts(CurrentShiftOee))
                {
                    <span class="ov-apq-row">
                        <span class="ov-apq-name">@part.Label</span>
                        <span class="ov-meter @(part.Value is null ? "is-ghost" : "")">
                            @if (part.Value is { } value)
                            {
                                <span class="ov-meter-fill" style="width: @MeterWidth(value)"></span>
                            }
                            <span class="ov-meter-target" style="left: 85%"></span>
                        </span>
                        <span class="ov-apq-value">@FormatPct(part.Value)</span>
                    </span>
                }
            </div>
        </div>
        <div class="ov-sum">
            <span class="ov-sum-label">@L["Good output"]</span>
            @if (_overview is null)
            {
                <span class="ov-sum-value is-ghost">—</span>
                <span class="ov-meter is-ghost is-wide"></span>
            }
            else if (GoodOutput.Count == 0)
            {
                <span class="ov-sum-value">0</span>
            }
            else
            {
                @foreach (var q in GoodOutput)
                {
                    <span class="ov-sum-value @(GoodOutput.Count > 1 ? "is-small" : "")">@Number(q.Qty) <span class="ov-sum-unit">@(q.Of > 0 ? L["of {0} {1}", Number(q.Of), q.UomCode] : q.UomCode)</span></span>
                    @if (q.Of > 0)
                    {
                        <span class="ov-meter is-wide"><span class="ov-meter-fill" style="width: @MeterWidth(q.Qty / q.Of * 100m)"></span></span>
                    }
                }
            }
            <span class="ov-sum-note">@(_overview is null ? L["From production reports"] : GoodOutput.Count == 0 ? L["Nothing reported or planned this shift"] : L["Reported this shift, against the plan for the shift"])</span>
        </div>
        <div class="ov-sum">
            <span class="ov-sum-label">@L["Scrap"]</span>
            @if (_overview is null)
            {
                <span class="ov-sum-value is-ghost">—</span>
            }
            else if (ScrapOutput.Count == 0)
            {
                <span class="ov-sum-value">0</span>
            }
            else
            {
                @foreach (var q in ScrapOutput)
                {
                    <span class="ov-sum-value @(ScrapOutput.Count > 1 ? "is-small" : "")">@Number(q.Qty) <span class="ov-sum-unit">@q.UomCode@(q.Of > 0 ? $" · {FormatPct(Math.Round(q.Qty / q.Of * 100m, 1))}" : "")</span></span>
                }
            }
            <span class="ov-sum-note">@(_overview is not null && ScrapOutput.Count == 0 ? L["Nothing reported this shift"] : L["Quantity and share of output"])</span>
        </div>
        <div class="ov-sum">
            <span class="ov-sum-label">@L["Downtime"]</span>
            @if (_overview is null || !AnyTracked)
            {
                <span class="ov-sum-value is-ghost">— <span class="ov-sum-unit">@L["min"]</span></span>
                <span class="ov-sum-note">
                    @if (_overview is not null)
                    {
                        <Icon Name="plug" Size="14" />
                    }
                    @(_overview is null ? L["With the biggest reason named"] : L["Needs machine data: no line reports its state"])
                </span>
            }
            else
            {
                <span class="ov-sum-value">@Number(Math.Round(DownMinutes)) <span class="ov-sum-unit">@L["min"]</span></span>
                <span class="ov-sum-note">@(TopReason is { } top ? L["Top: {0}, {1} min", top.Name, Number(Math.Round(top.Minutes))] : L["No down time this shift"])</span>
            }
        </div>
    </div>
</section>

@* ---- Line board ---- *@
<section class="ov-board" aria-labelledby="board-title">
    <div class="ov-board-head">
        <h2 id="board-title" class="ov-h2">@L["Lines"]</h2>
        <ul class="ov-key" aria-label="@L["Key"]">
            <li><span class="ov-swatch is-run"></span>@L["Running"]</li>
            <li><span class="ov-swatch is-down"></span>@L["Down"]</li>
            <li><span class="ov-swatch is-stop"></span>@L["Planned stop"]</li>
            <li><span class="ov-swatch is-nosignal"></span>@L["No signal"]</li>
            <li><span class="ov-swatch is-planned"></span>@L["Planned"]</li>
            <li><span class="ov-swatch is-published"></span>@L["Dispatched or firmed"]</li>
            <li><span class="ov-swatch is-changeover"></span>@L["Changeover"]</li>
        </ul>
    </div>

    @if (_lines is null)
    {
        <div class="ov-rows" aria-busy="true">
            @for (var i = 0; i < 3; i++)
            {
                <div class="ov-row is-skeleton"><span></span><span></span><span></span><span></span></div>
            }
        </div>
    }
    else if (_lines.Count == 0)
    {
        <div class="ov-empty">
            <p class="mb-1 fw-semibold">@(Site?.Code is { } code ? L["No lines in {0} yet.", code] : L["No lines in this site yet."])</p>
            <p class="mb-0 text-muted">@L["Add a work center that can run jobs on"] <ScreenLink Href="equipment" Permission="@PermissionCodes.EquipmentView">@L["Equipment"]</ScreenLink>@L[", and it appears here."]</p>
        </div>
    }
    else
    {
        <div class="ov-rows" role="table" aria-label="@L["Lines"]">
            <div class="ov-row is-head" role="row">
                <span role="columnheader">@L["Line"]</span>
                <span role="columnheader">@L["State"]</span>
                <span role="columnheader">@L["Now or next"]</span>
                <span role="columnheader" class="ov-scale">
                    @foreach (var (percent, label) in _window.Ticks(Tz, _window.TickStep))
                    {
                        <span class="ov-tick" style="left: @Pct(percent)">@label</span>
                    }
                </span>
                <span role="columnheader">@L["OEE"]</span>
                <span role="columnheader"><span class="visually-hidden">@L["Flags"]</span></span>
            </div>

            @foreach (var line in _lines)
            {
                var timeline = _timelines.GetValueOrDefault(line.Id);
                var lineOee = CurrentShift(line.Id)?.Figures;
                var segments = timeline?.Segments ?? [];
                var job = OverviewModel.NowOrNext(segments, Now);
                var flags = Flags(timeline);
                var live = LiveOf(line.Id);
                <div class="ov-row" role="row" @key="line.Id">
                    <span role="cell" class="ov-line">
                        @if (CanSchedule)
                        {
                            <a class="ov-line-code" href="schedule">@line.Code</a>
                        }
                        else
                        {
                            <span class="ov-line-code">@line.Code</span>
                        }
                        <span class="ov-line-name">@line.Name</span>
                        @if (live is { HandoverItems.Count: > 0 } handed)
                        {
                            @* What the shifts have handed on and nobody has closed (#124). *@
                            <a class="ov-handover small" href="@($"handover#line-{line.Code}")" title="@string.Join("\n", handed.HandoverItems)">
                                @Pulaski.Web.Services.Execution.HandoverView.OpenItems(L, handed.HandoverItems.Count)
                            </a>
                        }
                    </span>

                    <span role="cell" class="ov-live-state">
                        @if (_overview is null)
                        {
                            <span class="text-muted">—</span>
                        }
                        else if (live is not { TracksState: true })
                        {
                            <span class="ov-state is-untracked" title="@L["This line doesn't report its machine state. Bind its tags through an edge node and switch on state tracking to see it here."]">@L["Not tracked"]</span>
                        }
                        else
                        {
                            <span class="ov-state @MachineView.CategoryClass(live.Category)" title="@StateTitle(live)">
                                @if (live.Category == "no_signal" || live.EdgeQuiet)
                                {
                                    <Icon Name="signal-off" Size="16" />
                                }
                                else
                                {
                                    <span class="ov-state-dot" aria-hidden="true"></span>
                                }
                                @(live.EdgeQuiet ? L["Edge quiet"] : L[MachineView.CategoryLabel(live.Category)])
                            </span>
                            <span class="ov-state-note">@StateNote(live)</span>
                        }
                    </span>

                    <span role="cell" class="ov-job">
                        @if (job is null)
                        {
                            <span class="text-muted">@L["Nothing planned"]</span>
                        }
                        else
                        {
                            <span class="ov-job-when">@NowOrNextLabel(job)</span>
                            @if (CanSchedule)
                            {
                                <a class="ov-job-number" href="@(job.WorkOrderId is { } wo ? $"schedule?workOrder={wo}" : "schedule")">@job.JobNumber</a>
                            }
                            else
                            {
                                <span class="ov-job-number">@job.JobNumber</span>
                            }
                            <span class="ov-job-material">@job.MaterialCode</span>
                            <span class="ov-progress">
                                <span class="ov-meter"><span class="ov-meter-fill" style="width: @Pct(OverviewModel.Made(job) * 100)"></span></span>
                                <span class="ov-progress-text">@L["{0} of {1}", Number(job.PlannedQty - job.RemainingQty), ScheduleFormat.Qty(job.PlannedQty, job.UomCode)]</span>
                            </span>
                        }
                        @if (live is { Output.Count: > 0 })
                        {
                            <span class="ov-shift-output">@L["This shift:"] @string.Join(", ", live.Output.Select(o => L["{0} {1} good", Number(o.GoodQty), o.UomCode] + (o.ScrapQty > 0 ? L[", {0} scrap", Number(o.ScrapQty)] : "")))</span>
                        }
                    </span>

                    <span role="cell" class="ov-strip" style="--now: @Pct(_window.Percent(Now))" aria-label="@StripLabel(line, segments)">
                        <span class="ov-lane is-state">
                            @if (live is { TracksState: true })
                            {
                                @foreach (var bar in OverviewModel.StateBars(live.States, _window))
                                {
                                    <span class="ov-act @UseClass(bar.Span.Use)" style="left: @Pct(bar.Left); width: @Pct(bar.Width)" title="@UseTitle(bar.Span)"></span>
                                }
                            }
                            else
                            {
                                <span class="ov-nosignal" style="width: @Pct(_window.Percent(Now))"></span>
                            }
                        </span>
                        <span class="ov-lane is-plan">
                            @if (!OverviewModel.Bars(segments, _window).Any())
                            {
                                <span class="ov-lane-empty">@(job is null ? L["Nothing planned"] : L["Nothing planned until {0}", ScheduleFormat.When(job.Start, Tz)])</span>
                            }
                            @foreach (var bar in OverviewModel.Bars(segments, _window))
                            {
                                @if (CanSchedule)
                                {
                                    <a class="ov-bar @BarClass(bar)" style="left: @Pct(bar.Left); width: @Pct(bar.Width)"
                                       href="@(bar.Segment.WorkOrderId is { } wo ? $"schedule?workOrder={wo}" : "schedule")"
                                       title="@BarTitle(bar)" aria-label="@BarTitle(bar)"></a>
                                }
                                else
                                {
                                    <span class="ov-bar @BarClass(bar)" style="left: @Pct(bar.Left); width: @Pct(bar.Width)" title="@BarTitle(bar)"></span>
                                }
                            }
                        </span>
                        <span class="ov-now" style="left: @Pct(_window.Percent(Now))" aria-hidden="true"></span>
                    </span>

                    <span role="cell" class="ov-oee" title="@OeeTitle(lineOee)">
                        <span class="ov-oee-value @(lineOee?.OeePct is null ? "is-empty" : "")">@FormatPct(lineOee?.OeePct)</span>
                        <span class="ov-oee-bars" aria-label="@OeeTitle(lineOee)">
                            <span class="@(lineOee?.AvailabilityPct is null ? "is-empty" : "")"><i style="width: @MeterWidth(lineOee?.AvailabilityPct)"></i></span>
                            <span class="@(lineOee?.PerformancePct is null ? "is-empty" : "")"><i style="width: @MeterWidth(lineOee?.PerformancePct)"></i></span>
                            <span class="@(lineOee?.QualityPct is null ? "is-empty" : "")"><i style="width: @MeterWidth(lineOee?.QualityPct)"></i></span>
                        </span>
                    </span>

                    <span role="cell" class="ov-flags">
                        @if (flags.Overlaps > 0)
                        {
                            <span class="ov-flag is-danger" title="@flags.OverlapText"><Icon Name="alert" Size="18" /><span class="visually-hidden">@flags.OverlapText</span></span>
                        }
                        @if (flags.Warnings.Count > 0)
                        {
                            <span class="ov-flag is-warning" title="@string.Join("\n", flags.Warnings)"><Icon Name="clock" Size="18" /><span class="visually-hidden">@string.Join(". ", flags.Warnings)</span></span>
                        }
                    </span>
                </div>
            }
        </div>
    }
</section>

@* ---- Orders and what starts next ---- *@
<div class="ov-lower">
    <section aria-labelledby="flow-title">
        <h2 id="flow-title" class="ov-h2">@L["Work orders"]</h2>
        <ol class="ov-flow">
            @foreach (var status in FlowStatuses)
            {
                var count = _orders.Count(o => o.Status == status);
                <li>
                    @if (User.Can(PermissionCodes.WorkOrdersView))
                    {
                        <a class="ov-flow-step @(count == 0 ? "is-zero" : "")" href="work-orders?status=@status">
                            <span class="ov-flow-count">@count</span>
                            <span class="ov-flow-label">@L.Label(status)</span>
                        </a>
                    }
                    else
                    {
                        <span class="ov-flow-step @(count == 0 ? "is-zero" : "")">
                            <span class="ov-flow-count">@count</span>
                            <span class="ov-flow-label">@L.Label(status)</span>
                        </span>
                    }
                </li>
            }
        </ol>
        <p class="ov-foot">
            @L["{0} closed and {1} cancelled.", _orders.Count(o => o.Status == "closed"), _orders.Count(o => o.Status == "cancelled")]
            @if (User.Can(PermissionCodes.WorkOrderManage))
            {
                <a href="schedule/work-orders/new">@L["New work order"]</a>
            }
        </p>
    </section>

    <section aria-labelledby="next-title">
        <h2 id="next-title" class="ov-h2">@L["Starting next"]</h2>
        @if (StartingNext.Count == 0)
        {
            <p class="text-muted">@L["Nothing is planned to start."] <ScreenLink Href="schedule" Permission="@PermissionCodes.ScheduleView">@L["Open the schedule"]</ScreenLink> @L["to place work on a line."]</p>
        }
        else
        {
            <table class="ov-next">
                <tbody>
                    @foreach (var (line, segment) in StartingNext)
                    {
                        <tr>
                            <td class="ov-next-time">@StartLabel(segment.Start)</td>
                            <td class="ov-next-line">@line.Code</td>
                            <td>
                                @if (CanSchedule)
                                {
                                    <a href="@(segment.WorkOrderId is { } wo ? $"schedule?workOrder={wo}" : "schedule")">@segment.JobNumber</a>
                                }
                                else
                                {
                                    @segment.JobNumber
                                }
                            </td>
                            <td class="text-muted">@segment.MaterialCode</td>
                            <td class="ov-next-qty">@ScheduleFormat.Qty(segment.PlannedQty, segment.UomCode)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>

@code {
    // Its lines and jobs link to the schedule for whoever may see it (D-039).
    private bool CanSchedule => User.Can(PermissionCodes.ScheduleView);

    private static readonly TimeSpan RefreshEvery = TimeSpan.FromSeconds(30);
    private static readonly TimeSpan StaleAfter = TimeSpan.FromSeconds(60);
    private static readonly string[] FlowStatuses = ["planned", "dispatched", "firmed", "in_progress", "completed"];

    private List<EquipmentDto> _sites = [];
    private IReadOnlyList<EquipmentDto> _equipment = [];
    private List<EquipmentDto>? _lines;
    private Dictionary<Guid, LineTimelineDto> _timelines = [];
    private OeeReportDto? _oeeReport;
    private IReadOnlyList<WorkOrderDto> _orders = [];
    private IReadOnlyList<WorkOrderProgressDto> _progress = [];
    private PendingLaborApprovalsDto? _labor;
    private OverviewDto? _overview;
    private Guid _siteId;
    private OverviewWindow _window = OverviewWindow.Around(DateTimeOffset.UtcNow);
    private Dictionary<Guid, OverviewLineDto> _live = [];
    private DateTimeOffset? _loadedAt;
    private bool _loading;
    private ApiException? _error;
    private Timer? _timer;

    private DateTimeOffset Now => Time.GetUtcNow();

    private EquipmentDto? Site => _sites.FirstOrDefault(s => s.Id == _siteId);

    private string? Tz => Site?.TimeZone;

    private DateTimeOffset SiteNow => Display.ToSite(Now, Tz);

    private bool IsStale => _loadedAt is { } at && Now - at > StaleAfter;

    private sealed record AttentionCell(
        string Icon, string Label, int Count, string Detail, string Tone, string? Href, string Help, bool IsPlaceholder = false, string PlaceholderIcon = "plug");

    // Labor is counted only where the user may see it (D-039); the count and its link follow approvals on every refresh.
    private bool CanSeeLabor => _siteId != Guid.Empty && User.Can(PermissionCodes.LaborView, _siteId);

    // Ordered by urgency (design/admin-dashboard-brief.md). Placeholders keep their place until their data exists.
    private IEnumerable<AttentionCell> Attention
    {
        get
        {
            var open = _progress.Where(WorkOrderTiles.IsOpen).ToList();
            var behind = open.Count(WorkOrderTiles.IsBehind);
            var conflicts = open.Count(p => p.Warnings.Count > 0 || p.HasOverlap);
            var overlaps = open.Count(p => p.HasOverlap);
            var unplaced = open.Count(p => p.Order.Status == "planned" && p.PlacedQty < p.Order.PlannedQty);
            var tracked = _overview?.Lines.Where(l => l.TracksState).ToList() ?? [];
            var machines = User.Can(PermissionCodes.MachinesView, _siteId) ? "machines" : null;

            // Machine figures are unavailable, not zero, until a line reports its state (D-070).
            var uncodedHelp = L["Stops in each line's current shift, longer than a micro-stop, that no one has given a reason yet."];
            if (tracked.Count == 0)
            {
                yield return new("stop", L["Uncoded stops"], 0, L["Needs machine data"], "danger", null, uncodedHelp, IsPlaceholder: true);
            }
            else
            {
                var uncoded = tracked.Sum(l => l.UncodedStops ?? 0);
                yield return new("stop", L["Uncoded stops"], uncoded, uncoded == 0 ? L["All coded"] : L["Give them a reason"], "danger", machines, uncodedHelp);
            }

            var alerts = _overview?.OpenSpcAlerts ?? 0;
            yield return new("spc", L["Open SPC alerts"], alerts, alerts == 0 ? L["None"] : L["Find the cause"], "danger",
                User.Can(PermissionCodes.QualityView, _siteId) ? "quality/alerts" : null,
                L["Control charts that signalled (beyond their limits, or a run rule) and wait for someone to record the cause and what was done."]);
            yield return new("clock", L["Orders behind"], behind, behind == 0 ? L["All on time"] : L["Late or slipping"], "danger", "work-orders",
                L["Open orders projected to finish after their due date, or to start more than 15 minutes after their published baseline."]);
            var (onHold, quarantine) = (_overview?.LotsOnHold ?? 0, _overview?.LotsInQuarantine ?? 0);
            yield return new("lot", L["Lots on hold"], onHold + quarantine,
                onHold + quarantine == 0 ? L["None"] : quarantine == 0 ? L["{0} on hold", onHold] : onHold == 0 ? L["{0} in quarantine", quarantine] : L["{0} on hold, {1} in quarantine", onHold, quarantine],
                "warning", User.Can(PermissionCodes.InventoryView, _siteId) ? $"inventory/lots?status={(onHold > 0 || quarantine == 0 ? "on_hold" : "quarantine")}" : null,
                L["Lots with stock on hold or in quarantine at this site."]);
            yield return new("alert", L["Schedule conflicts"], conflicts, overlaps > 0 ? L["{0} with an overlap", overlaps] : conflicts == 0 ? L["None"] : L["Warnings to review"], "warning", "schedule",
                L["Open orders with a schedule warning (late, no rate, unit mismatch…) or work that overlaps on a line."]);
            var silentHelp = L["Lines that report their state but send nothing now: no signal, or their edge node has been quiet for over 2 minutes."];
            if (tracked.Count == 0)
            {
                yield return new("signal-off", L["Lines with no signal"], 0, L["No line reports its state"], "muted", null, silentHelp, IsPlaceholder: true);
            }
            else
            {
                var silent = tracked.Count(l => l.Category == "no_signal" || l.EdgeQuiet);
                yield return new("signal-off", L["Lines with no signal"], silent, silent == 0 ? L["All reporting"] : L["Not reporting"], "muted", machines, silentHelp);
            }

            yield return new("schedule", L["Not on a line"], unplaced, unplaced == 0 ? L["Everything placed"] : L["Quantity to place"], "warning", "schedule",
                L["Planned orders with quantity not yet on a line or department."]);
            var erp = open.Count(p => p.Order.PendingChange is not null);
            yield return new("erp", L["ERP changes to accept"], erp, erp == 0 ? L["None"] : L["Accept or reject"], "warning",
                User.Can(PermissionCodes.WorkOrdersView) ? "work-orders" : null,
                L["Open orders the ERP changed after they left planning, waiting for a planner to accept or reject the change."]);
            yield return LaborCell();
        }
    }

    private AttentionCell LaborCell()
    {
        var help = L["Shifts of the last two weeks that have ended with labor no one has approved yet."];
        if (!CanSeeLabor)
        {
            return new("labor", L["Labor to approve"], 0, L["Needs permission to see labor"], "muted", null, help, IsPlaceholder: true, PlaceholderIcon: "lock");
        }

        var shifts = _labor?.Shifts ?? [];
        if (shifts.Count == 0)
        {
            return new("labor", L["Labor to approve"], 0, L["Nothing waiting"], "muted", "labor/review", help);
        }

        var oldest = shifts[0].ProductionDate;
        var sessions = shifts.Sum(s => s.Sessions);
        return new("labor", L["Labor to approve"], shifts.Count,
            sessions == 1
                ? L["1 session, oldest {0}", oldest.ToString("ddd d MMM", CultureInfo.CurrentCulture)]
                : L["Sessions: {0}, oldest {1}", sessions, oldest.ToString("ddd d MMM", CultureInfo.CurrentCulture)], "muted",
            $"labor/review?day={oldest.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}", help);
    }

    private RenderFragment AttentionBody(AttentionCell cell) =>
        @<text>
            <span class="ov-att-top">
                <span class="ov-att-icon"><Icon Name="@cell.Icon" Size="18" /></span>
                <span class="ov-att-count">@(cell.IsPlaceholder ? "—" : cell.Count.ToString(CultureInfo.CurrentCulture))</span>
            </span>
            <span class="ov-att-label">@cell.Label</span>
            <span class="ov-att-detail">
                @if (cell.IsPlaceholder)
                {
                    <Icon Name="@cell.PlaceholderIcon" Size="14" />
                }
                @cell.Detail
            </span>
        </text>;

    /// <summary>The next production jobs to start across the site's lines, soonest first.</summary>
    private IReadOnlyList<(EquipmentDto Line, TimelineSegmentDto Segment)> StartingNext =>
        [.. (_lines ?? [])
            .SelectMany(l => (_timelines.GetValueOrDefault(l.Id)?.Segments ?? [])
                .Where(s => s.Kind == "job" && s.JobType == "production" && s.Start > Now)
                .Select(s => (Line: l, Segment: s)))
            .OrderBy(x => x.Segment.Start)
            .Take(6)];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _equipment = await Api.ListEquipmentAsync();
            // Only the sites whose Overview the user may see (#43).
            _sites = [.. _equipment.Where(e => e.Level == "site" && e.IsActive && User.Can(PermissionCodes.OverviewView, e.Id)).OrderBy(e => e.Code, StringComparer.Ordinal)];
            _siteId = _sites.FirstOrDefault()?.Id ?? Guid.Empty;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }

        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        }), null, RefreshEvery, RefreshEvery);
    }

    private async Task OnSiteChangedAsync(ChangeEventArgs e)
    {
        _siteId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : Guid.Empty;
        _lines = null;
        _timelines = [];
        _oeeReport = null;
        _labor = null;
        _overview = null;
        _live = [];
        await LoadAsync();
    }

    private async Task RefreshAsync() => await LoadAsync();

    // Lines run jobs; departments plan for them and appear on the Schedule instead.
    private async Task LoadAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        try
        {
            var lines = _equipment
                .Where(e => e.SiteId == _siteId && e.IsActive && e.CanRunJob)
                .OrderBy(e => e.Code, StringComparer.Ordinal)
                .ToList();
            var orders = Api.ListWorkOrdersAsync();
            var progress = Api.ListWorkOrderProgressAsync(_siteId == Guid.Empty ? null : _siteId);
            var timelines = lines.Select(l => Api.GetLineTimelineAsync(l.Id)).ToList();
            var siteNow = Display.ToSite(Now, Tz);
            var productionDate = DateOnly.FromDateTime(siteNow.DateTime);
            Task<OeeReportDto>? oee = _siteId == Guid.Empty
                ? null
                : Api.GetOeeReportAsync(_siteId, productionDate.AddDays(-1), productionDate);
            var labor = CanSeeLabor ? Api.ListPendingLaborApprovalsAsync(_siteId) : null;
            var overview = _siteId == Guid.Empty ? null : Api.GetOverviewAsync(_siteId);

            _orders = [.. (await orders).Where(o => o.SiteId == _siteId)];
            _progress = await progress;
            _timelines = (await Task.WhenAll(timelines)).ToDictionary(t => t.LineId);
            _oeeReport = oee is null ? null : await oee;
            _labor = labor is null ? null : await labor;
            _overview = overview is null ? null : await overview;
            _live = _overview?.Lines.ToDictionary(l => l.EquipmentId) ?? [];
            _lines = lines;
            _window = _overview is { } o ? OverviewWindow.Of(o) : OverviewWindow.Around(Now);
            _loadedAt = Now;
            _error = null;
        }
        catch (ApiException ex)
        {
            // Keep showing the last figures; the stale banner says how old they are.
            _error = _loadedAt is null ? ex : null;
        }
        finally
        {
            _loading = false;
        }
    }

    private (int Overlaps, string OverlapText, IReadOnlyList<string> Warnings) Flags(LineTimelineDto? timeline)
    {
        if (timeline is null)
        {
            return (0, "", []);
        }

        var overlaps = timeline.Overlaps.Count;
        var warnings = timeline.Segments
            .SelectMany(s => s.Warnings.Select(w => $"{s.JobNumber}: {L.Of(w)}"))
            .Distinct()
            .Take(5)
            .ToList();
        return (overlaps, overlaps == 1 ? L["1 overlap on this line"] : L["{0} overlaps on this line", overlaps], warnings);
    }

    private static string BarClass(OverviewBar bar) =>
        bar.IsChangeover ? "is-changeover" : bar.Segment.Status is "dispatched" or "firmed" or "running" or "paused" ? "is-published" : "is-planned";

    private string BarTitle(OverviewBar bar)
    {
        var s = bar.Segment;
        var what = bar.IsChangeover ? L["Changeover"] : $"{s.JobNumber}, {s.MaterialCode}, {ScheduleFormat.Qty(s.PlannedQty, s.UomCode)}";
        return L["{0}: {1} to {2}, {3}", what, ScheduleFormat.Time(s.Start, Tz), ScheduleFormat.Time(s.End, Tz), L.Label(s.Status)];
    }

    private string StripLabel(EquipmentDto line, IReadOnlyList<TimelineSegmentDto> segments)
    {
        var jobs = segments.Count(s => s.Kind == "job" && s.End > _window.Start && s.Start < _window.End);
        var live = LiveOf(line.Id);
        var state = live is not { TracksState: true } ? "doesn't report its state"
            : live.DownMinutes is { } down ? L["{0}, down {1} min this shift", L[MachineView.CategoryLabel(live.Category)].ToLowerInvariant(), Number(Math.Round(down))]
            : L[MachineView.CategoryLabel(live.Category)].ToLowerInvariant();
        return L["{0}: {1}; {2} planned jobs between {3} and {4}", line.Code, state, jobs, ScheduleFormat.Time(_window.Start, Tz), ScheduleFormat.Time(_window.End, Tz)];
    }

    private OverviewLineDto? LiveOf(Guid lineId) => _live.GetValueOrDefault(lineId);

    private bool AnyTracked => _overview?.Lines.Any(l => l.TracksState) ?? false;

    private decimal DownMinutes => _overview?.Lines.Sum(l => l.DownMinutes ?? 0m) ?? 0m;

    private OverviewReasonDto? TopReason => _overview is null ? null : OverviewModel.TopReason(_overview.Lines);

    // Each line's plan inside its own shift, so lines on different shifts each count their own.
    private IReadOnlyList<OverviewQty> GoodOutput => _overview is null
        ? []
        : OverviewModel.Good(_overview.Lines, _overview.Lines.SelectMany(l =>
            OverviewModel.Planned(_timelines.GetValueOrDefault(l.EquipmentId)?.Segments ?? [], l.From, OverviewModel.Until(l, Tz))));

    private IReadOnlyList<OverviewQty> ScrapOutput => _overview is null ? [] : OverviewModel.Scrap(_overview.Lines).Where(q => q.Of > 0).ToList();

    private string StateTitle(OverviewLineDto live)
    {
        var parts = new List<string> { live.PackMlName ?? L[MachineView.CategoryLabel(live.Category)] };
        if (live.StateSince is { } since)
        {
            parts.Add(L["since {0}", ScheduleFormat.Time(since, Tz)]);
        }

        if (live.StopText is { } stop)
        {
            parts.Add(stop);
        }

        if (live.EdgeQuiet)
        {
            parts.Add("its edge node has been quiet for over 2 minutes");
        }

        if (live.DownMinutes is { } down)
        {
            parts.Add(L["down {0} min this shift", Number(Math.Round(down))]);
        }

        return string.Join("; ", parts);
    }

    // "12 min · Jam at infeed", or "2 stops to code".
    private string StateNote(OverviewLineDto live)
    {
        var parts = new List<string>();
        if (live.StateSince is { } since)
        {
            parts.Add(MachineView.Duration(Now - since));
        }

        if (live.Category != "producing" && live.StopText is { } stop)
        {
            parts.Add(stop);
        }

        if (live.UncodedStops is > 0 and var uncoded)
        {
            parts.Add(uncoded == 1 ? L["1 stop to code"] : L["{0} stops to code", uncoded]);
        }

        return string.Join(" · ", parts);
    }

    private static string UseClass(string use) => use switch
    {
        "run" => "is-run",
        "down" => "is-down",
        "planned" => "is-stop",
        "non_production" => "is-nonprod",
        _ => "is-nosignal",
    };

    private string UseTitle(OverviewStateSpanDto span)
    {
        var what = span.Use switch
        {
            "run" => L["Running"],
            "down" => L["Down"],
            "planned" => L["Planned stop"],
            "non_production" => L["Not in production mode"],
            _ => L["No signal"],
        };
        return L["{0}: {1} to {2} ({3})", what, ScheduleFormat.Time(span.Start, Tz), ScheduleFormat.Time(span.End, Tz), MachineView.Duration(span.End - span.Start)];
    }

    // "06:00" today, "Mon 19 Oct 06:00" on another day.
    private string StartLabel(DateTimeOffset at) =>
        ScheduleLayout.SiteDate(at, Tz) == ScheduleLayout.SiteDate(Now, Tz) ? ScheduleFormat.Time(at, Tz) : ScheduleFormat.When(at, Tz);

    // "Now", "Next at 06:00" today, or "Next Mon 19 Oct 06:00" on another day.
    private string NowOrNextLabel(TimelineSegmentDto job) =>
        job.Start <= Now ? L["Now"]
        : ScheduleLayout.SiteDate(job.Start, Tz) == ScheduleLayout.SiteDate(Now, Tz) ? L["Next at {0}", ScheduleFormat.Time(job.Start, Tz)]
        : L["Next {0}", ScheduleFormat.When(job.Start, Tz)];

    private static string Pct(double value) => value.ToString("0.###", CultureInfo.InvariantCulture) + "%";

    private OverviewOee? CurrentShiftOee => _oeeReport is null ? null : OverviewModel.CurrentShiftOee(_oeeReport.Shifts, Now);

    private OeeShiftRowDto? CurrentShift(Guid equipmentId) =>
        _oeeReport is null ? null : OverviewModel.CurrentShift(_oeeReport.Shifts, equipmentId, Now);

    private string OeeSummaryNote => _oeeReport is null
        ? _siteId == Guid.Empty ? L["Choose a site to view OEE"] : L["Loading current-shift OEE…"]
        : CurrentShiftOee?.OeePct is not null
            ? L["Current-shift OEE from reported machine data · refreshes every 30 seconds"]
            : L["No rated production data has been reported this shift"];

    private string OeeSummaryLabel => CurrentShiftOee is { } oee
        ? L["Current-shift OEE {0}; availability {1}, performance {2}, quality {3}", FormatPct(oee.OeePct), FormatPct(oee.AvailabilityPct), FormatPct(oee.PerformancePct), FormatPct(oee.QualityPct)]
        : L["No current-shift OEE data"];

    private IReadOnlyList<(string Label, decimal? Value)> OeeParts(OverviewOee? oee) =>
    [
        (L["Availability"], oee?.AvailabilityPct),
        (L["Performance"], oee?.PerformancePct),
        (L["Quality"], oee?.QualityPct),
    ];

    private static string FormatPct(decimal? value) =>
        value is { } percent ? percent.ToString("0.#", CultureInfo.CurrentCulture) + "%" : "—";

    private static string MeterWidth(decimal? value) =>
        Math.Clamp(value ?? 0m, 0m, 100m).ToString("0.###", CultureInfo.InvariantCulture) + "%";

    private string OeeTitle(OeeFiguresDto? figures) => figures is null
        ? L["No current-shift OEE data"]
        : L["Availability {0}, performance {1}, quality {2}", FormatPct(figures.AvailabilityPct), FormatPct(figures.PerformancePct), FormatPct(figures.QualityPct)];

    private static string Number(decimal? value) => (value ?? 0m).ToString("#,##0.###", CultureInfo.CurrentCulture);

    public void Dispose() => _timer?.Dispose();
}
