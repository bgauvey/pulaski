@page "/inventory/lots/{LotId:guid}"
@attribute [RequiresView(PermissionCodes.InventoryView)]
@inject PulaskiApiClient Api
@inject SiteSelection Sites
@inject TimeProvider Time
@inject CurrentUser User
@inject Downloads Downloads

<PageTitle>@(Title) · @L["Inventory"] · Pulaski</PageTitle>

<InventoryHeader Title="@Title">
    <Back>
        @if (_lot is { } back)
        {
            <a href="inventory/materials/@back.Lot.MaterialId">← @back.Lot.MaterialCode</a>
        }
    </Back>
    <Description>
        @if (_lot is { } d)
        {
            <span>@d.Lot.MaterialCode · @d.Lot.MaterialName</span>
        }
    </Description>
    <Actions>
        @if (_lot?.Lot is { } lot)
        {
            var expired = lot.ExpiresAt is { } ends && ends <= Time.GetUtcNow();
            string? Why(LotAction action) => L.Of(LotActionAvailability.Why(action, lot.Status, lot.Quantity, expired));
            <div class="inv-actions">
                <HistoryLink Subject="lot.Id" Class="btn btn-outline-secondary" />
                @if (May(LotAction.Consume))
                {
                    <ActionButton Class="btn btn-primary" Reason="@Why(LotAction.Consume)" OnClick="() => _action = LotAction.Consume">@L["Consume"]</ActionButton>
                }
                @if (May(LotAction.Move))
                {
                    <ActionButton Class="btn btn-outline-secondary" Reason="@Why(LotAction.Move)" OnClick="() => _action = LotAction.Move">@L["Move"]</ActionButton>
                }
                @if (May(LotAction.Load) && !lot.IsBulk)
                {
                    <ActionButton Class="btn btn-outline-secondary" Reason="@Why(LotAction.Load)" OnClick="() => _action = LotAction.Load">@L["Load"]</ActionButton>
                }
                @if (!lot.IsBulk)
                {
                    @if (May(LotAction.Split))
                    {
                        <ActionButton Class="btn btn-outline-secondary" Reason="@Why(LotAction.Split)" OnClick="() => _action = LotAction.Split">@L["Split"]</ActionButton>
                    }
                    @if (May(LotAction.Merge))
                    {
                        <ActionButton Class="btn btn-outline-secondary" Reason="@Why(LotAction.Merge)" OnClick="() => _action = LotAction.Merge">@L["Merge…"]</ActionButton>
                    }
                }
                @if (May(LotAction.Ship))
                {
                    <ActionButton Class="btn btn-outline-secondary" Reason="@Why(LotAction.Ship)" OnClick="() => _action = LotAction.Ship">@L["Ship"]</ActionButton>
                }
                @if (May(LotAction.WriteUp))
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _action = LotAction.WriteUp">@L["Write up"]</button>
                }
                @if (May(LotAction.WriteOff))
                {
                    <ActionButton Class="btn btn-outline-secondary" Reason="@Why(LotAction.WriteOff)" OnClick="() => _action = LotAction.WriteOff">@L["Write off"]</ActionButton>
                }
                @if (lot.Status is "on_hold" or "quarantine")
                {
                    @if (May(LotAction.Release))
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _action = LotAction.Release">@L["Release"]</button>
                    }
                }
                @if (May(LotAction.Hold))
                {
                    <ActionButton Class="btn btn-outline-secondary" Reason="@Why(LotAction.Hold)" OnClick="() => _action = LotAction.Hold">@(lot.Status is "on_hold" or "quarantine" ? L["Change hold…"] : L["Hold…"])</ActionButton>
                }
                @if (May(LotAction.Correct))
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _action = LotAction.Correct">@L["Correct…"]</button>
                }
                <button type="button" class="btn btn-outline-secondary" @onclick="PrintLabelAsync">@L["Print label"]</button>
                <PrintLabelControl Kind="lot" Id="LotId" SiteId="lot.SiteId" />
            </div>
        }
    </Actions>
</InventoryHeader>

<ProblemAlert Error="_error" />
<LotResultBanner Result="_result" OnDismiss="() => _result = null" />

@if (_lot?.Lot is { ExpiresAt: { } expiredAt } && expiredAt <= Time.GetUtcNow() && _lot.Lot.Quantity > 0)
{
    <div class="drawer-alert is-warning mb-3" role="status">
        <Icon Name="alert" Size="18" />
        <span>@L["Expired on {0}: it can't be consumed, shipped or merged. If quality has extended it, use Correct… to set the new expiry.", Display.SiteTime(expiredAt, _lot.SiteTimeZone)]</span>
    </div>
}

@if (_lot is { } detail)
{
    var l = detail.Lot;
    var tz = detail.SiteTimeZone;
    <div class="inv-layout mb-4">
        <div class="inv-facts">
            <dl class="facts">
                <dt>@L["Status"]</dt>
                <dd><span class="@InventoryView.StatusChip(l.Status)">@L.Label(l.Status)</span></dd>
                <dt>@L["Quantity"]</dt>
                <dd><strong>@InventoryView.Qty(l.Quantity)</strong> @l.UomCode</dd>
                <dt>@L["Location"]</dt>
                <dd>@(l.LocationCode is null ? "—" : $"{l.LocationCode} · {l.LocationName}")</dd>
                @if (!l.IsBulk)
                {
                    <dt>@L["Container"]</dt>
                    <dd><LotContainerField Lot="l" OnChanged="LoadAsync" /></dd>
                }
                <dt>@L["From"]</dt>
                <dd>
                    @if (l.ProducedByJobId is { } jobId)
                    {
                        <span>@L["Made by"] <a href="inventory/jobs/@jobId">@l.ProducedByJobNumber</a></span>
                    }
                    else
                    {
                        @L.Label(l.Origin)
                    }
                </dd>
                @if (l.IsBulk)
                {
                    <dt>@L["Kept as"]</dt>
                    <dd>
                        @L["The balance of {0} at {1}:", l.MaterialCode, l.LocationCode]
                        @(detail.MaterialIsLotTracked ? L["lots mix there, so what arrives joins it."] : L["{0} isn't lot-tracked.", l.MaterialCode])
                    </dd>
                }
                else
                {
                    <dt>@L["Supplier lot"]</dt>
                    <dd>@(l.SupplierLot ?? "—")</dd>
                }
                @if (!l.IsBulk || l.ExpiresAt is not null)
                {
                    <dt>@L["Expires"]</dt>
                    <dd class="@(InventoryView.ExpiresSoon(l.ExpiresAt, Time.GetUtcNow()) ? "inv-held" : "")">@(l.ExpiresAt is null ? "—" : Display.SiteTime(l.ExpiresAt, tz))</dd>
                }
                <dt>@L["Created"]</dt>
                <dd>@Display.SiteTime(l.CreatedAt, tz)</dd>
                <dt>@L["Last change"]</dt>
                <dd>@Display.SiteTime(l.UpdatedAt, tz)</dd>
            </dl>
        </div>

        <section aria-labelledby="genealogy-title">
            <div class="inv-section-head">
                <h2 id="genealogy-title">@L["Genealogy"]</h2>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => TraceAsync(false)">@L["Trace back"]</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => TraceAsync(true)">@L["Trace forward"]</button>
                </div>
            </div>
            @if (_trace is { } trace)
            {
                <h3 class="h6 mt-2">@(_traceForward ? L["Everything made from it"] : L["Everything it was made from"])</h3>
                @if (trace.Count <= 1)
                {
                    <p class="text-muted">@(_traceForward ? L["Nothing has been made from this lot yet."] : L["This lot wasn't made from other lots."])</p>
                }
                else
                {
                    <ul class="inv-trace">
                        @foreach (var row in trace)
                        {
                            <li @key="row.Node.LotId" style="padding-left:@(row.Indent * 20)px">
                                @if (row.Indent > 0)
                                {
                                    <span class="inv-trace-step" aria-hidden="true">@(_traceForward ? "↳" : "↰")</span>
                                }
                                <a class="fw-semibold" href="inventory/lots/@row.Node.LotId">@InventoryView.LotLabel(L, row.Node.LotNumber, row.Node.IsBulk, row.Node.LocationCode)</a>
                                <span class="small">@row.Node.MaterialCode</span>
                                <span class="@InventoryView.StatusChip(row.Node.Status)">@L.Label(row.Node.Status)</span>
                                <span class="small text-muted">@InventoryView.Qty(row.Node.Quantity) @row.Node.UomCode</span>
                                @if (row.Node.Precision is { } precision)
                                {
                                    <span class="@BalanceAllocationPanel.PrecisionChip(precision)" title="@row.Node.PrecisionNote">@L.Of(BalanceAllocationPanel.PrecisionLabel(precision))</span>
                                }
                            </li>
                        }
                    </ul>
                }
            }
            else
            {
                @LinkTable(L["Made from"], detail.Parents, L["Not made from other lots."], tz)
                @if (l.ProducedByJobId is { } madeBy && User.Can(PermissionCodes.ProductionReport, l.SiteId))
                {
                    <MadeFromPicker @key="l.Id" LotId="l.Id" JobId="madeBy" Parents="detail.Parents" OnChanged="LoadAsync" />
                }
                @LinkTable(L["Used in"], detail.Children, L["Nothing made from it yet."], tz)
            }
        </section>
    </div>

    <LotRecordsPanel @key="@($"{l.Id}-{_documentsShown}")" LotId="l.Id" SiteId="l.SiteId" TimeZone="@tz" />

    @if (User.Can(PermissionCodes.QualityView, l.SiteId) || User.Can(PermissionCodes.LotRecords, l.SiteId))
    {
        <CertificatePanel @key="l.Id" LotId="l.Id" SiteId="l.SiteId" Issued="() => _documentsShown++" />
    }

    @if (User.Can(PermissionCodes.QualityView, l.SiteId))
    {
        <LotNcrPanel @key="l.Id" Lot="l" />
    }

    @if (User.Can(PermissionCodes.QualityView, l.SiteId))
    {
        <Pulaski.Web.Components.Pages.Quality.LotQualityPanel @key="@($"{l.Id}-{l.Version}")" Lot="l" TimeZone="@tz" Changed="LoadAsync" />
    }

    @if (l.IsBulk)
    {
        <BalanceAllocationPanel @key="l.Id" LotId="l.Id" TimeZone="@tz" />
    }

    @if (detail.Allocations.Count > 0)
    {
        <section class="inv-section" aria-labelledby="allocations-title">
            <h2 id="allocations-title">@L["Allocated to jobs"]</h2>
            <ul class="small mb-0">
                @foreach (var a in detail.Allocations)
                {
                    <li @key="a.Id">
                        <ScreenLink Href="@($"inventory/jobs/{a.JobId}")" Permission="@PermissionCodes.InventoryView">@a.JobNumber</ScreenLink>:
                        @InventoryView.Qty(a.Quantity) @a.UomCode set aside
                    </li>
                }
            </ul>
            <p class="small text-muted mb-0">@L["Other jobs can still consume it, with a warning; consuming it into its job uses the allocation up."]</p>
        </section>
    }

    <section class="inv-section" aria-labelledby="asof-title">
        <h2 id="asof-title">@L["As it was"]</h2>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <label class="small text-muted" for="lot-asof">@L["On"]</label>
            <input id="lot-asof" type="datetime-local" class="form-control form-control-sm w-auto" @bind="_asOf" />
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_asOf is null || _asOfBusy)" @onclick="ShowAsOfAsync">@L["Show"]</button>
            <span class="small text-muted">@L["Its quantity, place and status then, in the order its movements count (back-dated ones at their time)."]</span>
        </div>
        @if (_asOfState is { } then)
        {
            @if (!then.Existed)
            {
                <p class="small mb-0">@L["It didn't exist yet on {0}.", Display.SiteTime(then.At, tz)]</p>
            }
            else
            {
                <dl class="facts small mb-0">
                    <dt>@L["Quantity"]</dt><dd>@InventoryView.Qty(then.Quantity) @then.UomCode</dd>
                    <dt>@L["Where"]</dt><dd>@(then.LocationCode ?? "—")@(then.ContainerCode is { } container ? L[" · in {0}", container] : "")</dd>
                    <dt>@L["Status"]</dt><dd><span class="@InventoryView.StatusChip(then.Status)">@L.Label(then.Status)</span></dd>
                </dl>
            }
        }
    </section>

    <section class="inv-section" aria-labelledby="history-title">
        <h2 id="history-title">@L["History"]</h2>
        <div class="table-panel">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>@L["When"]</th>
                        <th>@L["What"]</th>
                        <th class="inv-num">@L["Change"]</th>
                        <th class="inv-num">@L["After"]</th>
                        <th>@L["Where"]</th>
                        <th>@L["Job"]</th>
                        <th>@L["Reason"]</th>
                        <th>@L["Who"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in detail.History)
                    {
                        <tr @key="e.Id">
                            <td class="small text-nowrap">
                                @Display.SiteTime(e.IsBackdated ? e.EffectiveAt : e.OccurredAt, tz)
                                @if (e.IsBackdated)
                                {
                                    <div class="text-muted" title="@L["Back-dated: it counts from the time above"]">@L["recorded {0}", Display.SiteTime(e.OccurredAt, tz)]</div>
                                }
                            </td>
                            <td>
                                @(L[InventoryView.EventLabel(e.Kind)])
                                @if (e.AutoSource is { } auto)
                                {
                                    <span class="chip ms-1" title="@L["Consumed automatically, not declared by hand"]">@L[FeedPointsPage.SourceLabel(auto)]</span>
                                }
                                @if (e.ToStatus is { } to)
                                {
                                    <div class="small text-muted">@L.Label(e.FromStatus) → @L.Label(to)</div>
                                }
                            </td>
                            <td class="inv-num">@(e.QtyDelta is { } d ? InventoryView.Delta(d) : "")</td>
                            <td class="inv-num">@(e.QtyAfter is { } a ? InventoryView.Qty(a) : "") <span class="small text-muted">@e.UomCode</span></td>
                            <td class="small">
                                @(e.Kind == "moved" ? $"{e.FromLocationCode} → {e.ToLocationCode}" : e.ToLocationCode ?? e.FromLocationCode)
                                @if (e.ContainerCode is { } container)
                                {
                                    <div class="text-muted">@(e.Kind == "packed" ? "into" : e.Kind == "unpacked" ? "out of" : "with") @container</div>
                                }
                                @if (e.RelatedLotId is { } related)
                                {
                                    <div><a href="inventory/lots/@related">@InventoryView.LotLabel(L, e.RelatedLotNumber, e.RelatedLotNumber is null, e.RelatedLotLocationCode)</a></div>
                                }
                            </td>
                            <td class="small">
                                @if (e.JobId is { } job)
                                {
                                    <a href="inventory/jobs/@job">@e.JobNumber</a>
                                }
                            </td>
                            <td class="small">
                                @if (e.Reference is { } reference)
                                {
                                    <div>@reference</div>
                                }
                                @e.ReasonName
                                @if (e.Comment is { } comment)
                                {
                                    <div class="text-muted">@comment</div>
                                }
                            </td>
                            <td class="small text-muted">@e.ActorId</td>
                            <td class="text-end">
                                @if (CanReverse(detail, e) && May(LotAction.Reverse))
                                {
                                    <button type="button" class="btn btn-sm btn-link p-0" title="@L["Undo this movement"]" @onclick="() => Reverse(e)">@L["Reverse"]</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else if (_error is null)
{
    <p class="text-muted">@L["Loading…"]</p>
}

<LotActionDrawer Action="_action" Lot="_lot?.Lot" Movement="_movement" OnDone="OnDoneAsync" OnClose="() => _action = null" />

@code {
    // Bumped when a certificate is issued (#137), so the documents list reads again.
    private int _documentsShown;

    [Parameter]
    public Guid LotId { get; set; }

    private LotDto? _lot;
    private DateTime? _asOf;
    private LotStateAtDto? _asOfState;
    private bool _asOfBusy;
    private IReadOnlyList<TraceRow>? _trace;
    private bool _traceForward;
    private ApiException? _error;
    private LotActionResult? _result;
    private LotAction? _action;
    private LotEventDto? _movement;

    private static readonly HashSet<string> Reversible = ["received", "adjusted", "scrapped", "moved", "status_changed", "shipped"];
    private static readonly HashSet<string> PutBack = ["packed", "unpacked", "corrected"];

    // Changes of quantity alone, reversed even when later movements followed, if the stock allows (D-063).
    private static readonly HashSet<string> QuantityOnly = ["received", "adjusted", "scrapped"];

    // Declarations, reversed with every lot they touched; production only when it predates report ids (otherwise with its report).
    private static readonly HashSet<string> Declarations = ["consumed", "split", "merged"];

    private string Title => _lot?.Lot is { } l ? InventoryView.LotLabel(L, l.LotNumber, l.IsBulk, l.LocationCode) : L["Lot"];

    protected override async Task OnParametersSetAsync()
    {
        _trace = null;
        _result = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            await Sites.EnsureAsync(Api);
            _lot = await Api.GetLotAsync(LotId);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    // Only the latest movement, once, and only one that touched this lot alone (D-030).
    // The site the inventory screens show; lots belong to it (D-027, D-037).
    private async Task ShowAsOfAsync()
    {
        if (Display.FromSiteLocal(_asOf, _lot?.SiteTimeZone) is not { } at)
        {
            return;
        }

        _asOfBusy = true;
        try
        {
            _asOfState = await Api.GetLotStateAtAsync(LotId, at);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _asOfBusy = false;
        }
    }

    private bool May(LotAction action) => User.Can(LotActions.Permission(action), Sites.SiteId);

    // Any movement that still stands (#79); the drawer says what reversing it does, and the API refuses one something later depends on,
    // offering to undo the chain.
    private static bool CanReverse(LotDto lot, LotEventDto e) =>
        !e.IsReversed && e.ReversesEventId is null && e.Kind != "reversed" && (
            Reversible.Contains(e.Kind)
            || QuantityOnly.Contains(e.Kind)
            || Declarations.Contains(e.Kind)
            || PutBack.Contains(e.Kind)
            || (e.Kind == "produced" && e.ReportId is null));

    private void Reverse(LotEventDto e)
    {
        _movement = e;
        _action = LotAction.Reverse;
    }

    private async Task TraceAsync(bool forward)
    {
        _error = null;
        try
        {
            _traceForward = forward;
            _trace = InventoryView.Tree(await Api.TraceLotAsync(LotId, forward));
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    // The label as a PDF (D-059): its barcode names this lot exactly, for scanning later.
    private async Task PrintLabelAsync()
    {
        try
        {
            var (content, type, name) = await Api.GetLabelAsync("lot", LotId, _lot!.Lot.SiteId);
            await Downloads.FileAsync(name, content, type);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task OnDoneAsync(LotActionResult result)
    {
        _action = null;
        _result = result;
        _trace = null;
        await LoadAsync();
    }

    private RenderFragment LinkTable(string title, IReadOnlyList<LotLinkDto> links, string empty, string? tz) => __builder =>
    {
        <h3 class="h6 mt-2">@title</h3>
        @if (links.Count == 0)
        {
            <p class="text-muted small">@empty</p>
        }
        else
        {
            <div class="table-panel mb-3">
                <table class="table table-sm align-middle">
                    <tbody>
                        @foreach (var link in links)
                        {
                            <tr @key="link.LotId">
                                <td><a class="fw-semibold" href="inventory/lots/@link.LotId">@InventoryView.LotLabel(L, link.LotNumber, link.IsBulk, link.LocationCode)</a></td>
                                <td>@link.MaterialCode <div class="small text-muted">@link.MaterialName</div></td>
                                <td><span class="@InventoryView.StatusChip(link.Status)">@L.Label(link.Status)</span></td>
                                <td class="small">
                                    @(link.JobNumber is null ? L.Label(link.LinkBasis) : L["via {0}", link.JobNumber])
                                    @if (link.Precision is { } precision)
                                    {
                                        <span class="@BalanceAllocationPanel.PrecisionChip(precision) ms-1" title="@link.PrecisionNote">@L.Of(BalanceAllocationPanel.PrecisionLabel(precision))</span>
                                    }
                                    else if (link.Unpaired)
                                    {
                                        <span class="chip ms-1 text-muted" title="@link.PrecisionNote">@L["Not paired"]</span>
                                    }
                                    <div class="text-muted" title="@(link.EffectiveAt < link.DerivedAt.AddMinutes(-1) ? L["Back-dated; recorded {0}", Display.SiteTime(link.DerivedAt, tz)] : null)">
                                        since @Display.SiteTime(link.EffectiveAt, tz)@(link.EffectiveAt < link.DerivedAt.AddMinutes(-1) ? " (back-dated)" : "")
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    };
}
