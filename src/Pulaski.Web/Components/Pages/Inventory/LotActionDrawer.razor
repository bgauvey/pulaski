@* One drawer for every movement of a lot (D-027): receive, declare production or consumption,
   write up, write off, move, hold and release. The page opens it with what it already knows (the
   lot, the material or the job) and reloads when it reports a result. *@
@inject PulaskiApiClient Api
@inject SiteSelection Sites
@inject CurrentUser User

@if (Action is { } action)
{
    <aside class="drawer" role="dialog" aria-modal="false" aria-labelledby="lot-drawer-title" @onkeydown="OnKeyDown">
        <header class="drawer-head">
            <div>
                <div class="small text-muted">@Context</div>
                <h2 id="lot-drawer-title" class="mb-0">@(L[LotActions.Title(action)])</h2>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-square" aria-label="@L["Close"]" @onclick="OnClose"><Icon Name="close" Size="18" /></button>
        </header>

        <form class="drawer-body" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
            <ProblemAlert Error="_error" />

            @if (_loading)
            {
                <p class="text-muted">@L["Loading…"]</p>
            }
            else
            {
                @switch (action)
                {
                    case LotAction.Receive:
                        <div class="mb-3">
                            <label class="form-label" for="lot-material">@L["Material"]</label>
                            <MaterialPicker Id="lot-material" Materials="_materials" Value="@(_materialId == Guid.Empty ? null : _materialId)"
                                            ValueChanged="id => SelectMaterialAsync(id ?? Guid.Empty)" />
                        </div>
                        @if (_expected.Count > 0)
                        {
                            <div class="mb-3">
                                <label class="form-label" for="lot-expected">@L["Against expected receipt"] <span class="text-muted">@L["(optional)"]</span></label>
                                <select id="lot-expected" class="form-select" @bind="_expectedId" @bind:after="ExpectedChosen">
                                    <option value="@Guid.Empty">@L["None"]</option>
                                    @foreach (var e in _expected)
                                    {
                                        <option value="@e.Id">@(e.Reference ?? L["No reference"]) · @InventoryView.Qty(e.RemainingQty) @e.UomCode@(e.ReceivedQty > 0 ? " still to come" : "") · due @Display.SiteTime(e.ExpectedAt, Sites.Site?.TimeZone)</option>
                                    }
                                </select>
                                <div class="form-text">@L["Receiving against it closes it: nothing more is expected, whatever quantity arrives."]</div>
                            </div>
                        }
                        @LocationField(null)
                        @if (ReceivingMaterial is { } received)
                        {
                            @if (received.IsLotTracked)
                            {
                                <div class="mb-3">
                                    <label class="form-label" for="lot-number">@(Mixing ? L["Lot number (optional)"] : L["Lot number"])</label>
                                    <input id="lot-number" class="form-control" maxlength="100" @bind="_lotNumber" />
                                    @if (Mixing)
                                    {
                                        <div class="form-text">@L["Lots mix at {0}: this joins its balance of {1}. Give the supplier's lot number to keep it traceable.", LocationCode(_locationId), received.Code]</div>
                                    }
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-7">
                                        <label class="form-label" for="lot-supplier">@L["Supplier lot"]</label>
                                        <input id="lot-supplier" class="form-control" maxlength="100" @bind="_supplierLot" />
                                    </div>
                                    <div class="col-5">
                                        <label class="form-label" for="lot-expires">@L["Expires"]</label>
                                        <input id="lot-expires" type="date" class="form-control" @bind="_expires" />
                                    </div>
                                    @if (received.ShelfLifeDays is { } days)
                                    {
                                        <div class="col-12 form-text mt-1">@L["Blank: {0} days from today, {1}'s shelf life.", days, received.Code]</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="small text-muted">@received.Code isn't lot-tracked: the quantity is added to its balance at the location.</p>
                            }
                        }
                        @QuantityField(true, null)
                        break;

                    case LotAction.Produce:
                        @JobField()
                        @LocationField(null)
                        @if (_producedTracked)
                        {
                            <div class="row g-2 mb-3">
                                <div class="col-7">
                                    <label class="form-label" for="lot-number">@L["Lot number"]</label>
                                    <input id="lot-number" class="form-control" maxlength="100" placeholder="@(Mixing ? L["Blank: straight into the balance"] : L["Blank: {0}-01, -02…", SelectedJob?.JobNumber ?? L["job"]])" @bind="_lotNumber" />
                                </div>
                                <div class="col-5">
                                    <label class="form-label" for="lot-expires">@L["Expires"]</label>
                                    <input id="lot-expires" type="date" class="form-control" @bind="_expires" />
                                </div>
                            </div>
                        }
                        @QuantityField(true, null)
                        break;

                    case LotAction.Consume:
                        @if (Lot is null)
                        {
                            <div class="mb-3">
                                <label class="form-label" for="lot-component">@L["Material"]</label>
                                <select id="lot-component" class="form-select" value="@_materialId" @onchange="OnComponentChangedAsync">
                                    <option value="@Guid.Empty">@L["Choose a material…"]</option>
                                    @foreach (var c in _components)
                                    {
                                        <option value="@c.MaterialId">@c.MaterialCode · @c.MaterialName@(c.IsPlanned ? " · planned" : "")</option>
                                    }
                                    <option disabled>──────────</option>
                                    @foreach (var m in _materials.Where(m => _components.All(c => c.MaterialId != m.Id)))
                                    {
                                        <option value="@m.Id">@m.Code · @m.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="lot-pick">@L["Lot"]</label>
                                <select id="lot-pick" class="form-select" @bind="_lotId" disabled="@(_materialId == Guid.Empty)">
                                    <option value="@Guid.Empty">@(_lots.Count == 0 && _materialId != Guid.Empty ? L["No available lot of this material"] : L["Choose a lot…"])</option>
                                    @foreach (var l in _lots)
                                    {
                                        <option value="@l.Id">@InventoryView.LotLabel(L, l.LotNumber, l.IsBulk, l.LocationCode) · @InventoryView.Qty(l.Quantity) @l.UomCode@(l.IsBulk ? "" : $" · {l.LocationCode}")</option>
                                    }
                                </select>
                            </div>
                            @RunField()
                        }
                        else
                        {
                            @JobField()
                        }
                        @QuantityField(true, ConsumeLot is { } lot ? L["{0} {1} available", InventoryView.Qty(lot.Quantity), lot.UomCode] : null)
                        break;

                    case LotAction.WriteUp:
                        @QuantityField(true, null)
                        @ReasonField()
                        break;

                    case LotAction.WriteOff:
                        @(QuantityField(false, L["Leave blank to write off all {0} {1}.", InventoryView.Qty(Lot!.Quantity), Lot.UomCode]))
                        @ReasonField()
                        break;

                    case LotAction.Load:
                        <div class="mb-3">
                            <label class="form-label" for="lot-feed">@L["Feed point"]</label>
                            <select id="lot-feed" class="form-select" @bind="_locationId">
                                <option value="@Guid.Empty">@(_feedPoints.Count == 0 ? L["No feed points at this site"] : L["Choose a feed point…"])</option>
                                @foreach (var f in _feedPoints)
                                {
                                    <option value="@f.Id">@f.Code · @f.Name@(f.LineCode is { } line ? $" ({line})" : "")</option>
                                }
                            </select>
                        </div>
                        <p class="small text-muted">
                            @(_locationId == Lot!.LocationId
                                ? L["It is there already: it feeds from now, and the lot of its material loaded before it stops feeding."]
                                : L["The whole lot moves there, all {0} {1}, and feeds from now.", InventoryView.Qty(Lot.Quantity), Lot.UomCode])
                            @L["Automated consumption (backflush, time window, a counter) takes from it while it is loaded."]
                        </p>
                        break;

                    case LotAction.Move:
                        @LocationField(Lot!.LocationId)
                        @if (Lot.IsBulk)
                        {
                            @(QuantityField(true, L["{0} {1} here. It joins the balance at the new location.", InventoryView.Qty(Lot.Quantity), Lot.UomCode]))
                        }
                        else
                        {
                            <p class="small text-muted">@L["The whole lot moves, all {0} {1}.", InventoryView.Qty(Lot.Quantity), Lot.UomCode]</p>
                        }
                        break;

                    case LotAction.Hold:
                        <fieldset class="mb-3">
                            <legend class="form-label">@L["Set to"]</legend>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="lot-hold" name="lot-hold" checked="@(_holdStatus == "on_hold")" @onchange='() => _holdStatus = "on_hold"' disabled="@(Lot!.Status == "on_hold")" />
                                <label class="form-check-label" for="lot-hold">@L["On hold: waiting for a decision"]</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="lot-quarantine" name="lot-hold" checked="@(_holdStatus == "quarantine")" @onchange='() => _holdStatus = "quarantine"' disabled="@(Lot.Status == "quarantine")" />
                                <label class="form-check-label" for="lot-quarantine">@L["Quarantine: kept apart, suspected bad"]</label>
                            </div>
                        </fieldset>
                        @ReasonField()
                        break;

                    case LotAction.Release:
                        <p>@InventoryView.LotLabel(L, Lot!.LotNumber, Lot.IsBulk, Lot.LocationCode) becomes available again, and can be consumed.</p>
                        break;

                    case LotAction.Split:
                        @(QuantityField(true, L["Of {0} {1}; the rest stays in {2}.", InventoryView.Qty(Lot!.Quantity), Lot.UomCode, Lot.LotNumber]))
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label" for="lot-number">@L["New lot number"]</label>
                                <input id="lot-number" class="form-control" maxlength="100" placeholder="@L["Blank: {0}-1…", Lot?.LotNumber]" @bind="_lotNumber" />
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="lot-split-to">@L["Goes to"]</label>
                                <select id="lot-split-to" class="form-select" @bind="_locationId">
                                    <option value="@Guid.Empty">@L["Where it is ({0})", Lot!.LocationCode]</option>
                                    @foreach (var l in _locations.Where(l => l.Id != Lot.LocationId))
                                    {
                                        <option value="@l.Id">@l.Code · @l.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        break;

                    case LotAction.Merge:
                        <p class="small text-muted">
                            @L["Lots of {0} at {1} that are {2} can be merged in.", Lot!.MaterialCode, Lot.LocationCode, L.Label(Lot.Status).ToLowerInvariant()]
                            @L["They go to zero; {0} takes their stock and the earliest expiry.", Lot.LotNumber]
                        </p>
                        @if (_lots.Count == 0)
                        {
                            <p class="text-muted">@L["No other lot can be merged into this one. Move or release lots first."]</p>
                        }
                        else
                        {
                            <fieldset class="mb-3">
                                <legend class="form-label">@L["Merge in"]</legend>
                                @foreach (var l in _lots)
                                {
                                    <div class="form-check" @key="l.Id">
                                        <input class="form-check-input" type="checkbox" id="merge-@l.Id" checked="@_mergeIds.Contains(l.Id)"
                                               @onchange="e => ToggleMerge(l.Id, e.Value is true)" />
                                        <label class="form-check-label" for="merge-@l.Id">
                                            @l.LotNumber · @InventoryView.Qty(l.Quantity) @l.UomCode@(l.ExpiresAt is { } x ? L[" · expires {0}", Display.SiteTime(x, Sites.Site?.TimeZone)[..10]] : "")
                                        </label>
                                    </div>
                                }
                            </fieldset>
                        }
                        break;

                    case LotAction.Ship:
                        @(QuantityField(false, L["Leave blank to ship all {0} {1}.", InventoryView.Qty(Lot!.Quantity), Lot.UomCode]))
                        <div class="mb-3">
                            <label class="form-label" for="lot-reference">@L["Delivery or shipment number"]</label>
                            <input id="lot-reference" class="form-control" maxlength="100" @bind="_reference" @bind:event="oninput" />
                        </div>
                        @if (User.Can(PermissionCodes.LotRecords, Lot.SiteId))
                        {
                            @* A certificate of analysis with the shipment (#137): issued after it ships, with the shipment's number on it. *@
                            <div class="form-check mb-3">
                                <input id="lot-coa" type="checkbox" class="form-check-input" @bind="_withCertificate" />
                                <label class="form-check-label" for="lot-coa">@L["Issue its certificate of analysis"]</label>
                            </div>
                        }
                        break;

                    case LotAction.Correct:
                        <div class="mb-3">
                            <label class="form-label" for="lot-number">@L["Lot number"]</label>
                            <input id="lot-number" class="form-control" maxlength="100" disabled="@Lot!.IsBulk" @bind="_lotNumber" />
                            @if (Lot.IsBulk)
                            {
                                <div class="form-text">@L["A balance has no lot number; it is named by its location."]</div>
                            }
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label" for="lot-supplier">@L["Supplier lot"]</label>
                                <input id="lot-supplier" class="form-control" maxlength="100" @bind="_supplierLot" />
                            </div>
                            <div class="col-5">
                                <label class="form-label" for="lot-expires">@L["Expires"]</label>
                                <input id="lot-expires" type="date" class="form-control" @bind="_expires" />
                            </div>
                        </div>
                        <p class="small text-muted">@L["Say why in the comment; it is required."]</p>
                        break;

                    case LotAction.Reverse:
                        @if (Movement is { } undo)
                        {
                            <dl class="facts">
                                <dt>@L["Movement"]</dt>
                                <dd>@(L[InventoryView.EventLabel(undo.Kind)])@(undo.QtyDelta is { } d ? $" {InventoryView.Delta(d)} {undo.UomCode}" : "")</dd>
                                <dt>@L["When"]</dt>
                                <dd>@Display.SiteTime(undo.OccurredAt, Sites.Site?.TimeZone)</dd>
                            </dl>
                            <p class="small text-muted">@InventoryView.ReversalNote(L, undo, Lot!)</p>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="lot-chain" checked="@_chain" @onchange="e => { _chain = e.Value is true; _chainCheck = null; }" />
                                <label class="form-check-label" for="lot-chain">@L["With everything after it that depends on it"]</label>
                                <div class="form-text">@L["Every later movement of this lot, and of lots split off it since, is reversed first, latest first. Check shows the list before anything is done."]</div>
                            </div>
                            @if (_chainCheck is { } check)
                            {
                                <div class="small mb-2">
                                    <div class="fw-semibold">@(check.Reversible ? (check.Steps.Count == 1 ? L["It reverses 1 movement:"] : L["It reverses these movements, latest first: {0}", check.Steps.Count]) : L["It can't all be reversed:"])</div>
                                    <ol class="mb-1">
                                        @foreach (var step in check.Steps)
                                        {
                                            <li>@step.LotName: @(L[InventoryView.EventLabel(step.Kind)]).ToLowerInvariant()@(step.Quantity is { } q ? $" {InventoryView.Delta(q)}" : "")@(step.JobNumber is { } job ? $" ({job})" : ""), @Display.SiteTime(step.EffectiveAt, Sites.Site?.TimeZone)</li>
                                        }
                                    </ol>
                                    @if (check.Problem is { } problem)
                                    {
                                        <div class="text-danger">@problem</div>
                                    }
                                </div>
                            }
                        }
                        @ReasonField()
                        break;
                }

                @if (CanBackdate)
                {
                    <div class="mb-3">
                        <label class="form-label" for="lot-effective">@L["Counts from"] <span class="text-muted">@L["(optional)"]</span></label>
                        <input id="lot-effective" type="datetime-local" class="form-control" @bind="_effective" />
                        <div class="form-text">
                            @L["To back-date it, up to 31 days, to when it was really done; it is recorded now as well. A comment saying why is required."]
                            @(Action is LotAction.Consume or LotAction.Produce ? L["It goes into the run going on then."] : "")
                            @(Action is LotAction.Move or LotAction.Hold or LotAction.Release ? L["Only as the lot's latest movement: nothing else may count after it."] : "")
                            @(Action is LotAction.Split or LotAction.Ship ? L["Only if the lot's status and location haven't changed since."] : "")
                            @(Action is LotAction.Merge ? L["The lots taken in must have nothing counting after it."] : "")
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label" for="lot-comment">@(SelectedReason?.RequiresComment == true || _effective is not null || Action == LotAction.Reverse ? L["Comment (required)"] : L["Comment"])</label>
                    <textarea id="lot-comment" class="form-control" rows="2" maxlength="1000" @bind="_comment"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@(_saving || !CanSubmit)">@SubmitLabel</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="OnClose">@L["Cancel"]</button>
                </div>
            }
        </form>
    </aside>
}

@code {
    [Parameter]
    public LotAction? Action { get; set; }

    /// <summary>The lot acted on; required for everything but receive and produce, optional for consume.</summary>
    [Parameter]
    public LotSummaryDto? Lot { get; set; }

    /// <summary>The material to receive, pre-selected.</summary>
    [Parameter]
    public Guid? MaterialId { get; set; }

    /// <summary>Where a receipt goes, when the screen already knows (a scanned location, D-059).</summary>
    [Parameter]
    public Guid? LocationId { get; set; }

    /// <summary>A scanned GS1 or supplier barcode (#75) to fill in a receipt from: material, lot, quantity and expiry.</summary>
    [Parameter]
    public ScannedLotDto? Scanned { get; set; }

    /// <summary>The job to declare against, pre-selected.</summary>
    [Parameter]
    public DeclarableJobDto? Job { get; set; }

    /// <summary>The movement to reverse: the lot's latest.</summary>
    [Parameter]
    public LotEventDto? Movement { get; set; }

    [Parameter]
    public EventCallback<LotActionResult> OnDone { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private LotAction? _openFor;
    private bool _loading;
    private bool _saving;
    private ApiException? _error;

    private IReadOnlyList<UomDto> _uoms = [];
    private IReadOnlyList<MaterialDto> _materials = [];
    private IReadOnlyList<InventoryLocationDto> _locations = [];
    private IReadOnlyList<FeedPointDto> _feedPoints = [];
    private IReadOnlyList<ReasonCodeDto> _reasons = [];
    private IReadOnlyList<DeclarableJobDto> _jobs = [];
    private IReadOnlyList<JobComponentUseDto> _components = [];
    private IReadOnlyList<LotSummaryDto> _lots = [];

    // The job's runs (D-035): consumption and production go into one; Guid.Empty means its open run.
    private IReadOnlyList<JobRunDto> _runs = [];
    private Guid _runId;

    private Guid _materialId;
    private Guid _locationId;
    private Guid _jobId;
    private Guid _lotId;
    private Guid _reasonId;
    private Guid _uomId;
    private decimal? _quantity;
    private string? _lotNumber;
    private string? _supplierLot;
    private DateTime? _expires;
    private string? _comment;
    private DateTime? _effective;
    private IReadOnlyList<ExpectedReceiptDto> _expected = [];
    private Guid _expectedId;

    // Back-dating (D-057, D-076): every movement but a correction, a reversal and packing, and only for those allowed it at the site.
    private bool CanBackdate =>
        Action is LotAction.Receive or LotAction.Produce or LotAction.Consume or LotAction.WriteUp or LotAction.WriteOff
            or LotAction.Move or LotAction.Hold or LotAction.Release or LotAction.Split or LotAction.Merge or LotAction.Ship
        && User.Can(PermissionCodes.InventoryBackdate, Sites.SiteId);

    private DateTimeOffset? EffectiveAt => CanBackdate ? Display.FromSiteLocal(_effective, Sites.Site?.TimeZone) : null;
    private string _holdStatus = "on_hold";
    private string? _reference;
    private readonly HashSet<Guid> _mergeIds = [];
    private bool _producedTracked = true;

    private Guid SiteId => Sites.SiteId ?? Lot?.SiteId ?? Guid.Empty;

    private MaterialDto? ReceivingMaterial => _materials.FirstOrDefault(m => m.Id == _materialId);

    // The chosen location mixes lots into one balance per material (D-031).
    private bool Mixing => _locations.FirstOrDefault(l => l.Id == _locationId)?.ComminglesLots == true;

    private DeclarableJobDto? SelectedJob => Job ?? _jobs.FirstOrDefault(j => j.Id == _jobId);

    private ReasonCodeDto? SelectedReason => _reasons.FirstOrDefault(r => r.Id == _reasonId);

    private LotSummaryDto? ConsumeLot => Lot ?? _lots.FirstOrDefault(l => l.Id == _lotId);

    private string Context => Lot is { } lot
        ? $"{lot.MaterialCode} · {InventoryView.LotLabel(L, lot.LotNumber, lot.IsBulk, lot.LocationCode)}"
        : Job is { } job ? $"{job.JobNumber} · {job.MaterialCode}" : Sites.Site?.Code ?? "";

    private bool _chain;
    private ChainReversalDto? _chainCheck;

    private string SubmitLabel => Action == LotAction.Reverse && _chain
        ? _chainCheck is { Reversible: true } check ? (check.Steps.Count == 1 ? L["Undo 1 movement"] : L["Undo movements: {0}", check.Steps.Count]) : L["Check"]
        : PlainSubmitLabel;

    private string PlainSubmitLabel => Action switch
    {
        LotAction.Receive => L["Receive"],
        LotAction.Produce => L["Record production"],
        LotAction.Consume => L["Record consumption"],
        LotAction.WriteUp => L["Write up"],
        LotAction.WriteOff => L["Write off"],
        LotAction.Move => L["Move"],
        LotAction.Load => L["Load"],
        LotAction.Hold => _holdStatus == "quarantine" ? L["Quarantine"] : L["Hold"],
        LotAction.Release => L["Release"],
        LotAction.Split => L["Split"],
        LotAction.Merge => _mergeIds.Count == 0 ? L["Merge"] : (_mergeIds.Count == 1 ? L["Merge 1 lot"] : L["Merge lots: {0}", _mergeIds.Count]),
        LotAction.Ship => L["Ship"],
        LotAction.Correct => L["Correct"],
        LotAction.Reverse => L["Reverse"],
        _ => L["Save"],
    };

    private bool CanSubmit => Action switch
    {
        LotAction.Receive => _materialId != Guid.Empty && _locationId != Guid.Empty && _quantity > 0,
        LotAction.Produce => SelectedJob is not null && _runs.Count > 0 && _locationId != Guid.Empty && _quantity > 0,
        LotAction.Consume => SelectedJob is not null && _runs.Count > 0 && ConsumeLot is not null && _quantity > 0,
        LotAction.WriteUp => _quantity > 0 && _reasonId != Guid.Empty,
        LotAction.WriteOff => _reasonId != Guid.Empty,
        LotAction.Move => _locationId != Guid.Empty && (Lot?.IsBulk != true || _quantity > 0),
        LotAction.Load => _locationId != Guid.Empty,
        LotAction.Hold => _reasonId != Guid.Empty,
        LotAction.Split => _quantity > 0 && _uomId != Guid.Empty,
        LotAction.Merge => _mergeIds.Count > 0,
        LotAction.Ship => !string.IsNullOrWhiteSpace(_reference),
        LotAction.Correct => (Lot?.IsBulk == true || !string.IsNullOrWhiteSpace(_lotNumber)) && !string.IsNullOrWhiteSpace(_comment),
        LotAction.Reverse => Movement is not null && _reasonId != Guid.Empty && !string.IsNullOrWhiteSpace(_comment),
        _ => true,
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Action == _openFor)
        {
            return;
        }

        _openFor = Action;
        if (Action is not { } action)
        {
            return;
        }

        Reset();
        _loading = true;
        try
        {
            _uoms = [.. (await Api.ListUomsAsync()).Where(u => u.IsActive)];
            if (action is LotAction.Receive or LotAction.Produce or LotAction.Move or LotAction.Split)
            {
                _locations = [.. (await Api.ListInventoryLocationsAsync(SiteId)).Where(l => l.IsActive)];
            }

            if (action is LotAction.Receive or LotAction.Produce || (action == LotAction.Consume && Lot is null))
            {
                _materials = await Api.ListMaterialsAsync();
            }

            if (action is LotAction.WriteUp or LotAction.WriteOff or LotAction.Hold or LotAction.Reverse)
            {
                _reasons = await Api.ListReasonCodesAsync(action == LotAction.Hold ? "hold" : "inventory_adjustment", SiteId);
            }

            if (action is LotAction.Produce or LotAction.Consume && Job is null)
            {
                _jobs = await Api.ListDeclarableJobsAsync(SiteId, materialId: action == LotAction.Consume ? Lot?.MaterialId : null);
                _jobId = _jobs.FirstOrDefault(j => j.PlansComponent)?.Id ?? Guid.Empty;
            }

            if (action == LotAction.Consume && Lot is null && Job is not null)
            {
                _components = (await Api.GetJobMaterialsAsync(Job.Id)).Components;
            }

            if (action is LotAction.Produce or LotAction.Consume && Job is not null)
            {
                await LoadRunsAsync(Job.Id);
            }

            switch (action)
            {
                case LotAction.Receive when Scanned is { MaterialId: { } scannedMaterial } scanned:
                    await SelectMaterialAsync(scannedMaterial);
                    _lotNumber = scanned.LotNumber ?? scanned.SupplierLot;
                    _supplierLot = scanned.SupplierLot ?? scanned.LotNumber;
                    _quantity = scanned.Quantity;
                    if (scanned.QuantityUnit is { } unit && _uoms.FirstOrDefault(u => string.Equals(u.Code, unit, StringComparison.OrdinalIgnoreCase)) is { } uom)
                    {
                        _uomId = uom.Id;
                    }

                    _expires = scanned.Expiry?.ToDateTime(TimeOnly.MinValue);
                    break;
                case LotAction.Receive when MaterialId is { } materialId:
                    await SelectMaterialAsync(materialId);
                    break;
                case LotAction.Produce:
                    await OnJobChangedAsync(_jobId);
                    break;
                case LotAction.Consume or LotAction.WriteUp or LotAction.WriteOff when Lot is not null:
                    _uomId = Lot.UomId;
                    break;
                case LotAction.Move when Lot is not null:
                    _uomId = Lot.UomId;
                    break;
                case LotAction.Load when Lot is not null:
                    _feedPoints = await Api.ListFeedPointsAsync(Lot.SiteId);
                    _locationId = _feedPoints.FirstOrDefault(f => f.Id == Lot.LocationId)?.Id ?? Guid.Empty;
                    break;
                case LotAction.Hold when Lot?.Status == "on_hold":
                    _holdStatus = "quarantine";
                    break;
                case LotAction.Split or LotAction.Ship when Lot is not null:
                    _uomId = Lot.UomId;
                    break;
                case LotAction.Merge when Lot is not null:
                    _lots = [.. (await Api.SearchLotsAsync(Lot.SiteId, materialId: Lot.MaterialId, locationId: Lot.LocationId, status: Lot.Status))
                        .Where(l => l.Id != Lot.Id && !l.IsBulk && l.Quantity > 0)];
                    break;
                case LotAction.Correct when Lot is not null:
                    _lotNumber = Lot.LotNumber;
                    _supplierLot = Lot.SupplierLot;
                    _expires = Lot.ExpiresAt is { } expires ? Display.ToSite(expires, Sites.Site?.TimeZone).Date : null;
                    break;
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _loading = false;
        }
    }

    private void Reset()
    {
        _error = null;
        _saving = false;
        _materials = [];
        _locations = [];
        _reasons = [];
        _jobs = [];
        _components = [];
        _lots = [];
        _materialId = Guid.Empty;
        _locationId = LocationId ?? Guid.Empty;
        _jobId = Guid.Empty;
        _lotId = Guid.Empty;
        _reasonId = Guid.Empty;
        _uomId = Guid.Empty;
        _quantity = null;
        _lotNumber = null;
        _supplierLot = null;
        _expires = null;
        _comment = null;
        _effective = null;
        _expected = [];
        _expectedId = Guid.Empty;
        _holdStatus = "on_hold";
        _producedTracked = true;
        _reference = null;
        _withCertificate = false;
        _mergeIds.Clear();
    }

    private async Task SelectMaterialAsync(Guid id)
    {
        _materialId = id;
        _expectedId = Guid.Empty;
        _expected = [];
        if (ReceivingMaterial is { } material)
        {
            _uomId = material.BaseUomId;
        }

        // What is on its way of it (D-058), to receive against.
        if (id != Guid.Empty && Sites.SiteId is { } site)
        {
            try
            {
                _expected = await Api.ListExpectedReceiptsAsync(site, materialId: id);
            }
            catch (ApiException ex)
            {
                _error = ex;
            }
        }
    }

    private void ExpectedChosen()
    {
        if (_expected.FirstOrDefault(e => e.Id == _expectedId) is { } chosen)
        {
            _quantity ??= chosen.RemainingQty;
            _uomId = chosen.UomId;
        }
    }

    // Consuming from a job: pick the material, then one of its available lots.
    private async Task OnComponentChangedAsync(ChangeEventArgs e)
    {
        _materialId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : Guid.Empty;
        _lotId = Guid.Empty;
        _lots = [];
        if (_materialId == Guid.Empty)
        {
            return;
        }

        try
        {
            _lots = await Api.SearchLotsAsync(SiteId, materialId: _materialId, status: "available");
            _lots = [.. _lots.Where(l => l.Quantity > 0)];
            _lotId = _lots.Count == 1 ? _lots[0].Id : Guid.Empty;
            _uomId = _lots.FirstOrDefault()?.UomId ?? _materials.FirstOrDefault(m => m.Id == _materialId)?.BaseUomId ?? Guid.Empty;
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    // Producing: the job's unit is the default, and a material that isn't lot-tracked takes no lot number.
    private async Task OnJobChangedAsync(Guid id)
    {
        _jobId = id;
        _runs = [];
        if (SelectedJob is not { } job)
        {
            return;
        }

        await LoadRunsAsync(job.Id);

        if (Action == LotAction.Produce && _materials.FirstOrDefault(m => m.Id == job.MaterialId) is { } material)
        {
            _producedTracked = material.IsLotTracked;
            _uomId = _uoms.FirstOrDefault(u => u.Code == job.UomCode)?.Id ?? material.BaseUomId;
        }
    }

    /// <summary>The job's runs, with its open run chosen, or else its latest one (for a report after the run).</summary>
    private async Task LoadRunsAsync(Guid jobId)
    {
        _runs = (await Api.GetJobExecutionAsync(jobId)).Runs;
        _runId = _runs.Any(r => r.EndedAt is null) ? Guid.Empty : _runs.LastOrDefault()?.Id ?? Guid.Empty;
    }

    private Guid? RunId => _runId == Guid.Empty ? null : _runId;

    private async Task SubmitAsync()
    {
        if (Action is not { } action || !CanSubmit)
        {
            return;
        }

        _saving = true;
        _error = null;
        var comment = string.IsNullOrWhiteSpace(_comment) ? null : _comment.Trim();
        try
        {
            // A chain undo's first click only checks; the drawer stays open with the list.
            (LotTransactionResponse, string)? chained = null;
            if (action == LotAction.Reverse && _chain)
            {
                chained = await ChainAsync(comment);
                if (chained is null)
                {
                    return;
                }
            }

            var (response, message) = action switch
            {
                LotAction.Receive => await ReceiveAsync(comment),
                LotAction.Produce => await ProduceAsync(comment),
                LotAction.Consume => await ConsumeAsync(comment),
                LotAction.WriteUp => Done(await Api.WriteUpLotAsync(Lot!.Id, Adjustment(comment)), L["written up by {0}", QtyText]),
                LotAction.WriteOff => Done(await Api.WriteOffLotAsync(Lot!.Id, Adjustment(comment)), _quantity is null ? L["written off"] : L["{0} written off", QtyText]),
                LotAction.Move => Done(
                    await Api.MoveLotAsync(Lot!.Id, new MoveLotRequest
                    {
                        Version = Lot.Version,
                        ToLocationId = _locationId,
                        Quantity = Lot.IsBulk ? _quantity : null,
                        UomId = Lot.IsBulk ? _uomId : null,
                        Comment = comment,
                        EffectiveAt = EffectiveAt,
                    }),
                    (Lot.IsBulk ? L["{0} moved to {1}", QtyText, LocationCode(_locationId)] : L["moved to {0}", LocationCode(_locationId)])),
                LotAction.Load => Done(
                    await Api.LoadLotAsync(Lot!.Id, new LoadLotRequest { Version = Lot.Version, FeedPointId = _locationId, Comment = comment }),
                    L["loaded at {0}", _feedPoints.FirstOrDefault(f => f.Id == _locationId)?.Code]),
                LotAction.Hold => Done(
                    await Api.ChangeLotStatusAsync(Lot!.Id, new ChangeLotStatusRequest { Version = Lot.Version, Status = _holdStatus, ReasonCodeId = _reasonId, Comment = comment, EffectiveAt = EffectiveAt }),
                    _holdStatus == "quarantine" ? L["quarantined"] : L["put on hold"]),
                LotAction.Release => Done(
                    await Api.ChangeLotStatusAsync(Lot!.Id, new ChangeLotStatusRequest { Version = Lot.Version, Status = "available", Comment = comment, EffectiveAt = EffectiveAt }),
                    L["released"]),
                LotAction.Split => await SplitAsync(comment),
                LotAction.Merge => Done(
                    await Api.MergeLotsAsync(Lot!.Id, new MergeLotsRequest { Version = Lot.Version, SourceLotIds = [.. _mergeIds], Comment = comment, EffectiveAt = EffectiveAt }),
                    (_mergeIds.Count == 1 ? L["took in 1 lot"] : L["took in lots: {0}", _mergeIds.Count])),
                LotAction.Ship => await ShipAsync(comment),
                LotAction.Correct => Done(
                    await Api.CorrectLotAsync(Lot!.Id, new CorrectLotRequest
                    {
                        Version = Lot.Version,
                        LotNumber = Lot.IsBulk ? null : _lotNumber!.Trim(),
                        SupplierLot = string.IsNullOrWhiteSpace(_supplierLot) ? null : _supplierLot.Trim(),
                        ExpiresAt = Display.FromSiteLocal(_expires, Sites.Site?.TimeZone),
                        Comment = comment!,
                    }),
                    L["corrected"]),
                LotAction.Reverse when chained is { } done => done,
                LotAction.Reverse => Done(
                    await Api.ReverseMovementAsync(Lot!.Id, new ReverseMovementRequest { Version = Lot.Version, EventId = Movement!.Id, ReasonCodeId = _reasonId, Comment = comment }),
                    L["had a movement ({0}) reversed", L[InventoryView.EventLabel(Movement.Kind)].ToLowerInvariant()]),
                _ => throw new InvalidOperationException(),
            };
            await OnDone.InvokeAsync(new LotActionResult(response, message));
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<(LotTransactionResponse, string)> ReceiveAsync(string? comment)
    {
        var response = await Api.ReceiveLotAsync(new ReceiveLotRequest
        {
            MaterialId = _materialId,
            LocationId = _locationId,
            LotNumber = ReceivingMaterial?.IsLotTracked == true ? _lotNumber : null,
            Quantity = _quantity!.Value,
            UomId = _uomId,
            SupplierLot = _supplierLot,
            ExpiresAt = Display.FromSiteLocal(_expires, Sites.Site?.TimeZone),
            Comment = comment,
            EffectiveAt = EffectiveAt,
            ExpectedReceiptId = _expectedId == Guid.Empty ? null : _expectedId,
        });
        return (response, L["{0} of {1} received into {2}", QtyText, ReceivingMaterial?.Code, LocationCode(_locationId)]);
    }

    private async Task<(LotTransactionResponse, string)> ProduceAsync(string? comment)
    {
        var job = SelectedJob!;
        var response = await Api.ProduceLotAsync(job.Id, new ProduceLotRequest
        {
            LocationId = _locationId,
            Quantity = _quantity!.Value,
            UomId = _uomId,
            LotNumber = _producedTracked ? _lotNumber : null,
            ExpiresAt = Display.FromSiteLocal(_expires, Sites.Site?.TimeZone),
            Comment = comment,
            RunId = RunId,
            EffectiveAt = EffectiveAt,
        });
        return (response, L["{0} of {1} produced by {2}", QtyText, job.MaterialCode, job.JobNumber]);
    }

    private async Task<(LotTransactionResponse, string)> ConsumeAsync(string? comment)
    {
        var job = SelectedJob!;
        var lot = ConsumeLot!;
        var response = await Api.ConsumeLotAsync(lot.Id, new ConsumeLotRequest
        {
            JobId = job.Id,
            Quantity = _quantity!.Value,
            UomId = _uomId,
            Comment = comment,
            RunId = RunId,
            EffectiveAt = EffectiveAt,
        });
        return (response, L["{0} of {1} consumed by {2}", QtyText, InventoryView.LotLabel(L, lot.LotNumber, lot.IsBulk, lot.LocationCode), job.JobNumber]);
    }

    // A chain undo (#79): the first click checks and lists what it would reverse; the second does it, refused if the chain changed meanwhile.
    private async Task<(LotTransactionResponse, string)?> ChainAsync(string? comment)
    {
        var request = new ReverseChainRequest { EventId = Movement!.Id, ReasonCodeId = _reasonId, Comment = comment, ExpectedSteps = _chainCheck?.Steps.Select(s => s.EventId).ToList() };
        if (_chainCheck is not { Reversible: true })
        {
            _chainCheck = await Api.ReverseChainAsync(Lot!.Id, request with { ExpectedSteps = null }, dryRun: true);
            return null;
        }

        var done = await Api.ReverseChainAsync(Lot!.Id, request, dryRun: false);
        _chainCheck = null;
        return (new LotTransactionResponse { LotId = Lot.Id, LotNumber = Lot.LotNumber, Quantity = Lot.Quantity, Status = Lot.Status, Version = Lot.Version },
            (done.Steps.Count == 1 ? L["had 1 movement reversed"] : L["had movements reversed, latest first: {0}", done.Steps.Count]));
    }

    private bool _withCertificate;

    // Ships, then (when asked, #137) issues the certificate with the shipment's number; a certificate that can't be issued is said, the shipment stands.
    private async Task<(LotTransactionResponse, string)> ShipAsync(string? comment)
    {
        var reference = _reference!.Trim();
        var shipped = Done(
            await Api.ShipLotAsync(Lot!.Id, new ShipLotRequest
            {
                Version = Lot.Version,
                Quantity = _quantity,
                UomId = _quantity is null ? null : _uomId,
                Reference = reference,
                Comment = comment,
                EffectiveAt = EffectiveAt,
            }),
            _quantity is null ? L["shipped on {0}", reference] : L["{0} shipped on {1}", QtyText, reference]);
        if (!_withCertificate)
        {
            return shipped;
        }

        try
        {
            var issued = await Api.IssueCertificateAsync(Lot.Id, new IssueCertificateRequest { Reference = reference });
            var said = issued.Warnings.Count == 0 ? L["Its certificate of analysis is attached."] : L["Its certificate of analysis is attached, noting: {0}", string.Join(" ", L.Notes(issued.Warnings))];
            return (shipped.Item1, $"{shipped.Item2} {said}");
        }
        catch (ApiException ex)
        {
            return (shipped.Item1, $"{shipped.Item2} {L["Its certificate couldn't be issued: {0}", L.Problem(ex)]}");
        }
    }

    private async Task<(LotTransactionResponse, string)> SplitAsync(string? comment)
    {
        var response = await Api.SplitLotAsync(Lot!.Id, new SplitLotRequest
        {
            Version = Lot.Version,
            Quantity = _quantity!.Value,
            UomId = _uomId,
            NewLotNumber = string.IsNullOrWhiteSpace(_lotNumber) ? null : _lotNumber.Trim(),
            ToLocationId = _locationId == Guid.Empty ? null : _locationId,
            Comment = comment,
            EffectiveAt = EffectiveAt,
        });
        return (response, L["{0} split off {1} into {2}.", QtyText, Lot.LotNumber, response.LotNumber]);
    }

    private void ToggleMerge(Guid id, bool on)
    {
        if (on)
        {
            _mergeIds.Add(id);
        }
        else
        {
            _mergeIds.Remove(id);
        }
    }

    private (LotTransactionResponse, string) Done(LotTransactionResponse response, string what) =>
        (response, $"{InventoryView.LotLabel(L, response.LotNumber, Lot?.IsBulk == true, Lot?.LocationCode)} {what}.");

    private AdjustLotRequest Adjustment(string? comment) => new()
    {
        Version = Lot!.Version,
        Quantity = _quantity,
        UomId = _quantity is null ? null : _uomId,
        ReasonCodeId = _reasonId,
        Comment = comment,
        EffectiveAt = EffectiveAt,
    };

    private string QtyText => _quantity is { } q ? $"{InventoryView.Qty(q)} {_uoms.FirstOrDefault(u => u.Id == _uomId)?.Code}" : "";

    private string LocationCode(Guid id) => _locations.FirstOrDefault(l => l.Id == id)?.Code ?? "";

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            OnClose.InvokeAsync();
        }
    }

    private RenderFragment LocationField(Guid? exclude) => __builder =>
    {
        <div class="mb-3">
            <label class="form-label" for="lot-location">@(Action == LotAction.Move ? L["To location"] : L["Location"])</label>
            <select id="lot-location" class="form-select" @bind="_locationId">
                <option value="@Guid.Empty">@(_locations.Count == 0 ? L["No location holds inventory: mark one on the Equipment page"] : L["Choose a location…"])</option>
                @foreach (var l in _locations.Where(l => l.Id != exclude))
                {
                    <option value="@l.Id">@l.Code · @l.Name</option>
                }
            </select>
        </div>
    };

    private RenderFragment QuantityField(bool required, string? hint) => __builder =>
    {
        <div class="row g-2 mb-3">
            <div class="col-7">
                <label class="form-label" for="lot-qty">@(required ? L["Quantity"] : L["Quantity (optional)"])</label>
                <input id="lot-qty" type="number" class="form-control" min="0" step="any" @bind="_quantity" @bind:event="oninput" />
            </div>
            <div class="col-5">
                <label class="form-label" for="lot-uom">@L["Unit"]</label>
                <select id="lot-uom" class="form-select" @bind="_uomId">
                    <option value="@Guid.Empty">@L["Unit…"]</option>
                    @foreach (var u in _uoms)
                    {
                        <option value="@u.Id">@u.Code</option>
                    }
                </select>
            </div>
            @if (hint is not null)
            {
                <div class="col-12 form-text mt-1">@hint</div>
            }
        </div>
    };

    private RenderFragment ReasonField() => __builder =>
    {
        <div class="mb-3">
            <label class="form-label" for="lot-reason">@L["Reason"]</label>
            <select id="lot-reason" class="form-select" @bind="_reasonId">
                <option value="@Guid.Empty">@(_reasons.Count == 0 ? L["No reasons set up: load db/seed-reasons.sql"] : L["Choose a reason…"])</option>
                @foreach (var r in _reasons)
                {
                    <option value="@r.Id">@Display.ReasonLabel(r)</option>
                }
            </select>
        </div>
    };

    private RenderFragment JobField() => __builder =>
    {
        @if (Job is { } fixedJob)
        {
            <dl class="facts">
                <dt>@L["Job"]</dt>
                <dd>@L["{0} · {1} on {2}", fixedJob.JobNumber, fixedJob.MaterialCode, fixedJob.LineCode]</dd>
            </dl>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label" for="lot-job">@L["Job"]</label>
                <select id="lot-job" class="form-select" value="@_jobId" @onchange="e => OnJobChangedAsync(Guid.TryParse(e.Value?.ToString(), out var id) ? id : Guid.Empty)">
                    <option value="@Guid.Empty">@(_jobs.Count == 0 ? L["No open production job"] : L["Choose a job…"])</option>
                    @foreach (var j in _jobs)
                    {
                        <option value="@j.Id">@L["{0} · {1} on {2}", j.JobNumber, j.MaterialCode, j.LineCode]@(j.PlansComponent ? $" · {L["planned"]}" : "")</option>
                    }
                </select>
                @if (Action == LotAction.Consume && SelectedJob is { PlansComponent: false })
                {
                    <div class="form-text text-warning-strong">@L["This job has no planned component of {0}; it will be recorded as a substitution.", Lot?.MaterialCode]</div>
                }
            </div>
        }

        @if (SelectedJob is not null)
        {
            @RunField()
        }
    };

    /// <summary>Which run the movement belongs to (D-035): the open run, or an earlier one for a late entry.</summary>
    private RenderFragment RunField() => __builder =>
    {
        @if (SelectedJob is null)
        {
            return;
        }

        @if (_runs.Count == 0)
        {
            <p class="small text-warning-strong mb-3">@L["{0} hasn't run yet. Start it on the Floor first.", SelectedJob.JobNumber] <ScreenLink Href="floor" Permission="@PermissionCodes.FloorView">@L["Floor"]</ScreenLink></p>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label" for="lot-run">@L["Run"]</label>
                <select id="lot-run" class="form-select" @bind="_runId">
                    @foreach (var r in _runs.Reverse())
                    {
                        <option value="@(r.EndedAt is null ? Guid.Empty : r.Id)">
                            @L["Run {0} on {1}", r.RunNo, r.LineCode] · @(r.EndedAt is { } end ? L["{0} to {1}", Display.SiteTime(r.StartedAt, Sites.Site?.TimeZone), Display.SiteTime(end, Sites.Site?.TimeZone)] : L["{0} · running now", Display.SiteTime(r.StartedAt, Sites.Site?.TimeZone)])
                        </option>
                    }
                </select>
                @if (_runId != Guid.Empty)
                {
                    <div class="form-text">@L["That run has ended: this is recorded late, into it."]</div>
                }
            </div>
        }
    };
}
