@page "/inventory/lots"
@attribute [RequiresView(PermissionCodes.InventoryView)]
@inject PulaskiApiClient Api
@inject CurrentUser User
@inject SiteSelection Sites
@inject TimeProvider Time
@inject Downloads Downloads

<PageTitle>@L["Lots · Inventory"] · Pulaski</PageTitle>

<InventoryHeader Title="@L["Find a lot"]" SiteChanged="SiteChangedAsync">
    <Description>@L["By lot or supplier lot number, material, location, status, expiry or an attribute's value. Without a status, only lots with stock on hand are found."]</Description>
</InventoryHeader>

<ProblemAlert Error="_error" />

<form class="inv-toolbar" role="search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
    <div class="inv-search inv-grow">
        <input type="search" class="form-control" placeholder="@L["Lot, supplier lot or material code"]" aria-label="@L["Lot number"]" @bind="_search" />
        <Icon Name="search" Size="16" />
    </div>
    <div class="inv-picker"><MaterialPicker Materials="_materials" @bind-Value="_materialId" Placeholder="@L["Any material"]" /></div>
    <select class="form-select" aria-label="@L["Location"]" @bind="_locationId">
        <option value="">@L["Any location"]</option>
        @foreach (var l in _locations)
        {
            <option value="@l.Id">@l.Code · @l.Name</option>
        }
    </select>
    <select class="form-select" aria-label="@L["Status"]" @bind="_status">
        <option value="">@L["On hand"]</option>
        @foreach (var s in InventoryView.Statuses)
        {
            <option value="@s">@L.Label(s)</option>
        }
    </select>
    <select class="form-select" aria-label="@L["Expiry"]" @bind="_expiryDays">
        <option value="">@L["Any expiry"]</option>
        <option value="0">@L["Expired"]</option>
        <option value="7">@L["Expiring within 7 days"]</option>
        <option value="30">@L["Expiring within 30 days"]</option>
        <option value="90">@L["Expiring within 90 days"]</option>
    </select>
    @if (_attributes.Count > 0)
    {
        <select class="form-select" aria-label="@L["Attribute"]" @bind="_attributeId" @bind:after="AttributeChanged">
            <option value="">@L["Any attribute"]</option>
            @foreach (var a in _attributes)
            {
                <option value="@a.Id">@a.Name</option>
            }
        </select>
        @if (Attribute is { } chosen)
        {
            @if (chosen.DataType is "number" or "date")
            {
                <input class="form-control" style="width: 8rem" type="@(chosen.DataType == "date" ? "date" : "text")" placeholder="@L["From"]" aria-label="@chosen.Name from" @bind="_attributeMin" />
                <input class="form-control" style="width: 8rem" type="@(chosen.DataType == "date" ? "date" : "text")" placeholder="@L["To"]" aria-label="@chosen.Name to" @bind="_attributeMax" />
            }
            else if (chosen.DataType is "choice" or "boolean")
            {
                <select class="form-select" aria-label="@chosen.Name" @bind="_attributeValue">
                    <option value="">@L["Any value"]</option>
                    @foreach (var choice in chosen.DataType == "boolean" ? ["yes", "no"] : chosen.Choices)
                    {
                        <option value="@choice">@choice</option>
                    }
                </select>
            }
            else
            {
                <input class="form-control" style="width: 10rem" placeholder="@L["Contains"]" aria-label="@chosen.Name contains" @bind="_attributeValue" />
            }
        }
    }
    <button type="submit" class="btn btn-primary">@L["Search"]</button>
    <button type="button" class="btn btn-outline-secondary" @onclick="ClearAsync">@L["Clear filters"]</button>
    <button type="button" class="btn btn-outline-secondary" disabled="@(_lots is not { Count: > 0 })" @onclick="ExportAsync">@L["Export CSV"]</button>
</form>

@if (_lots is null)
{
    @if (_error is null)
    {
        <p class="text-muted">@L["Loading…"]</p>
    }
}
else if (_lots.Count == 0)
{
    <div class="empty-panel">
        <h2>@L["No lots found"]</h2>
        <p class="text-muted mb-0">@L["Try fewer filters. Used-up lots show only when you choose the Consumed or Scrapped status."]</p>
    </div>
}
else
{
    <p class="small text-muted">@_lots.Count @(_lots.Count == 1 ? "lot" : "lots")@(_hasMore ? " so far" : "")</p>
    <div class="table-panel">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>@L["Lot"]</th>
                    <th>@L["Material"]</th>
                    <th>@L["Status"]</th>
                    <th class="inv-num">@L["Quantity"]</th>
                    <th>@L["Location"]</th>
                    <th>@L["Supplier lot"]</th>
                    <th>@L["Expires"]</th>
                    <th>@L["Updated"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in _lots)
                {
                    <tr @key="l.Id">
                        <td><a class="fw-semibold" href="inventory/lots/@l.Id">@InventoryView.LotLabel(L, l.LotNumber, l.IsBulk, l.LocationCode)</a></td>
                        <td><a href="inventory/materials/@l.MaterialId">@l.MaterialCode</a> <div class="small text-muted">@l.MaterialName</div></td>
                        <td><span class="@InventoryView.StatusChip(l.Status)">@L.Label(l.Status)</span></td>
                        <td class="inv-num">@InventoryView.Qty(l.Quantity) <span class="small text-muted">@l.UomCode</span></td>
                        <td>@l.LocationCode</td>
                        <td>@l.SupplierLot</td>
                        <td class="small text-nowrap @(InventoryView.ExpiresSoon(l.ExpiresAt, Time.GetUtcNow()) ? "inv-held" : "")">@Display.SiteTime(l.ExpiresAt, Sites.Site?.TimeZone)</td>
                        <td class="small text-muted text-nowrap">@Display.SiteTime(l.UpdatedAt, Sites.Site?.TimeZone)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (_hasMore)
    {
        <button type="button" class="btn btn-outline-secondary mt-3" disabled="@_loading" @onclick="MoreAsync">@L["Show more"]</button>
    }
}

@code {
    private const int Page = 200;

    [SupplyParameterFromQuery(Name = "materialId")]
    public Guid? MaterialQuery { get; set; }

    [SupplyParameterFromQuery(Name = "locationId")]
    public Guid? LocationQuery { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    private List<LotSummaryDto>? _lots;
    private bool _hasMore;
    private bool _loading;
    private IReadOnlyList<MaterialDto> _materials = [];
    private IReadOnlyList<InventoryLocationDto> _locations = [];
    private ApiException? _error;
    private string? _search;
    private Guid? _materialId;
    private Guid? _locationId;
    private string _status = "";
    private int? _expiryDays;
    private IReadOnlyList<LotAttributeDto> _attributes = [];
    private Guid? _attributeId;
    private string? _attributeValue;
    private string? _attributeMin;
    private string? _attributeMax;

    private LotAttributeDto? Attribute => _attributes.FirstOrDefault(a => a.Id == _attributeId);

    // The filters last searched with (#131), kept for the user; a link that names a material, location or status opens with those instead.
    private sealed record Filters(string? Search, Guid? MaterialId, Guid? LocationId, string? Status, int? ExpiryDays, Guid? AttributeId,
        string? AttributeValue, string? AttributeMin, string? AttributeMax);

    private static readonly string FiltersKey = UserViews.FiltersKey("inventory/lots");

    private void Restore()
    {
        if (MaterialQuery is null && LocationQuery is null && StatusQuery is null && User.Setting<Filters>(FiltersKey) is { } f)
        {
            (_search, _materialId, _locationId, _status, _expiryDays) = (f.Search, f.MaterialId, f.LocationId, f.Status ?? "", f.ExpiryDays);
            (_attributeId, _attributeValue, _attributeMin, _attributeMax) = (f.AttributeId, f.AttributeValue, f.AttributeMin, f.AttributeMax);
        }
    }

    private async Task SaveFiltersAsync()
    {
        try
        {
            await User.SetSettingAsync(Api, FiltersKey,
                new Filters(_search, _materialId, _locationId, _status, _expiryDays, _attributeId, _attributeValue, _attributeMin, _attributeMax));
        }
        catch (ApiException)
        {
        }
    }

    private async Task ClearAsync()
    {
        (_search, _materialId, _locationId, _status, _expiryDays) = (null, null, null, "", null);
        (_attributeId, _attributeValue, _attributeMin, _attributeMax) = (null, null, null, null);
        try
        {
            await User.SetSettingAsync<Filters>(Api, FiltersKey, null);
        }
        catch (ApiException)
        {
        }

        await LoadAsync(0);
    }

    protected override async Task OnInitializedAsync()
    {
        _materialId = MaterialQuery;
        _locationId = LocationQuery;
        _status = StatusQuery ?? "";
        Restore();
        try
        {
            await Sites.EnsureAsync(Api);
            _materials = await Api.ListMaterialsAsync();
            _locations = await Api.ListInventoryLocationsAsync(Sites.SiteId);
            await LoadAttributesAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }

        // Opening the page saves nothing: only a search does.
        await LoadAsync(0);
    }

    // Attributes belong to a site (D-056), so the filter offers the chosen site's.
    private async Task LoadAttributesAsync()
    {
        _attributes = Sites.SiteId is { } site ? [.. (await Api.ListLotAttributesAsync(site)).Where(a => a.IsActive || a.LotsWithValue > 0)] : [];
        if (Attribute is null)
        {
            _attributeId = null;
        }
    }

    private async Task SiteChangedAsync()
    {
        try
        {
            await LoadAttributesAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }

        await SearchAsync();
    }

    private void AttributeChanged() => (_attributeValue, _attributeMin, _attributeMax) = (null, null, null);

    private async Task SearchAsync()
    {
        await SaveFiltersAsync();
        await LoadAsync(0);
    }

    private Task MoreAsync() => LoadAsync(_lots?.Count ?? 0);

    private async Task LoadAsync(int offset)
    {
        _error = null;
        _loading = true;
        try
        {
            var page = await Fetch(offset, Page);
            _lots = offset == 0 ? [.. page] : [.. _lots ?? [], .. page];
            _hasMore = page.Count == Page;
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task<IReadOnlyList<LotSummaryDto>> Fetch(int offset, int limit)
    {
        var expiresBefore = _expiryDays is { } days ? Time.GetUtcNow().AddDays(days) : (DateTimeOffset?)null;
        return Api.SearchLotsAsync(
            Sites.SiteId, _search, _materialId, _locationId, string.IsNullOrEmpty(_status) ? null : _status, expiresBefore, offset, limit,
            _attributeId is { } attribute ? (attribute, _attributeValue, _attributeMin, _attributeMax) : null);
    }

    // Every matching lot, not only the pages shown, up to 10,000.
    private async Task ExportAsync()
    {
        _error = null;
        try
        {
            List<LotSummaryDto> all = [];
            IReadOnlyList<LotSummaryDto> page;
            do
            {
                page = await Fetch(all.Count, 500);
                all.AddRange(page);
            }
            while (page.Count == 500 && all.Count < 10_000);

            var tz = Sites.Site?.TimeZone;

            // One column per active lot attribute (#78), headed by its code as the attribute import reads it.
            var codes = Sites.SiteId is { } site
                ? (await Api.ListLotAttributesAsync(site)).Where(a => a.IsActive).Select(a => a.Code).ToList()
                : [];
            IReadOnlyList<LotAttributeExportDto> recorded = codes.Count == 0 || Sites.SiteId is not { } valueSite ? [] : await Api.ListLotAttributeValuesAsync(valueSite);
            var values = recorded.ToLookup(v => v.LotId);
            await Downloads.CsvAsync(
                Csv.FileName("lots", Sites.Site?.Code, Time.GetUtcNow()),
                Csv.Write(
                    ["Lot", "Material", "Name", "Status", "Quantity", "Unit", "Location", "Supplier lot", "Expires", "Origin", "Made by", "Created", "Updated", .. codes],
                    all.Select(l => (IReadOnlyList<object?>)[
                        InventoryView.LotLabel(L, l.LotNumber, l.IsBulk, l.LocationCode), l.MaterialCode, l.MaterialName, l.Status, l.Quantity, l.UomCode,
                        l.LocationCode, l.SupplierLot, l.ExpiresAt is { } x ? Display.SiteTime(x, tz) : null, l.Origin, l.ProducedByJobNumber,
                        Display.SiteTime(l.CreatedAt, tz), Display.SiteTime(l.UpdatedAt, tz),
                        .. codes.Select(c => (object?)values[l.Id].FirstOrDefault(v => v.AttributeCode == c)?.Value)])));
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }
}
