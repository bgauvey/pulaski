@page "/inventory/shortages"
@attribute [RequiresView(PermissionCodes.InventoryView)]
@inject PulaskiApiClient Api
@inject SiteSelection Sites
@inject CurrentUser User
@inject Downloads Downloads

<PageTitle>@L["Shortages · Inventory"] · Pulaski</PageTitle>

<InventoryHeader Title="@L["Material shortages"]" SiteChanged="OnSiteChangedAsync">
    <Description>
        @L["What the open jobs still need of each component, against the stock available now and the deliveries expected. Jobs take stock in the order they are needed, then what is due by then, so a shortfall shows on the first job it reaches."]
        @L["Stock allocated to a job covers that job first and isn't free for the others."]
    </Description>
    <Actions>
        @if (Sites.SiteId is { } site && User.Can(PermissionCodes.LotAllocate, site))
        {
            <button type="button" class="btn btn-outline-secondary" disabled="@_refreshing" @onclick="RefreshAllocationsAsync"
                    title="@L["For every open job: release allocations that are no longer usable and allocate what is still needed, earliest job first"]">@L["Refresh allocations"]</button>
        }
        @if (Sites.SiteId is not null)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="PickingListAsync"
                    title="@L["What to fetch from the stores for open jobs' allocations, by location; the equipment chosen below narrows it"]">@L["Picking list"]</button>
        }
    </Actions>
</InventoryHeader>

<ProblemAlert Error="_error" />
@foreach (var note in _allocationNotes)
{
    <p class="small text-muted mb-1">@note</p>
}

<div class="inv-toolbar">
    <EquipmentPicker Equipment="_equipment" Value="_equipmentId" ValueChanged="OnEquipmentChangedAsync" />
    <select class="form-select" aria-label="@L["Horizon"]" value="@_horizon" @onchange="OnHorizonChangedAsync">
        <option value="">@L["All open jobs"]</option>
        <option value="1">@L["Needed in the next 24 hours"]</option>
        <option value="3">@L["Next 3 days"]</option>
        <option value="7">@L["Next 7 days"]</option>
        <option value="14">@L["Next 14 days"]</option>
    </select>
    <select class="form-select" aria-label="@L["Timing"]" value="@(_live ? "live" : "published")" @onchange="OnTimingChangedAsync">
        <option value="live">@L["Jobs as the schedule has them now"]</option>
        <option value="published">@L["Jobs at their published times"]</option>
    </select>
    <div class="form-check ms-1">
        <input class="form-check-input" type="checkbox" id="short-only" @bind="_shortOnly" />
        <label class="form-check-label" for="short-only">@L["Short only"]</label>
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary btn-with-icon ms-auto" @onclick="LoadAsync"><Icon Name="refresh" Size="16" /> @L["Refresh"]</button>
</div>

@if (Sites.Sites.Count == 0 && _error is null)
{
    <p class="text-muted">@L["Create a site under Equipment first."] <ScreenLink Href="equipment" Permission="@PermissionCodes.EquipmentView">@L["Equipment"]</ScreenLink></p>
}
else if (_report is null)
{
    @if (_error is null)
    {
        <p class="text-muted">@L["Loading…"]</p>
    }
}
else
{
    var shown = _report.Materials.Where(m => !_shortOnly || m.Shortfall > 0).ToList();
    var shortCount = _report.Materials.Count(m => m.Shortfall > 0);

    <p class="small text-muted">
        @(shortCount == 0 ? L["Nothing is short."] : L["{0} of {1} components short.", shortCount, _report.Materials.Count])
        @L["Calculated {0}, with jobs {1}.", Display.SiteTime(_report.CalculatedAt, Sites.Site?.TimeZone), _report.LiveTiming ? L["where the schedule has them now"] : L["at their published times"]]
        @L["Held stock isn't counted until it is released. Incoming deliveries aren't stock: they count only for jobs that need the material after they are due, and a late one counts as arriving now."]
    </p>

    @foreach (var problem in _report.Problems)
    {
        <div class="drawer-alert is-warning"><Icon Name="alert" Size="18" /><span>@problem.Message</span></div>
    }

    @if (shown.Count == 0)
    {
        <div class="empty-panel">
            <h2>@(_report.Materials.Count == 0 ? L["No open job needs components"] : L["Everything is covered"])</h2>
            <p class="text-muted mb-0">
                @(_report.Materials.Count == 0
                    ? L["Components are planned when a work order is made from a BOM. Jobs with nothing left to consume don't show."]
                    : L["Available stock covers every open job's remaining components. Clear Short only to see them."])
            </p>
        </div>
    }
    else
    {
        <div class="table-panel">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>@L["Component"]</th>
                        <th class="inv-num">@L["Needed"]</th>
                        <th class="inv-num">@L["Available"]</th>
                        <th class="inv-num">@L["Held"]</th>
                        <th class="inv-num">@L["Incoming"]</th>
                        <th class="inv-num">@L["Short"]</th>
                        <th>@L["First short"]</th>
                    </tr>
                </thead>
                @foreach (var m in shown)
                {
                    var open = _open.Contains(m.MaterialId);
                    <tbody @key="m.MaterialId">
                        <tr>
                            <td>
                                <button type="button" class="inv-group-toggle p-0" aria-expanded="@(open ? "true" : "false")" @onclick="() => Toggle(m.MaterialId)">
                                    <Icon Name="chevron-right" Size="16" />
                                    <span>@m.MaterialCode</span>
                                </button>
                                <div class="small text-muted">@m.MaterialName · @m.Lines.Count @(m.Lines.Count == 1 ? "job" : "jobs") · <a href="inventory/materials/@m.MaterialId">@L["stock"]</a></div>
                            </td>
                            <td class="inv-num">@InventoryView.Qty(m.Demand) <span class="small text-muted">@m.BaseUomCode</span></td>
                            <td class="inv-num">@InventoryView.Qty(m.Available)</td>
                            <td class="inv-num @(m.Held > 0 ? "inv-held" : "")">@InventoryView.Qty(m.Held)</td>
                            <td class="inv-num">
                                @if (m.Incoming > 0)
                                {
                                    @InventoryView.Qty(m.Incoming)
                                    <div class="small @(m.NextIncomingAt < _report.CalculatedAt ? "text-danger" : "text-muted")">
                                        @L["next {0}", m.NextIncomingAt is { } next ? Display.SiteTime(next, Sites.Site?.TimeZone) : ""]@(m.NextIncomingAt < _report.CalculatedAt ? $" ({L["late"]})" : "")
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="inv-num">
                                @if (m.Shortfall > 0)
                                {
                                    <span class="chip chip-danger">@InventoryView.Qty(m.Shortfall) @m.BaseUomCode</span>
                                    @if (m.CantArriveInTime)
                                    {
                                        <div><span class="chip chip-warning" title="@L["Needed sooner than its {0}-day lead time from now", m.LeadTimeDays]">@L["Can't arrive in time"]</span></div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="small">
                                @if (m.FirstShortJobId is { } jobId)
                                {
                                    <a href="inventory/jobs/@jobId">@m.FirstShortJobNumber</a>
                                    <div class="text-muted">@(m.FirstShortAt is null ? "no time yet" : Display.SiteTime(m.FirstShortAt, Sites.Site?.TimeZone))</div>
                                }
                            </td>
                        </tr>
                        @if (open)
                        {
                            @foreach (var l in m.Lines)
                            {
                                <tr @key="l.JobId" class="small">
                                    <td class="ps-5">
                                        <a href="inventory/jobs/@l.JobId">@l.JobNumber</a>
                                        <span class="text-muted">· @l.LineCode · @L.Label(l.JobStatus)</span>
                                    </td>
                                    <td class="inv-num" title="@L["{0} needed by this job and every one before it", InventoryView.Qty(l.Cumulative)]">@InventoryView.Qty(l.Remaining)</td>
                                    <td class="inv-num text-muted">@(l.FromStock > 0 ? L["{0} from stock", InventoryView.Qty(l.FromStock)] : "")</td>
                                    <td></td>
                                    <td class="inv-num text-muted">@(l.FromIncoming > 0 ? L["{0} incoming", InventoryView.Qty(l.FromIncoming)] : "")</td>
                                    <td class="inv-num @(l.Uncovered > 0 ? "text-danger fw-semibold" : "text-muted")">
                                        @(l.Uncovered > 0 ? InventoryView.Qty(l.Uncovered) : "covered")
                                        @if (l.CantArriveInTime)
                                        {
                                            <div class="small fw-normal" title="@L["Needed sooner than the material's {0}-day lead time from now", m.LeadTimeDays]">@L["within lead time"]</div>
                                        }
                                    </td>
                                    <td class="text-muted">
                                        @(l.NeededFrom is null ? "no time yet" : Display.SiteTime(l.NeededFrom, Sites.Site?.TimeZone))
                                        <div title="@TimeHint(l)">@TimeLabel(l.TimeSource)</div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                }
            </table>
        </div>
    }
}

@code {
    private ShortageReportDto? _report;
    private IReadOnlyList<EquipmentDto> _equipment = [];
    private readonly HashSet<Guid> _open = [];
    private ApiException? _error;
    private Guid? _equipmentId;
    private string _horizon = "";
    private bool _shortOnly = true;
    private bool _live = true;

    private static string TimeLabel(string source) => source switch
    {
        "live" => "as scheduled now",
        "published" => "published start",
        "window" => "hold-until or window",
        _ => "",
    };

    private string? TimeHint(ShortageLineDto l) =>
        l.TimeSource == "live" && l.PublishedStart is { } published ? L["Published start {0}", Display.SiteTime(published, Sites.Site?.TimeZone)] : null;

    private async Task OnTimingChangedAsync(ChangeEventArgs e)
    {
        _live = e.Value?.ToString() != "published";
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Sites.EnsureAsync(Api);
            _equipment = await Api.ListEquipmentAsync(Sites.SiteId);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Sites.SiteId is not { } siteId)
        {
            _report = null;
            return;
        }

        _error = null;
        try
        {
            _report = await Api.GetShortagesAsync(siteId, _equipmentId, int.TryParse(_horizon, out var days) ? days : null, _live);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private bool _refreshing;
    private IReadOnlyList<string> _allocationNotes = [];

    private async Task RefreshAllocationsAsync()
    {
        _refreshing = true;
        _error = null;
        try
        {
            var result = await Api.RefreshSiteAllocationsAsync(Sites.SiteId!.Value);
            _allocationNotes = [AllocationView.Summary(L, result), .. result.Notes];
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _refreshing = false;
        }
    }

    // The picking list (#82) of the site, or of the jobs of the equipment chosen.
    private async Task PickingListAsync()
    {
        _error = null;
        try
        {
            var (content, type, name) = await Api.GetPickingListPdfAsync(Sites.SiteId!.Value, lineId: _equipmentId);
            await Downloads.FileAsync(name, content, type);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task OnSiteChangedAsync()
    {
        _equipmentId = null;
        _equipment = await Api.ListEquipmentAsync(Sites.SiteId);
        await LoadAsync();
    }

    private async Task OnEquipmentChangedAsync(Guid? id)
    {
        _equipmentId = id;
        await LoadAsync();
    }

    private async Task OnHorizonChangedAsync(ChangeEventArgs e)
    {
        _horizon = e.Value?.ToString() ?? "";
        await LoadAsync();
    }

    private void Toggle(Guid materialId)
    {
        if (!_open.Remove(materialId))
        {
            _open.Add(materialId);
        }
    }
}
