@page "/inventory/locations"
@attribute [RequiresView(PermissionCodes.InventoryView)]
@inject PulaskiApiClient Api
@inject SiteSelection Sites
@inject Downloads Downloads
@inject CurrentUser User

<PageTitle>Locations · Inventory · Pulaski</PageTitle>

<InventoryHeader Title="Locations" SiteChanged="LoadAsync">
    <Description>Equipment that holds inventory: stores, staging areas and the feed points on a line. Mark more on the <ScreenLink Href="equipment" Permission="@PermissionCodes.EquipmentView">Equipment</ScreenLink> page with <strong>Holds inventory</strong>.</Description>
</InventoryHeader>

<ProblemAlert Error="_error" />

@if (_locations is null)
{
    @if (_error is null)
    {
        <p class="text-muted">Loading…</p>
    }
}
else if (_locations.Count == 0)
{
    <div class="empty-panel">
        <h2>No locations yet</h2>
        <p class="text-muted mb-0">Lots need somewhere to be. On the Equipment page, add a storage zone (for example <em>Raw material stores</em>) and tick <strong>Holds inventory</strong>.</p>
    </div>
}
else
{
    <div class="table-panel">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Location</th>
                    <th>Kind</th>
                    <th>In</th>
                    <th class="inv-num">Lots</th>
                    <th class="inv-num">Materials</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in _locations)
                {
                    <tr @key="l.Id" class="@(l.IsActive ? "" : "text-muted")">
                        <td><span class="fw-semibold">@l.Code</span> <div class="small text-muted">@l.Name@(l.IsActive ? "" : " · inactive")</div></td>
                        <td>
                            @Display.Label(l.EquipmentRole)
                            @if (l.ComminglesLots)
                            {
                                <span class="chip ms-1" title="Lots here mix into one balance per material">Mixes lots</span>
                                <div class="small text-muted">
                                    @(l.FlowModel == "fifo" ? "First in, first out" : "Mixed")@(l.MinResidenceMinutes is { } m ? $", at least {m} min" : "")
                                    @if (User.Can(PermissionCodes.Equipment, l.SiteId))
                                    {
                                        <button type="button" class="btn btn-sm btn-link p-0 ms-1" @onclick="() => EditFlow(l)">Change</button>
                                    }
                                </div>
                                @if (_flow?.Id == l.Id)
                                {
                                    <form class="d-flex flex-wrap gap-2 mt-1" @onsubmit="SaveFlowAsync" @onsubmit:preventDefault>
                                        <select class="form-select form-select-sm w-auto" aria-label="How it flows" @bind="_flowModel">
                                            <option value="mixed">Mixed: everything blends</option>
                                            <option value="fifo">First in, first out</option>
                                        </select>
                                        <input type="number" min="0" class="form-control form-control-sm" style="width: 9rem" placeholder="Min. minutes" aria-label="Minimum residence in minutes" @bind="_residence" />
                                        <button type="submit" class="btn btn-sm btn-primary" disabled="@_saving">Save</button>
                                        <button type="button" class="btn btn-sm btn-link" @onclick="() => _flow = null">Cancel</button>
                                    </form>
                                }
                            }
                            @if (l.SingleMaterial)
                            {
                                <span class="chip ms-1" title="Takes one material at a time">One material</span>
                            }
                        </td>
                        <td>@l.ParentCode</td>
                        <td class="inv-num">@l.LotCount</td>
                        <td class="inv-num">@l.MaterialCount</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" href="inventory?locationId=@l.Id">Stock</a>
                            <a class="btn btn-sm btn-outline-secondary" href="inventory/lots?locationId=@l.Id">Lots</a>
                            <button type="button" class="btn btn-sm btn-outline-secondary" title="A label to scan when moving stock here" @onclick="() => LabelAsync(l)">Label</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<InventoryLocationDto>? _locations;
    private ApiException? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    // A location's label (D-059): scanned as where a move or receipt goes.
    private async Task LabelAsync(InventoryLocationDto location)
    {
        try
        {
            var (content, type, name) = await Api.GetLabelAsync("location", location.Id, location.SiteId);
            await Downloads.FileAsync(name, content, type);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private InventoryLocationDto? _flow;
    private string _flowModel = "mixed";
    private int? _residence;
    private bool _saving;

    // How a silo or tank flows (D-060), for which arrivals a trace through it keeps.
    private void EditFlow(InventoryLocationDto location) => (_flow, _flowModel, _residence) = (location, location.FlowModel, location.MinResidenceMinutes);

    private async Task SaveFlowAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            await Api.SetFlowAsync(_flow!.Id, new SetFlowRequest { Version = _flow.Version, FlowModel = _flowModel, MinResidenceMinutes = _residence });
            _flow = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            await Sites.EnsureAsync(Api);
            _locations = await Api.ListInventoryLocationsAsync(Sites.SiteId);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }
}
