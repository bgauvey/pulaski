@page "/inventory"
@attribute [RequiresView(PermissionCodes.InventoryView)]
@inject PulaskiApiClient Api
@inject SiteSelection Sites
@inject TimeProvider Time
@inject Downloads Downloads
@inject CurrentUser User

<PageTitle>@L["Inventory"] · Pulaski</PageTitle>

<InventoryHeader Title="@L["Inventory"]" SiteChanged="LoadAsync">
    <Description>@L["Stock of every material at {0}, grouped by class. Quantities are in each material's base unit.", Sites.Site?.Code ?? L["the site"]]</Description>
    <Actions>
        <button type="button" class="btn btn-outline-secondary" disabled="@(_stock is null)" @onclick="ExportAsync">@L["Export CSV"]</button>
        @if (User.Can(LotActions.Permission(LotAction.Produce), Sites.SiteId))
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="() => _action = LotAction.Produce">@L["Declare production"]</button>
        }
        @if (User.Can(LotActions.Permission(LotAction.Receive), Sites.SiteId))
        {
            <button type="button" class="btn btn-primary" @onclick="() => _action = LotAction.Receive">@L["Receive"]</button>
        }
    </Actions>
</InventoryHeader>

<ProblemAlert Error="_error" />
<LotResultBanner Result="_result" OnDismiss="() => _result = null" />

<div class="inv-toolbar" role="search">
    <div class="inv-search inv-grow">
        <input type="search" class="form-control" placeholder="@L["Find a material by code or name"]" aria-label="@L["Find a material"]"
               @bind="_search" @bind:event="oninput" />
        <Icon Name="search" Size="16" />
    </div>
    <select class="form-select" aria-label="@L["Material class"]" @bind="_classCode" @bind:after="SaveFiltersAsync">
        <option value="">@L["All classes"]</option>
        @foreach (var g in _groups)
        {
            <option value="@g.Key">@L[g.Label]</option>
        }
    </select>
    <select class="form-select" aria-label="@L["Location"]" value="@_locationId" @onchange="OnLocationChangedAsync">
        <option value="">@L["All locations"]</option>
        @foreach (var l in _locations)
        {
            <option value="@l.Id">@l.Code · @l.Name</option>
        }
    </select>
    <div class="form-check ms-1">
        <input class="form-check-input" type="checkbox" id="inv-in-stock" @bind="_inStockOnly" @bind:after="SaveFiltersAsync" />
        <label class="form-check-label" for="inv-in-stock">@L["In stock only"]</label>
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary btn-square" title="@L["Expand all"]" aria-label="@L["Expand all"]" @onclick="() => _collapsed.Clear()">
        <Icon Name="expand-all" Size="18" />
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary btn-square" title="@L["Collapse all"]" aria-label="@L["Collapse all"]"
            @onclick="() => _collapsed = [.. _groups.Select(g => g.Key)]">
        <Icon Name="collapse-all" Size="18" />
    </button>
</div>

@if (_stock is null)
{
    @if (_error is null)
    {
        <p class="text-muted">@L["Loading…"]</p>
    }
}
else if (Sites.Sites.Count == 0)
{
    <div class="empty-panel">
        <h2>@L["No site yet"]</h2>
        <p class="text-muted mb-0">@L["Create a site under Equipment, and mark the stores and staging areas in it as Holds inventory."] <ScreenLink Href="equipment" Permission="@PermissionCodes.EquipmentView">@L["Equipment"]</ScreenLink></p>
    </div>
}
else
{
    var shown = Shown;
    <div class="table-panel">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>@L["Material"]</th>
                    <th class="inv-num">@L["On hand"]</th>
                    <th class="inv-num">@L["Available"]</th>
                    <th class="inv-num">@L["Held"]</th>
                    <th class="inv-num">@L["Lots"]</th>
                    <th class="inv-num">@L["Locations"]</th>
                    <th>@L["Next expiry"]</th>
                </tr>
            </thead>
            @foreach (var group in shown)
            {
                var open = !_collapsed.Contains(group.Key) || Filtering;
                <tbody @key="group.Key">
                    <tr class="inv-group">
                        <th colspan="7">
                            <button type="button" class="inv-group-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => Toggle(group.Key)">
                                <Icon Name="chevron-right" Size="16" />
                                @L[group.Label]
                                <span class="text-muted">@L["Materials: {0} · in stock: {1} · lots: {2}", group.Items.Count, group.InStock, group.Lots]</span>
                            </button>
                        </th>
                    </tr>
                    @if (open)
                    {
                        @foreach (var s in group.Items)
                        {
                            <tr @key="s.MaterialId" class="@(s.LotCount == 0 ? "inv-empty-row" : "")">
                                <td>
                                    <a class="fw-semibold" href="inventory/materials/@s.MaterialId">@s.Code</a>
                                    <div class="small text-muted">@s.Name · @L.Label(s.MaterialType)@(s.IsLotTracked ? "" : " · not lot-tracked")</div>
                                </td>
                                <td class="inv-num">@InventoryView.Qty(s.OnHand) <span class="small text-muted">@s.BaseUomCode</span></td>
                                <td class="inv-num">@InventoryView.Qty(s.Available)</td>
                                <td class="inv-num @(s.Held > 0 ? "inv-held" : "")">@InventoryView.Qty(s.Held)</td>
                                <td class="inv-num">@s.LotCount</td>
                                <td class="inv-num">@s.LocationCount</td>
                                <td class="small text-nowrap @(InventoryView.ExpiresSoon(s.NextExpiry, Time.GetUtcNow()) ? "inv-held" : "")">
                                    @Display.SiteTime(s.NextExpiry, Sites.Site?.TimeZone)
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            }
        </table>
        @if (shown.Count == 0)
        {
            <p class="text-muted p-4 mb-0">@L["Nothing matches. {0}", _inStockOnly ? L["Clear In stock only to see materials with no stock."] : ""]</p>
        }
    </div>
}

<LotActionDrawer Action="_action" OnDone="OnDoneAsync" OnClose="() => _action = null" />

@code {
    [SupplyParameterFromQuery(Name = "locationId")]
    public Guid? LocationQuery { get; set; }

    private IReadOnlyList<MaterialStockDto>? _stock;
    private IReadOnlyList<StockGroup> _groups = [];
    private IReadOnlyList<InventoryLocationDto> _locations = [];
    private HashSet<string> _collapsed = [];
    private ApiException? _error;
    private LotActionResult? _result;
    private LotAction? _action;
    private string _search = "";
    private string _classCode = "";
    private Guid? _locationId;
    private bool _inStockOnly;

    private bool Filtering => !string.IsNullOrWhiteSpace(_search);

    // Search, class and in-stock filter what is loaded; a location reloads, since quantities are per location.
    private IReadOnlyList<StockGroup> Shown => InventoryView.Group(_stock!
        .Where(s => _classCode.Length == 0 || (s.MaterialClassCode ?? InventoryView.NoClass) == _classCode)
        .Where(s => !_inStockOnly || s.LotCount > 0)
        .Where(s => !Filtering
            || s.Code.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || s.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)));

    // The filters last chosen (#131): class, location and in stock only; the words typed aren't kept. A link naming a location wins.
    private sealed record Filters(string? ClassCode, Guid? LocationId, bool InStockOnly);

    private const string Page = "inventory";

    private Task SaveFiltersAsync() => SavedFilters.SaveAsync(User, Api, Page, new Filters(_classCode, _locationId, _inStockOnly));

    protected override async Task OnInitializedAsync()
    {
        _locationId = LocationQuery;
        _inStockOnly = LocationQuery is not null;
        if (LocationQuery is null && SavedFilters.Load<Filters>(User, Page) is { } f)
        {
            (_classCode, _locationId, _inStockOnly) = (f.ClassCode ?? "", f.LocationId, f.InStockOnly);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            await Sites.EnsureAsync(Api);
            _locations = await Api.ListInventoryLocationsAsync(Sites.SiteId);
            _stock = await Api.ListStockAsync(Sites.SiteId, locationId: _locationId);
            _groups = InventoryView.Group(_stock);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task OnLocationChangedAsync(ChangeEventArgs e)
    {
        _locationId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await SaveFiltersAsync();
        await LoadAsync();
    }

    // What is on screen: the same filters, every group open.
    private Task ExportAsync() =>
        Downloads.CsvAsync(
            Csv.FileName("stock", Sites.Site?.Code, Time.GetUtcNow()),
            Csv.Write(
                ["Class", "Material", "Name", "Type", "Lot-tracked", "On hand", "Available", "Held", "Unit", "Lots", "Locations", "Next expiry"],
                Shown.SelectMany(g => g.Items).Select(s => (IReadOnlyList<object?>)[
                    s.MaterialClassName, s.Code, s.Name, s.MaterialType, s.IsLotTracked ? "yes" : "no", s.OnHand, s.Available, s.Held, s.BaseUomCode,
                    s.LotCount, s.LocationCount, s.NextExpiry is { } x ? Display.SiteTime(x, Sites.Site?.TimeZone) : null]))).AsTask();

    private void Toggle(string key)
    {
        if (!_collapsed.Remove(key))
        {
            _collapsed.Add(key);
        }
    }

    private async Task OnDoneAsync(LotActionResult result)
    {
        _action = null;
        _result = result;
        await LoadAsync();
    }
}
