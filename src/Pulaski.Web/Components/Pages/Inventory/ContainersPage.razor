@page "/inventory/containers"
@attribute [RequiresView(PermissionCodes.InventoryView)]
@inject PulaskiApiClient Api
@inject SiteSelection Sites
@inject CurrentUser User
@inject Downloads Downloads

@* Pallets, totes, boxes and bins holding lots (D-059), and other containers (#76). Lots keep their own identity inside; moving a container moves
   everything in it. *@
<PageTitle>@L["Containers · Inventory"] · Pulaski</PageTitle>

<InventoryHeader Title="@L["Containers"]" SiteChanged="OnSiteChangedAsync">
    <Description>
        @L["Pallets, totes, boxes and bins that hold lots. Each lot keeps its own number and history; moving a container moves every lot in it. Pack a lot from its page or by scanning."]
        <a href="inventory/scan">@L["Scan"]</a>
    </Description>
</InventoryHeader>

<ProblemAlert Error="_error" />
<ViewOnlyNote Permission="@PermissionCodes.LotMove" What="@L["manage containers"]" SiteId="Sites.SiteId" />

@if (CanManage)
{
    <form class="inv-toolbar" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <select class="form-select w-auto" aria-label="@L["Kind"]" @bind="_kind">
            <option value="pallet">@L["Pallet"]</option>
            <option value="tote">@L["Tote"]</option>
            <option value="box">@L["Box"]</option>
            <option value="bin">@L["Bin"]</option>
            <option value="other">@L["Other"]</option>
        </select>
        <input class="form-control" style="width: 10rem" maxlength="30" placeholder="@L["Code (optional)"]" aria-label="@L["Code"]" @bind="_code" />
        <select class="form-select w-auto" aria-label="@L["Location"]" @bind="_locationId">
            <option value="@Guid.Empty">@L["Where it is"]</option>
            @foreach (var l in _locations)
            {
                <option value="@l.Id">@l.Code · @l.Name</option>
            }
        </select>
        <div class="form-check align-self-center">
            <input class="form-check-input" type="checkbox" id="ct-mixes" @bind="_mixes" />
            <label class="form-check-label" for="ct-mixes" title="@L["Lots put in it lose their identity and join one balance per material, like a gaylord of partial bags"]">@L["Lots mix in it"]</label>
        </div>
        <button type="submit" class="btn btn-primary" disabled="@(_busy || _locationId == Guid.Empty)">@L["Add container"]</button>
    </form>
}

<div class="inv-toolbar">
    <input type="search" class="form-control" style="max-width: 16rem" placeholder="@L["Container or location code"]" aria-label="@L["Search"]" @bind="_search" @bind:after="SearchAsync" />
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="ct-retired" @bind="_includeRetired" @bind:after="SearchAsync" />
        <label class="form-check-label" for="ct-retired">@L["Show retired"]</label>
    </div>
</div>

@if (_containers is null)
{
    @if (_error is null)
    {
        <p class="text-muted">@L["Loading…"]</p>
    }
}
else if (_containers.Count == 0)
{
    <div class="empty-panel"><p class="text-muted mb-0">@L["No containers at {0} yet.", Sites.Site?.Code ?? L["this site"]]</p></div>
}
else
{
    <div class="table-panel">
        <table class="table align-middle">
            <thead><tr><th>@L["Container"]</th><th>@L["Kind"]</th><th>@L["Where"]</th><th class="inv-num">@L["Lots"]</th><th></th></tr></thead>
            @foreach (var c in _containers)
            {
                <tbody @key="c.Id">
                    <tr class="@(c.IsActive ? "" : "text-muted")">
                        <td>
                            <button type="button" class="inv-group-toggle p-0" aria-expanded="@(_open?.Id == c.Id ? "true" : "false")" @onclick="() => ToggleAsync(c)">
                                <Icon Name="chevron-right" Size="16" /><span class="fw-semibold">@c.Code</span>
                            </button>
                            @(c.IsActive ? "" : " · retired")
                            @if (c.MixesLots)
                            {
                                <span class="chip ms-1" title="@(c.FlowModel == "fifo" ? L["Lots put in it join one balance per material (first in, first out)"] : L["Lots put in it join one balance per material (mixed)"])">@L["Mixes lots"]</span>
                            }
                        </td>
                        <td>@L.Label(c.Kind)</td>
                        <td>@c.LocationCode@(c.ParentContainerCode is { } parent ? L[" · in {0}", parent] : "")</td>
                        <td class="inv-num">@c.LotCount@(c.ContainerCount > 0 ? L[" + {0} inside", c.ContainerCount] : "")</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-link" @onclick="() => LabelAsync(c)">@L["Label"]</button>
                            <PrintLabelControl Kind="container" Id="c.Id" SiteId="c.SiteId" ButtonClass="btn btn-sm btn-link" />
                            @if (CanManage && c.IsActive)
                            {
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => { _moving = c; _toId = Guid.Empty; _packing = null; }">@L["Move…"]</button>
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => { _packing = c; _intoId = Guid.Empty; _moving = null; }">@L["Pack into…"]</button>
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => EditMixing(c)">@L["Mixing…"]</button>
                                @if (c.ParentContainerId is not null)
                                {
                                    <button type="button" class="btn btn-sm btn-link" disabled="@_busy" @onclick="() => TakeOutAsync(c)">@L["Take out of {0}", c.ParentContainerCode]</button>
                                }
                                <ActionButton Class="btn btn-sm btn-link" Busy="_busy" Reason="@(c.LotCount + c.ContainerCount > 0 ? L["Empty it first: it still holds lots or containers."] : null)" OnClick="() => RetireAsync(c)">@L["Retire"]</ActionButton>
                            }
                        </td>
                    </tr>
                    @if (_moving?.Id == c.Id)
                    {
                        <tr>
                            <td colspan="5">
                                <form class="d-flex gap-2" @onsubmit="MoveAsync" @onsubmit:preventDefault>
                                    <select class="form-select form-select-sm w-auto" aria-label="@L["To"]" @bind="_toId">
                                        <option value="@Guid.Empty">@(c.LotCount == 1 ? L["Move {0} and its lot to…", c.Code] : L["Move {0} and its lots ({1}) to…", c.Code, c.LotCount])</option>
                                        @foreach (var l in _locations.Where(l => l.Id != c.LocationId))
                                        {
                                            <option value="@l.Id">@l.Code · @l.Name</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary" disabled="@(_busy || _toId == Guid.Empty)">@L["Move"]</button>
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => _moving = null">@L["Cancel"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (_mixing?.Id == c.Id)
                    {
                        <tr>
                            <td colspan="5">
                                <form class="d-flex flex-wrap gap-2 align-items-center" @onsubmit="SaveMixingAsync" @onsubmit:preventDefault>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="mix-@c.Id" @bind="_mixOn" disabled="@(c.LotCount + c.ContainerCount > 0)" />
                                        <label class="form-check-label small" for="mix-@c.Id">@(c.LotCount + c.ContainerCount > 0 ? L["Lots mix in it (empty it to change)"] : L["Lots mix in it"])</label>
                                    </div>
                                    <select class="form-select form-select-sm w-auto" aria-label="@L["How it flows"]" @bind="_mixFlow">
                                        <option value="mixed">@L["Mixed: everything blends"]</option>
                                        <option value="fifo">@L["First in, first out"]</option>
                                    </select>
                                    <input type="number" min="0" class="form-control form-control-sm" style="width: 9rem" placeholder="@L["Min. minutes"]" aria-label="@L["Minimum residence in minutes"]" @bind="_mixResidence" />
                                    <button type="submit" class="btn btn-sm btn-primary" disabled="@_busy">@L["Save"]</button>
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => _mixing = null">@L["Cancel"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (_packing?.Id == c.Id)
                    {
                        <tr>
                            <td colspan="5">
                                <form class="d-flex gap-2" @onsubmit="PackAsync" @onsubmit:preventDefault>
                                    <select class="form-select form-select-sm w-auto" aria-label="@L["Into"]" @bind="_intoId">
                                        <option value="@Guid.Empty">@L["Put {0} and all it holds inside…", c.Code]</option>
                                        @foreach (var o in _containers.Where(o => o.IsActive && !o.MixesLots && o.Id != c.Id && o.Id != c.ParentContainerId))
                                        {
                                            <option value="@o.Id">@o.Code · @o.LocationCode@(o.LocationId == c.LocationId ? "" : " (moves it there)")</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary" disabled="@(_busy || _intoId == Guid.Empty)">@L["Pack"]</button>
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => _packing = null">@L["Cancel"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (_open?.Id == c.Id)
                    {
                        @foreach (var inner in _open.Containers)
                        {
                            <tr @key="inner.Id" class="small">
                                <td class="ps-5"><span class="chip">@L.Label(inner.Kind)</span> @inner.Code</td>
                                <td colspan="2">@L["container"]</td>
                                <td class="inv-num">@inner.LotCount@(inner.ContainerCount > 0 ? L[" + {0} inside", inner.ContainerCount] : "")</td>
                                <td></td>
                            </tr>
                        }
                        @if (_open.Lots.Count == 0 && _open.Containers.Count == 0)
                        {
                            <tr><td colspan="5" class="ps-5 small text-muted">@L["Empty."]</td></tr>
                        }
                        @foreach (var l in _open.Lots)
                        {
                            <tr @key="l.Id" class="small">
                                <td class="ps-5"><a href="inventory/lots/@l.Id">@l.LotNumber</a></td>
                                <td>@l.MaterialCode</td>
                                <td><span class="@InventoryView.StatusChip(l.Status)">@L.Label(l.Status)</span></td>
                                <td class="inv-num">@InventoryView.Qty(l.Quantity) @l.UomCode</td>
                                <td></td>
                            </tr>
                        }
                    }
                </tbody>
            }
        </table>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "open")]
    public Guid? OpenQuery { get; set; }

    private IReadOnlyList<ContainerDto>? _containers;
    private IReadOnlyList<InventoryLocationDto> _locations = [];
    private ContainerDto? _open;
    private ContainerDto? _packing;
    private ContainerDto? _mixing;
    private bool _mixes;
    private bool _mixOn;
    private string _mixFlow = "mixed";
    private int? _mixResidence;
    private Guid _intoId;
    private ContainerDto? _moving;
    private Guid _toId;
    private string _kind = "pallet";
    private string? _code;
    private Guid _locationId;
    private string? _search;
    private bool _includeRetired;
    private ApiException? _error;
    private bool _busy;

    private bool CanManage => User.Can(PermissionCodes.LotMove, Sites.SiteId);

    // The search last made (#131): its words and whether retired containers show.
    private sealed record Filters(string? Search, bool IncludeRetired);

    private const string Page = "inventory/containers";

    private async Task SearchAsync()
    {
        await SavedFilters.SaveAsync(User, Api, Page, new Filters(_search, _includeRetired));
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        if (SavedFilters.Load<Filters>(User, Page) is { } f)
        {
            (_search, _includeRetired) = (f.Search, f.IncludeRetired);
        }

        try
        {
            await Sites.EnsureAsync(Api);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }

        await OnSiteChangedAsync();
        if (OpenQuery is { } open)
        {
            _open = await Api.GetContainerAsync(open);
        }
    }

    private async Task OnSiteChangedAsync()
    {
        try
        {
            _locations = [.. (await Api.ListInventoryLocationsAsync(Sites.SiteId)).Where(l => l.IsActive)];
        }
        catch (ApiException ex)
        {
            _error = ex;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Sites.SiteId is not { } site)
        {
            _containers = [];
            return;
        }

        try
        {
            _containers = await Api.ListContainersAsync(site, _search, _includeRetired);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task ToggleAsync(ContainerDto c)
    {
        _open = _open?.Id == c.Id ? null : await Api.GetContainerAsync(c.Id);
    }

    private Task CreateAsync() => RunAsync(async () =>
    {
        await Api.CreateContainerAsync(new CreateContainerRequest { SiteId = Sites.SiteId!.Value, Code = _code, Kind = _kind, LocationId = _locationId, MixesLots = _mixes });
        _code = null;
        _mixes = false;
    });

    private Task MoveAsync() => RunAsync(async () =>
    {
        await Api.MoveContainerAsync(_moving!.Id, new MoveContainerRequest { Version = _moving.Version, ToLocationId = _toId });
        _moving = null;
        _open = null;
    });

    private Task RetireAsync(ContainerDto c) => RunAsync(() => Api.RetireContainerAsync(c.Id, c.Version));

    private void EditMixing(ContainerDto c) =>
        (_mixing, _mixOn, _mixFlow, _mixResidence, _moving, _packing) = (c, c.MixesLots, c.FlowModel, c.MinResidenceMinutes, null, null);

    private Task SaveMixingAsync() => RunAsync(async () =>
    {
        await Api.SetContainerMixingAsync(_mixing!.Id, new SetContainerMixingRequest
        {
            Version = _mixing.Version, MixesLots = _mixOn, FlowModel = _mixFlow, MinResidenceMinutes = _mixResidence,
        });
        _mixing = null;
    });

    private Task PackAsync() => RunAsync(async () =>
    {
        await Api.PackContainerAsync(_packing!.Id, new PackContainerRequest { Version = _packing.Version, IntoContainerId = _intoId });
        _packing = null;
        _open = null;
    });

    private Task TakeOutAsync(ContainerDto c) => RunAsync(async () =>
    {
        await Api.PackContainerAsync(c.Id, new PackContainerRequest { Version = c.Version });
        _open = null;
    });

    private async Task LabelAsync(ContainerDto c)
    {
        try
        {
            var (content, type, name) = await Api.GetLabelAsync("container", c.Id, c.SiteId);
            await Downloads.FileAsync(name, content, type);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }
}
