@page "/inventory/containers"
@attribute [RequiresView(PermissionCodes.InventoryView)]
@inject PulaskiApiClient Api
@inject SiteSelection Sites
@inject CurrentUser User
@inject Downloads Downloads

@* Pallets, totes, boxes and bins holding lots (D-059), and other containers (#76). Lots keep their own identity inside; moving a container moves
   everything in it. *@
<PageTitle>Containers · Inventory · Pulaski</PageTitle>

<InventoryHeader Title="Containers" SiteChanged="OnSiteChangedAsync">
    <Description>
        Pallets, totes, boxes and bins that hold lots. Each lot keeps its own number and history; moving a container moves every lot in it. Pack a lot from its page or by
        <a href="inventory/scan">scanning</a>.
    </Description>
</InventoryHeader>

<ProblemAlert Error="_error" />
<ViewOnlyNote Permission="@PermissionCodes.LotMove" What="manage containers" SiteId="Sites.SiteId" />

@if (CanManage)
{
    <form class="inv-toolbar" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <select class="form-select w-auto" aria-label="Kind" @bind="_kind">
            <option value="pallet">Pallet</option>
            <option value="tote">Tote</option>
            <option value="box">Box</option>
            <option value="bin">Bin</option>
            <option value="other">Other</option>
        </select>
        <input class="form-control" style="width: 10rem" maxlength="30" placeholder="Code (optional)" aria-label="Code" @bind="_code" />
        <select class="form-select w-auto" aria-label="Location" @bind="_locationId">
            <option value="@Guid.Empty">Where it is</option>
            @foreach (var l in _locations)
            {
                <option value="@l.Id">@l.Code · @l.Name</option>
            }
        </select>
        <div class="form-check align-self-center">
            <input class="form-check-input" type="checkbox" id="ct-mixes" @bind="_mixes" />
            <label class="form-check-label" for="ct-mixes" title="Lots put in it lose their identity and join one balance per material, like a gaylord of partial bags">Lots mix in it</label>
        </div>
        <button type="submit" class="btn btn-primary" disabled="@(_busy || _locationId == Guid.Empty)">Add container</button>
    </form>
}

<div class="inv-toolbar">
    <input type="search" class="form-control" style="max-width: 16rem" placeholder="Container or location code" aria-label="Search" @bind="_search" @bind:after="LoadAsync" />
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="ct-retired" @bind="_includeRetired" @bind:after="LoadAsync" />
        <label class="form-check-label" for="ct-retired">Show retired</label>
    </div>
</div>

@if (_containers is null)
{
    @if (_error is null)
    {
        <p class="text-muted">Loading…</p>
    }
}
else if (_containers.Count == 0)
{
    <div class="empty-panel"><p class="text-muted mb-0">No containers at @(Sites.Site?.Code ?? "this site") yet.</p></div>
}
else
{
    <div class="table-panel">
        <table class="table align-middle">
            <thead><tr><th>Container</th><th>Kind</th><th>Where</th><th class="inv-num">Lots</th><th></th></tr></thead>
            @foreach (var c in _containers)
            {
                <tbody @key="c.Id">
                    <tr class="@(c.IsActive ? "" : "text-muted")">
                        <td>
                            <button type="button" class="inv-group-toggle p-0" aria-expanded="@(_open?.Id == c.Id ? "true" : "false")" @onclick="() => ToggleAsync(c)">
                                <Icon Name="chevron-right" Size="16" /><span class="fw-semibold">@c.Code</span>
                            </button>
                            @(c.IsActive ? "" : " · retired")
                            @if (c.MixesLots)
                            {
                                <span class="chip ms-1" title="Lots put in it join one balance per material (@(c.FlowModel == "fifo" ? "first in, first out" : "mixed"))">Mixes lots</span>
                            }
                        </td>
                        <td>@Display.Label(c.Kind)</td>
                        <td>@c.LocationCode@(c.ParentContainerCode is { } parent ? $" · in {parent}" : "")</td>
                        <td class="inv-num">@c.LotCount@(c.ContainerCount > 0 ? $" + {c.ContainerCount} inside" : "")</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-link" @onclick="() => LabelAsync(c)">Label</button>
                            <PrintLabelControl Kind="container" Id="c.Id" SiteId="c.SiteId" ButtonClass="btn btn-sm btn-link" />
                            @if (CanManage && c.IsActive)
                            {
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => { _moving = c; _toId = Guid.Empty; _packing = null; }">Move…</button>
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => { _packing = c; _intoId = Guid.Empty; _moving = null; }">Pack into…</button>
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => EditMixing(c)">Mixing…</button>
                                @if (c.ParentContainerId is not null)
                                {
                                    <button type="button" class="btn btn-sm btn-link" disabled="@_busy" @onclick="() => TakeOutAsync(c)">Take out of @c.ParentContainerCode</button>
                                }
                                <ActionButton Class="btn btn-sm btn-link" Busy="_busy" Reason="@(c.LotCount + c.ContainerCount > 0 ? "Empty it first: it still holds lots or containers." : null)" OnClick="() => RetireAsync(c)">Retire</ActionButton>
                            }
                        </td>
                    </tr>
                    @if (_moving?.Id == c.Id)
                    {
                        <tr>
                            <td colspan="5">
                                <form class="d-flex gap-2" @onsubmit="MoveAsync" @onsubmit:preventDefault>
                                    <select class="form-select form-select-sm w-auto" aria-label="To" @bind="_toId">
                                        <option value="@Guid.Empty">Move @c.Code and its @c.LotCount @(c.LotCount == 1 ? "lot" : "lots") to…</option>
                                        @foreach (var l in _locations.Where(l => l.Id != c.LocationId))
                                        {
                                            <option value="@l.Id">@l.Code · @l.Name</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary" disabled="@(_busy || _toId == Guid.Empty)">Move</button>
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => _moving = null">Cancel</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (_mixing?.Id == c.Id)
                    {
                        <tr>
                            <td colspan="5">
                                <form class="d-flex flex-wrap gap-2 align-items-center" @onsubmit="SaveMixingAsync" @onsubmit:preventDefault>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="mix-@c.Id" @bind="_mixOn" disabled="@(c.LotCount + c.ContainerCount > 0)" />
                                        <label class="form-check-label small" for="mix-@c.Id">Lots mix in it@(c.LotCount + c.ContainerCount > 0 ? " (empty it to change)" : "")</label>
                                    </div>
                                    <select class="form-select form-select-sm w-auto" aria-label="How it flows" @bind="_mixFlow">
                                        <option value="mixed">Mixed: everything blends</option>
                                        <option value="fifo">First in, first out</option>
                                    </select>
                                    <input type="number" min="0" class="form-control form-control-sm" style="width: 9rem" placeholder="Min. minutes" aria-label="Minimum residence in minutes" @bind="_mixResidence" />
                                    <button type="submit" class="btn btn-sm btn-primary" disabled="@_busy">Save</button>
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => _mixing = null">Cancel</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (_packing?.Id == c.Id)
                    {
                        <tr>
                            <td colspan="5">
                                <form class="d-flex gap-2" @onsubmit="PackAsync" @onsubmit:preventDefault>
                                    <select class="form-select form-select-sm w-auto" aria-label="Into" @bind="_intoId">
                                        <option value="@Guid.Empty">Put @c.Code and all it holds inside…</option>
                                        @foreach (var o in _containers.Where(o => o.IsActive && !o.MixesLots && o.Id != c.Id && o.Id != c.ParentContainerId))
                                        {
                                            <option value="@o.Id">@o.Code · @o.LocationCode@(o.LocationId == c.LocationId ? "" : " (moves it there)")</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary" disabled="@(_busy || _intoId == Guid.Empty)">Pack</button>
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => _packing = null">Cancel</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (_open?.Id == c.Id)
                    {
                        @foreach (var inner in _open.Containers)
                        {
                            <tr @key="inner.Id" class="small">
                                <td class="ps-5"><span class="chip">@Display.Label(inner.Kind)</span> @inner.Code</td>
                                <td colspan="2">container</td>
                                <td class="inv-num">@inner.LotCount@(inner.ContainerCount > 0 ? $" + {inner.ContainerCount} inside" : "")</td>
                                <td></td>
                            </tr>
                        }
                        @if (_open.Lots.Count == 0 && _open.Containers.Count == 0)
                        {
                            <tr><td colspan="5" class="ps-5 small text-muted">Empty.</td></tr>
                        }
                        @foreach (var l in _open.Lots)
                        {
                            <tr @key="l.Id" class="small">
                                <td class="ps-5"><a href="inventory/lots/@l.Id">@l.LotNumber</a></td>
                                <td>@l.MaterialCode</td>
                                <td><span class="@InventoryView.StatusChip(l.Status)">@Display.Label(l.Status)</span></td>
                                <td class="inv-num">@InventoryView.Qty(l.Quantity) @l.UomCode</td>
                                <td></td>
                            </tr>
                        }
                    }
                </tbody>
            }
        </table>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "open")]
    public Guid? OpenQuery { get; set; }

    private IReadOnlyList<ContainerDto>? _containers;
    private IReadOnlyList<InventoryLocationDto> _locations = [];
    private ContainerDto? _open;
    private ContainerDto? _packing;
    private ContainerDto? _mixing;
    private bool _mixes;
    private bool _mixOn;
    private string _mixFlow = "mixed";
    private int? _mixResidence;
    private Guid _intoId;
    private ContainerDto? _moving;
    private Guid _toId;
    private string _kind = "pallet";
    private string? _code;
    private Guid _locationId;
    private string? _search;
    private bool _includeRetired;
    private ApiException? _error;
    private bool _busy;

    private bool CanManage => User.Can(PermissionCodes.LotMove, Sites.SiteId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Sites.EnsureAsync(Api);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }

        await OnSiteChangedAsync();
        if (OpenQuery is { } open)
        {
            _open = await Api.GetContainerAsync(open);
        }
    }

    private async Task OnSiteChangedAsync()
    {
        try
        {
            _locations = [.. (await Api.ListInventoryLocationsAsync(Sites.SiteId)).Where(l => l.IsActive)];
        }
        catch (ApiException ex)
        {
            _error = ex;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Sites.SiteId is not { } site)
        {
            _containers = [];
            return;
        }

        try
        {
            _containers = await Api.ListContainersAsync(site, _search, _includeRetired);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task ToggleAsync(ContainerDto c)
    {
        _open = _open?.Id == c.Id ? null : await Api.GetContainerAsync(c.Id);
    }

    private Task CreateAsync() => RunAsync(async () =>
    {
        await Api.CreateContainerAsync(new CreateContainerRequest { SiteId = Sites.SiteId!.Value, Code = _code, Kind = _kind, LocationId = _locationId, MixesLots = _mixes });
        _code = null;
        _mixes = false;
    });

    private Task MoveAsync() => RunAsync(async () =>
    {
        await Api.MoveContainerAsync(_moving!.Id, new MoveContainerRequest { Version = _moving.Version, ToLocationId = _toId });
        _moving = null;
        _open = null;
    });

    private Task RetireAsync(ContainerDto c) => RunAsync(() => Api.RetireContainerAsync(c.Id, c.Version));

    private void EditMixing(ContainerDto c) =>
        (_mixing, _mixOn, _mixFlow, _mixResidence, _moving, _packing) = (c, c.MixesLots, c.FlowModel, c.MinResidenceMinutes, null, null);

    private Task SaveMixingAsync() => RunAsync(async () =>
    {
        await Api.SetContainerMixingAsync(_mixing!.Id, new SetContainerMixingRequest
        {
            Version = _mixing.Version, MixesLots = _mixOn, FlowModel = _mixFlow, MinResidenceMinutes = _mixResidence,
        });
        _mixing = null;
    });

    private Task PackAsync() => RunAsync(async () =>
    {
        await Api.PackContainerAsync(_packing!.Id, new PackContainerRequest { Version = _packing.Version, IntoContainerId = _intoId });
        _packing = null;
        _open = null;
    });

    private Task TakeOutAsync(ContainerDto c) => RunAsync(async () =>
    {
        await Api.PackContainerAsync(c.Id, new PackContainerRequest { Version = c.Version });
        _open = null;
    });

    private async Task LabelAsync(ContainerDto c)
    {
        try
        {
            var (content, type, name) = await Api.GetLabelAsync("container", c.Id, c.SiteId);
            await Downloads.FileAsync(name, content, type);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }
}
