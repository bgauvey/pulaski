@page "/inventory/scan"
@attribute [RequiresView(PermissionCodes.InventoryView)]
@inject PulaskiApiClient Api
@inject SiteSelection Sites
@inject CurrentUser User
@inject Downloads Downloads
@inject IJSRuntime JS

@* Scanning (D-059): a barcode scanner types into the box and presses Enter, like a keyboard. Scan a lot, container or location, then
   say what to do with it; a move or pack asks for a second scan of where it goes. Every movement is an ordinary one, with its
   own history. *@
<PageTitle>@L["Scan · Inventory"] · Pulaski</PageTitle>

<InventoryHeader Title="@L["Scan"]" SiteChanged="OnSiteChangedAsync">
    <Description>
        @L["Scan a lot, container or location label, or type a lot or container number. Then move it, pack it, consume it or receive into it; a move or pack asks you to scan where it goes. A scanner that types like a keyboard works; click the box first."]
    </Description>
</InventoryHeader>

<ProblemAlert Error="_error" />

@* The line this device works at (#135): a scan here then offers what fits there, ready to confirm. Kept per browser and site. *@
@if (_lines.Count > 0)
{
    <div class="d-flex align-items-center gap-2 mb-2" style="max-width: 36rem">
        <label class="form-label small mb-0 text-nowrap" for="scan-line">@L["Working at"]</label>
        <select id="scan-line" class="form-select form-select-sm" value="@(_lineId?.ToString() ?? "")" @onchange="OnLineChangedAsync">
            <option value="">@L["No line: inventory only"]</option>
            @foreach (var line in _lines)
            {
                <option value="@line.Id">@line.Code · @line.Name</option>
            }
        </select>
    </div>
}

<form class="mb-3" @onsubmit="ScanAsync" @onsubmit:preventDefault>
    <label class="form-label" for="scan-box">@Prompt</label>
    <div class="d-flex gap-2" style="max-width: 36rem">
        <input id="scan-box" @ref="_box" class="form-control form-control-lg" autocomplete="off" @bind="_code" @bind:event="oninput" />
        <button type="submit" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(_code) || _busy)">@L["Go"]</button>
        @if (_item is not null)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="Reset">@L["Start again"]</button>
        }
    </div>
</form>

@if (_message is not null)
{
    <div class="drawer-alert @(_messageIsWarning ? "is-warning" : "") mb-3" role="status"><Icon Name="@(_messageIsWarning ? "alert" : "info")" Size="18" /><span>@_message</span></div>
}

@if (_actions.Count > 0 && _next is null)
{
    var likely = _actions[0];
    <section class="inv-facts mb-3" style="max-width: 36rem" aria-label="@L["What to do"]">
        <div class="small text-muted">@L["At {0}", _scanLine ?? ""]</div>
        <div class="fs-5 fw-semibold">@ScanActionView.Title(L, likely)</div>
        @if (likely.Warning is { } warning)
        {
            <div class="drawer-alert is-warning mt-2" role="status"><Icon Name="alert" Size="18" /><span>@L.Of(warning)</span></div>
        }
        <form class="d-flex flex-wrap gap-2 align-items-end mt-2" @onsubmit="() => ConfirmAsync(likely)" @onsubmit:preventDefault>
            @if (likely.Kind == "consume")
            {
                <div>
                    <label class="form-label small" for="scan-qty">@L["Quantity ({0}, {1} in the lot)", likely.UomCode ?? "", InventoryView.Qty(likely.Available ?? 0)]</label>
                    <input id="scan-qty" class="form-control" inputmode="decimal" type="number" step="any" min="0" @bind="_quantity" />
                </div>
            }
            <ActionButton Type="submit" Class="btn btn-primary btn-lg" Busy="_busy" Reason="@(likely.Kind == "consume" && _quantity is not > 0 ? L["Give a quantity above zero."] : null)">@L["Confirm"]</ActionButton>
        </form>
        @if (_actions.Count > 1)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                <span class="small text-muted align-self-center">@L["Or:"]</span>
                @foreach (var other in _actions.Skip(1))
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => Prefer(other)">@ScanActionView.Title(L, other)</button>
                }
            </div>
        }
    </section>
}

@if (_choices.Count > 0)
{
    <div class="list-group mb-3" style="max-width: 36rem">
        @foreach (var m in _choices)
        {
            <button type="button" class="list-group-item list-group-item-action" @onclick="() => ChooseAsync(m)">
                <span class="chip">@L.Label(m.Kind)</span> <span class="fw-semibold">@m.Label</span>
                <span class="small text-muted">@m.Detail · by @m.MatchedBy</span>
            </button>
        }
    </div>
}

@if (_scanned is { MaterialId: not null } scanned && _item is null)
{
    <div class="inv-facts mb-3" style="max-width: 36rem">
        <div class="small text-muted">@L["From the {0} barcode", scanned.Source == "gs1" ? "GS1" : scanned.Source]</div>
        <div class="fw-semibold">@scanned.MaterialCode@((scanned.LotNumber ?? scanned.SupplierLot) is { } lot ? L[" · lot {0}", lot] : "")</div>
        <div class="small">@(scanned.Quantity is { } q ? $"{InventoryView.Qty(q)} {scanned.QuantityUnit}" : "")@(scanned.Expiry is { } e ? L[" · expires {0:yyyy-MM-dd}", e] : "")</div>
        @if (User.Can(PermissionCodes.LotReceive, Sites.SiteId))
        {
            <button type="button" class="btn btn-primary mt-2" @onclick="() => _action = LotAction.Receive">@L["Receive it…"]</button>
        }
    </div>
}

@if (_item is { } item)
{
    <div class="inv-facts mb-3" style="max-width: 36rem">
        <div class="d-flex justify-content-between">
            <div>
                <span class="chip">@L.Label(item.Kind)</span>
                <span class="fs-5 fw-semibold">@item.Label</span>
                <div class="small text-muted">@item.Detail</div>
            </div>
            <button type="button" class="btn btn-sm btn-link" @onclick="LabelAsync">@L["Label"]</button>
        </div>

        @if (_next is null)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                @switch (item.Kind)
                {
                    case "lot":
                        <a class="btn btn-outline-secondary" href="inventory/lots/@item.Id">@L["Open lot"]</a>
                        @if (CanMove)
                        {
                            <button type="button" class="btn btn-primary" @onclick='() => Await("location", L["Scan where it goes"])'>@L["Move"]</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick='() => Await("container", L["Scan the container"])'>@L["Pack"]</button>
                            @if (_lot?.ContainerId is not null)
                            {
                                <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="UnpackAsync">@L["Unpack from {0}", _lot.ContainerCode]</button>
                            }
                        }
                        @if (User.Can(PermissionCodes.ProductionReport, Sites.SiteId))
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _action = LotAction.Consume">@L["Consume…"]</button>
                        }
                        @if (CanMove && _lot is { IsBulk: false })
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick='() => Await("feed", L["Scan the feed point to load it at"])'>@L["Load"]</button>
                        }
                        break;
                    case "container":
                        <a class="btn btn-outline-secondary" href="inventory/containers?open=@item.Id">@L["Open container"]</a>
                        @if (CanMove)
                        {
                            <button type="button" class="btn btn-primary" @onclick='() => Await("location", L["Scan where it goes"])'>@L["Move with what it holds"]</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick='() => Await("container", L["Scan the container to put it in"])'>@L["Pack into another"]</button>
                            @if (_container?.ParentContainerId is not null)
                            {
                                <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="TakeOutAsync">@L["Take out of {0}", _container.ParentContainerCode]</button>
                            }
                        }
                        break;
                    case "location":
                        @if (User.Can(PermissionCodes.LotReceive, Sites.SiteId))
                        {
                            <button type="button" class="btn btn-primary" @onclick="() => _action = LotAction.Receive">@L["Receive here…"]</button>
                        }
                        <a class="btn btn-outline-secondary" href="inventory/lots?locationId=@item.Id">@L["What is here"]</a>
                        break;
                }
            </div>
        }
    </div>
}

<LotActionDrawer Action="_action" Lot="_lot" LocationId="@(_item?.Kind == "location" ? _item.Id : null)" Scanned="@(_item is null ? _scanned : null)"
                 OnDone="OnDoneAsync" OnClose="() => _action = null" />

@code {
    private ElementReference _box;
    private string? _code;
    private ScanMatchDto? _item;

    // Scanning at a line (#135): the lines, the one this device works at, and what the last scan offers there, the likely one first.
    private IReadOnlyList<ScanLineOptionDto> _lines = [];
    private Guid? _lineId;
    private string? _scanLine;
    private IReadOnlyList<ScanActionDto> _actions = [];
    private decimal? _quantity;
    private LotSummaryDto? _lot;
    private ContainerDto? _container;
    private IReadOnlyList<ScanMatchDto> _choices = [];

    // A GS1 or supplier code for a material with nothing at the site yet (#75): offered to receive.
    private ScannedLotDto? _scanned;

    // What the next scan is for: a location to move to, or a container to pack into; null when scanning the item.
    private (string Kind, string Prompt)? _next;
    private LotAction? _action;
    private string? _message;
    private bool _messageIsWarning;
    private ApiException? _error;
    private bool _busy;

    private bool CanMove => User.Can(PermissionCodes.LotMove, Sites.SiteId);

    private string Prompt => _next?.Prompt ?? (_item is null ? L["Scan or type"] : L["Scan another, or choose what to do"]);

    protected override async Task OnInitializedAsync()
    {
        await Sites.EnsureAsync(Api);
        await LoadLinesAsync();
    }

    private async Task LoadLinesAsync()
    {
        (_lines, _lineId) = ([], null);
        if (Sites.SiteId is not { } site)
        {
            return;
        }

        try
        {
            _lines = await Api.ListScanLinesAsync(site);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task OnSiteChangedAsync()
    {
        Reset();
        await LoadLinesAsync();
        await RestoreLineAsync();
    }

    private async Task RestoreLineAsync()
    {
        if (Sites.SiteId is not { } site || _lines.Count == 0)
        {
            return;
        }

        try
        {
            var stored = await JS.InvokeAsync<string?>("pulaski.ui.load", ScanActionView.StorageKey(site));
            _lineId = Guid.TryParse(stored, out var id) && _lines.Any(l => l.Id == id) ? id : null;
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task OnLineChangedAsync(ChangeEventArgs e)
    {
        _lineId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _actions = [];
        if (Sites.SiteId is { } site)
        {
            try
            {
                await JS.InvokeVoidAsync("pulaski.ui.save", ScanActionView.StorageKey(site), _lineId?.ToString() ?? "");
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private void Offer(IReadOnlyList<ScanActionDto> actions)
    {
        _actions = ScanActionView.Allowed(actions, p => User.Can(p, Sites.SiteId));
        _quantity = _actions.FirstOrDefault()?.Quantity;
    }

    // Another offered action becomes the one to confirm.
    private void Prefer(ScanActionDto action)
    {
        _actions = [action, .. _actions.Where(a => a != action)];
        _quantity = action.Quantity;
    }

    private async Task ConfirmAsync(ScanActionDto a)
    {
        _busy = true;
        _error = null;
        try
        {
            switch (a.Kind)
            {
                case "consume":
                    await Api.ConsumeLotAsync(a.LotId!.Value, new ConsumeLotRequest { JobId = a.JobId!.Value, Quantity = _quantity ?? 0, UomId = a.UomId!.Value, RunId = a.RunId });
                    break;
                case "load":
                    await Api.LoadLotAsync(a.LotId!.Value, new LoadLotRequest { Version = a.LotVersion ?? 0, FeedPointId = a.ToId!.Value });
                    break;
                case "move":
                    await Api.MoveLotAsync(a.LotId!.Value, new MoveLotRequest { Version = a.LotVersion ?? 0, ToLocationId = a.ToId!.Value });
                    break;
                case "move_container":
                    await Api.MoveContainerAsync(a.ContainerId!.Value, new MoveContainerRequest { Version = a.ContainerVersion ?? 0, ToLocationId = a.ToId!.Value });
                    break;
                case "start":
                    await Api.StartJobAsync(a.JobId!.Value, new StartJobRequest { Version = a.JobVersion ?? 0, LineId = a.ToId });
                    break;
            }

            Say(ScanActionView.Done(L, a, _quantity));
            _actions = [];
            if (_item is { } item)
            {
                await ChooseAsync(item);
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestoreLineAsync();
        }

        if (_action is null)
        {
            try
            {
                await _box.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // Not rendered yet.
            }
        }
    }

    private void Reset()
    {
        (_item, _lot, _container, _next, _choices, _message, _code, _scanned) = (null, null, null, null, [], null, null, null);
        _actions = [];
    }

    private void Await(string kind, string prompt)
    {
        _next = (kind, prompt);
        _message = null;
    }

    private async Task ScanAsync()
    {
        if (Sites.SiteId is not { } site || string.IsNullOrWhiteSpace(_code))
        {
            return;
        }

        var code = _code.Trim();
        _code = null;
        _choices = [];
        _actions = [];
        _error = null;
        try
        {
            ScanResultDto result;
            if (_next is null && _lineId is { } lineId)
            {
                var offered = await Api.GetScanActionsAsync(site, lineId, code);
                result = offered.Scan;
                _scanLine = offered.Line?.Code;
                Offer(offered.Actions);
                if (result.Status != "found" && _actions.Count > 0)
                {
                    // A shop order's barcode: nothing to open, only its job to start.
                    (_item, _lot, _container, _scanned, _message) = (null, null, null, null, null);
                    return;
                }
            }
            else
            {
                result = await Api.ResolveScanAsync(site, code);
            }

            if (_next is null && result.Status == "receivable")
            {
                (_item, _lot, _container, _scanned) = (null, null, null, result.Parsed);
                Say(result.Message is { } said ? L.Of(said) : L["Not at this site yet: receive it?"]);
                return;
            }

            // A feed point is a location; whether it is one, the load says.
            var wantedKind = _next?.Kind == "feed" ? "location" : _next?.Kind;
            var matches = wantedKind is { } next ? [.. result.Matches.Where(m => m.Kind == next)] : result.Matches;
            switch (matches.Count)
            {
                case 1:
                    await ChooseAsync(matches[0]);
                    break;
                case 0:
                    Say(wantedKind is { } wanted && result.Matches.Count > 0 ? L["{0} isn't a {1}.", code, L.Label(wanted).ToLowerInvariant()] : result.Message is { } said ? L.Of(said) : L["Nothing matches {0}.", code], warning: true);
                    break;
                default:
                    _choices = matches;
                    Say(L["{0} match {1}; choose one.", matches.Count, code], warning: true);
                    break;
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task ChooseAsync(ScanMatchDto match)
    {
        _choices = [];
        if (_next is { } next)
        {
            await CompleteAsync(next.Kind, match);
            return;
        }

        _item = match;
        _scanned = null;
        _message = null;
        _lot = match.Kind == "lot" ? (await Api.GetLotAsync(match.Id)).Lot : null;
        _container = match.Kind == "container" ? await Api.GetContainerAsync(match.Id) : null;
    }

    // The second scan: where the lot or container goes, or the container it goes into.
    private async Task CompleteAsync(string kind, ScanMatchDto target)
    {
        _busy = true;
        try
        {
            if (kind == "container" && _container is { } packing)
            {
                await Api.PackContainerAsync(packing.Id, new PackContainerRequest { Version = packing.Version, IntoContainerId = target.Id });
                Say(L["{0} and all it holds put inside {1}.", packing.Code, target.Label]);
            }
            else if (kind == "container" && _lot is { } lot)
            {
                await Api.PackLotAsync(lot.Id, new PackLotRequest { Version = lot.Version, ContainerId = target.Id });
                Say(L["{0} packed into {1}.", _item!.Label, target.Label]);
            }
            else if (kind == "location" && _container is { } container)
            {
                await Api.MoveContainerAsync(container.Id, new MoveContainerRequest { Version = container.Version, ToLocationId = target.Id });
                Say((container.LotCount == 1 ? L["{0} and its lot moved to {1}.", container.Code, target.Label] : L["{0} and its lots ({1}) moved to {2}.", container.Code, container.LotCount, target.Label]));
            }
            else if (kind == "feed" && _lot is { } loading)
            {
                await Api.LoadLotAsync(loading.Id, new LoadLotRequest { Version = loading.Version, FeedPointId = target.Id });
                Say(L["{0} loaded at {1}.", _item!.Label, target.Label]);
            }
            else if (kind == "location" && _lot is { } moving)
            {
                await Api.MoveLotAsync(moving.Id, new MoveLotRequest { Version = moving.Version, ToLocationId = target.Id });
                Say(L["{0} moved to {1}{2}.", _item!.Label, target.Label, (moving.ContainerCode is { } from ? L[", out of {0}", from] : "")]);
            }

            _next = null;
            await ChooseAsync(_item!);
        }
        catch (ApiException ex)
        {
            _error = ex;
            _next = null;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TakeOutAsync()
    {
        _busy = true;
        try
        {
            await Api.PackContainerAsync(_container!.Id, new PackContainerRequest { Version = _container.Version });
            Say(L["{0} taken out of {1}.", _container.Code, _container.ParentContainerCode]);
            await ChooseAsync(_item!);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UnpackAsync()
    {
        _busy = true;
        try
        {
            await Api.PackLotAsync(_lot!.Id, new PackLotRequest { Version = _lot.Version });
            Say(L["{0} unpacked from {1}.", _item!.Label, _lot.ContainerCode]);
            await ChooseAsync(_item);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LabelAsync()
    {
        try
        {
            var (content, type, name) = await Api.GetLabelAsync(_item!.Kind, _item.Id, Sites.SiteId!.Value);
            await Downloads.FileAsync(name, content, type);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task OnDoneAsync(LotActionResult result)
    {
        _action = null;
        Say(result.Message);
        if (_item is { Kind: "lot" } lot)
        {
            await ChooseAsync(lot);
        }
    }

    private void Say(string message, bool warning = false) => (_message, _messageIsWarning) = (message, warning);
}
