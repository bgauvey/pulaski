@page "/inventory/materials/{MaterialId:guid}"
@attribute [RequiresView(PermissionCodes.InventoryView)]
@inject PulaskiApiClient Api
@inject SiteSelection Sites
@inject TimeProvider Time
@inject CurrentUser User

<PageTitle>@(_detail?.Material.Code ?? L["Material"]) · @L["Inventory"] · Pulaski</PageTitle>

<InventoryHeader Title="@(_detail?.Material.Code ?? L["Material"])" SiteChanged="LoadAsync">
    <Back><a href="inventory">@L["← Stock"]</a></Back>
    <Description>
        @if (_detail?.Material is { } m)
        {
            <span>@m.Name · @(m.MaterialClassName ?? L["No class"]) · stocked in <strong>@m.BaseUomCode</strong> · @(m.IsLotTracked ? "lot-tracked" : "kept as one balance per location")</span>
        }
    </Description>
    <Actions>
        <a class="btn btn-outline-secondary" href="inventory/journal?materialId=@MaterialId">@L["Movements"]</a>
        <a class="btn btn-outline-secondary" href="inventory/lots?materialId=@MaterialId&status=consumed">@L["Used-up lots"]</a>
        @if (User.Can(LotActions.Permission(LotAction.Receive), Sites.SiteId))
        {
            <button type="button" class="btn btn-primary" @onclick="() => _action = LotAction.Receive" disabled="@(_detail is null)">@L["Receive"]</button>
        }
    </Actions>
</InventoryHeader>

<ProblemAlert Error="_error" />
<LotResultBanner Result="_result" OnDismiss="() => _result = null" />

@if (_detail is { } detail)
{
    var m = detail.Material;
    <div class="inv-tiles">
        <div class="inv-tile"><span class="metric @(m.OnHand == 0 ? "is-zero" : "")">@InventoryView.Qty(m.OnHand)</span><span class="inv-tile-label">@L["On hand, {0}", m.BaseUomCode]</span></div>
        <div class="inv-tile"><span class="metric @(m.Available == 0 ? "is-zero" : "")">@InventoryView.Qty(m.Available)</span><span class="inv-tile-label">@L["Available"]</span></div>
        <div class="inv-tile @(m.Held > 0 ? "is-warning" : "")"><span class="metric @(m.Held == 0 ? "is-zero" : "")">@InventoryView.Qty(m.Held)</span><span class="inv-tile-label">@L["On hold or quarantine"]</span></div>
        <div class="inv-tile"><span class="metric @(m.LotCount == 0 ? "is-zero" : "")">@m.LotCount</span><span class="inv-tile-label">@(m.IsLotTracked ? L["Lots"] : L["Balances"])</span></div>
        <div class="inv-tile"><span class="metric @(m.LocationCount == 0 ? "is-zero" : "")">@m.LocationCount</span><span class="inv-tile-label">@L["Locations"]</span></div>
        <div class="inv-tile">
            @if (_editingShelfLife)
            {
                <form class="d-flex gap-1 align-items-center" @onsubmit="SaveShelfLifeAsync" @onsubmit:preventDefault>
                    <input type="number" class="form-control form-control-sm" min="1" max="36500" placeholder="@L["None"]" aria-label="@L["Shelf life in days"]" @bind="_shelfLife" />
                    <button type="submit" class="btn btn-sm btn-primary" disabled="@_saving">@L["Save"]</button>
                </form>
                <span class="inv-tile-label">@L["Shelf life, days (blank for none)"]</span>
            }
            else
            {
                <span class="metric @(m.ShelfLifeDays is null ? "is-zero" : "")">@(m.ShelfLifeDays?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</span>
                <span class="inv-tile-label">
                    @L["Shelf life, days"]
                    @if (User.Can(PermissionCodes.Materials))
                    {
                        <button type="button" class="btn btn-link btn-sm p-0 ms-1" @onclick="() => { _shelfLife = m.ShelfLifeDays; _editingShelfLife = true; }">@L["Change"]</button>
                    }
                </span>
            }
        </div>
    </div>

    <section class="inv-section" aria-labelledby="lots-title">
        <h2 id="lots-title">@(m.IsLotTracked ? L["Lots on hand"] : L["Balances"])</h2>
        @if (detail.Lots.Count == 0)
        {
            <p class="text-muted">@L["None on hand. Receive some, or declare production from a job."]</p>
        }
        else
        {
            <div class="table-panel">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>@(m.IsLotTracked ? L["Lot"] : L["Balance"])</th>
                            <th>@L["Status"]</th>
                            <th class="inv-num">@L["Quantity"]</th>
                            <th>@L["Location"]</th>
                            <th>@L["Supplier lot"]</th>
                            <th>@L["Expires"]</th>
                            <th>@L["From"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in detail.Lots)
                        {
                            <tr @key="l.Id">
                                <td><a class="fw-semibold" href="inventory/lots/@l.Id">@InventoryView.LotLabel(L, l.LotNumber, l.IsBulk, l.LocationCode)</a></td>
                                <td><span class="@InventoryView.StatusChip(l.Status)">@L.Label(l.Status)</span></td>
                                <td class="inv-num">@InventoryView.Qty(l.Quantity) <span class="small text-muted">@l.UomCode</span></td>
                                <td>@l.LocationCode</td>
                                <td>@l.SupplierLot</td>
                                <td class="small text-nowrap @(InventoryView.ExpiresSoon(l.ExpiresAt, Time.GetUtcNow()) ? "inv-held" : "")">@Display.SiteTime(l.ExpiresAt, Tz)</td>
                                <td class="small">@(l.ProducedByJobNumber is { } job ? L["Made by {0}", job] : L.Label(l.Origin))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="inv-layout">
        <section class="inv-section" aria-labelledby="locations-title">
            <h2 id="locations-title">@L["By location"]</h2>
            @if (detail.Locations.Count == 0)
            {
                <p class="text-muted">@L["Nowhere yet."]</p>
            }
            else
            {
                <div class="table-panel">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>@L["Location"]</th><th class="inv-num">@L["Lots"]</th><th class="inv-num">@L["On hand"]</th><th class="inv-num">@L["Available"]</th></tr></thead>
                        <tbody>
                            @foreach (var l in detail.Locations)
                            {
                                <tr @key="l.LocationId">
                                    <td><a href="inventory/lots?locationId=@l.LocationId&materialId=@MaterialId">@l.LocationCode</a> <span class="small text-muted">@l.LocationName</span></td>
                                    <td class="inv-num">@l.LotCount</td>
                                    <td class="inv-num">@InventoryView.Qty(l.OnHand)</td>
                                    <td class="inv-num">@InventoryView.Qty(l.Available)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="inv-section" aria-labelledby="used-title">
            <div class="inv-section-head">
                <h2 id="used-title">@L["Where used"]</h2>
                <span class="small">
                    @L["Made from:"]
                    @if (_boms.Count == 0)
                    {
                        <span class="text-muted">@L["no BOM"]</span>
                    }
                    @foreach (var b in _boms)
                    {
                        <ScreenLink Href="@($"boms/{b.Id}")" Permission="@PermissionCodes.ProcessesView" class="ms-1">@L["BOM for {0}", b.ProcessCode ?? L["any process"]]</ScreenLink>
                    }
                </span>
            </div>
            @if (_whereUsed is { } used)
            {
                @if (used.Boms.Count == 0)
                {
                    <p class="text-muted">@L["No released or draft BOM lists {0} as a component.", m.Code]</p>
                }
                else
                {
                    <div class="table-panel mb-3">
                        <table class="table table-sm align-middle">
                            <thead><tr><th>@L["In BOM of"]</th><th>@L["Version"]</th><th class="inv-num">@L["Per"]</th><th>@L["Operation"]</th></tr></thead>
                            <tbody>
                                @foreach (var b in used.Boms)
                                {
                                    <tr @key="(b.VersionId, b.LineNo)" class="@(b.BomIsActive ? "" : "text-muted")">
                                        <td>
                                            <ScreenLink Href="@($"boms/{b.BomId}")" Permission="@PermissionCodes.ProcessesView" class="fw-semibold">@b.MaterialCode</ScreenLink>
                                            <div class="small text-muted">@b.MaterialName · @(b.ProcessCode ?? "any process")</div>
                                        </td>
                                        <td><span class="@(b.VersionStatus == "released" ? "chip chip-strong" : "chip")">v@(b.VersionNumber) @b.VersionStatus</span></td>
                                        <td class="inv-num">@InventoryView.Qty(b.QtyPer) @b.UomCode <span class="small text-muted">@L["per {0} {1}", InventoryView.Qty(b.BaseQty), b.BaseUomCode]</span></td>
                                        <td>@(b.OperationNumber?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "first")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <h3 class="h6">@L["Open jobs planned to use it"]</h3>
                @if (used.Jobs.Count == 0)
                {
                    <p class="text-muted">@L["None."]</p>
                }
                else
                {
                    <div class="table-panel">
                        <table class="table table-sm align-middle">
                            <thead><tr><th>@L["Job"]</th><th>@L["Line"]</th><th class="inv-num">@L["Planned"]</th><th class="inv-num">@L["Consumed"]</th></tr></thead>
                            <tbody>
                                @foreach (var j in used.Jobs)
                                {
                                    <tr @key="j.JobId">
                                        <td>
                                            <a class="fw-semibold" href="inventory/jobs/@j.JobId">@j.JobNumber</a>
                                            <div class="small text-muted">@L["makes {0} ·", j.MaterialCode] <span class="@Display.JobStatusChip(j.JobStatus)">@L.Label(j.JobStatus)</span></div>
                                        </td>
                                        <td>@j.LineCode</td>
                                        <td class="inv-num">@InventoryView.Qty(j.PlannedQty) @j.UomCode</td>
                                        <td class="inv-num">@InventoryView.Qty(j.ConsumedQty) @used.BaseUomCode</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>
    </div>
}
else if (_error is null)
{
    <p class="text-muted">@L["Loading…"]</p>
}

<LotActionDrawer Action="_action" MaterialId="MaterialId" OnDone="OnDoneAsync" OnClose="() => _action = null" />

@code {
    [Parameter]
    public Guid MaterialId { get; set; }

    private MaterialStockDetailDto? _detail;
    private WhereUsedDto? _whereUsed;
    private IReadOnlyList<BomSummaryDto> _boms = [];
    private ApiException? _error;
    private LotActionResult? _result;
    private LotAction? _action;
    private bool _editingShelfLife;
    private int? _shelfLife;
    private bool _saving;

    private string? Tz => Sites.Site?.TimeZone;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            await Sites.EnsureAsync(Api);
            _detail = await Api.GetMaterialStockAsync(MaterialId, Sites.SiteId);
            _whereUsed = await Api.GetWhereUsedAsync(MaterialId);
            _boms = await Api.ListBomsAsync(MaterialId);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    // New lots expire this long after they arrive; lots already here keep their expiry (D-032).
    private async Task SaveShelfLifeAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            await Api.SetShelfLifeAsync(MaterialId, new SetShelfLifeRequest { Version = _detail!.Material.MaterialVersion, ShelfLifeDays = _shelfLife });
            _editingShelfLife = false;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnDoneAsync(LotActionResult result)
    {
        _action = null;
        _result = result;
        await LoadAsync();
    }
}
