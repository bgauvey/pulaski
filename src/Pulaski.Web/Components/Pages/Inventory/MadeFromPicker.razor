@inject PulaskiApiClient Api

@* Naming the lots a made lot came from (#81), out of those its job used; with none named they are paired by time. *@
@if (Candidates.Count > 0)
{
    @if (!_open)
    {
        <button type="button" class="btn btn-sm btn-link p-0 mb-3" @onclick="Open">@(HasPicks ? "Change what it was made from…" : "Pick what it was made from…")</button>
    }
    else
    {
        <div class="mb-3">
            <p class="small text-muted mb-1">
                Tick the lots it was made from. They replace the pairing by time; untick them all to go back to it.
            </p>
            @foreach (var c in Candidates)
            {
                <div class="form-check" @key="c.LotId">
                    <input class="form-check-input" type="checkbox" id="mf-@c.LotId" checked="@_picked.Contains(c.LotId)" @onchange="e => Toggle(c.LotId, (bool)e.Value!)" />
                    <label class="form-check-label small" for="mf-@c.LotId">@InventoryView.LotLabel(c.LotNumber, c.IsBulk, c.LocationCode) · @c.MaterialCode</label>
                </div>
            }
            <input class="form-control form-control-sm mt-2" maxlength="1000" placeholder="Comment (optional)" aria-label="Comment" @bind="_comment" />
            <div class="d-flex gap-2 mt-2">
                <button type="button" class="btn btn-sm btn-primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
                <button type="button" class="btn btn-sm btn-link" @onclick="() => _open = false">Cancel</button>
            </div>
        </div>
    }
}
<ProblemAlert Error="_error" />

@code {
    [Parameter, EditorRequired]
    public Guid LotId { get; set; }

    /// <summary>The job that made the lot: its links name the lots it used.</summary>
    [Parameter, EditorRequired]
    public Guid JobId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<LotLinkDto> Parents { get; set; } = [];

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private readonly HashSet<Guid> _picked = [];
    private string? _comment;
    private bool _open;
    private bool _busy;
    private ApiException? _error;

    private IReadOnlyList<LotLinkDto> Candidates => [.. Parents.Where(p => p.JobId == JobId && p.LinkBasis is "declared" or "made_from")];

    private bool HasPicks => Parents.Any(p => p.JobId == JobId && p.LinkBasis == "made_from");

    private void Open()
    {
        _picked.Clear();
        _picked.UnionWith(Parents.Where(p => p.JobId == JobId && p.LinkBasis == "made_from").Select(p => p.LotId));
        _comment = null;
        _open = true;
    }

    private void Toggle(Guid lotId, bool on)
    {
        if (on)
        {
            _picked.Add(lotId);
        }
        else
        {
            _picked.Remove(lotId);
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.SetMadeFromAsync(LotId, new SetMadeFromRequest { ParentLotIds = [.. _picked], Comment = string.IsNullOrWhiteSpace(_comment) ? null : _comment });
            _open = false;
            await OnChanged.InvokeAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }
}
