@page "/work-orders"
@attribute [RequiresView(PermissionCodes.WorkOrdersView)]
@using System.Globalization
@inject PulaskiApiClient Api
@inject Downloads Downloads
@inject NavigationManager Navigation
@inject EquipmentSelection Selection
@inject TimeProvider Time
@inject CurrentUser User

<PageTitle>@L["Work orders"] · Pulaski</PageTitle>

<div class="wo-head">
    <h1 class="mb-0">@L["Work orders"]</h1>
    <div class="wo-head-tools">
        @* New work orders are created by planners, from the Schedule page; the ERP's come by import (D-066, D-102). *@
        @if (ImportSites.Count > 0)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" aria-expanded="@(_importOpen ? "true" : "false")" aria-controls="wo-import"
                    @onclick="() => _importOpen = !_importOpen">@L["Import from the ERP"]</button>
        }
        <EquipmentPicker Equipment="_equipment" Value="EquipmentId" ValueChanged="OnEquipmentChanged" />
    </div>
</div>

<ProblemAlert Error="_error" />
@if (_importOpen && ImportSites.Count > 0)
{
    <div id="wo-import">
        <WorkOrderB2mmlImport Sites="ImportSites" OnImported="LoadAsync" />
    </div>
}

@* The tiles count everything in the selection; picking one filters the list below to it. *@
<div class="wo-tiles" role="group" aria-label="@L["Filter by"]">
    @foreach (var tile in WorkOrderTiles.All)
    {
        var count = _tiles.GetValueOrDefault(tile.Key);
        var active = _tile == tile.Key;
        <button type="button" class="wo-tile tone-@tile.Tone @(active ? "is-active" : "") @(count == 0 ? "is-zero" : "")"
                aria-pressed="@(active ? "true" : "false")" title="@L[tile.Help]" @onclick="() => ToggleTile(tile.Key)">
            <span class="wo-tile-count">
                @(_progress is null ? "–" : count.ToString(CultureInfo.InvariantCulture))
                @if (tile.Key == WorkOrderTiles.NeedAttention && count > 0)
                {
                    <Icon Name="alert" Size="22" />
                }
            </span>
            <span class="wo-tile-label">@L[tile.Label]</span>
            <span class="wo-tile-foot" aria-hidden="true"><Icon Name="chevron-down" Size="16" /></span>
        </button>
    }
</div>

<div class="table-panel wo-panel">
    <div class="wo-toolbar">
        <label class="wo-toolbar-label" for="wo-find-by">@L["Find by"]</label>
        <select id="wo-find-by" class="form-select form-select-sm w-auto" @bind="_findBy">
            <option value="order">@L["Order"]</option>
            <option value="material">@L["Material"]</option>
            <option value="line">@L["Line or department"]</option>
        </select>
        <div class="wo-search">
            <input type="search" class="form-control form-control-sm" placeholder="@L["Search"]" aria-label="@L["Search"]"
                   @bind="_search" @bind:event="oninput" />
            <Icon Name="search" Size="16" />
        </div>
        <select class="form-select form-select-sm w-auto" aria-label="@L["Status"]" @bind="_status">
            <option value="">@L["Open orders"]</option>
            @foreach (var status in Display.WorkOrderStatuses)
            {
                <option value="@status">@L.Label(status)</option>
            }
            <option value="*">@L["All statuses"]</option>
        </select>
        <button type="button" class="btn btn-outline-secondary btn-square btn-sm-square" aria-label="@L["Refresh"]" title="@L["Refresh"]"
                disabled="@_loading" @onclick="LoadAsync">
            <Icon Name="refresh" Size="16" />
        </button>
        <span class="small text-muted ms-auto">
            @L["{0} of {1} orders", Rows.Count(), _progress?.Count ?? 0]
            @if (_tile is not null)
            {
                <button type="button" class="link-button ms-1" @onclick="() => _tile = null">@L["Show all"]</button>
            }
        </span>
    </div>

    @if (_pendingBulk is { } pending)
    {
        var cancelCount = SelectedOrders.Count(o => o.Order.NextStatuses.Contains(pending) && MayMove(o.Order, pending));
        <div class="wo-confirm" role="alert">
            <span>@(cancelCount == 1 ? L["Cancel this work order?"] : L["Cancel {0} work orders?", cancelCount]) Their open jobs must be cancelled first.</span>
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RunBulkAsync(pending)">@L["Confirm cancellation"]</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _pendingBulk = null">@L["Keep them"]</button>
        </div>
    }

    @if (_result is not null)
    {
        <div class="wo-result @(_resultFailed ? "is-failed" : "")" role="status">
            <span>@_result</span>
            <button type="button" class="toast-close" aria-label="@L["Dismiss"]" @onclick="() => _result = null"><Icon Name="close" Size="16" /></button>
        </div>
    }

    <div class="wo-select-links small" hidden="@(!CanSelectAny)">
        @if (_selected.Count > 0)
        {
            <strong>@_selected.Count selected</strong>
            <div class="wo-menu">
                <button type="button" class="btn btn-outline-secondary btn-sm btn-with-icon" aria-haspopup="menu"
                        aria-expanded="@(_actionsOpen ? "true" : "false")"
                        disabled="@(_busy || _printingId is not null)" @onclick="() => _actionsOpen = !_actionsOpen">
                    @(_printingId is null ? L["Actions"] : L["Preparing PDF…"])
                    @if (_printingId is null)
                    {
                        <Icon Name="chevron-down" Size="16" />
                    }
                </button>
                @if (_actionsOpen)
                {
                    var selectedOrders = SelectedOrders.ToList();
                    <div class="wo-menu-backdrop" @onclick="() => _actionsOpen = false"></div>
                    <ul class="wo-menu-list" role="menu">
                        @if (selectedOrders.Count == 1)
                        {
                            var selected = selectedOrders[0];
                            @if (CanPrint(selected.Order))
                            {
                                <li role="none">
                                    <button type="button" role="menuitem" class="wo-menu-item"
                                            disabled="@(_printingId is not null)"
                                            @onclick="() => PrintShopOrderAsync(selected.Order)">
                                        @(_printingId == selected.Order.Id ? L["Preparing PDF…"] : L["Print shop order"])
                                    </button>
                                </li>
                            }
                            @foreach (var next in selected.Order.NextStatuses.Where(n => MayMove(selected.Order, n)))
                            {
                                <li role="none">
                                    <button type="button" role="menuitem" class="wo-menu-item @(next == "cancelled" ? "is-danger" : "")"
                                            disabled="@(_busyId == selected.Order.Id)"
                                            @onclick="() => StartSelectedStatus(next)">
                                        @(L[Display.StatusAction(selected.Order.Status, next)])
                                    </button>
                                </li>
                            }
                            @if (User.Can(PermissionCodes.ScheduleView, selected.Order.SiteId))
                            {
                                <li role="none"><a role="menuitem" class="wo-menu-item" href="schedule?workOrder=@selected.Order.Id">@L["Show on the schedule"]</a></li>
                            }
                        }
                        else
                        {
                            @foreach (var (status, label) in BulkActions)
                            {
                                var eligible = selectedOrders.Count(o => o.Order.NextStatuses.Contains(status) && MayMove(o.Order, status));
                                <li role="none">
                                    <ActionButton role="menuitem" Class="@($"wo-menu-item {(status == "cancelled" ? "is-danger" : "")}")"
                                                  Reason="@(eligible == 0 ? L["None of the selected orders can move to {0}, or you may not do it.", L.Label(status).ToLowerInvariant()] : null)"
                                                  OnClick="() => StartSelectedStatus(status)">
                                        @L[label] <span class="text-muted">@L["{0} of {1}", eligible, selectedOrders.Count]</span>
                                    </ActionButton>
                                </li>
                            }
                            <li role="none"><span class="wo-menu-note">@L["Print and schedule actions are available for one selected order."]</span></li>
                        }
                    </ul>
                }
            </div>
        }
        <button type="button" class="link-button" disabled="@(_pendingBulk is not null || !SelectableRows.Any())" @onclick="SelectAll">
            @L["Select visible ({0})", SelectableRows.Count()]
        </button>
        @if (_selected.Count > 0)
        {
            <button type="button" class="link-button" disabled="@(_pendingBulk is not null)" @onclick="ClearSelection">@L["Clear selection"]</button>
        }
    </div>

    <table class="table align-middle wo-table">
        <thead>
            <tr>
                <th rowspan="2" class="wo-col-select">@(CanSelectAny ? L["Select"] : "")</th>
                <th rowspan="2" class="wo-col-flag"><span class="visually-hidden">@L["Flags"]</span></th>
                <th rowspan="2">@L["Order"]</th>
                <th rowspan="2">@L["Status"]</th>
                <th rowspan="2">@L["Material"]</th>
                <th rowspan="2" class="wo-col-info"><span class="visually-hidden">@L["Details"]</span></th>
                <th rowspan="2">@L["Schedule"]</th>
                <th colspan="2" class="text-center wo-qty-head">@L["Quantity"]</th>
                <th rowspan="2">@L["Unit"]</th>
            </tr>
            <tr>
                <th class="text-end">@L["Planned"]</th>
                <th class="text-end">@L["Made"]</th>
            </tr>
        </thead>
        <tbody>
            @if (_progress is null)
            {
                <tr><td colspan="10" class="text-muted">@(_error is null ? L["Loading…"] : "")</td></tr>
            }
            else if (!Rows.Any())
            {
                <tr><td colspan="10" class="text-muted">@L["No work orders match."]</td></tr>
            }
            @foreach (var p in Rows)
            {
                var wo = p.Order;
                var tz = ZoneOf(wo.SiteId);
                var expanded = _expanded.Contains(wo.Id);
                var flags = Flags(p);
                <tr class="@(_selected.Contains(wo.Id) ? "table-active" : "") @(_busyId == wo.Id ? "is-saving" : "")" @key="wo.Id">
                    <td class="wo-col-select">
                        @if (CanSelect(wo))
                        {
                            <input class="form-check-input" type="checkbox" aria-label="@L["Select {0}", wo.OrderNumber]"
                                   checked="@_selected.Contains(wo.Id)" disabled="@(_pendingBulk is not null)"
                                   @onchange="e => ToggleSelected(wo.Id, e.Value is true)" />
                        }
                    </td>
                    <td class="wo-col-flag">
                        @if (flags.Count > 0)
                        {
                            <span class="wo-flag @(WorkOrderTiles.IsBehind(p) ? "is-danger" : "")" title="@string.Join("\n", flags)" aria-label="@string.Join(". ", flags)">
                                <Icon Name="alert" Size="18" />
                            </span>
                        }
                    </td>
                    <td><ScreenLink Href="@($"schedule?workOrder={wo.Id}")" Permission="@PermissionCodes.ScheduleView" class="fw-semibold">@wo.OrderNumber</ScreenLink></td>
                    <td class="text-nowrap">
                        <span class="@Display.StatusChip(wo.Status)">@L.Label(wo.Status)</span>
                        @if (wo.QuantityHeld)
                        {
                            <span class="chip chip-warning ms-1" title="@L["The ERP's quantity isn't whole batches; set one before dispatching"]">@L["held"]</span>
                        }
                        @if (wo.PendingChange is not null)
                        {
                            <span class="chip chip-warning ms-1" title="@L["The ERP changed it; accept or reject the change"]">@L["ERP change"]</span>
                        }
                        @if (wo.Priority > 0)
                        {
                            <span class="wo-priority" title="@L["Priority {0}", wo.Priority]" aria-label="@L["Priority {0}", wo.Priority]"><Icon Name="arrow-up" Size="16" /></span>
                        }
                    </td>
                    <td>
                        @wo.MaterialCode
                        <div class="small text-muted">@wo.MaterialName</div>
                    </td>
                    <td class="wo-col-info">
                        <button type="button" class="wo-icon-button" aria-expanded="@(expanded ? "true" : "false")"
                                aria-label="@(expanded ? L["Hide"] : L["Show"]) details for @wo.OrderNumber" @onclick="() => ToggleExpanded(wo.Id)">
                            <Icon Name="info" Size="20" />
                        </button>
                    </td>
                    <td class="wo-schedule">
                        @if (p.ProjectedStart is null)
                        {
                            <span class="text-muted">@L["Not on a line"]</span>
                            @if (wo.DueAt is not null)
                            {
                                <div class="small">@L["Due {0}", Display.SiteTime(wo.DueAt, tz)]</div>
                            }
                        }
                        else
                        {
                            <div><span class="wo-date-label">@L["Start"]</span> @Display.SiteTime(p.ProjectedStart, tz)</div>
                            <div><span class="wo-date-label">@L["Finish"]</span> @Display.SiteTime(p.ProjectedEnd, tz)</div>
                            @if (p.StartSlip is { } startSlip && startSlip > WorkOrderTiles.SlipTolerance)
                            {
                                <div class="wo-slip">@L["Starts {0} after its baseline", ScheduleFormat.Duration(startSlip)]</div>
                            }
                            @if (p.FinishSlip is { } finishSlip)
                            {
                                <div class="wo-slip">@L["Finishes {0} after due", ScheduleFormat.Duration(finishSlip)]</div>
                            }
                        }
                    </td>
                    <td class="text-end">@Number(wo.PlannedQty)</td>
                    <td class="text-end">@Number(p.CompletedQty)</td>
                    <td>@wo.UomCode</td>
                </tr>
                @if (expanded)
                {
                    <tr class="wo-details" @key="(wo.Id, true)">
                        <td colspan="10">
                            <div class="wo-details-grid">
                                <dl class="facts mb-0">
                                    <dt>@L["Due"]</dt>
                                    <dd>@(wo.DueAt is null ? L["No due date"] : Display.SiteTime(wo.DueAt, tz))</dd>
                                    <dt>@L["Baseline"]</dt>
                                    <dd>@(p.BaselineStart is null ? L["Not published yet"] : $"{Display.SiteTime(p.BaselineStart, tz)} – {Display.SiteTime(p.BaselineEnd, tz)}")</dd>
                                    <dt>@L["On lines"]</dt>
                                    <dd>@L["{0} of {1} {2}", Number(p.PlacedQty), Number(wo.PlannedQty), wo.UomCode]</dd>
                                    <dt>@L["Process"]</dt>
                                    <dd>@(wo.ProcessCode is null ? L["None"] : $"{wo.ProcessCode} · {wo.ProcessName} (v{wo.ProcessVersionNumber})")</dd>
                                    <dt>@L["BOM"]</dt>
                                    <dd>@(wo.BomVersionNumber is { } bomVersion ? L["Version {0}", bomVersion] : L["None: no components planned"])</dd>
                                    <dt>@L["Origin"]</dt>
                                    <dd>
                                        @(wo.Origin == "erp" ? "ERP" : L.Label(wo.Origin)) · @wo.SiteCode
                                        @if (wo.ExternalKey is { } key)
                                        {
                                            <div class="small text-muted">@wo.ExternalSystem @key@(wo.ExternalVersion is { } v ? L[" · version {0}", v] : "")@(wo.ImportedAt is { } imported ? L[" · last from the ERP {0}", Display.SiteTime(imported, tz)] : "")</div>
                                        }
                                        @if (wo.ErpQty is { } sent)
                                        {
                                            <div class="small">@L["The ERP sent {0} {1}: {2}", Number(sent), wo.ErpUomCode, WorkOrderView.Adjustment(wo.BatchAdjustment)]</div>
                                        }
                                    </dd>
                                    @if (wo.Notes is not null)
                                    {
                                        <dt>@L["Notes"]</dt>
                                        <dd class="wo-notes">@wo.Notes</dd>
                                    }
                                </dl>
                                <div>
                                    @if (wo.QuantityHeld)
                                    {
                                        <div class="drawer-alert is-warning mb-2">
                                            @L["{0} is held: the ERP's quantity isn't whole batches, so it can't be dispatched yet.", wo.OrderNumber]
                                            @if (CanManage(wo))
                                            {
                                                <form class="d-flex gap-2 mt-2" @onsubmit="() => SetQuantityAsync(wo)" @onsubmit:preventDefault>
                                                    <input type="number" class="form-control form-control-sm w-auto" min="0" step="any" aria-label="@L["Whole-batch quantity"]" @bind="_heldQuantity" />
                                                    <span class="align-self-center small">@wo.UomCode</span>
                                                    <button type="submit" class="btn btn-sm btn-primary" disabled="@(_busyId == wo.Id || _heldQuantity is not > 0)">@L["Set quantity"]</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                    @if (wo.PendingChange is { } change)
                                    {
                                        <div class="drawer-alert is-warning mb-2">
                                            <div class="fw-semibold">@(change.Version is { } cv ? L["The ERP changed this order (version {0}):", cv] : L["The ERP changed this order:"])</div>
                                            <div class="small">@WorkOrderView.PendingSummary(wo, change, tz)</div>
                                            @if (CanManage(wo))
                                            {
                                                <div class="d-flex flex-wrap gap-2 mt-2">
                                                    <button type="button" class="btn btn-sm btn-primary" disabled="@(_busyId == wo.Id)" @onclick="() => AcceptErpAsync(wo)">@L["Accept"]</button>
                                                    <input class="form-control form-control-sm w-auto" maxlength="500" placeholder="@L["Why it is rejected"]" aria-label="@L["Reason for rejecting"]" @bind="_rejectReason" @bind:event="oninput" />
                                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(_busyId == wo.Id || string.IsNullOrWhiteSpace(_rejectReason))" @onclick="() => RejectErpAsync(wo)">@L["Reject"]</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                    @if (p.Jobs.Count == 0)
                                    {
                                        <p class="text-muted mb-0">@L["No open jobs."]</p>
                                    }
                                    else
                                    {
                                        <table class="table table-sm mb-0 wo-jobs">
                                            <thead>
                                                <tr><th>@L["Job"]</th><th>@L["Where"]</th><th>@L["Status"]</th><th>@L["When"]</th><th class="text-end">@L["To make"]</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var job in p.Jobs)
                                                {
                                                    <tr @key="job.JobId">
                                                        <td>@job.JobNumber</td>
                                                        <td>@job.EquipmentCode@(job.Kind == "window" ? " · waiting for a line" : "")</td>
                                                        <td><span class="@Display.JobStatusChip(job.Status)">@L.Label(job.Status)</span></td>
                                                        <td class="text-nowrap">@Display.SiteTime(job.Start, tz) – @Display.SiteTime(job.End, tz)</td>
                                                        <td class="text-end">@Number(job.RemainingQty ?? job.PlannedQty ?? 0m)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    @foreach (var warning in p.Warnings)
                                    {
                                        <div class="small wo-warning"><Icon Name="alert" Size="14" /> @L.Of(warning)</div>
                                    }
                                    @if (p.HasOverlap)
                                    {
                                        <div class="small wo-warning is-danger"><Icon Name="alert" Size="14" /> @L["A job overlaps other work on its line."]</div>
                                    }
                                    @if (_components.GetValueOrDefault(wo.Id) is { Count: > 0 } components)
                                    {
                                        <table class="table table-sm mb-0 mt-3 wo-jobs">
                                            <thead>
                                                <tr><th>@L["Component"]</th><th>@L["For job"]</th><th>@L["Consumed by"]</th><th class="text-end">@L["Planned"]</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var c in components)
                                                {
                                                    <tr>
                                                        <td>@c.MaterialCode <span class="small text-muted">@c.MaterialName</span></td>
                                                        <td>@c.JobNumber · @c.EquipmentCode</td>
                                                        <td>@L.Label(c.ConsumptionMethod)</td>
                                                        <td class="text-end text-nowrap">@Number(c.PlannedQty) @c.UomCode</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    // Dispatching, un-dispatching and firming is managing an order; cancelling and closing it is its own permission (D-037).
    private bool CanSelectAny => User.CanAny([
        PermissionCodes.WorkOrderManage,
        PermissionCodes.WorkOrderClose,
        PermissionCodes.WorkOrdersView,
        PermissionCodes.ScheduleView,
        PermissionCodes.OverviewView,
    ]);

    private bool CanSelect(WorkOrderDto order) =>
        order.NextStatuses.Any(n => MayMove(order, n))
        || User.Can(PermissionCodes.ScheduleView, order.SiteId)
        || CanPrint(order);

    private bool CanPrint(WorkOrderDto order) =>
        User.CanAny([PermissionCodes.WorkOrdersView, PermissionCodes.ScheduleView, PermissionCodes.OverviewView], order.SiteId);

    private bool MayMove(WorkOrderDto order, string status) =>
        User.Can(status is "cancelled" or "closed" ? PermissionCodes.WorkOrderClose : PermissionCodes.WorkOrderManage, order.SiteId);

    private static readonly (string Status, string Label)[] BulkActions =
    [
        ("dispatched", Term.Mark("Dispatch")),
        ("planned", Term.Mark("Un-dispatch")),
        ("firmed", Term.Mark("Firm")),
        ("cancelled", Term.Mark("Cancel…")),
    ];

    [SupplyParameterFromQuery(Name = "equipment")]
    public Guid? EquipmentId { get; set; }

    /// <summary>Opens the list on one status, e.g. from the Overview cards.</summary>
    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    private string? _statusApplied;

    private IReadOnlyList<EquipmentDto> _equipment = [];
    private Dictionary<Guid, string?> _siteZones = [];
    private IReadOnlyList<WorkOrderProgressDto>? _progress;
    private Dictionary<string, int> _tiles = [];
    private Dictionary<Guid, IReadOnlySet<string>> _tilesOf = [];
    private ApiException? _error;
    private bool _loading;
    private Guid? _loadedFor;
    private bool _loadedOnce;

    private string? _tile;
    private string _findBy = "order";
    private string _search = "";
    private string _status = "";
    private readonly HashSet<Guid> _selected = [];
    private readonly HashSet<Guid> _expanded = [];
    private readonly Dictionary<Guid, IReadOnlyList<PlannedComponentDto>> _components = [];
    private bool _actionsOpen;
    private bool _importOpen;

    // Sites where the user may manage work orders: the import refuses orders anywhere else.
    private IReadOnlyList<EquipmentDto> ImportSites =>
        [.. _equipment.Where(e => e.Level == "site" && e.IsActive && User.Can(PermissionCodes.WorkOrderManage, e.Id)).OrderBy(e => e.Code, StringComparer.Ordinal)];
    private string? _pendingBulk;
    private bool _busy;
    private Guid? _busyId;
    private string? _result;
    private bool _resultFailed;
    private Guid? _printingId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _equipment = await Api.ListEquipmentAsync();
            _siteZones = _equipment.Where(e => e.Level == "site").ToDictionary(e => e.Id, e => e.TimeZone);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // No selection in the address (e.g. the menu link): open on the one remembered for the
        // session. Choosing "All equipment" clears the remembered one first, so it isn't restored.
        if (EquipmentId is null && Selection.EquipmentId is { } remembered)
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("equipment", remembered), replace: true);
            return;
        }

        Selection.EquipmentId = EquipmentId;
        if (Status != _statusApplied)
        {
            _statusApplied = Status;
            _status = Status is not null && Display.WorkOrderStatuses.Contains(Status) ? Status : "";
        }

        if (!_loadedOnce || _loadedFor != EquipmentId)
        {
            _selected.Clear();
            _expanded.Clear();
            _tile = null;
            _result = null;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _progress = await Api.ListWorkOrderProgressAsync(EquipmentId);
            _loadedFor = EquipmentId;
            _loadedOnce = true;
            _error = null;
            var now = Time.GetUtcNow();
            _tilesOf = _progress.ToDictionary(p => p.Order.Id, p => WorkOrderTiles.Of(p, now, ZoneOf(p.Order.SiteId)));
            _tiles = _tilesOf.Values.SelectMany(t => t).GroupBy(t => t).ToDictionary(g => g.Key, g => g.Count());
            _selected.IntersectWith(_progress.Select(p => p.Order.Id));
        }
        catch (ApiException ex)
        {
            _error = ex;
            _loadedOnce = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<WorkOrderProgressDto> Rows
    {
        get
        {
            IEnumerable<WorkOrderProgressDto> rows = _progress ?? [];
            if (_tile is not null)
            {
                rows = rows.Where(p => _tilesOf.TryGetValue(p.Order.Id, out var tiles) && tiles.Contains(_tile));
            }

            rows = _status switch
            {
                "" => rows.Where(WorkOrderTiles.IsOpen),
                "*" => rows,
                var status => rows.Where(p => p.Order.Status == status),
            };

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                rows = _findBy switch
                {
                    "material" => rows.Where(p => Contains(p.Order.MaterialCode, term) || Contains(p.Order.MaterialName, term)),
                    "line" => rows.Where(p => p.Jobs.Any(j => Contains(j.EquipmentCode, term)) || Contains(p.Order.TargetEquipmentCode, term)),
                    _ => rows.Where(p => Contains(p.Order.OrderNumber, term)),
                };
            }

            return rows;
        }
    }

    private IEnumerable<WorkOrderProgressDto> SelectedOrders => (_progress ?? []).Where(p => _selected.Contains(p.Order.Id));

    private IEnumerable<WorkOrderProgressDto> SelectableRows => Rows.Where(p => CanSelect(p.Order));

    private static bool Contains(string? text, string term) => text?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;

    private string? ZoneOf(Guid siteId) => _siteZones.GetValueOrDefault(siteId);

    private static string Number(decimal value) => value.ToString("#,##0.###", CultureInfo.InvariantCulture);

    /// <summary>Why the row is flagged, one reason per line, for its tooltip.</summary>
    private List<string> Flags(WorkOrderProgressDto p)
    {
        var flags = new List<string>();
        if (p.FinishSlip is { } late)
        {
            flags.Add(L["Projected to finish {0} after its due date.", ScheduleFormat.Duration(late)]);
        }

        if (p.StartSlip is { } slip && slip > WorkOrderTiles.SlipTolerance)
        {
            flags.Add(L["Projected to start {0} after its published baseline.", ScheduleFormat.Duration(slip)]);
        }

        if (p.HasOverlap)
        {
            flags.Add("A job overlaps other work on its line.");
        }

        flags.AddRange(p.Warnings.Where(w => w.Code != "late").Select(L.Of));
        return flags;
    }

    private void OnEquipmentChanged(Guid? id)
    {
        Selection.EquipmentId = id;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("equipment", id));
    }

    private void ToggleTile(string key) => _tile = _tile == key ? null : key;

    private async Task ToggleExpanded(Guid id)
    {
        if (_expanded.Remove(id))
        {
            return;
        }

        _expanded.Add(id);
        try
        {
            // Planned components never change after the order is made (D-025), so load them once.
            if (!_components.ContainsKey(id))
            {
                _components[id] = await Api.ListWorkOrderComponentsAsync(id);
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private void ToggleSelected(Guid id, bool selected)
    {
        _actionsOpen = false;
        if (selected)
        {
            _selected.Add(id);
        }
        else
        {
            _selected.Remove(id);
        }
    }

    private void SelectAll()
    {
        _actionsOpen = false;
        _selected.UnionWith(SelectableRows.Select(p => p.Order.Id));
    }

    private void ClearSelection()
    {
        _actionsOpen = false;
        _selected.Clear();
    }

    /// <summary>Cancelling asks once more; other actions run for one or many selected orders.</summary>
    private Task StartSelectedStatus(string status)
    {
        _actionsOpen = false;
        if (status == "cancelled")
        {
            _pendingBulk = status;
            return Task.CompletedTask;
        }

        var selected = SelectedOrders.ToList();
        if (selected.Count == 1)
        {
            return ChangeStatusAsync(selected[0], status);
        }

        return RunBulkAsync(status);
    }

    /// <summary>Applies the action to every selected order that allows it, one by one, then reports what happened.</summary>
    private async Task RunBulkAsync(string status)
    {
        _pendingBulk = null;
        _busy = true;
        var orders = SelectedOrders.ToList();
        var eligible = orders.Where(o => o.Order.NextStatuses.Contains(status) && MayMove(o.Order, status)).ToList();
        var failures = new List<string>();
        foreach (var order in eligible)
        {
            try
            {
                await Api.MoveWorkOrderAsync(order.Order, status);
            }
            catch (ApiException ex)
            {
                failures.Add($"{order.Order.OrderNumber}: {L.Problem(ex)}");
            }
        }

        var done = eligible.Count - failures.Count;
        var skipped = orders.Count - eligible.Count;
        var action = L[BulkActions.First(a => a.Status == status).Label].TrimEnd('…');
        _result = L["{0}: {1} done", action, done]
            + (skipped > 0 ? L[", {0} skipped (not allowed from their status)", skipped] : "")
            + (failures.Count > 0 ? L[", {0} failed. {1}", failures.Count, string.Join(" ", failures)] : ".");
        _resultFailed = failures.Count > 0;
        _busy = false;
        await LoadAsync();
    }

    private decimal? _heldQuantity;
    private string? _rejectReason;

    private bool CanManage(WorkOrderDto order) => User.Can(PermissionCodes.WorkOrderManage, order.SiteId);

    private Task SetQuantityAsync(WorkOrderDto order) =>
        RunOnOrderAsync(order, () => Api.SetWorkOrderQuantityAsync(order.Id, order.Version, _heldQuantity!.Value), "quantity set; it can be dispatched");

    private Task AcceptErpAsync(WorkOrderDto order) => RunOnOrderAsync(order, () => Api.AcceptErpChangeAsync(order.Id, order.Version), "the ERP's change is applied");

    private Task RejectErpAsync(WorkOrderDto order) =>
        RunOnOrderAsync(order, () => Api.RejectErpChangeAsync(order.Id, order.Version, _rejectReason!.Trim()), "the ERP's change is rejected");

    private async Task RunOnOrderAsync(WorkOrderDto order, Func<Task<VersionResponse>> action, string done)
    {
        _busyId = order.Id;
        try
        {
            await action();
            _result = $"{order.OrderNumber}: {done}.";
            _resultFailed = false;
            (_heldQuantity, _rejectReason) = (null, null);
        }
        catch (ApiException ex)
        {
            _result = $"{order.OrderNumber}: {L.Problem(ex)}";
            _resultFailed = true;
        }
        finally
        {
            _busyId = null;
        }

        await LoadAsync();
    }

    private async Task ChangeStatusAsync(WorkOrderProgressDto progress, string status)
    {
        _actionsOpen = false;
        _busyId = progress.Order.Id;
        try
        {
            await Api.MoveWorkOrderAsync(progress.Order, status);
            _result = L["{0} is now {1}.", progress.Order.OrderNumber, L.Label(status).ToLowerInvariant()];
            _resultFailed = false;
        }
        catch (ApiException ex)
        {
            _result = $"{progress.Order.OrderNumber}: {L.Problem(ex)}";
            _resultFailed = true;
        }
        finally
        {
            _busyId = null;
        }

        // Reload either way: after a conflict the user needs the current row and version.
        await LoadAsync();
    }

    private async Task PrintShopOrderAsync(WorkOrderDto order)
    {
        _actionsOpen = false;
        _printingId = order.Id;
        _result = null;
        try
        {
            var file = await Api.GetShopOrderPdfAsync(order.Id);
            await Downloads.PdfAsync(file.FileName, file.Content);
            _result = L["Shop order {0} downloaded.", order.OrderNumber];
            _resultFailed = false;
        }
        catch (ApiException ex)
        {
            _result = L.Problem(ex);
            _resultFailed = true;
        }
        finally
        {
            _printingId = null;
        }
    }
}
