@* The editor every view opens: a job (move, lock, hold, cancel) or a work order (dispatch,
   un-dispatch, firm, place on a line). It reads the live board on every render, so what it shows
   follows refreshes; the form fields keep what the planner is typing. Every action is also
   reachable here from the keyboard, so nothing depends on dragging. *@
@using System.Globalization
@inject CurrentUser User

@if (Item is not null || WorkOrder is not null)
{
    <aside class="drawer" role="dialog" aria-modal="false" aria-labelledby="drawer-title" @onkeydown="OnKeyDown">
        @if (Item is { } item)
        {
            var s = item.Segment;
            var order = Controller.Board.FindWorkOrder(s.WorkOrderId);
            var group = s.GroupEquipmentId is { } groupId ? Controller.Board.FindLine(groupId) : null;
            <header class="drawer-head">
                <div>
                    <div class="small text-muted">@Display.Label(s.JobType) job · @item.LineCode</div>
                    <h2 id="drawer-title" class="mb-0">@s.JobNumber</h2>
                </div>
                <span class="@Display.JobStatusChip(s.Status)">@Display.Label(s.Status)</span>
                <button type="button" class="icon-button" aria-label="Close" @onclick="OnClose"><Icon Name="close" /></button>
            </header>

            <div class="drawer-body">
                @foreach (var overlap in Controller.Board.OverlapsFor(item))
                {
                    <div class="drawer-alert is-danger" @key="overlap.Key">
                        <Icon Name="alert" Size="18" />
                        <span>@overlap.Describe(), from @ScheduleFormat.When(overlap.Start, Tz) to @ScheduleFormat.Time(overlap.End, Tz).</span>
                    </div>
                }
                @foreach (var warning in s.Warnings)
                {
                    <div class="drawer-alert @(warning.Code is "late" or "firmed_conflict" or "link_not_met" or "link_cycle" ? "is-warning" : "")">
                        <Icon Name="alert" Size="18" /><span>@warning.Message</span>
                    </div>
                }

                <dl class="facts">
                    <dt>@(item.IsWindow ? "Window" : "Projected")</dt>
                    <dd>@ScheduleFormat.When(s.Start, Tz) – @ScheduleFormat.When(s.End, Tz) <span class="text-muted">(@ScheduleFormat.Duration(s.End - s.Start))</span></dd>
                    @if (group is not null)
                    {
                        <dt>Planned to</dt>
                        <dd>@group.Code <span class="text-muted">@(item.IsWindow ? "· waiting for a line" : $"· running on {item.LineCode}")</span></dd>
                    }
                    @if (s.LinkReadyAt is not null)
                    {
                        <dt>Process links</dt>
                        <dd>Can start from @ScheduleFormat.When(s.LinkReadyAt, Tz) <span class="text-muted">· when the operations it follows allow</span></dd>
                    }
                    @if (s.LatestEnd is not null && !item.IsWindow)
                    {
                        <dt>Finish by</dt>
                        <dd>@ScheduleFormat.When(s.LatestEnd, Tz)</dd>
                    }
                    @if (s.BaselineStart is not null)
                    {
                        <dt>Baseline</dt>
                        <dd>@ScheduleFormat.When(s.BaselineStart, Tz) – @ScheduleFormat.When(s.BaselineEnd, Tz)</dd>
                    }
                    @if (order is not null)
                    {
                        <dt>Work order</dt>
                        <dd><button type="button" class="link-button" @onclick="() => OnSelectWorkOrder.InvokeAsync(order.Id)">@order.OrderNumber</button> · @Display.Label(order.Status)</dd>
                    }
                    @if (s.MaterialCode is not null)
                    {
                        <dt>Material</dt>
                        <dd>@s.MaterialCode</dd>
                    }
                    @if (s.PlannedQty is not null)
                    {
                        <dt>Quantity</dt>
                        <dd>@ScheduleFormat.Qty(s.RemainingQty, s.UomCode) to make of @ScheduleFormat.Qty(s.PlannedQty, s.UomCode)</dd>
                    }
                    @if (s.RatePerHour is not null)
                    {
                        <dt>Rate</dt>
                        <dd>@ScheduleFormat.Qty(s.RatePerHour, s.UomCode)/h <span class="text-muted">(@s.RateSource)</span></dd>
                    }
                    @if (s.DueAt is not null)
                    {
                        <dt>Due</dt>
                        <dd>@ScheduleFormat.When(s.DueAt, Tz)</dd>
                    }
                </dl>

                @if (Controller.ReadOnly && (item.CanChangeLine || item.CanPin || item.CanCancel))
                {
                    @Locked($"You can view {s.JobNumber}, but moving, pinning or cancelling it needs permission to plan jobs at this site.")
                }

                @if (item.IsWindow)
                {
                    <section class="drawer-section">
                        <h3>Lines that could run it</h3>
                        @if (s.Candidates.Count == 0)
                        {
                            <p class="small text-muted mb-0">No line in @group?.Code can run @s.MaterialCode.</p>
                        }
                        else
                        {
                            <ul class="candidate-list">
                                @foreach (var candidate in s.Candidates)
                                {
                                    <li @key="candidate.LineId">
                                        <span class="fw-semibold">@candidate.LineCode</span>
                                        <span class="small text-muted">@(candidate.Work is { } work ? $"~{ScheduleFormat.Duration(work)}" : "no run standard")</span>
                                        <span class="chip @(candidate.FitsWindow ? "" : "chip-warning")">@(candidate.FitsWindow ? "Fits the window" : "Won't fit")</span>
                                        @if (!Controller.ReadOnly)
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm ms-auto" disabled="@(Busy(item) || !item.CanChangeLine)"
                                                    @onclick="() => Controller.AssignJobAsync(item, candidate.LineId, null)">Run on @candidate.LineCode</button>
                                        }
                                    </li>
                                }
                            </ul>
                            <p class="small text-muted mt-2 mb-0">It joins the end of that line. To put it elsewhere in the line, drag it onto the line on the Gantt.</p>
                        }
                    </section>
                }
                else if (item.IsFromGroup && group is not null && !Controller.ReadOnly)
                {
                    <section class="drawer-section">
                        <h3>On the floor</h3>
                        <p class="small text-muted">Planned to @group.Code, so it can move between its lines whatever its plan status, until it starts.</p>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label" for="assign-line">Line</label>
                                <select id="assign-line" class="form-select" @bind="_moveLine" @bind:after="ResetBefore">
                                    <option value="@item.LineId">@item.LineCode</option>
                                    @foreach (var line in Controller.Board.AssignTargets(item).Where(l => !l.IsGroup))
                                    {
                                        <option value="@line.Id">@line.Code</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="assign-before">Runs</label>
                                <select id="assign-before" class="form-select" @bind="_moveBefore">
                                    @foreach (var other in BeforeChoices(item))
                                    {
                                        <option value="@other.JobId">Before @other.Segment.JobNumber</option>
                                    }
                                    <option value="">At the end</option>
                                </select>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button type="button" class="btn btn-primary btn-sm" disabled="@(Busy(item) || !item.CanChangeLine)" @onclick="() => MoveAsync(item)">Move</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(Busy(item) || !item.CanChangeLine)"
                                    @onclick="() => Controller.AssignJobAsync(item, group.Id, null)">Send back to @group.Code</button>
                        </div>
                    </section>
                }
                else if (item.CanChangeLine && !Controller.ReadOnly)
                {
                    <section class="drawer-section">
                        <h3>Line and sequence</h3>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label" for="move-line">Line</label>
                                <select id="move-line" class="form-select" @bind="_moveLine" @bind:after="ResetBefore">
                                    @foreach (var line in Controller.Board.Lines.Where(l => !l.IsGroup))
                                    {
                                        <option value="@line.Id">@line.Code</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="move-before">Runs</label>
                                <select id="move-before" class="form-select" @bind="_moveBefore" disabled="@(s.Status == "firmed")">
                                    @foreach (var other in BeforeChoices(item))
                                    {
                                        <option value="@other.JobId">Before @other.Segment.JobNumber</option>
                                    }
                                    <option value="">At the end</option>
                                </select>
                            </div>
                        </div>
                        @if (s.Status == "firmed")
                        {
                            <p class="small text-muted mt-2 mb-0">Firmed: it keeps its start, so it takes its place on the new line by time.</p>
                        }
                        <button type="button" class="btn btn-primary btn-sm mt-2" disabled="@Busy(item)" @onclick="() => MoveAsync(item)">Move</button>
                    </section>
                }

                @if (item.CanPin && !Controller.ReadOnly)
                {
                    <section class="drawer-section">
                        <h3>Pins</h3>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="pin-lock"
                                   checked="@s.IsLocked" disabled="@Busy(item)" @onchange="e => Controller.PinJobAsync(item, e.Value is true, s.EarliestStart)" />
                            <label class="form-check-label" for="pin-lock">Locked: it keeps its place when others move</label>
                        </div>
                        @{ var holdShown = item.CanResequence || item.IsWindow; }
                        <div class="row g-2 mt-1">
                            @if (holdShown)
                            {
                                <div class="col-6">
                                    <label class="form-label" for="pin-hold">@(item.IsWindow ? "Window opens" : "Hold until") (site time)</label>
                                    <input id="pin-hold" type="datetime-local" class="form-control" @bind="_holdUntil" />
                                </div>
                            }
                            <div class="col-6">
                                <label class="form-label" for="pin-finish">Finish by (site time)</label>
                                <input id="pin-finish" type="datetime-local" class="form-control" @bind="_finishBy" />
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@Busy(item)"
                                    @onclick="() => Controller.PinJobAsync(item, s.IsLocked, holdShown ? Display.FromSiteLocal(_holdUntil, Tz) : s.EarliestStart, Display.FromSiteLocal(_finishBy, Tz))">
                                @(item.IsWindow ? "Set window" : "Set")
                            </button>
                            @if (holdShown && s.EarliestStart is not null)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@Busy(item)"
                                        @onclick="() => Controller.PinJobAsync(item, s.IsLocked, null)">@(item.IsWindow ? "Open from now" : "Clear hold")</button>
                            }
                            @if (s.LatestEnd is not null && !item.IsWindow)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@Busy(item)"
                                        @onclick="() => Controller.PinJobAsync(item, s.IsLocked, s.EarliestStart, null)">Clear finish-by</button>
                            }
                        </div>
                    </section>
                }

                @if (item.CanCancel && !Controller.ReadOnly)
                {
                    <section class="drawer-section">
                        <h3>Cancel</h3>
                        @if (!_confirmCancel)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => _confirmCancel = true">Cancel job…</button>
                        }
                        else
                        {
                            <label class="form-label" for="cancel-reason">Reason</label>
                            <input id="cancel-reason" class="form-control" @bind="_cancelReason" />
                            @if (s.JobType == "production")
                            {
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="cancel-replace" @bind="_cancelReplace" />
                                    <label class="form-check-label" for="cancel-replace">Replace it with a job for the quantity not yet made</label>
                                </div>
                                @if (_cancelReplace)
                                {
                                    <fieldset class="ms-4">
                                        <legend class="form-text mb-1">For a material made in batches:</legend>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="cancel-rounding" id="cancel-up" checked="@(_cancelRounding == "up")" @onchange='() => _cancelRounding = "up"' />
                                            <label class="form-check-label" for="cancel-up">Round up to whole batches, to meet the order</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="cancel-rounding" id="cancel-down" checked="@(_cancelRounding == "down")" @onchange='() => _cancelRounding = "down"' />
                                            <label class="form-check-label" for="cancel-down">Round down to whole batches; the order ends short</label>
                                        </div>
                                        @if (User.Can(PermissionCodes.SchedulePlanPartial, Controller.SiteId))
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="cancel-rounding" id="cancel-exact" checked="@(_cancelRounding == "exact")" @onchange='() => _cancelRounding = "exact"' />
                                                <label class="form-check-label" for="cancel-exact">Exactly what is left, even a partial batch</label>
                                            </div>
                                        }
                                    </fieldset>
                                }
                            }
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@Busy(item)" @onclick="() => CancelAsync(item)">Cancel @s.JobNumber</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmCancel = false">Keep it</button>
                            </div>
                        }
                    </section>
                }
            </div>
        }
        else if (WorkOrder is { } wo)
        {
            var key = ScheduleBoard.WorkOrderKey(wo.Id);
            var jobs = Controller.Board.JobsFor(wo.Id);
            var unplaced = Controller.Board.UnplacedQty(wo);
            <header class="drawer-head">
                <div>
                    <div class="small text-muted">Work order · @wo.SiteCode</div>
                    <h2 id="drawer-title" class="mb-0">@wo.OrderNumber</h2>
                </div>
                <span class="@Display.StatusChip(wo.Status)">@Display.Label(wo.Status)</span>
                <button type="button" class="icon-button" aria-label="Close" @onclick="OnClose"><Icon Name="close" /></button>
            </header>

            <div class="drawer-body">
                <dl class="facts">
                    <dt>Material</dt>
                    <dd>@wo.MaterialCode <span class="text-muted">@wo.MaterialName</span></dd>
                    <dt>Quantity</dt>
                    <dd>@ScheduleFormat.Qty(wo.PlannedQty, wo.UomCode)</dd>
                    @if (wo.DueAt is not null)
                    {
                        <dt>Due</dt>
                        <dd>@ScheduleFormat.When(wo.DueAt, Tz)</dd>
                    }
                    @if (wo.ProcessCode is not null)
                    {
                        <dt>Process</dt>
                        <dd>@wo.ProcessCode <span class="text-muted">v@(wo.ProcessVersionNumber)</span></dd>
                    }
                    <dt>Origin</dt>
                    <dd>@Display.Label(wo.Origin)</dd>
                    @if (wo.Notes is not null)
                    {
                        <dt>Notes</dt>
                        <dd style="white-space: pre-wrap">@wo.Notes</dd>
                    }
                </dl>

                @if (wo.NextStatuses.Count > 0 && Controller.OrdersReadOnly)
                {
                    @Locked($"You can view {wo.OrderNumber}, but changing its status needs permission to manage work orders at this site.")
                }
                @if (wo.Status == "planned" && Controller.ReadOnly)
                {
                    @Locked($"Placing {wo.OrderNumber} on a line needs permission to plan jobs at this site.")
                }

                @if (wo.NextStatuses.Count > 0 && !Controller.OrdersReadOnly)
                {
                    <section class="drawer-section">
                        <h3>Status</h3>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var next in wo.NextStatuses)
                            {
                                <button type="button" class="btn btn-sm @(next == "cancelled" ? "btn-outline-danger" : "btn-outline-primary")"
                                        disabled="@Controller.Saving.Contains(key)" @onclick="() => Controller.MoveWorkOrderAsync(wo, next)">
                                    @Display.StatusAction(wo.Status, next)
                                </button>
                            }
                        </div>
                    </section>
                }

                <section class="drawer-section">
                    <h3>Jobs</h3>
                    @if (jobs.Count == 0)
                    {
                        <p class="small text-muted mb-0">No open jobs.</p>
                    }
                    else
                    {
                        <ul class="drawer-jobs">
                            @foreach (var job in jobs)
                            {
                                <li @key="job.Key">
                                    <button type="button" class="link-button fw-semibold" @onclick="() => OnSelect.InvokeAsync(job)">@job.Segment.JobNumber</button>
                                    <span class="chip">@job.LineCode</span>
                                    <span class="small text-muted">@ScheduleFormat.When(job.Segment.Start, Tz) – @ScheduleFormat.Time(job.Segment.End, Tz)</span>
                                    @if (Controller.Board.IsOverlapping(job))
                                    {
                                        <span class="chip chip-danger">Overlap</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </section>

                @if (wo.Status == "planned" && !Controller.ReadOnly)
                {
                    var placeGroup = Controller.Board.FindLine(_placeLine) is { IsGroup: true } chosen ? chosen : null;
                    <section class="drawer-section">
                        <h3>Place on a line or plan to a department</h3>
                        @if (unplaced > 0)
                        {
                            <p class="small text-muted">@ScheduleFormat.Qty(unplaced, wo.UomCode) is not on a line yet.</p>
                        }
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label" for="place-line">Line or department</label>
                                <select id="place-line" class="form-select" @bind="_placeLine" @bind:after="() => DefaultWindow(wo)">
                                    @foreach (var line in Controller.Board.Lines.Where(l => l.IsGroup || l.Line.IsSchedulable))
                                    {
                                        <option value="@line.Id">@line.Code@(line.IsGroup ? " · department" : "")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="place-qty">Quantity (@wo.UomCode)</label>
                                <input id="place-qty" type="number" min="0" step="any" class="form-control" @bind="_placeQty" />
                            </div>
                        </div>
                        @if (placeGroup is not null)
                        {
                            <div class="row g-2 mt-1">
                                <div class="col-6">
                                    <label class="form-label" for="place-start">Window opens (site time)</label>
                                    <input id="place-start" type="datetime-local" class="form-control" @bind="_placeStart" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label" for="place-end">Finish by (site time)</label>
                                    <input id="place-end" type="datetime-local" class="form-control" @bind="_placeEnd" />
                                </div>
                            </div>
                            <p class="small text-muted mt-2 mb-0">It waits on @placeGroup.Code until one of its lines takes it; the floor decides which.</p>
                        }
                        <button type="button" class="btn btn-primary btn-sm mt-2"
                                disabled="@(Controller.Saving.Contains(key) || _placeQty is not > 0 || (placeGroup is not null && _placeEnd is null))"
                                @onclick="() => PlaceAsync(wo)">
                            @(placeGroup is not null ? $"Plan to {placeGroup.Code}" : "Add job at the end of the line")
                        </button>
                    </section>
                }
            </div>
        }
    </aside>
}

@code {
    // Says, where an action is left out, that the user's roles don't allow it here (#47).
    private static RenderFragment Locked(string text) =>
        @<div class="view-only-note small" role="note"><Icon Name="lock" Size="16" /><span>@text</span></div>;

    [Parameter, EditorRequired]
    public ScheduleController Controller { get; set; } = null!;

    [Parameter]
    public (Guid JobId, string Kind)? Selected { get; set; }

    [Parameter]
    public Guid? SelectedWorkOrder { get; set; }

    [Parameter]
    public EventCallback<BoardItem> OnSelect { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSelectWorkOrder { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>An order dropped on a department: open its form on that department with a suggested window.</summary>
    [Parameter]
    public PlacementPreset? Preset { get; set; }

    // Form state, reset whenever the selection changes; a refresh leaves it alone.
    private object? _formFor;
    private Guid _moveLine;
    private string _moveBefore = "";
    private DateTime? _holdUntil;
    private bool _confirmCancel;
    private string? _cancelReason;
    private bool _cancelReplace = true;
    private string _cancelRounding = "up";
    private Guid _placeLine;
    private decimal? _placeQty;
    private DateTime? _placeStart;
    private DateTime? _placeEnd;
    private DateTime? _finishBy;
    private PlacementPreset? _presetApplied;

    private string? Tz => Controller.TimeZone;

    private BoardItem? Item => Selected is { } s ? Controller.Board.Find(s.JobId, s.Kind) : null;

    private WorkOrderDto? WorkOrder => Controller.Board.FindWorkOrder(SelectedWorkOrder);

    protected override void OnParametersSet()
    {
        object? current = Selected is { } s ? s : SelectedWorkOrder;
        if (Equals(current, _formFor))
        {
            ApplyPreset();
            return;
        }

        _formFor = current;
        _confirmCancel = false;
        _cancelReason = null;
        _cancelReplace = true;
        _cancelRounding = "up";

        if (Item is { } item)
        {
            _moveLine = item.LineId;
            _moveBefore = ScheduleLayout.NextJobAfter(Controller.Board.ItemsOn(item.LineId), item.JobId)?.ToString() ?? "";
            _holdUntil = item.Segment.EarliestStart is { } at ? Display.ToSite(at, Tz).DateTime : null;
            _finishBy = item.Segment.LatestEnd is { } by ? Display.ToSite(by, Tz).DateTime : null;
        }
        else if (WorkOrder is { } wo)
        {
            _placeLine = wo.TargetEquipmentId is { } target && Controller.Board.FindLine(target) is not null
                ? target
                : Controller.Board.Lines.FirstOrDefault(l => !l.IsGroup)?.Id ?? Guid.Empty;
            // The API sends numeric(…, 6): drop the trailing zeros so the field shows 5000, not 5000.000000.
            var unplaced = Controller.Board.UnplacedQty(wo) / 1.000000000000000000000000000000000m;
            _placeQty = unplaced > 0 ? unplaced : null;
            DefaultWindow(wo);
        }

        ApplyPreset();
    }

    private void ApplyPreset()
    {
        if (Preset is not { } preset || ReferenceEquals(preset, _presetApplied) || preset.WorkOrderId != WorkOrder?.Id)
        {
            return;
        }

        _presetApplied = preset;
        _placeLine = preset.TargetId;
        _placeStart = Display.ToSite(preset.Start, Tz).DateTime;
        _placeEnd = Display.ToSite(preset.End, Tz).DateTime;
    }

    /// <summary>A window from now to the order's due date, or two days if it has none (D-022).</summary>
    private void DefaultWindow(WorkOrderDto workOrder)
    {
        var (start, end) = ScheduleLayout.SuggestWindow(Controller.Now, workOrder.DueAt, Tz);
        _placeStart = Display.ToSite(start, Tz).DateTime;
        _placeEnd = Display.ToSite(end, Tz).DateTime;
    }

    /// <summary>The jobs on the chosen line this one can be put in front of.</summary>
    private IEnumerable<BoardItem> BeforeChoices(BoardItem item) =>
        Controller.Board.ItemsOn(_moveLine)
            .Where(i => !i.IsPlaceholder && i.JobId != item.JobId && i.Segment.Status != "running")
            .OrderBy(i => i.Segment.Start);

    private bool Busy(BoardItem item) => Controller.Saving.Contains(item.Key);

    private void ResetBefore() => _moveBefore = "";

    private Task MoveAsync(BoardItem item) =>
        Controller.MoveJobAsync(item, _moveLine, Guid.TryParse(_moveBefore, out var before) ? before : null);

    private async Task CancelAsync(BoardItem item)
    {
        var replace = _cancelReplace && item.Segment.JobType == "production";
        await Controller.CancelJobAsync(item, replace, _cancelReason, replace && _cancelRounding == "exact", replace && _cancelRounding == "down");
        _confirmCancel = false;
    }

    private Task PlaceAsync(WorkOrderDto workOrder)
    {
        if (_placeQty is not { } qty || qty <= 0)
        {
            return Task.CompletedTask;
        }

        return Controller.Board.FindLine(_placeLine) is { IsGroup: true }
            ? Controller.PlaceWorkOrderAsync(workOrder, _placeLine, null, qty, Display.FromSiteLocal(_placeStart, Tz), Display.FromSiteLocal(_placeEnd, Tz))
            : Controller.PlaceWorkOrderAsync(workOrder, _placeLine, null, qty);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }
}
