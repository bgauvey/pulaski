@* Lines down the side, projected time across. Drag a bar to resequence it or move it to another
   line, drag a planned order from the tray onto a line to cut a job from it. Times are never
   dragged directly: the planner owns line and sequence, the projector owns time (D-014).
   The drag itself runs in js/ui.js (pulaski.gantt): it finds the slot under the pointer and
   calls back only when the slot changes. While an order is dragged, each line gets a drop lane
   where the API's placement preview shows where the job would land and what it would push. *@
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="view-toolbar">
    <div class="btn-group" role="group" aria-label="Move the window">
        <button type="button" class="btn btn-outline-secondary btn-square" aria-label="Earlier" @onclick="() => ShiftAsync(-1)">
            <Icon Name="chevron-left" Size="18" />
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="TodayAsync">Today</button>
        <button type="button" class="btn btn-outline-secondary btn-square" aria-label="Later" @onclick="() => ShiftAsync(1)">
            <Icon Name="chevron-right" Size="18" />
        </button>
    </div>
    <span class="range-label">@ScheduleFormat.When(_scale.Start, Tz) – @ScheduleFormat.When(_scale.End, Tz)</span>
    <div class="segmented segmented-sm ms-auto" role="group" aria-label="Zoom">
        @foreach (var (days, label) in Zooms)
        {
            <button type="button" class="segmented-item @(_days == days ? "is-active" : "")"
                    aria-pressed="@(_days == days ? "true" : "false")" @onclick="() => ZoomAsync(days)">
                @label
            </button>
        }
    </div>
</div>

<div class="gantt-layout @(Unscheduled.Count > 0 ? "has-tray" : "")">
    @if (Unscheduled.Count > 0)
    {
        <aside class="tray" aria-labelledby="tray-title">
            <h2 id="tray-title">To place <span class="chip chip-muted">@Unscheduled.Count</span></h2>
            <p class="small text-muted">Drag a planned order onto a line to give it a job.</p>
            @foreach (var wo in Unscheduled)
            {
                var key = ScheduleBoard.WorkOrderKey(wo.Id);
                <div class="tray-card @(Controller.Saving.Contains(key) ? "is-saving" : "") @(Controller.DraggingWorkOrder?.Id == wo.Id ? "is-dragging" : "")"
                     @key="wo.Id" draggable="@(Controller.ReadOnly ? "false" : "true")" role="button" tabindex="0" data-drag="@($"wo:{wo.Id}")"
                     @ondragstart="() => Controller.StartDrag(wo)" @ondragend="Controller.EndDrag"
                     @onclick="() => OnSelectWorkOrder.InvokeAsync(wo.Id)"
                     @onkeydown="e => OnKey(e, () => OnSelectWorkOrder.InvokeAsync(wo.Id))">
                    <div class="d-flex justify-content-between gap-2">
                        <span class="fw-semibold">@wo.OrderNumber</span>
                        <span class="small text-muted">@ScheduleFormat.Qty(Controller.Board.UnplacedQty(wo), wo.UomCode)</span>
                    </div>
                    <div class="small text-muted">@wo.MaterialCode</div>
                    @if (wo.DueAt is not null)
                    {
                        <div class="small">Due @ScheduleFormat.When(wo.DueAt, Tz)</div>
                    }
                </div>
            }
        </aside>
    }

    <div class="gantt" role="grid" aria-label="Schedule by line" @ref="_gantt"
         data-dragging-job="@(Controller.DraggingItem?.JobId.ToString())">
        <div class="gantt-row gantt-header" role="row">
            <div class="gantt-label" role="columnheader">Line</div>
            <div class="gantt-track" role="columnheader">
                @foreach (var tick in _ticks)
                {
                    <span class="gantt-tick-label @(tick.IsDayStart ? "is-day" : "")" style="left:@Pct(tick.Percent)">@tick.Label</span>
                }
            </div>
        </div>

        @foreach (var line in Controller.Board.Lines)
        {
            var items = Controller.Board.ItemsOn(line.Id).Where(IsVisible).ToList();
            var lanes = ScheduleLayout.Lanes(items);
            var laneCount = Math.Max(1, lanes.Count == 0 ? 1 : lanes.Values.Max() + 1);
            var ghosts = Controller.Board.GhostsOn(line.Id).Where(g => IsVisible(g.Window)).ToList();
            var ghostLanes = ScheduleLayout.Lanes(ghosts.Select(g => g.Window));
            var ghostLaneCount = ghostLanes.Count == 0 ? 0 : ghostLanes.Values.Max() + 1;
            var blocked = !CanDropOn(line);
            var ghost = _ghost?.LineId == line.Id ? _ghost : null;
            var dropLane = Controller.DraggingWorkOrder is not null;
            <div class="gantt-row @(line.IsGroup ? "is-group" : "")" role="row" @key="line.Id" data-line-id="@line.Id"
                 data-drop-zone data-drop-blocked="@(blocked ? "" : null)" data-drop-refused="@(ghost?.Error is not null ? "" : null)">
                <div class="gantt-label" role="rowheader" style="padding-left:@(12 + line.Indent * 14)px">
                    <span class="fw-semibold">@line.Code</span>
                    <span class="small text-muted text-truncate">@line.Line.Name</span>
                    <span class="gantt-label-meta">
                        @if (line.IsGroup)
                        {
                            var runners = Controller.Board.Lines.Count(l => !l.IsGroup && Controller.Board.IsUnder(line.Id, l.Id));
                            <span class="chip" title="Jobs planned here wait in a window until one of its lines takes them.">Plans for @runners line@(runners == 1 ? "" : "s")</span>
                        }
                        @if (!line.Timeline.HasShiftCalendar)
                        {
                            <span class="chip chip-muted" title="No shift schedule covers this line; times assume it runs around the clock.">24/7</span>
                        }
                        else if (line.Timeline.CalendarName is { } calendar)
                        {
                            @* Where its working time comes from (D-038), such as "2X8 · Two shifts, from PLT1". *@
                            <span class="chip chip-muted" title="Shifts: @calendar">@(calendar.StartsWith("Around the clock", StringComparison.Ordinal) ? "24/7" : calendar.Split(' ')[0])</span>
                        }
                        @{ var overlaps = Controller.Board.Overlaps.Count(o => o.Line.Id == line.Id); }
                        @if (overlaps > 0)
                        {
                            <span class="chip chip-danger">@overlaps overlap@(overlaps == 1 ? "" : "s")</span>
                        }
                    </span>
                </div>
                <div class="gantt-track" data-slots="@Slots(line)"
                     style="height:@(laneCount * LaneHeight + ghostLaneCount * GhostLaneHeight + 8 + (dropLane ? DropLaneHeight : 0))px">
                    @foreach (var tick in _ticks)
                    {
                        <span class="gantt-grid @(tick.IsDayStart ? "is-day" : "")" style="left:@Pct(tick.Percent)"></span>
                    }
                    @if (_scale.IsVisible(Controller.Now, Controller.Now.AddTicks(1)))
                    {
                        <span class="gantt-now" style="left:@Pct(_scale.Percent(Controller.Now))" title="Now"></span>
                    }
                    @foreach (var overlap in Controller.Board.Overlaps.Where(o => o.Line.Id == line.Id && _scale.IsVisible(o.Start, o.End)))
                    {
                        <span class="gantt-overlap" @key="overlap.Key"
                              style="left:@Pct(_scale.Percent(overlap.Start));width:@Pct(_scale.Width(overlap.Start, overlap.End))"
                              title="@overlap.Describe()"></span>
                    }
                    @foreach (var item in items)
                    {
                        var s = item.Segment;
                        var width = _scale.Width(s.Start, s.End);
                        <div class="bar @BarClasses(item)" @key="item.Key + item.Signature"
                             style="left:@Pct(_scale.Percent(s.Start));width:@Pct(width);top:@(lanes[item.Key] * LaneHeight + 4)px"
                             draggable="@(item.CanChangeLine && !Controller.ReadOnly ? "true" : "false")" data-drag="@($"job:{item.Key}")"
                             role="button" tabindex="0" aria-label="@Describe(item)" title="@Describe(item)"
                             @ondragstart="() => Controller.StartDrag(item)" @ondragend="Controller.EndDrag"
                             @onclick="() => Select(item)" @onkeydown="e => OnKey(e, () => Select(item))">
                            @if (item.IsPlaceholder)
                            {
                                <span class="bar-title">Changeover</span>
                            }
                            else if (item.IsWindow)
                            {
                                <span class="bar-title">
                                    @if (s.IsLocked)
                                    {
                                        <Icon Name="lock" Size="12" />
                                    }
                                    @s.JobNumber · @ScheduleFormat.Qty(s.RemainingQty, s.UomCode)
                                </span>
                                <span class="bar-sub">@WindowSummary(item)</span>
                            }
                            else
                            {
                                <span class="bar-title">
                                    @if (s.IsLocked)
                                    {
                                        <Icon Name="lock" Size="12" />
                                    }
                                    @s.JobNumber
                                </span>
                                <span class="bar-sub">@(s.MaterialCode ?? Display.Label(s.JobType))</span>
                            }
                        </div>
                    }
                    @foreach (var (window, candidate) in ghosts)
                    {
                        var s = window.Segment;
                        <div class="bar bar-ghost @(candidate.FitsWindow ? "" : "is-tight") @(Selected == (window.JobId, s.Kind) ? "is-selected" : "")"
                             @key="@($"ghost:{window.Key}:{window.Signature}")"
                             style="left:@Pct(_scale.Percent(s.Start));width:@Pct(_scale.Width(s.Start, s.End));top:@(laneCount * LaneHeight + ghostLanes[window.Key] * GhostLaneHeight + 4)px"
                             draggable="@(window.CanChangeLine && !Controller.ReadOnly ? "true" : "false")" data-drag="@($"job:{window.Key}")"
                             role="button" tabindex="0" title="@GhostTitle(window, candidate, line)" aria-label="@GhostTitle(window, candidate, line)"
                             @ondragstart="() => Controller.StartDrag(window)" @ondragend="Controller.EndDrag"
                             @onclick="() => Select(window)" @onkeydown="e => OnKey(e, () => Select(window))">
                            <span class="bar-title">@s.JobNumber</span>
                            <span class="bar-sub">@(candidate.Work is { } work ? $"~{ScheduleFormat.Duration(work)} here" : "no rate here")@(candidate.FitsWindow ? "" : " · won't fit")</span>
                        </div>
                    }
                    @if (_slot is { } slot && slot.Line == line.Id && SlotPercent(line, slot.Before) is { } at)
                    {
                        <span class="slot-marker" style="left:@Pct(at)" aria-hidden="true">
                            <span class="slot-marker-label">@SlotLabel(slot.Before)</span>
                        </span>
                    }
                    @if (dropLane)
                    {
                        <div class="drop-lane @(ghost is not null ? "is-active" : "") @(ghost?.Error is not null ? "is-refused" : "")"
                             style="top:@(laneCount * LaneHeight + ghostLaneCount * GhostLaneHeight + 4)px">
                            @if (ghost is null)
                            {
                                <span class="drop-lane-hint">
                                    @(line.IsGroup
                                        ? $"Drop {Controller.DraggingWorkOrder!.OrderNumber} here to plan it to {line.Code} in a window"
                                        : $"Drop {Controller.DraggingWorkOrder!.OrderNumber} here to see where it lands")
                                </span>
                            }
                            else if (ghost.IsLoading)
                            {
                                <span class="ghost ghost-new ghost-loading" style="left:@Pct(SlotPercent(line, ghost.BeforeJobId) ?? 0);width:12%">Projecting…</span>
                            }
                            else
                            {
                                @foreach (var part in ghost.Segments.Where(p => _scale.IsVisible(p.Segment.Start, p.Segment.End > p.Segment.Start ? p.Segment.End : p.Segment.Start.AddTicks(1))))
                                {
                                    var s = part.Segment;
                                    <div class="ghost @(part.IsNew ? "ghost-new" : "ghost-moved") @(s.Kind != "job" ? "ghost-changeover" : "") @(part.IsNew && ghost.IsLate ? "is-late" : "") @(part.IsNew && ghost.IsOverlapping ? "is-overlap" : "")"
                                         @key="part.Key" style="left:@Pct(_scale.Percent(s.Start));width:@Pct(_scale.Width(s.Start, s.End))"
                                         title="@GhostTitle(part)">
                                        @if (s.Kind != "job")
                                        {
                                            <span class="bar-title">Changeover</span>
                                        }
                                        else if (part.IsNew)
                                        {
                                            <span class="bar-title">@s.JobNumber</span>
                                            <span class="bar-sub">@ScheduleFormat.Qty(s.PlannedQty, s.UomCode) · @ScheduleFormat.Duration(s.End - s.Start)</span>
                                        }
                                        else
                                        {
                                            <span class="bar-title">@s.JobNumber</span>
                                            <span class="bar-sub">+@ScheduleFormat.Duration(part.Delay)</span>
                                        }
                                    </div>
                                }
                                @if (ghost.Job is { } job && !_scale.IsVisible(ghost.Changeover?.Start ?? job.Start, job.End))
                                {
                                    <span class="ghost-offscreen @(job.Start >= _scale.End ? "is-later" : "")">
                                        @(job.Start >= _scale.End ? "Lands later →" : "← Lands earlier")
                                    </span>
                                }
                            }
                            @if (ghost is { IsLoading: false })
                            {
                                <span class="drop-lane-caption @(ghost.Error is not null ? "is-refused" : "")">@ghost.Summary(Tz)</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<ul class="legend" aria-label="Legend">
    <li><span class="swatch swatch-planned"></span>Planned</li>
    <li><span class="swatch swatch-dispatched"></span>Dispatched</li>
    <li><span class="swatch swatch-firmed"></span>Firmed</li>
    <li><span class="swatch swatch-running"></span>Running</li>
    <li><span class="swatch swatch-changeover"></span>Changeover</li>
    <li><span class="swatch swatch-overlap"></span>Overlap</li>
    <li><span class="swatch swatch-late"></span>Late</li>
    <li><span class="swatch swatch-window"></span>Department window</li>
    <li><span class="swatch swatch-ghost"></span>Could run here</li>
</ul>

@code {
    private const int LaneHeight = 40;
    private const int DropLaneHeight = 62;
    private const int GhostLaneHeight = 36;
    private static readonly (int Days, string Label)[] Zooms = [(1, "Day"), (3, "3 days"), (7, "Week"), (14, "2 weeks")];

    [Parameter, EditorRequired]
    public ScheduleController Controller { get; set; } = null!;

    [Parameter]
    public (Guid JobId, string Kind)? Selected { get; set; }

    [Parameter]
    public EventCallback<BoardItem> OnSelect { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSelectWorkOrder { get; set; }

    [Parameter]
    public EventCallback<DateTimeOffset> OnHorizon { get; set; }

    /// <summary>An order was dropped on a group at a time: the page asks for its window (D-022).</summary>
    [Parameter]
    public EventCallback<(WorkOrderDto WorkOrder, Guid GroupId, DateTimeOffset At)> OnPlanToGroup { get; set; }

    private int _days = 3;
    private DateTimeOffset _from;
    private GanttScale _scale = new(DateTimeOffset.UnixEpoch, TimeSpan.FromDays(1), null);
    private IReadOnlyList<GanttTick> _ticks = [];
    private bool _initialized;

    // Drag state driven from js/ui.js: the slot under the pointer and the preview for it. Previews
    // are kept per slot for the order being dragged, so moving back and forth costs no new reads.
    private ElementReference _gantt;
    private DotNetObjectReference<GanttView>? _self;
    private IJSObjectReference? _dragHandle;
    private (Guid Line, Guid? Before)? _slot;
    private PlacementGhost? _ghost;
    private readonly Dictionary<(Guid Line, Guid? Before), PlacementGhost> _ghosts = [];
    private Guid? _ghostsFor;
    private CancellationTokenSource? _previewCts;

    private string? Tz => Controller.TimeZone;

    private IReadOnlyList<WorkOrderDto> Unscheduled => Controller.Board.Unscheduled();

    protected override void OnParametersSet()
    {
        if (!_initialized)
        {
            _from = Recent();
            _initialized = true;
        }

        var span = TimeSpan.FromDays(_days);
        if (_scale.Start != _from || _scale.Span != span || _scale.TimeZone != Tz)
        {
            _scale = new GanttScale(_from, span, Tz);
            _ticks = _scale.Ticks();
        }
    }

    private Task ShiftAsync(int direction) => MoveWindowAsync(_from.AddDays(direction * _days));

    private Task TodayAsync() => MoveWindowAsync(Recent());

    /// <summary>The window opens a couple of hours back, on the hour, so what is running now sits near the left edge.</summary>
    private DateTimeOffset Recent()
    {
        var now = Controller.Now;
        return new DateTimeOffset(now.Year, now.Month, now.Day, now.Hour, 0, 0, now.Offset).AddHours(-2);
    }

    private Task ZoomAsync(int days)
    {
        _days = days;
        return MoveWindowAsync(_from);
    }

    private async Task MoveWindowAsync(DateTimeOffset from)
    {
        _from = from;
        OnParametersSet();
        await OnHorizon.InvokeAsync(_scale.End);
    }

    /// <summary>A zero-length segment (no duration known yet) still shows as a sliver at its start.</summary>
    private bool IsVisible(BoardItem item) =>
        _scale.IsVisible(item.Segment.Start, item.Segment.End > item.Segment.Start ? item.Segment.End : item.Segment.Start.AddTicks(1));

    /// <summary>A placeholder has nothing to edit, so selecting it opens the job it precedes.</summary>
    private Task Select(BoardItem item) =>
        OnSelect.InvokeAsync(item.IsPlaceholder && Controller.Board.Find(item.JobId) is { } job ? job : item);

    private bool CanDropOn(BoardLine line) => Controller switch
    {
        { DraggingWorkOrder: not null } => true,
        { DraggingItem: { } item } => Controller.Board.CanDrop(item, line),
        _ => true,
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _dragHandle = await JS.InvokeAsync<IJSObjectReference>("pulaski.gantt.attach", _gantt, _self);
        }
    }

    /// <summary>The pointer moved to another slot (or off the lines: null). Shows the order's preview there.</summary>
    [JSInvokable]
    public async Task OnDragSlot(string? lineId, string? beforeJobId)
    {
        _previewCts?.Cancel();
        _slot = Guid.TryParse(lineId, out var line) ? (line, Guid.TryParse(beforeJobId, out var before) ? before : null) : null;

        if (_slot is not { } slot || Controller.DraggingWorkOrder is not { } workOrder)
        {
            _ghost = null;
            StateHasChanged();
            return;
        }

        // A group takes a window, not a slot: nothing to project until the planner picks the dates.
        if (Controller.Board.FindLine(slot.Line) is { IsGroup: true } group)
        {
            _ghost = PlacementGhost.Hint(slot.Line, $"Drop to plan {workOrder.OrderNumber} to {group.Code}; you'll set its window next.");
            StateHasChanged();
            return;
        }

        if (_ghostsFor != workOrder.Id)
        {
            _ghosts.Clear();
            _ghostsFor = workOrder.Id;
        }

        if (_ghosts.TryGetValue(slot, out var known))
        {
            _ghost = known;
            StateHasChanged();
            return;
        }

        _ghost = PlacementGhost.Loading(slot.Line, slot.Before);
        StateHasChanged();

        var cts = _previewCts = new CancellationTokenSource();
        PlacementGhost result;
        try
        {
            var preview = await Controller.PreviewPlacementAsync(workOrder, slot.Line, slot.Before, cts.Token);
            result = PlacementGhost.From(slot.Line, slot.Before, preview);
            _ghosts[slot] = result;
        }
        catch (ApiException ex)
        {
            result = PlacementGhost.Refused(slot.Line, slot.Before, ex.Detail ?? ex.Title);
            if (ex.Status != 0)
            {
                _ghosts[slot] = result;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_slot == slot)
        {
            _ghost = result;
            StateHasChanged();
        }
    }

    /// <summary>
    /// A drop on a line. <paramref name="payload"/> is what the browser says was dragged
    /// (<c>wo:&lt;id&gt;</c> or <c>job:&lt;key&gt;</c>), so the drop works even if the drag start
    /// never reached the server.
    /// </summary>
    [JSInvokable]
    public async Task OnDropSlot(string lineId, string? beforeJobId, string? payload, double percent)
    {
        var item = payload?.StartsWith("job:", StringComparison.Ordinal) == true
            ? Controller.Board.Items.FirstOrDefault(i => i.Key == payload[4..])
            : Controller.DraggingItem;
        var workOrder = payload?.StartsWith("wo:", StringComparison.Ordinal) == true && Guid.TryParse(payload[3..], out var woId)
            ? Controller.Board.FindWorkOrder(woId)
            : Controller.DraggingWorkOrder;
        var ghost = _ghost;
        Controller.EndDrag();
        ClearPreview();
        StateHasChanged();

        if (!Guid.TryParse(lineId, out var line))
        {
            return;
        }

        var before = Guid.TryParse(beforeJobId, out var b) ? b : (Guid?)null;
        var target = Controller.Board.FindLine(line);
        if (item is not null && target is not null)
        {
            if (!Controller.Board.CanDrop(item, target))
            {
                Controller.Toast("warning", RefusalFor(item, target));
                return;
            }

            await Controller.MoveJobAsync(item, line, before);
        }
        else if (workOrder is not null && target is { IsGroup: true })
        {
            await OnPlanToGroup.InvokeAsync((workOrder, line, _scale.At(percent / 100d)));
        }
        else if (workOrder is not null)
        {
            if (ghost?.Error is { } refused && ghost.LineId == line)
            {
                Controller.Toast("warning", refused);
                return;
            }

            await Controller.PlaceWorkOrderAsync(workOrder, line, before, Controller.Board.UnplacedQty(workOrder));
        }
    }

    private static string RefusalFor(BoardItem item, BoardLine target)
    {
        var s = item.Segment;
        var state = s.IsLocked ? "locked" : s.Status;
        return (item.IsFromGroup, target.IsGroup) switch
        {
            (true, true) => $"{s.JobNumber} can only go back to the group it was planned to.",
            (true, false) when !item.CanChangeLine => $"{s.JobNumber} can't move while it is {state}.",
            (true, false) => $"{target.Code} isn't a line of {s.JobNumber}'s group that can run it.",
            (false, true) => $"{s.JobNumber} was planned to a line. Plan a new job to {target.Code} from its work order instead.",
            _ when item.LineId == target.Id => $"{s.JobNumber} can't be resequenced while it is {state}.",
            _ => $"{s.JobNumber} can't change line while it is {state}.",
        };
    }

    /// <summary>'~10h on EXT-01 · window 2d' or the window's warning.</summary>
    private static string WindowSummary(BoardItem window)
    {
        var s = window.Segment;
        var fastest = s.Candidates.Where(c => c.Work is not null).OrderBy(c => c.Work).FirstOrDefault();
        var estimate = fastest is null ? "no line has a rate" : $"~{ScheduleFormat.Duration(fastest.Work!.Value)} on {fastest.LineCode}";
        return s.Warnings.Count > 0 ? $"{estimate} · {s.Warnings[0].Message}" : $"{estimate} · window {ScheduleFormat.Duration(s.End - s.Start)}";
    }

    private string GhostTitle(BoardItem window, CandidateLineDto candidate, BoardLine line)
    {
        var s = window.Segment;
        var estimate = candidate.Work is { } work ? $"about {ScheduleFormat.Duration(work)} on {line.Code}" : $"no run standard on {line.Code}";
        var fit = candidate.FitsWindow ? "fits its window" : "would not finish inside its window";
        return $"{s.JobNumber} could run here: {estimate}, {fit} ({ScheduleFormat.When(s.Start, Tz)} – {ScheduleFormat.When(s.End, Tz)}). Drag it onto a line to assign it.";
    }

    private void ClearPreview()
    {
        _previewCts?.Cancel();
        _slot = null;
        _ghost = null;
        _ghosts.Clear();
        _ghostsFor = null;
    }

    /// <summary>
    /// The jobs a drop can go in front of, in order, with each one's midpoint on the track (unclamped,
    /// so jobs outside the window still count): 'id@percent;...'. Read by js/ui.js during a drag.
    /// </summary>
    private string Slots(BoardLine line) => line.IsGroup ? "" : string.Join(';', Controller.Board.ItemsOn(line.Id)
        .Where(i => !i.IsPlaceholder && i.Segment.Status != "running")
        .OrderBy(i => i.Segment.Start)
        .Select(i => $"{i.JobId}@{_scale.RawPercent(i.Segment.Start + (i.Segment.End - i.Segment.Start) / 2).ToString("0.###", CultureInfo.InvariantCulture)}"));

    /// <summary>Where the insertion marker goes: the start of the job it goes before, or the end of the line's last job.</summary>
    private double? SlotPercent(BoardLine line, Guid? beforeJobId)
    {
        var items = Controller.Board.ItemsOn(line.Id);
        var at = beforeJobId is { } before
            ? items.Where(i => i.JobId == before).Select(i => (DateTimeOffset?)i.Segment.Start).Min()
            : items.Count > 0 ? items.Max(i => i.Segment.End) : Controller.Now;
        return at is { } time && _scale.IsVisible(time, time.AddTicks(1)) ? _scale.Percent(time) : null;
    }

    private string SlotLabel(Guid? beforeJobId) =>
        beforeJobId is { } before && Controller.Board.Find(before) is { } next ? $"Before {next.Segment.JobNumber}" : "At the end";

    private string GhostTitle(GhostSegment part)
    {
        var s = part.Segment;
        var when = $"{ScheduleFormat.When(s.Start, Tz)} – {ScheduleFormat.When(s.End, Tz)}";
        return part.IsNew
            ? (s.Kind == "job" ? $"{s.JobNumber}: {when}" : $"Changeover {s.FromMaterialCode} → {s.MaterialCode}: {when}")
            : $"{s.JobNumber} would move {ScheduleFormat.Duration(part.Delay)} later: {when}";
    }

    public async ValueTask DisposeAsync()
    {
        _previewCts?.Cancel();
        if (_dragHandle is not null)
        {
            try
            {
                await _dragHandle.InvokeVoidAsync("dispose");
                await _dragHandle.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone; nothing to detach.
            }
        }

        _self?.Dispose();
    }

    private string BarClasses(BoardItem item)
    {
        var s = item.Segment;
        var classes = new List<string> { item.IsPlaceholder ? "bar-placeholder" : $"bar-{s.Status}" };
        if (item.IsWindow) classes.Add("bar-window");
        if (item.IsWindow && s.Warnings.Any(w => w.Code is "window_too_short" or "window_passed" or "no_runner")) classes.Add("is-at-risk");
        if (item.IsPlaceholder || s.JobType == "changeover") classes.Add("bar-changeover");
        else if (s.JobType != "production") classes.Add("bar-activity");
        if (Selected == (item.JobId, s.Kind)) classes.Add("is-selected");
        if (Controller.Board.IsOverlapping(item)) classes.Add("is-overlap");
        if (s.Warnings.Any(w => w.Code == "late")) classes.Add("is-late");
        if (Controller.Saving.Contains(item.Key)) classes.Add("is-saving");
        if (Controller.Changed.Contains(item.Key)) classes.Add("is-updated");
        if (Controller.DraggingItem?.Key == item.Key) classes.Add("is-dragging");
        if (s.Start < _scale.Start) classes.Add("is-clipped-start");
        if (s.End > _scale.End) classes.Add("is-clipped-end");
        if (!item.CanChangeLine) classes.Add("is-fixed");
        return string.Join(' ', classes);
    }

    private string Describe(BoardItem item)
    {
        var s = item.Segment;
        var head = item.IsPlaceholder
            ? $"Changeover {s.FromMaterialCode} → {s.MaterialCode}"
            : $"{s.JobNumber} · {Display.Label(s.Status)}{(s.IsLocked ? " · locked" : "")}";
        var lines = new List<string>
        {
            head,
            $"{ScheduleFormat.When(s.Start, Tz)} – {ScheduleFormat.When(s.End, Tz)} ({ScheduleFormat.Duration(s.End - s.Start)})",
        };
        if (s.WorkOrderNumber is not null) lines.Add($"Work order {s.WorkOrderNumber}");
        if (s.RemainingQty is not null) lines.Add($"{ScheduleFormat.Qty(s.RemainingQty, s.UomCode)} to make");
        lines.AddRange(s.Warnings.Select(w => "⚠ " + w.Message));
        lines.AddRange(Controller.Board.OverlapsFor(item).Select(o => "⚠ " + o.Describe()));
        return string.Join('\n', lines);
    }

    private static string Pct(double value) => value.ToString("0.###", CultureInfo.InvariantCulture) + "%";

    private static async Task OnKey(KeyboardEventArgs e, Func<Task> action)
    {
        if (e.Key is "Enter" or " ")
        {
            await action();
        }
    }
}
