@page "/units"
@using System.Globalization
@inject PulaskiApiClient Api

<PageTitle>Units · Pulaski</PageTitle>

<div class="mb-3">
    <h1 class="mb-1">Units and conversions</h1>
    <p class="text-muted mb-0">
        Standard units convert within their dimension for every material. A material's own conversions link the rest:
        weight per metre, pieces per box, kilograms per bag.
    </p>
</div>

<ProblemAlert Error="_error" />

@if (_units is null || _materials is null)
{
    @if (_error is null)
    {
        <p class="text-muted">Loading…</p>
    }
}
else
{
    <div class="units-layout">
        @* ---- A material's own conversions ---- *@
        <section aria-labelledby="conversions-title">
            <h2 id="conversions-title" class="h5">Material conversions</h2>
            <div class="mb-3" style="max-width: 32rem">
                <label class="form-label" for="conv-material">Material</label>
                <select id="conv-material" class="form-select" value="@_materialId" @onchange="OnMaterialChangedAsync">
                    <option value="@Guid.Empty">Choose a material…</option>
                    @foreach (var m in _materials)
                    {
                        <option value="@m.Id">@m.Code · @m.Name (@m.BaseUomCode)</option>
                    }
                </select>
            </div>

            @if (Material is { } material)
            {
                <p class="small text-muted">
                    @material.Code is stocked in <strong>@material.BaseUomCode</strong>. Each line reads "1 of the first unit is this many of the second"
                    and works both ways.
                </p>

                <div class="table-panel mb-3">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Conversion</th><th class="text-end">And back</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in _conversions)
                            {
                                <tr @key="(c.FromUomId, c.ToUomId)">
                                    <td>1 <strong>@c.FromUomCode</strong> = @Plain(c.Factor) <strong>@c.ToUomCode</strong></td>
                                    <td class="text-end small text-muted">1 @c.ToUomCode = @Plain(Math.Round(1m / c.Factor, 6)) @c.FromUomCode</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" disabled="@_saving"
                                                @onclick="() => RemoveAsync(c)">Remove</button>
                                    </td>
                                </tr>
                            }
                            @if (_conversions.Count == 0)
                            {
                                <tr><td colspan="3" class="text-muted small">No conversions yet: @material.Code converts only between standard units of its own dimension.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <form class="d-flex flex-wrap gap-2 align-items-end mb-4" @onsubmit="SetAsync" @onsubmit:preventDefault>
                    <span class="pb-2">1</span>
                    <div>
                        <label class="form-label small" for="conv-from">Unit</label>
                        <select id="conv-from" class="form-select form-select-sm" @bind="_from">
                            @UnitOptions()
                        </select>
                    </div>
                    <span class="pb-2">=</span>
                    <div>
                        <label class="form-label small" for="conv-factor">Quantity</label>
                        <input id="conv-factor" type="number" min="0" step="any" class="form-control form-control-sm" style="width: 9rem" @bind="_factor" />
                    </div>
                    <div>
                        <label class="form-label small" for="conv-to">Unit</label>
                        <select id="conv-to" class="form-select form-select-sm" @bind="_to">
                            @UnitOptions()
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@(_saving || _factor is not > 0 || _from == Guid.Empty || _to == Guid.Empty)">
                        Save conversion
                    </button>
                </form>
            }

            <h3 class="h6">Try a conversion</h3>
            <form class="d-flex flex-wrap gap-2 align-items-end" @onsubmit="TryAsync" @onsubmit:preventDefault>
                <div>
                    <label class="form-label small" for="try-qty">Quantity</label>
                    <input id="try-qty" type="number" step="any" class="form-control form-control-sm" style="width: 9rem" @bind="_tryQty" />
                </div>
                <div>
                    <label class="form-label small" for="try-from">From</label>
                    <select id="try-from" class="form-select form-select-sm" @bind="_tryFrom">@UnitOptions()</select>
                </div>
                <div>
                    <label class="form-label small" for="try-to">To</label>
                    <select id="try-to" class="form-select form-select-sm" @bind="_tryTo">@UnitOptions()</select>
                </div>
                <button type="submit" class="btn btn-outline-primary btn-sm" disabled="@(_tryFrom == Guid.Empty || _tryTo == Guid.Empty)">Convert</button>
            </form>
            @if (_tryResult is { } result)
            {
                <p class="mt-2 @(result.Converts ? "" : "text-warning-strong")" role="status">
                    @if (result.Converts)
                    {
                        <span>@Plain(_tryQty) @Code(_tryFrom) = <strong>@Plain(result.Quantity!.Value) @Code(_tryTo)</strong>@(Material is { } m ? $" of {m.Code}" : "")</span>
                    }
                    else
                    {
                        @result.Message
                    }
                </p>
            }
        </section>

        @* ---- The unit catalog ---- *@
        <section aria-labelledby="units-title">
            <div class="d-flex justify-content-between align-items-center">
                <h2 id="units-title" class="h5 mb-0">Units</h2>
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => _adding = !_adding">New unit</button>
            </div>

            @if (_adding)
            {
                <form class="d-flex flex-wrap gap-2 align-items-end my-3" @onsubmit="CreateAsync" @onsubmit:preventDefault>
                    <div>
                        <label class="form-label small" for="new-code">Code</label>
                        <input id="new-code" class="form-control form-control-sm" style="width: 6rem" maxlength="20" @bind="_newCode" />
                    </div>
                    <div>
                        <label class="form-label small" for="new-name">Name</label>
                        <input id="new-name" class="form-control form-control-sm" maxlength="100" @bind="_newName" />
                    </div>
                    <div>
                        <label class="form-label small" for="new-dimension">Kind</label>
                        <select id="new-dimension" class="form-select form-select-sm" @bind="_newDimension">
                            @foreach (var dimension in Dimensions)
                            {
                                <option value="@dimension.Code">@dimension.Label</option>
                            }
                        </select>
                    </div>
                    @if (_newDimension != "other")
                    {
                        <div>
                            <label class="form-label small" for="new-factor">1 of it is how many @BaseCode(_newDimension)</label>
                            <input id="new-factor" type="number" min="0" step="any" class="form-control form-control-sm" style="width: 10rem" @bind="_newFactor" />
                        </div>
                    }
                    <button type="submit" class="btn btn-primary btn-sm"
                            disabled="@(_saving || string.IsNullOrWhiteSpace(_newCode) || string.IsNullOrWhiteSpace(_newName) || (_newDimension != "other" && _newFactor is not > 0))">
                        Create
                    </button>
                    <div class="w-100 small text-muted">The code, kind and factor can't change later, because quantities are stored in the unit.</div>
                </form>
            }

            @foreach (var group in _units.GroupBy(u => u.Dimension))
            {
                <h3 class="h6 mt-3 mb-1">@DimensionLabel(group.Key)</h3>
                <div class="table-panel">
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                            @foreach (var u in group)
                            {
                                <tr @key="u.Id" class="@(u.IsActive ? "" : "text-muted")">
                                    <td style="width: 5rem"><strong>@u.Code</strong></td>
                                    <td>
                                        <input class="form-control form-control-sm border-0 bg-transparent p-0" aria-label="Name of @u.Code"
                                               value="@u.Name" @onchange="e => RenameAsync(u, e.Value?.ToString())" />
                                    </td>
                                    <td class="small text-nowrap text-end">
                                        @(u.ToBaseFactor is { } f ? (f == 1m ? "base unit" : $"= {Plain(f)} {u.BaseCode}") : "per material")
                                    </td>
                                    <td style="width: 6rem">
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="active-@u.Id" checked="@u.IsActive"
                                                   @onchange="e => SetActiveAsync(u, e.Value is true)" />
                                            <label class="form-check-label small" for="active-@u.Id">Active</label>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
}

@code {
    private static readonly (string Code, string Label)[] Dimensions =
    [
        ("mass", "Mass"), ("length", "Length"), ("area", "Area"), ("volume", "Volume"),
        ("count", "Count"), ("time", "Time"), ("other", "Packaging (per material)"),
    ];

    [SupplyParameterFromQuery(Name = "material")]
    public Guid? MaterialParam { get; set; }

    private IReadOnlyList<UomDto>? _units;
    private IReadOnlyList<MaterialDto>? _materials;
    private IReadOnlyList<MaterialConversionDto> _conversions = [];
    private Guid _materialId;
    private Guid _from;
    private Guid _to;
    private decimal? _factor;
    private decimal _tryQty = 1m;
    private Guid _tryFrom;
    private Guid _tryTo;
    private UnitConversionResultDto? _tryResult;
    private bool _adding;
    private string _newCode = "";
    private string _newName = "";
    private string _newDimension = "mass";
    private decimal? _newFactor;
    private bool _saving;
    private ApiException? _error;

    private MaterialDto? Material => _materials?.FirstOrDefault(m => m.Id == _materialId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _units = await Api.ListUomsAsync();
            _materials = await Api.ListMaterialsAsync();
            if (MaterialParam is { } materialId && _materials.Any(m => m.Id == materialId))
            {
                await SelectMaterialAsync(materialId);
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private RenderFragment UnitOptions() => __builder =>
    {
        <option value="@Guid.Empty">Unit…</option>
        @foreach (var u in _units!.Where(u => u.IsActive))
        {
            <option value="@u.Id">@u.Code · @u.Name</option>
        }
    };

    private string Code(Guid id) => _units?.FirstOrDefault(u => u.Id == id)?.Code ?? "?";

    private string? BaseCode(string dimension) => _units?.FirstOrDefault(u => u.Dimension == dimension && u.ToBaseFactor == 1m)?.Code;

    private static string DimensionLabel(string dimension) => Dimensions.FirstOrDefault(d => d.Code == dimension).Label ?? dimension;

    private static string Plain(decimal value) => value.ToString("0.######", CultureInfo.InvariantCulture);

    private async Task OnMaterialChangedAsync(ChangeEventArgs e) =>
        await SelectMaterialAsync(Guid.TryParse(e.Value?.ToString(), out var id) ? id : Guid.Empty);

    private async Task SelectMaterialAsync(Guid materialId)
    {
        _materialId = materialId;
        _conversions = [];
        _tryResult = null;
        _error = null;
        if (Material is { } material)
        {
            _conversions = await Api.ListMaterialConversionsAsync(materialId);
            _to = material.BaseUomId;
            _tryTo = material.BaseUomId;
        }
    }

    private async Task SetAsync()
    {
        await RunAsync(async () =>
        {
            await Api.SetMaterialConversionAsync(_materialId, new SetMaterialConversionRequest { FromUomId = _from, ToUomId = _to, Factor = _factor!.Value });
            _conversions = await Api.ListMaterialConversionsAsync(_materialId);
            _factor = null;
        });
    }

    private Task RemoveAsync(MaterialConversionDto conversion) => RunAsync(async () =>
    {
        await Api.RemoveMaterialConversionAsync(_materialId, conversion.FromUomId, conversion.ToUomId);
        _conversions = await Api.ListMaterialConversionsAsync(_materialId);
    });

    private Task TryAsync() => RunAsync(async () =>
        _tryResult = await Api.ConvertAsync(_tryQty, _tryFrom, _tryTo, _materialId == Guid.Empty ? null : _materialId));

    private Task CreateAsync() => RunAsync(async () =>
    {
        await Api.CreateUomAsync(new CreateUomRequest
        {
            Code = _newCode,
            Name = _newName,
            Dimension = _newDimension,
            ToBaseFactor = _newDimension == "other" ? null : _newFactor,
        });
        _units = await Api.ListUomsAsync();
        (_newCode, _newName, _newFactor, _adding) = ("", "", null, false);
    });

    private Task RenameAsync(UomDto unit, string? name) => string.IsNullOrWhiteSpace(name) || name == unit.Name
        ? Task.CompletedTask
        : UpdateAsync(unit, name.Trim(), unit.IsActive);

    private Task SetActiveAsync(UomDto unit, bool active) => UpdateAsync(unit, unit.Name, active);

    private Task UpdateAsync(UomDto unit, string name, bool active) => RunAsync(async () =>
    {
        try
        {
            await Api.UpdateUomAsync(unit.Id, new UpdateUomRequest { Version = unit.Version, Name = name, IsActive = active });
        }
        finally
        {
            // Show what is stored now, whether the change went through or someone else's did.
            _units = await Api.ListUomsAsync();
        }
    });

    private async Task RunAsync(Func<Task> action)
    {
        _saving = true;
        _error = null;
        try
        {
            await action();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }
}
