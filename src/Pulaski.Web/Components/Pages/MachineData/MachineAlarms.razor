@using System.Globalization
@using Pulaski.Web.Services.MachineData
@inject PulaskiApiClient Api
@inject TimeProvider Clock

@* Alarms and warnings (#26): what the machines raised in a period, active ones first. Apart from states and stops. *@
<div class="inv-toolbar flex-wrap">
    <select class="form-select w-auto" aria-label="Equipment" value="@(_equipment?.ToString() ?? "")" @onchange="OnEquipmentChangedAsync">
        <option value="">All equipment</option>
        @foreach (var m in Machines)
        {
            <option value="@m.EquipmentId">@m.Code · @m.Name</option>
        }
    </select>
    <select class="form-select w-auto" aria-label="Period" value="@_hours" @onchange="OnPeriodChangedAsync">
        <option value="8">Last 8 hours</option>
        <option value="24">Last 24 hours</option>
        <option value="168">Last 7 days</option>
    </select>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="alarms-active" checked="@_activeOnly" @onchange="OnActiveChangedAsync" />
        <label class="form-check-label" for="alarms-active">Only active ones</label>
    </div>
    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_loading" @onclick="LoadAsync">Refresh</button>
</div>

<ProblemAlert Error="_error" />
@if (_list is null)
{
    <p class="text-muted">Loading…</p>
}
else if (_list.Alarms.Count == 0)
{
    <div class="empty-panel">
        <p class="text-muted mb-0">@(_activeOnly ? "No alarm or warning is active." : "No alarms or warnings in this period.") Bind a machine's alarm and warning tags on its edge node to record them.</p>
    </div>
}
else
{
    <div class="table-panel">
        <table class="table align-middle">
            <thead><tr><th>Raised</th><th>Cleared</th><th class="inv-num">Duration</th><th>Equipment</th><th>Kind</th><th class="inv-num">Number</th><th>Message</th><th>Tag</th></tr></thead>
            <tbody>
                @foreach (var a in _list.Alarms)
                {
                    <tr @key="a.Id" class="@(a.ClearedAt is null ? "" : "text-muted")">
                        <td class="text-nowrap">@Display.SiteTime(a.RaisedAt, TimeZone)</td>
                        <td class="text-nowrap">@if (a.ClearedAt is { } cleared) { @Display.SiteTime(cleared, TimeZone) } else { <span class="chip chip-danger">active</span> }</td>
                        <td class="inv-num">@MachineView.Duration(TimeSpan.FromSeconds(a.DurationSeconds))</td>
                        <td class="fw-semibold">@a.EquipmentCode</td>
                        <td><span class="chip @(a.Kind == "alarm" ? "chip-danger" : "chip-warning")">@(a.Kind == "alarm" ? "Alarm" : "Warning")</span></td>
                        <td class="inv-num">@a.Number</td>
                        <td>@(a.Message ?? "No message in the machine profile")</td>
                        <td class="small text-muted"><code>@a.Address</code></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (_list.IsTruncated)
    {
        <p class="small text-muted" role="status">Showing the first @_list.Alarms.Count; there are more. Narrow the period or the equipment.</p>
    }
}

@code {
    [Parameter, EditorRequired]
    public Guid SiteId { get; set; }

    [Parameter]
    public string? TimeZone { get; set; }

    [Parameter]
    public IReadOnlyList<MachineStatusDto> Machines { get; set; } = [];

    private AlarmListDto? _list;
    private Guid? _equipment;
    private int _hours = 24;
    private bool _activeOnly;
    private bool _loading;
    private ApiException? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task OnEquipmentChangedAsync(ChangeEventArgs e)
    {
        _equipment = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await LoadAsync();
    }

    private async Task OnPeriodChangedAsync(ChangeEventArgs e)
    {
        _hours = int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var hours) ? hours : 24;
        await LoadAsync();
    }

    private async Task OnActiveChangedAsync(ChangeEventArgs e)
    {
        _activeOnly = e.Value is true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var now = Clock.GetUtcNow();
            _list = await Api.ListAlarmsAsync(SiteId, now.AddHours(-_hours), now.AddMinutes(1), _equipment, _activeOnly);
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _loading = false;
        }
    }
}
