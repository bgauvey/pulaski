@page "/edge-nodes/{NodeId:guid}"
@attribute [RequiresView(PermissionCodes.EquipmentView)]
@using Pulaski.Web.Services.MachineData
@inject PulaskiApiClient Api
@inject CurrentUser User
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* One edge node (D-050): its connections, the tags binding what it reads to equipment, the addresses it has seen, what its
   machines last reported, and how to set the edge itself up. *@
<PageTitle>@(_detail?.Node.Code ?? L["Edge node"]) · Pulaski</PageTitle>

<div class="inv-head">
    <div>
        <div class="small mb-1"><a href="edge-nodes">@L["← Edge nodes"]</a></div>
        <h1 class="mb-1">
            @(_detail?.Node.Code ?? L["Edge node"])
            @if (_detail?.Node is { } head)
            {
                @if (!head.IsActive)
                {
                    <span class="chip chip-muted ms-2 align-middle">@L["Inactive"]</span>
                }
                else if (EdgeView.IsQuiet(head.LastSeenAt, DateTimeOffset.UtcNow))
                {
                    <span class="chip chip-warning ms-2 align-middle" title="@L["Nothing forwarded for 2 minutes: the edge is offline, or nothing changed"]">@L["Quiet"]</span>
                }
                else
                {
                    <span class="chip ms-2 align-middle">@L["Forwarding"]</span>
                }
            }
        </h1>
        <p class="text-muted mb-0">
            @_detail?.Node.Name
            @if (_detail?.Node is { } n)
            {
                <span> · @L["last heard from {0}", EdgeView.LastHeard(L, n.LastSeenAt, DateTimeOffset.UtcNow, null)]@(n.AgentVersion is null ? "" : L[" · version {0}", n.AgentVersion])</span>
            }
        </p>
    </div>
    <div class="inv-head-tools">
        @if (CanManage && _detail is not null)
        {
            <button type="button" class="btn btn-outline-danger" disabled="@_saving" @onclick="DeleteNodeAsync">@L["Delete"]</button>
        }
        <button type="button" class="btn btn-outline-secondary btn-with-icon" @onclick="LoadAsync"><Icon Name="refresh" Size="16" />@L["Refresh"]</button>
    </div>
</div>

<ProblemAlert Error="_error" />
@if (_notice is not null)
{
    <div class="alert alert-success" role="status">@_notice</div>
}

@if (_detail is null)
{
    @if (_error is null)
    {
        <p class="text-muted">@L["Loading…"]</p>
    }
}
else
{
    <ViewOnlyNote Permission="@PermissionCodes.Equipment" What="@L["maintain edge nodes"]" SiteId="_detail.Node.SiteId" />

    <fieldset class="view-only-scope" disabled="@(!CanManage)">
        <form class="inv-toolbar" @onsubmit="SaveNodeAsync" @onsubmit:preventDefault>
            <input class="form-control inv-grow" maxlength="100" aria-label="@L["Name"]" placeholder="@L["Name"]" @bind="_name" />
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="node-active" @bind="_active" />
                <label class="form-check-label" for="node-active">@L["Active"]</label>
            </div>
            <button type="submit" class="btn btn-outline-primary" disabled="@(_saving || (_name?.Trim() == _detail.Node.Name && _active == _detail.Node.IsActive))">@L["Save"]</button>
        </form>
    </fieldset>

    <nav class="inv-tabs" aria-label="@L["Edge node"]">
        @foreach (var (tab, label, count) in Tabs())
        {
            <button type="button" class="inv-tab btn btn-link @(_tab == tab ? "active" : "")" @onclick="() => _tab = tab">
                @label @if (count is { } c) { <span class="small text-muted">@c</span> }
            </button>
        }
    </nav>

    <fieldset class="view-only-scope" disabled="@(!CanManage)">
        @switch (_tab)
        {
            case "connections":
                <p class="small text-muted">
                    @L["Where the edge reads from: an MQTT broker its machines publish to in Sparkplug B (Pulaski listens as a Sparkplug host application), an OPC UA server, or an EtherNet/IP PLC. Passwords aren't kept here; they go in the edge's own configuration (Setup)."]
                </p>
                @if (CanManage)
                {
                    <form class="inv-toolbar flex-wrap" @onsubmit="AddConnectionAsync" @onsubmit:preventDefault>
                        <input class="form-control" style="width: 8rem" maxlength="20" placeholder="@L["CODE"]" aria-label="@L["Connection code"]" @bind="_connCode" @bind:event="oninput" />
                        <input class="form-control" style="width: 12rem" maxlength="100" placeholder="@L["Name, e.g. Line broker"]" aria-label="@L["Connection name"]" @bind="_connName" @bind:event="oninput" />
                        <select class="form-select w-auto" aria-label="@L["Protocol"]" value="@_connProtocol" @onchange="@(e => (_connProtocol, _connSettings) = (Text(e), []))">
                            @foreach (var (protocol, label) in EdgeView.Protocols)
                            {
                                <option value="@protocol">@label</option>
                            }
                        </select>
                        @SettingsFields(_connProtocol, _connSettings, (key, value) => _connSettings[key] = value, "new", small: false)
                        <button type="submit" class="btn btn-primary" disabled="@(_saving || string.IsNullOrWhiteSpace(_connCode) || string.IsNullOrWhiteSpace(_connName))">@L["Add connection"]</button>
                    </form>
                }

                @if (_detail.Connections.Count == 0)
                {
                    <div class="empty-panel"><p class="text-muted mb-0">@L["No connections yet. Add the broker, server or PLC your machines are read through."]</p></div>
                }
                else
                {
                    <div class="table-panel">
                        <table class="table align-middle">
                            <thead>
                                <tr><th>@L["Code"]</th><th>@L["Name"]</th><th>@L["Protocol"]</th><th>@L["Settings"]</th><th>@L["Active"]</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in _detail.Connections)
                                {
                                    var edit = ConnectionEdit(c);
                                    <tr @key="c.Id" class="@(c.IsActive ? "" : "text-muted")">
                                        <td class="fw-semibold">@c.Code</td>
                                        <td><input class="form-control form-control-sm" style="min-width: 10rem" maxlength="100" aria-label="@L["Name of {0}", c.Code]" value="@edit.Name" @onchange="e => ChangeConnection(c, x => x with { Name = Text(e) })" /></td>
                                        <td class="small">@EdgeView.ProtocolLabel(c.Protocol)</td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                                @SettingsFields(c.Protocol, edit.Settings, (key, value) => ChangeConnection(c, x => x with { Settings = With(x.Settings, key, value) }), c.Code, small: true)
                                            </div>
                                        </td>
                                        <td><input class="form-check-input" type="checkbox" aria-label="@c.Code active" checked="@edit.IsActive" @onchange="e => ChangeConnection(c, x => x with { IsActive = e.Value is true })" /></td>
                                        <td class="text-end">
                                            @if (_connEdits.ContainsKey(c.Id))
                                            {
                                                <button type="button" class="btn btn-sm btn-primary" disabled="@_saving" @onclick="() => SaveConnectionAsync(c)">@L["Save"]</button>
                                                <button type="button" class="btn btn-sm btn-link" @onclick="() => _connEdits.Remove(c.Id)">@L["Undo"]</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                break;

            case "tags":
                <p class="small text-muted">
                    @L["Which signal means what on which equipment. A Sparkplug B address is"] <code>group/node[/device]:metric</code>@L[", an OPC UA address a node id"]
                    (<code>ns=2;s=Line1.State</code>@L["), an EtherNet/IP address a tag name with its type ("]<code>Program:Main.State|dint</code>@L["); the easiest way to bind one is from"] <strong>@L["Seen"]</strong>@L[". Counts and process values are multiplied by the scale; a counter that wraps needs its rollover value; a process value is recorded when it moves by more than its deadband (in scaled units), and at least once a minute while it holds. An alarm or warning tag carries the number of the active one (0 for none); a machine may have several."]
                </p>
                @if (CanManage && _detail.Connections.Count > 0)
                {
                    @BindForm(null)
                }

                @if (_detail.Tags.Count == 0)
                {
                    <div class="empty-panel"><p class="text-muted mb-0">@L["No tags yet."]</p></div>
                }
                else
                {
                    <div class="table-panel">
                        <table class="table align-middle">
                            <thead><tr><th>@L["Equipment"]</th><th>@L["Role"]</th><th>@L["Connection"]</th><th>@L["Address"]</th><th>@L["Scale"]</th><th>@L["Rollover or deadband"]</th><th>@L["Last value"]</th><th>@L["Active"]</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var t in _detail.Tags)
                                {
                                    var edit = TagEdit(t);
                                    <tr @key="t.Id" class="@(t.IsActive ? "" : "text-muted")">
                                        <td class="fw-semibold">@t.EquipmentCode</td>
                                        <td>@L.Of(EdgeView.RoleLabel(t.Role))</td>
                                        <td>@t.ConnectionCode</td>
                                        <td><input class="form-control form-control-sm" style="min-width: 16rem" aria-label="@L["Address of {0} {1}", t.EquipmentCode, t.Role]" value="@edit.Address" @onchange="e => ChangeTag(t, x => x with { Address = Text(e) })" /></td>
                                        <td><input class="form-control form-control-sm text-end" style="width: 6rem" aria-label="@L["Scale of {0} {1}", t.EquipmentCode, t.Role]" value="@EdgeView.Number(edit.ScaleFactor)" @onchange="e => ChangeTag(t, x => x with { ScaleFactor = Dec(e) ?? x.ScaleFactor })" /></td>
                                        <td>
                                            @if (EdgeView.IsCounter(t.Role))
                                            {
                                                <input class="form-control form-control-sm text-end" style="width: 8rem" aria-label="@L["Rollover of {0} {1}", t.EquipmentCode, t.Role]" placeholder="@L["none"]" value="@edit.CounterRollover"
                                                       @onchange="e => ChangeTag(t, x => x with { CounterRollover = long.TryParse(Text(e), out var r) ? r : null })" />
                                            }
                                            else if (EdgeView.HasDeadband(t.Role))
                                            {
                                                <input class="form-control form-control-sm text-end" style="width: 8rem" aria-label="@L["Deadband of {0} {1}", t.EquipmentCode, t.Address]" placeholder="@L["none"]"
                                                       value="@(edit.Deadband is { } band ? EdgeView.Number(band) : "")" @onchange="e => ChangeTag(t, x => x with { Deadband = Dec(e) })" />
                                            }
                                        </td>
                                        <td class="small">@t.LastValue @if (t.LastSeenAt is { } seen) { <span class="text-muted">· @EdgeView.LastHeard(L, seen, DateTimeOffset.UtcNow, null)</span> }</td>
                                        <td><input class="form-check-input" type="checkbox" aria-label="@t.EquipmentCode @t.Role active" checked="@edit.IsActive" @onchange="e => ChangeTag(t, x => x with { IsActive = e.Value is true })" /></td>
                                        <td class="text-end">
                                            @if (_tagEdits.ContainsKey(t.Id))
                                            {
                                                <button type="button" class="btn btn-sm btn-primary" disabled="@_saving" @onclick="() => SaveTagAsync(t)">@L["Save"]</button>
                                                <button type="button" class="btn btn-sm btn-link" @onclick="() => _tagEdits.Remove(t.Id)">@L["Undo"]</button>
                                            }
                                            @if (CanManage)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger ms-1" disabled="@_saving" @onclick="() => DeleteTagAsync(t)">@L["Delete"]</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                break;

            case "seen":
                <p class="small text-muted">
                    @L["Everything the edge's connections have announced (Sparkplug birth certificates) or sent, with its last value. Pick one to bind it to equipment. The edge reports what it sees every 30 seconds."]
                </p>
                @if (_binding is { } address && CanManage)
                {
                    @BindForm(address)
                }

                @if (_detail.Metrics.Count == 0)
                {
                    <div class="empty-panel"><p class="text-muted mb-0">@L["Nothing seen yet. Once the edge runs and a machine publishes, its metrics appear here."]</p></div>
                }
                else
                {
                    <input type="search" class="form-control mb-2" style="max-width: 24rem" placeholder="@L["Filter addresses"]" aria-label="@L["Filter addresses"]" @bind="_filter" @bind:event="oninput" />
                    <div class="table-panel">
                        <table class="table table-sm align-middle">
                            <thead><tr><th>@L["Connection"]</th><th>@L["Address"]</th><th>@L["Type"]</th><th>@L["Last value"]</th><th>@L["Seen"]</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var m in _detail.Metrics.Where(m => string.IsNullOrWhiteSpace(_filter) || m.Address.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)))
                                {
                                    <tr @key="(m.ConnectionId, m.Address)">
                                        <td>@ConnectionCode(m.ConnectionId)</td>
                                        <td><code>@m.Address</code></td>
                                        <td class="small">@m.DataType</td>
                                        <td>@m.LastValue</td>
                                        <td class="small text-muted">@EdgeView.LastHeard(L, m.LastSeenAt, DateTimeOffset.UtcNow, null)</td>
                                        <td class="text-end">
                                            @if (m.TagId is { } tagId)
                                            {
                                                var tag = _detail.Tags.FirstOrDefault(t => t.Id == tagId);
                                                <span class="small text-muted">@tag?.EquipmentCode · @L.Of(EdgeView.RoleLabel(tag?.Role ?? ""))</span>
                                            }
                                            else if (CanManage)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => StartBind(m)">@L["Bind"]</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                break;

            case "live":
                <p class="small text-muted">
                    @L["What each machine bound here last reported, as Pulaski applied it: its PackML state (and the value the machine sent), unit mode, latched stop code and speed. The machines' stops are coded on Operate → Machines."]
                </p>
                @if (_detail.Live.Count == 0)
                {
                    <div class="empty-panel"><p class="text-muted mb-0">@L["Nothing received yet."]</p></div>
                }
                else
                {
                    <div class="table-panel">
                        <table class="table align-middle">
                            <thead><tr><th>@L["Equipment"]</th><th>@L["State"]</th><th>@L["Since"]</th><th>@L["Mode"]</th><th>@L["Stop code"]</th><th>@L["Speed"]</th><th>@L["Last signal"]</th></tr></thead>
                            <tbody>
                                @foreach (var l in _detail.Live)
                                {
                                    <tr @key="l.EquipmentId">
                                        <td class="fw-semibold">@l.EquipmentCode</td>
                                        <td>
                                            <span class="chip @(l.PackMlState == 6 ? "" : l.PackMlState == 0 ? "chip-muted" : "chip-warning")">@l.PackMlState · @l.PackMlName</span>
                                            @if (l.RawState is { } raw && raw != l.PackMlState)
                                            {
                                                <span class="small text-muted ms-1">@L["sent {0}", raw]</span>
                                            }
                                        </td>
                                        <td class="small">@EdgeView.LastHeard(L, l.StateSince, DateTimeOffset.UtcNow, null)</td>
                                        <td>@l.UnitMode</td>
                                        <td>@(l.StopReason is { } code ? $"{code}{(l.StopReasonText is null ? "" : " · " + l.StopReasonText)}" : "")</td>
                                        <td>@(l.MachineSpeed is { } s ? EdgeView.Reading(s) : "")</td>
                                        <td class="small text-muted">@EdgeView.LastHeard(L, l.SignalAt, DateTimeOffset.UtcNow, null)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                break;

            default:
                <ol class="small">
                    <li>@L["On"] <strong>@L["Configure → Users"]</strong>@L[", add a user for this edge (such as"] <code>edge-@_detail.Node.Code.ToLowerInvariant()</code>@L[") and give it the"]
                        <strong>@L["Edge node"]</strong> @L["role at this site. Sign in once as that user and set its password."]</li>
                    <li>@L["Install Pulaski Edge on a machine that can reach both the broker and Pulaski, and put this in its"] <code>appsettings.json</code>,
                        @L["with the user's password (and each broker's, where it has a user name):"]</li>
                </ol>
                <pre class="inv-facts small" style="white-space: pre-wrap">@EdgeView.ConfigSnippet(_detail, ApiUrl)</pre>
                <p class="small text-muted">
                    @L["Start it ("]<code>dotnet Pulaski.Edge.dll</code>@L[", or as a service). It reads this page's connections and tags every minute, so changes here reach it without a restart. If Pulaski can't be reached it keeps collecting into its buffer and forwards everything once it can."]
                </p>
                break;
        }
    </fieldset>
}

@code {
    [Parameter]
    public Guid NodeId { get; set; }

    private EdgeNodeDetailDto? _detail;
    private IReadOnlyList<EquipmentDto> _equipment = [];
    private ApiException? _error;
    private string? _notice;
    private bool _saving;
    private string _tab = "connections";
    private string? _filter;

    private string? _name;
    private bool _active;

    private string? _connCode;
    private string? _connName;
    private string _connProtocol = "sparkplug_b";
    private Dictionary<string, string> _connSettings = [];
    private readonly Dictionary<Guid, EdgeConnectionDto> _connEdits = [];
    private readonly Dictionary<Guid, EquipmentTagDto> _tagEdits = [];

    private string? _binding;
    private Guid? _bindConnection;
    private string? _bindAddress;
    private Guid? _bindEquipment;
    private string _bindRole = "state";
    private string? _bindScale;
    private string? _bindRollover;
    private string? _bindDeadband;

    private bool CanManage => _detail is not null && User.Can(PermissionCodes.Equipment, _detail.Node.SiteId);

    private Uri ApiUrl => Uri.TryCreate(Configuration["PulaskiApi:BaseUrl"], UriKind.Absolute, out var url) ? url : new Uri("http://localhost:5080/");

    /// <summary>Equipment of the node's site that tracks state: what tags can be bound to.</summary>
    // A consumed counter or a level also goes on equipment that holds inventory: a hopper or a silo (#33, D-060).
    private IEnumerable<EquipmentDto> Bindable => _equipment.Where(e => e.SiteId == _detail?.Node.SiteId && e.IsActive
        && (e.TracksState || (e.HoldsInventory && _bindRole is "consumed_count" or "level")));

    protected override Task OnParametersSetAsync() => LoadAsync();

    private IEnumerable<(string Tab, string Label, int? Count)> Tabs()
    {
        yield return ("connections", L["Connections"], _detail!.Connections.Count(c => c.IsActive));
        yield return ("tags", L["Tags"], _detail.Tags.Count(t => t.IsActive));
        yield return ("seen", L["Seen"], _detail.Metrics.Count);
        yield return ("live", L["Live"], _detail.Live.Count);
        yield return ("setup", L["Setup"], null);
    }

    private async Task LoadAsync()
    {
        try
        {
            _detail = await Api.GetEdgeNodeAsync(NodeId);
            if (_equipment.Count == 0)
            {
                _equipment = await Api.ListEquipmentAsync();
            }

            (_name, _active) = (_detail.Node.Name, _detail.Node.IsActive);
            _connEdits.Clear();
            _tagEdits.Clear();
            _bindConnection ??= _detail.Connections.FirstOrDefault()?.Id;
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    private static decimal? Dec(ChangeEventArgs e) =>
        decimal.TryParse(Text(e), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;

    private static IReadOnlyDictionary<string, string> With(IReadOnlyDictionary<string, string> settings, string key, string value)
    {
        var copy = settings.ToDictionary(s => s.Key, s => s.Value);
        if (string.IsNullOrWhiteSpace(value))
        {
            copy.Remove(key);
        }
        else
        {
            copy[key] = value.Trim();
        }

        return copy;
    }

    private string ConnectionCode(Guid id) => _detail?.Connections.FirstOrDefault(c => c.Id == id)?.Code ?? "";

    private EdgeConnectionDto ConnectionEdit(EdgeConnectionDto c) => _connEdits.GetValueOrDefault(c.Id) ?? c;

    private EquipmentTagDto TagEdit(EquipmentTagDto t) => _tagEdits.GetValueOrDefault(t.Id) ?? t;

    private void ChangeConnection(EdgeConnectionDto c, Func<EdgeConnectionDto, EdgeConnectionDto> apply) => _connEdits[c.Id] = apply(ConnectionEdit(c));

    private void ChangeTag(EquipmentTagDto t, Func<EquipmentTagDto, EquipmentTagDto> apply) => _tagEdits[t.Id] = apply(TagEdit(t));

    private void StartBind(EdgeMetricDto metric)
    {
        (_binding, _bindConnection, _bindAddress) = (metric.Address, metric.ConnectionId, metric.Address);
        _bindRole = metric.Address.EndsWith("StateCurrent", StringComparison.OrdinalIgnoreCase) ? "state"
            : metric.Address.Contains("UnitMode", StringComparison.OrdinalIgnoreCase) ? "unit_mode"
            : metric.Address.Contains("StopReason", StringComparison.OrdinalIgnoreCase) ? "stop_reason"
            : metric.Address.Contains("Defective", StringComparison.OrdinalIgnoreCase) ? "defective_count"
            : metric.Address.Contains("Processed", StringComparison.OrdinalIgnoreCase) ? "processed_count"
            : metric.Address.Contains("Speed", StringComparison.OrdinalIgnoreCase) ? "machine_speed"
            : metric.Address.Contains("Alarm", StringComparison.OrdinalIgnoreCase) ? "alarm"
            : metric.Address.Contains("Warning", StringComparison.OrdinalIgnoreCase) ? "warning"
            : _bindRole;
    }

    // A protocol's settings as inputs: text, a tick box or a choice; setting one to blank leaves it out.
    private RenderFragment SettingsFields(string protocol, IReadOnlyDictionary<string, string> values, Action<string, string> set, string idPrefix, bool small) =>
        @<text>
            @foreach (var setting in EdgeView.Settings(protocol))
            {
                var id = $"{idPrefix}-{setting.Key}";
                var current = values.GetValueOrDefault(setting.Key) ?? "";
                @if (setting.IsFlag)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@id" checked="@(current == "true")" @onchange="@(e => set(setting.Key, e.Value is true ? "true" : ""))" />
                        <label class="form-check-label @(small ? "small" : "")" for="@id">@L[setting.Label]</label>
                    </div>
                }
                else if (setting.Choices is { } choices)
                {
                    <select class="form-select @(small ? "form-select-sm" : "") w-auto" aria-label="@L[setting.Label]" title="@L[setting.Label]" value="@current" @onchange="@(e => set(setting.Key, e.Value?.ToString() ?? ""))">
                        @foreach (var (value, label) in choices)
                        {
                            <option value="@value">@L[setting.Label]: @L[label]</option>
                        }
                    </select>
                }
                else
                {
                    <input class="form-control @(small ? "form-control-sm" : "")" style="width: @(small ? "9rem" : "11rem")" aria-label="@L[setting.Label]" title="@L[setting.Label]"
                           placeholder="@($"{L[setting.Label]}{(setting.Placeholder.Length > 0 ? ": " + L[setting.Placeholder] : "")}")"
                           value="@current" @onchange="@(e => set(setting.Key, e.Value?.ToString() ?? ""))" />
                }
            }
        </text>;

    // Binding a tag, from Seen (an address picked) or typed on Tags.
    private RenderFragment BindForm(string? picked) =>
        @<form class="inv-toolbar flex-wrap" @onsubmit="AddTagAsync" @onsubmit:preventDefault>
            <select class="form-select w-auto" aria-label="@L["Equipment to bind to"]" value="@(_bindEquipment?.ToString() ?? "")" @onchange="@(e => _bindEquipment = Guid.TryParse(Text(e), out var id) ? id : null)">
                <option value="">@L["Equipment…"]</option>
                @foreach (var eq in Bindable)
                {
                    <option value="@eq.Id">@eq.Code · @eq.Name</option>
                }
            </select>
            <select class="form-select w-auto" aria-label="@L["Role"]" value="@_bindRole" @onchange="@(e => _bindRole = Text(e))">
                @foreach (var (role, label) in EdgeView.Roles)
                {
                    <option value="@role">@L[label]</option>
                }
            </select>
            @if (picked is null)
            {
                <select class="form-select w-auto" aria-label="@L["Connection"]" value="@(_bindConnection?.ToString() ?? "")" @onchange="@(e => _bindConnection = Guid.TryParse(Text(e), out var id) ? id : null)">
                    @foreach (var c in _detail!.Connections.Where(c => c.IsActive))
                    {
                        <option value="@c.Id">@c.Code</option>
                    }
                </select>
                <input class="form-control inv-grow" style="min-width: 16rem" aria-label="@L["Address"]" placeholder="@EdgeView.AddressPlaceholder(_detail.Connections.FirstOrDefault(c => c.Id == _bindConnection)?.Protocol)"
                       value="@_bindAddress" @onchange="@(e => _bindAddress = Text(e))" />
            }
            else
            {
                <code class="align-self-center">@picked</code>
            }
            <input class="form-control text-end" style="width: 6rem" aria-label="@L["Scale"]" placeholder="@L["Scale 1"]" value="@_bindScale" @onchange="@(e => _bindScale = Text(e))" />
            @if (EdgeView.IsCounter(_bindRole))
            {
                <input class="form-control text-end" style="width: 8rem" aria-label="@L["Rollover"]" placeholder="@L["Rollover"]" value="@_bindRollover" @onchange="@(e => _bindRollover = Text(e))" />
            }
            else if (EdgeView.HasDeadband(_bindRole))
            {
                <input class="form-control text-end" style="width: 8rem" aria-label="@L["Deadband"]" placeholder="@L["Deadband"]" value="@_bindDeadband" @onchange="@(e => _bindDeadband = Text(e))" />
            }
            <button type="submit" class="btn btn-primary" disabled="@(_saving || _bindEquipment is null || _bindConnection is null || string.IsNullOrWhiteSpace(_bindAddress))">@L["Bind tag"]</button>
            @if (picked is not null)
            {
                <button type="button" class="btn btn-link" @onclick="@(() => _binding = null)">@L["Cancel"]</button>
            }
        </form>;

    private Task SaveNodeAsync() => RunAsync(() => Api.UpdateEdgeNodeAsync(NodeId, new UpdateEdgeNodeRequest
    {
        Version = _detail!.Node.Version,
        Name = (_name ?? "").Trim(),
        Description = _detail.Node.Description,
        IsActive = _active,
    }));

    private Task AddConnectionAsync() => RunAsync(async () =>
    {
        await Api.CreateEdgeConnectionAsync(NodeId, new CreateEdgeConnectionRequest
        {
            Code = _connCode!,
            Name = _connName!,
            Protocol = _connProtocol,
            Settings = _connSettings.Where(s => !string.IsNullOrWhiteSpace(s.Value)).ToDictionary(s => s.Key, s => s.Value.Trim()),
        });
        (_connCode, _connName, _connSettings) = (null, null, []);
    });

    private Task SaveConnectionAsync(EdgeConnectionDto c)
    {
        var edit = ConnectionEdit(c);
        return RunAsync(() => Api.UpdateEdgeConnectionAsync(c.Id, new UpdateEdgeConnectionRequest { Version = c.Version, Name = edit.Name, Settings = edit.Settings, IsActive = edit.IsActive }));
    }

    private Task AddTagAsync() => RunAsync(async () =>
    {
        await Api.CreateEquipmentTagAsync(new CreateEquipmentTagRequest
        {
            EquipmentId = _bindEquipment!.Value,
            Role = _bindRole,
            ConnectionId = _bindConnection!.Value,
            Address = (_bindAddress ?? "").Trim(),
            ScaleFactor = decimal.TryParse(_bindScale, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var scale) ? scale : 1,
            CounterRollover = EdgeView.IsCounter(_bindRole) && long.TryParse(_bindRollover, out var rollover) ? rollover : null,
            Deadband = EdgeView.HasDeadband(_bindRole)
                && decimal.TryParse(_bindDeadband, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var band) ? band : null,
        });
        (_binding, _bindAddress, _bindScale, _bindRollover, _bindDeadband) = (null, null, null, null, null);
    });

    private Task SaveTagAsync(EquipmentTagDto t)
    {
        var edit = TagEdit(t);
        return RunAsync(() => Api.UpdateEquipmentTagAsync(t.Id, new UpdateEquipmentTagRequest
        {
            Version = t.Version,
            Address = edit.Address,
            ScaleFactor = edit.ScaleFactor,
            ScaleOffset = edit.ScaleOffset,
            CounterRollover = edit.CounterRollover,
            Deadband = edit.Deadband,
            IsActive = edit.IsActive,
        }));
    }

    private async Task DeleteNodeAsync()
    {
        if (_detail is null || !await JS.InvokeAsync<bool>("confirm",
                L["Delete edge node {0}? This will deactivate the node and all its connections and tags. Historical data will be kept.", _detail.Node.Code]))
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            await Api.DeleteEdgeNodeAsync(NodeId);
            Navigation.NavigateTo("edge-nodes");
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteTagAsync(EquipmentTagDto tag)
    {
        if (!await JS.InvokeAsync<bool>("confirm",
                L["Permanently delete the {0} tag for {1}? Machine history will be kept, and any quality-characteristic source binding will be cleared.", L.Of(EdgeView.RoleLabel(tag.Role)), tag.EquipmentCode]))
        {
            return;
        }

        await RunAsync(
            () => Api.DeleteEquipmentTagAsync(tag.Id),
            L["{0} tag for {1} was permanently deleted. Machine history is retained.", L.Of(EdgeView.RoleLabel(tag.Role)), tag.EquipmentCode]);
    }

    private async Task RunAsync(Func<Task> action, string? successNotice = null)
    {
        _saving = true;
        _error = null;
        _notice = null;
        try
        {
            await action();
            _notice = successNotice;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
            if (ex.IsConflict)
            {
                await LoadAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
