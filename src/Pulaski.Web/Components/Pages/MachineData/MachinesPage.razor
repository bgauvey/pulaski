@page "/machines"
@attribute [RequiresView(PermissionCodes.MachinesView)]
@implements IDisposable
@inject LiveFeed LiveFeed
@using Pulaski.Web.Services.MachineData
@inject PulaskiApiClient Api
@inject SiteSelection Sites
@inject TimeProvider Clock
@inject CurrentUser User

@* Machines (D-050): each machine's live state, its stops to code, and utilization and OEE reports (D-052). The board refreshes itself every 5 seconds. *@
<PageTitle>@L["Machines"] · Pulaski</PageTitle>

<div class="inv-head">
    <div>
        <h1 class="mb-1">@L["Machines"]</h1>
        <p class="text-muted mb-0">
            @L["What every machine is doing now, as its edge node reports it, and its stops. A stop is time a machine isn't executing; stops shorter than the machine's micro-stop threshold aren't coded. Give each stop its reason, or confirm the one its stop code maps to. Where the machine's record is wrong or missing, a supervisor can enter a stop by hand, or split or merge stops."]
        </p>
    </div>
    @if (Sites.Sites.Count > 1)
    {
        <div class="inv-head-tools">
            <select class="form-select w-auto" aria-label="@L["Site"]" value="@Sites.SiteId" @onchange="OnSiteChangedAsync">
                @foreach (var site in Sites.Sites)
                {
                    <option value="@site.Id">@site.Code · @site.Name</option>
                }
            </select>
        </div>
    }
</div>

<nav class="inv-tabs" aria-label="@L["Machines"]">
    <button type="button" class="inv-tab btn btn-link @(_tab == "status" ? "active" : "")" @onclick="@(() => _tab = "status")">@L["Status"]</button>
    <button type="button" class="inv-tab btn btn-link @(_tab == "stops" ? "active" : "")" @onclick="ShowStopsAsync">
        @L["Stops"] @if (_status?.Sum(m => m.UncodedStops) is > 0 and var n) { <span class="chip chip-warning ms-1">@L["{0} to code", n]</span> }
    </button>
    <button type="button" class="inv-tab btn btn-link @(_tab == "maintenance" ? "active" : "")" @onclick="@(() => _tab = "maintenance")">@L["Maintenance"]</button>
    <button type="button" class="inv-tab btn btn-link @(_tab == "alarms" ? "active" : "")" @onclick="@(() => _tab = "alarms")">@L["Alarms"]</button>
    <button type="button" class="inv-tab btn btn-link @(_tab == "values" ? "active" : "")" @onclick="@(() => _tab = "values")">@L["Process values"]</button>
    <button type="button" class="inv-tab btn btn-link @(_tab == "reports" ? "active" : "")" @onclick="@(() => _tab = "reports")">@L["Utilization and OEE"]</button>
</nav>

<ProblemAlert Error="_error" />
@if (_requested is { } requested && _tab == "stops")
{
    <div class="alert alert-success small" role="status">@requested <button type="button" class="btn btn-sm btn-link p-0 align-baseline" @onclick="@(() => (_tab, _requested) = ("maintenance", null))">@L["See the Maintenance tab"]</button></div>
}

@if (_tab == "status")
{
    @if (_status is null)
    {
        @if (_error is null)
        {
            <p class="text-muted">@L["Loading…"]</p>
        }
    }
    else if (_status.Count == 0)
    {
        <div class="empty-panel">
            <p class="text-muted mb-0">@L["No equipment at {0} tracks state. Tick Tracks state on the Equipment screen, and bind its signals on an edge node.", Sites.Site?.Code ?? L["this site"]]</p>
        </div>
    }
    else
    {
        @foreach (var (head, below) in MachineView.Groups(_status))
        {
            <section class="machine-group" @key="head.EquipmentId">
                <div class="machine-tiles">
                    @Tile(head, isHead: true)
                    @foreach (var m in below)
                    {
                        @Tile(m, isHead: false)
                    }
                </div>
            </section>
        }
        <p class="small text-muted">@L["Updated {0} · refreshes every 5 seconds.", Display.SiteTime(_loadedAt, Sites.Site?.TimeZone)]</p>
    }
}
else if (_tab == "maintenance")
{
    @if (Sites.SiteId is { } maintenanceSite)
    {
        <MaintenanceRequests @key="maintenanceSite" SiteId="maintenanceSite" TimeZone="@Sites.Site?.TimeZone" Machines="@(_status ?? [])" />
    }
}
else if (_tab == "alarms")
{
    @if (Sites.SiteId is { } alarmSite)
    {
        <MachineAlarms @key="alarmSite" SiteId="alarmSite" TimeZone="@Sites.Site?.TimeZone" Machines="@(_status ?? [])" />
    }
}
else if (_tab == "values")
{
    @if (Sites.SiteId is { } valueSite)
    {
        <ProcessValues @key="valueSite" SiteId="valueSite" SiteCode="@Sites.Site?.Code" TimeZone="@Sites.Site?.TimeZone" Machines="@(_status ?? [])" />
    }
}
else if (_tab == "reports")
{
    @if (Sites.SiteId is { } reportSite)
    {
        <OeeReports @key="reportSite" SiteId="reportSite" SiteCode="@Sites.Site?.Code" TimeZone="@Sites.Site?.TimeZone" Machines="@(_status ?? [])" />
    }
}
else
{
    <div class="inv-toolbar flex-wrap">
        <select class="form-select w-auto" aria-label="@L["Equipment"]" value="@(_equipment?.ToString() ?? "")" @onchange="OnEquipmentChangedAsync">
            <option value="">@L["All equipment"]</option>
            @foreach (var m in _status ?? [])
            {
                <option value="@m.EquipmentId">@m.Code · @m.Name</option>
            }
        </select>
        <select class="form-select w-auto" aria-label="@L["Period"]" value="@_hours" @onchange="OnPeriodChangedAsync">
            <option value="8">@L["Last 8 hours"]</option>
            <option value="24">@L["Last 24 hours"]</option>
            <option value="168">@L["Last 7 days"]</option>
        </select>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="uncoded-only" checked="@_uncodedOnly" @onchange="@(e => ToggleAsync(() => _uncodedOnly = e.Value is true))" />
            <label class="form-check-label" for="uncoded-only">@L["Only stops to code"]</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="micro" checked="@_micro" @onchange="@(e => ToggleAsync(() => _micro = e.Value is true))" />
            <label class="form-check-label" for="micro">@L["Show micro-stops"]</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="replaced" checked="@_superseded" @onchange="@(e => ToggleAsync(() => _superseded = e.Value is true))" />
            <label class="form-check-label" for="replaced">@L["Show replaced stops"]</label>
        </div>
        @if (CanAdjustAny && _entry is null)
        {
            <button type="button" class="btn btn-outline-primary ms-auto" @onclick="StartEntry">@L["Enter a stop"]</button>
        }
    </div>

    @if (_entry is { } entry)
    {
        <form class="table-panel p-3 mb-3" @onsubmit="SaveEntryAsync" @onsubmit:preventDefault>
            <h2 class="h6">@L["Enter a stop"]</h2>
            <p class="small text-muted">@L["For time the machine didn't report, such as an outage with no signal. It may not overlap the machine's other stops."]</p>
            <div class="d-flex flex-wrap gap-2 align-items-end">
                <div>
                    <label class="form-label" for="entry-machine">@L["Machine"]</label>
                    <select id="entry-machine" class="form-select" value="@(entry.EquipmentId?.ToString() ?? "")" @onchange="OnEntryEquipmentChangedAsync">
                        <option value="">@L["Machine…"]</option>
                        @foreach (var m in _status ?? [])
                        {
                            <option value="@m.EquipmentId">@m.Code · @m.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="entry-start">@L["Started"]</label>
                    <input id="entry-start" type="datetime-local" class="form-control" @bind="entry.Start" />
                </div>
                <div>
                    <label class="form-label" for="entry-end">@L["Ended"]</label>
                    <input id="entry-end" type="datetime-local" class="form-control" @bind="entry.End" />
                </div>
                <div>
                    <label class="form-label" for="entry-reason">@L["Reason"]</label>
                    <select id="entry-reason" class="form-select" value="@(entry.ReasonId?.ToString() ?? "")"
                            @onchange="@(e => entry.ReasonId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null)">
                        <option value="">@L["Reason…"]</option>
                        @foreach (var r in _entryReasons)
                        {
                            <option value="@r.Id">@MachineProfileView.ReasonLabel(L, r)</option>
                        }
                    </select>
                </div>
                <div class="inv-grow">
                    <label class="form-label" for="entry-comment">@L["Why"]</label>
                    <input id="entry-comment" class="form-control" maxlength="1000" placeholder="@L["Why it is entered (needed)"]" @bind="entry.Comment" @bind:event="oninput" />
                </div>
                <button type="submit" class="btn btn-primary"
                        disabled="@(_saving || entry.EquipmentId is null || entry.ReasonId is null || entry.Start is null || entry.End is null || string.IsNullOrWhiteSpace(entry.Comment))">@L["Save"]</button>
                <button type="button" class="btn btn-link" @onclick="@(() => _entry = null)">@L["Cancel"]</button>
            </div>
        </form>
    }

    @if (_chosen.Count > 0)
    {
        <form class="table-panel p-3 mb-3 d-flex flex-wrap gap-2 align-items-center" @onsubmit="MergeAsync" @onsubmit:preventDefault>
            <span class="fw-semibold">@(_chosen.Count == 1 ? L["1 stop chosen"] : L["Stops chosen: {0}", _chosen.Count])</span>
            @if (MachineView.MergeProblem(L, _chosen.Values) is { } problem)
            {
                <span class="small text-muted">@problem</span>
            }
            else
            {
                <input class="form-control inv-grow" maxlength="1000" aria-label="@L["Why merge"]" placeholder="@L["Why merge them (needed)"]" @bind="_adjustComment" @bind:event="oninput" />
                <button type="submit" class="btn btn-primary" disabled="@(_saving || string.IsNullOrWhiteSpace(_adjustComment))">@L["Merge into one stop"]</button>
            }
            <button type="button" class="btn btn-link" @onclick="@(() => _chosen.Clear())">@L["Clear"]</button>
        </form>
    }

    @if (_stops is null)
    {
        <p class="text-muted">@L["Loading…"]</p>
    }
    else if (_stops.Count == 0)
    {
        <div class="empty-panel"><p class="text-muted mb-0">@(_uncodedOnly ? L["Nothing to code: every stop in this period has its reason."] : L["No stops in this period."])</p></div>
    }
    else
    {
        <div class="table-panel">
            <table class="table align-middle">
                <thead>
                    <tr>@if (CanAdjustAny) { <th><span class="visually-hidden">@L["Choose to merge"]</span></th> }<th>@L["Started"]</th><th class="inv-num">@L["Duration"]</th><th>@L["Equipment"]</th><th>@L["Stopped in"]</th><th>@L["Stop code"]</th><th>@L["Reason"]</th><th>@L["Job"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var s in _stops)
                    {
                        <tr @key="s.Id" class="@(s.IsMicroStop || s.SupersededAt is not null ? "text-muted" : "")">
                            @if (CanAdjustAny)
                            {
                                <td>
                                    @if (MachineView.CanAdjust(s))
                                    {
                                        <input class="form-check-input" type="checkbox" aria-label="@L["Choose to merge"]" checked="@_chosen.ContainsKey(s.Id)" @onchange="@(e => Choose(s, e.Value is true))" />
                                    }
                                </td>
                            }
                            <td>@Display.SiteTime(s.StartedAt, Sites.Site?.TimeZone)</td>
                            <td class="inv-num">
                                @MachineView.Duration(TimeSpan.FromSeconds(s.DurationSeconds))
                                @if (s.EndedAt is null)
                                {
                                    <span class="chip chip-warning ms-1">@L["ongoing"]</span>
                                }
                            </td>
                            <td class="fw-semibold">@s.EquipmentCode</td>
                            <td>@s.PackMlName @(s.UnitMode == 1 ? "" : $"({L[MachineView.UnitModeLabel(s.UnitMode)]})")</td>
                            <td>@(s.StopCode is { } code ? $"{code}{(s.StopCodeText is null ? "" : " · " + s.StopCodeText)}" : "")</td>
                            <td>
                                @if (s.IsMicroStop)
                                {
                                    <span class="small">@L["Micro-stop"]</span>
                                }
                                else if (s.OperatorReasonCode is not null)
                                {
                                    <span>@MachineView.ReasonText(s)</span>
                                    @if (s.ReasonGroupPath is { } path)
                                    {
                                        <div class="small text-muted">@path</div>
                                    }
                                    @if (s.OperatorReasonId != s.MappedReasonId && s.MappedReasonCode is not null)
                                    {
                                        <div class="small text-muted">@L["The code said {0}", s.MappedReasonCode]</div>
                                    }
                                    <div class="small text-muted">@s.CodedBy@(s.Comment is null ? "" : " · " + s.Comment)</div>
                                }
                                else if (s.MappedReasonCode is not null)
                                {
                                    <span>@MachineView.ReasonText(s)</span> <span class="chip ms-1" title="@L["From the stop code; confirm it or give another"]">@L["to confirm"]</span>
                                    @if (s.ReasonGroupPath is { } path)
                                    {
                                        <div class="small text-muted">@path</div>
                                    }
                                }
                                else
                                {
                                    <span class="chip chip-warning">@L["Uncoded"]</span>
                                }
                                @if (s.SupersededAt is not null)
                                {
                                    <div class="small"><span class="chip">@(s.SupersededNote is null ? L["replaced"] : L["removed"])</span> @L["by {0}, {1}{2}", s.SupersededBy, Display.SiteTime(s.SupersededAt, Sites.Site?.TimeZone), s.SupersededNote is { } note ? $" · {note}" : ""]</div>
                                }
                                @if (L.Of(MachineView.SourceLabel(s.Source)) is { } source)
                                {
                                    <div class="small text-muted"><span class="chip">@source</span> @s.AdjustedBy · @s.AdjustmentComment</div>
                                }
                            </td>
                            <td>@s.JobNumber</td>
                            <td class="text-end">
                                @if (CanRequestMaintenance(s) && _requesting?.Id != s.Id)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="() => StartRequest(s)">@L["Request maintenance"]</button>
                                }
                                @if (CanCode(s) && _coding?.Id != s.Id)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => StartCodingAsync(s)">@(s.OperatorReasonCode is null ? L["Code"] : L["Change"])</button>
                                }
                                @if (CanAdjustAny && MachineView.CanAdjust(s) && _splitting?.Id != s.Id && _acting?.Stop.Id != s.Id)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => StartSplit(s)">@L["Split"]</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="@(() => StartAction(s, "retime"))">@L["Change times"]</button>
                                }
                                @if (CanAdjustAny && MachineView.CanVoid(s) && _acting?.Stop.Id != s.Id)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1" @onclick="@(() => StartAction(s, "void"))">@L["Remove"]</button>
                                }
                                @if (CanAdjustAny && MachineView.CanUndo(s) && _acting?.Stop.Id != s.Id)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="@(() => StartAction(s, "undo"))">@L["Undo {0}", L.Of(MachineView.SourceLabel(s.Source))?.ToLowerInvariant()]</button>
                                }
                            </td>
                        </tr>
                        @if (_acting is { } acting && acting.Stop.Id == s.Id)
                        {
                            <tr @key="(s.Id, 3)">
                                <td colspan="@Columns">
                                    <form class="d-flex flex-wrap gap-2 align-items-center" @onsubmit="ActAsync" @onsubmit:preventDefault>
                                        @if (acting.Kind == "retime")
                                        {
                                            <label class="small" for="retime-from">@L["From"]</label>
                                            <input id="retime-from" type="datetime-local" step="1" class="form-control w-auto" @bind="_newStart" />
                                            <label class="small" for="retime-to">@L["to"]</label>
                                            <input id="retime-to" type="datetime-local" step="1" class="form-control w-auto" @bind="_newEnd" />
                                        }
                                        <input class="form-control inv-grow" maxlength="1000" aria-label="@L["Why"]" placeholder="@ActionPrompt(acting.Kind)" @bind="_adjustComment" @bind:event="oninput" />
                                        <button type="submit" class="btn @(acting.Kind == "void" ? "btn-danger" : "btn-primary")"
                                                disabled="@(_saving || string.IsNullOrWhiteSpace(_adjustComment) || (acting.Kind == "retime" && (_newStart is null || _newEnd is null)))">@ActionLabel(acting)</button>
                                        <button type="button" class="btn btn-link" @onclick="@(() => _acting = null)">@L["Cancel"]</button>
                                    </form>
                                    <div class="small text-muted mt-1">@ActionHelp(acting)</div>
                                </td>
                            </tr>
                        }
                        @if (_requesting?.Id == s.Id)
                        {
                            <tr @key="(s.Id, 4)">
                                <td colspan="@Columns">
                                    <form class="d-flex flex-wrap gap-2 align-items-center" @onsubmit="RequestMaintenanceAsync" @onsubmit:preventDefault>
                                        <select class="form-select w-auto" aria-label="@L["Priority"]" @bind="_requestPriority">
                                            @foreach (var (priority, priorityLabel) in MaintenanceRequestView.Priorities)
                                            {
                                                <option value="@priority">@L[priorityLabel]</option>
                                            }
                                        </select>
                                        <input class="form-control inv-grow" maxlength="1000" aria-label="@L["What needs looking at"]" placeholder="@L["What needs looking at (needed)"]" @bind="_requestDescription" @bind:event="oninput" />
                                        <button type="submit" class="btn btn-primary" disabled="@(_saving || string.IsNullOrWhiteSpace(_requestDescription))">@L["Request"]</button>
                                        <button type="button" class="btn btn-link" @onclick="@(() => _requesting = null)">@L["Cancel"]</button>
                                    </form>
                                    <div class="small text-muted mt-1">@L["The request names this stop; maintenance sees it on the Maintenance tab."]</div>
                                </td>
                            </tr>
                        }
                        @if (_splitting?.Id == s.Id)
                        {
                            <tr @key="(s.Id, 2)">
                                <td colspan="@Columns">
                                    <form class="d-flex flex-wrap gap-2 align-items-center" @onsubmit="SplitAsync" @onsubmit:preventDefault>
                                        <label class="small" for="split-at">@L["Split at"]</label>
                                        <input id="split-at" type="datetime-local" step="1" class="form-control w-auto" @bind="_splitAt" />
                                        <input class="form-control inv-grow" maxlength="1000" aria-label="@L["Why split"]" placeholder="@L["Why split it (needed)"]" @bind="_adjustComment" @bind:event="oninput" />
                                        <button type="submit" class="btn btn-primary" disabled="@(_saving || _splitAt is null || string.IsNullOrWhiteSpace(_adjustComment))">@L["Split"]</button>
                                        <button type="button" class="btn btn-link" @onclick="@(() => _splitting = null)">@L["Cancel"]</button>
                                    </form>
                                    <div class="small text-muted mt-1">@L["Both parts keep the stop's reason; code each one afterwards."]</div>
                                </td>
                            </tr>
                        }
                        @if (_coding?.Id == s.Id)
                        {
                            <tr @key="(s.Id, 1)">
                                <td colspan="@Columns">
                                    <form class="d-flex flex-wrap gap-2 align-items-center" @onsubmit="SaveCodeAsync" @onsubmit:preventDefault>
                                        <div class="touch-full">
                                            <ReasonPicker Reasons="_reasons" SelectClass="w-auto" AriaLabel="@L["Reason for the stop"]" OptionLabel="r => MachineProfileView.ReasonLabel(L, r)" @bind-Value="_reasonId" />
                                        </div>
                                        <input class="form-control inv-grow" maxlength="1000" aria-label="@L["Comment"]" placeholder="@(NeedsComment ? L["Comment (needed for this reason)"] : L["Comment (optional)"])"
                                               @bind="_comment" @bind:event="oninput" />
                                        @if (s.MappedReasonId is { } mapped && _reasons.Any(r => r.Id == mapped))
                                        {
                                            <button type="button" class="btn btn-outline-primary" disabled="@_saving" @onclick="() => ConfirmAsync(mapped)">@L["Confirm {0}", s.MappedReasonCode]</button>
                                        }
                                        <button type="submit" class="btn btn-primary" disabled="@(_saving || _reasonId is null || (NeedsComment && string.IsNullOrWhiteSpace(_comment)))">@L["Save"]</button>
                                        <button type="button" class="btn btn-link" @onclick="@(() => _coding = null)">@L["Cancel"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_next is not null)
        {
            <div class="d-flex align-items-center gap-2" role="status">
                <span class="small text-muted">@L["Showing the latest {0} stops in this period; there are more.", _stops.Count]</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_loadingMore" @onclick="LoadMoreStopsAsync">@L["Load more"]</button>
            </div>
        }
    }
}

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);

    private readonly CancellationTokenSource _cts = new();
    private IReadOnlyList<MachineStatusDto>? _status;
    private IReadOnlyList<DowntimeDto>? _stops;
    private string? _next;
    private bool _loadingMore;
    private IReadOnlyList<ReasonCodeDto> _reasons = [];
    private readonly Dictionary<Guid, IReadOnlyList<ReasonCodeDto>> _reasonsByEquipment = [];
    private ApiException? _error;
    private DateTimeOffset _loadedAt;
    private string _tab = "status";
    private Guid? _equipment;
    private int _hours = 24;
    private bool _uncodedOnly = true;
    private bool _micro;
    private bool _saving;
    private DowntimeDto? _coding;
    private Guid? _reasonId;
    private string? _comment;

    private bool NeedsComment => _reasonId is { } id && _reasons.FirstOrDefault(r => r.Id == id)?.RequiresComment == true;

    private bool CanCode(DowntimeDto stop) => !stop.IsMicroStop && stop.SupersededAt is null && User.Can(PermissionCodes.DowntimeCode, Sites.SiteId);

    private bool CanAdjustAny => User.Can(PermissionCodes.DowntimeAdjust, Sites.SiteId);

    private DowntimeDto? _requesting;
    private string _requestPriority = "normal";
    private string? _requestDescription;
    private string? _requested;

    private bool CanRequestMaintenance(DowntimeDto stop) => stop.SupersededAt is null && User.Can(PermissionCodes.MaintenanceRequest, Sites.SiteId);

    private void StartRequest(DowntimeDto stop) => (_requesting, _requestPriority, _requestDescription, _requested) = (stop, "normal", null, null);

    private async Task RequestMaintenanceAsync()
    {
        if (_requesting is not { } stop || string.IsNullOrWhiteSpace(_requestDescription))
        {
            return;
        }

        _saving = true;
        try
        {
            var raised = await Api.RaiseMaintenanceRequestAsync(new RaiseMaintenanceRequestRequest
            {
                EquipmentId = stop.EquipmentId,
                DowntimeId = stop.Id,
                DowntimeStartedAt = stop.StartedAt,
                Priority = _requestPriority,
                Description = _requestDescription,
            });
            _requested = raised.AlreadyOpen
                ? L["This stop already has {0}, still waiting for maintenance.", raised.Number]
                : L["{0} is waiting for maintenance.", raised.Number];
            (_requesting, _error) = (null, null);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }

    private int Columns => CanAdjustAny ? 9 : 8;

    // Adjusting stops (D-069): entering one, splitting one, or the stops chosen to merge, with the comment the split or merge needs.
    private sealed class StopEntry
    {
        public Guid? EquipmentId { get; set; }
        public DateTime? Start { get; set; }
        public DateTime? End { get; set; }
        public Guid? ReasonId { get; set; }
        public string? Comment { get; set; }
    }

    private StopEntry? _entry;
    private IReadOnlyList<ReasonCodeDto> _entryReasons = [];
    private DowntimeDto? _splitting;
    private (DowntimeDto Stop, string Kind)? _acting;
    private DateTime? _newStart;
    private DateTime? _newEnd;
    private DateTime? _splitAt;
    private readonly Dictionary<Guid, DowntimeDto> _chosen = [];
    private string? _adjustComment;
    private bool _superseded;

    private bool Adjusting => _entry is not null || _splitting is not null || _acting is not null || _chosen.Count > 0;

    /// <summary>A tab to open on: <c>?tab=maintenance</c> from the Inbox (#127).</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    private string? Tab { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Tab is "maintenance" or "alarms" or "values" or "reports")
        {
            _tab = Tab;
        }

        await LoadStatusAsync();
        _ = TickAsync(_cts.Token);
    }

    // Live updates (#143): reload when something it shows changes, as the timer does.
    private IDisposable? _liveFeed;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _liveFeed = LiveFeed.Subscribe(LiveFilters.At(() => Sites.SiteId, "equipment", LiveFilters.Machine, "maintenance_request"), () => InvokeAsync(async () =>
            {
                if (_coding is null && !_saving && !Adjusting)
                {
                    await LoadStatusAsync();
                    if (_tab == "stops")
                    {
                        await LoadStopsAsync();
                    }

                    StateHasChanged();
                }
            }), TimeSpan.FromSeconds(2));
        }
    }

    public void Dispose()
    {
        _liveFeed?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task LoadStatusAsync()
    {
        try
        {
            await Sites.EnsureAsync(Api);
            _status = Sites.SiteId is { } site ? await Api.GetMachineStatusAsync(site) : [];
            _loadedAt = Clock.GetUtcNow();
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task LoadStopsAsync()
    {
        if (Sites.SiteId is not { } site)
        {
            (_stops, _next) = ([], null);
            return;
        }

        try
        {
            // A refresh reloads as many stops as are shown, so pages already loaded stay (#10).
            var now = Clock.GetUtcNow();
            var shown = _stops?.Count ?? 0;
            var stops = new List<DowntimeDto>();
            string? next = null;
            do
            {
                var page = await Api.ListStopsAsync(site, now.AddHours(-_hours), now.AddMinutes(1), _equipment, _uncodedOnly, _micro, _superseded, next);
                stops.AddRange(page.Stops);
                next = page.Next;
            }
            while (next is not null && stops.Count < shown);

            (_stops, _next) = (stops, next);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task LoadMoreStopsAsync()
    {
        if (Sites.SiteId is not { } site || _next is null || _stops is null)
        {
            return;
        }

        _loadingMore = true;
        try
        {
            var now = Clock.GetUtcNow();
            var page = await Api.ListStopsAsync(site, now.AddHours(-_hours), now.AddMinutes(1), _equipment, _uncodedOnly, _micro, _superseded, _next);
            (_stops, _next) = ([.. _stops, .. page.Stops], page.Next);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private async Task TickAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshInterval, Clock);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    if (_coding is null && !_saving && !Adjusting)
                    {
                        await LoadStatusAsync();
                        if (_tab == "stops")
                        {
                            await LoadStopsAsync();
                        }

                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Page closed.
        }
    }

    private async Task OnSiteChangedAsync(ChangeEventArgs e)
    {
        Sites.SiteId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        (_equipment, _coding, _entry, _splitting) = (null, null, null, null);
        _chosen.Clear();
        await LoadStatusAsync();
        await ReloadStopsAsync();
    }

    // Other filters: start again from the first page.
    private Task ReloadStopsAsync()
    {
        (_stops, _next) = (null, null);
        return LoadStopsAsync();
    }

    private async Task ShowStopsAsync()
    {
        _tab = "stops";
        await LoadStopsAsync();
    }

    private async Task ShowStopsOfAsync(Guid equipmentId)
    {
        (_equipment, _uncodedOnly, _tab) = (equipmentId, true, "stops");
        await ReloadStopsAsync();
    }

    private async Task OnEquipmentChangedAsync(ChangeEventArgs e)
    {
        _equipment = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await ReloadStopsAsync();
    }

    private async Task OnPeriodChangedAsync(ChangeEventArgs e)
    {
        _hours = int.TryParse(e.Value?.ToString(), out var hours) ? hours : 24;
        await ReloadStopsAsync();
    }

    private async Task ToggleAsync(Action change)
    {
        change();
        await ReloadStopsAsync();
    }

    private async Task StartCodingAsync(DowntimeDto stop)
    {
        try
        {
            if (!_reasonsByEquipment.TryGetValue(stop.EquipmentId, out var reasons))
            {
                reasons = await Api.ListCodingReasonsAsync(stop.EquipmentId);
                _reasonsByEquipment[stop.EquipmentId] = reasons;
            }

            (_coding, _reasons, _reasonId, _comment) = (stop, reasons, stop.OperatorReasonId ?? stop.MappedReasonId, stop.Comment);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private Task ConfirmAsync(Guid mapped)
    {
        _reasonId = mapped;
        return SaveCodeAsync();
    }

    private async Task SaveCodeAsync()
    {
        if (_coding is not { } stop || _reasonId is not { } reason)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            await Api.CodeStopAsync(stop.Id, new CodeDowntimeRequest { StartedAt = stop.StartedAt, ReasonCodeId = reason, Comment = _comment });
            _coding = null;
            await LoadStopsAsync();
            await LoadStatusAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartEntry()
    {
        var now = Display.ToSite(Clock.GetUtcNow(), Sites.Site?.TimeZone).DateTime;
        var minute = new DateTime(now.Year, now.Month, now.Day, now.Hour, now.Minute, 0);
        (_entry, _entryReasons) = (new StopEntry { EquipmentId = _equipment, Start = minute.AddMinutes(-30), End = minute }, []);
        if (_equipment is { } equipment)
        {
            _ = LoadEntryReasonsAsync(equipment);
        }
    }

    private async Task OnEntryEquipmentChangedAsync(ChangeEventArgs e)
    {
        if (_entry is null)
        {
            return;
        }

        (_entry.EquipmentId, _entry.ReasonId, _entryReasons) = (Guid.TryParse(e.Value?.ToString(), out var id) ? id : null, null, []);
        if (_entry.EquipmentId is { } equipment)
        {
            await LoadEntryReasonsAsync(equipment);
        }
    }

    private async Task LoadEntryReasonsAsync(Guid equipmentId)
    {
        try
        {
            if (!_reasonsByEquipment.TryGetValue(equipmentId, out var reasons))
            {
                reasons = await Api.ListCodingReasonsAsync(equipmentId);
                _reasonsByEquipment[equipmentId] = reasons;
            }

            _entryReasons = reasons;
            await InvokeAsync(StateHasChanged);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private Task SaveEntryAsync() =>
        _entry is { EquipmentId: { } equipment, ReasonId: { } reason } entry
        && Display.FromSiteLocal(entry.Start, Sites.Site?.TimeZone) is { } start && Display.FromSiteLocal(entry.End, Sites.Site?.TimeZone) is { } end
            ? AdjustAsync(() => Api.EnterStopAsync(new EnterStopRequest { EquipmentId = equipment, StartedAt = start, EndedAt = end, ReasonCodeId = reason, Comment = entry.Comment }))
            : Task.CompletedTask;

    private void StartSplit(DowntimeDto stop)
    {
        var middle = stop.StartedAt + (stop.EndedAt!.Value - stop.StartedAt) / 2;
        var local = Display.ToSite(middle, Sites.Site?.TimeZone).DateTime;
        (_splitting, _splitAt, _adjustComment, _acting) = (stop, local.AddTicks(-(local.Ticks % TimeSpan.TicksPerSecond)), null, null);
    }

    private Task SplitAsync() =>
        _splitting is { } stop && Display.FromSiteLocal(_splitAt, Sites.Site?.TimeZone) is { } at
            ? AdjustAsync(() => Api.SplitStopAsync(stop.Id, new SplitStopRequest { StartedAt = stop.StartedAt, At = at, Comment = _adjustComment }))
            : Task.CompletedTask;

    // Changing a stop's times, removing one entered by hand, undoing an adjustment (#68).
    private void StartAction(DowntimeDto stop, string kind)
    {
        (_acting, _adjustComment, _splitting) = ((stop, kind), null, null);
        DateTime? Local(DateTimeOffset? at) => at is { } t ? Display.ToSite(t, Sites.Site?.TimeZone).DateTime : null;
        (_newStart, _newEnd) = (Local(stop.StartedAt), Local(stop.EndedAt));
    }

    private string ActionPrompt(string kind) => kind switch
    {
        "retime" => L["Why change its times (needed)"],
        "void" => L["Why remove it (needed)"],
        _ => L["Why undo it (needed)"],
    };

    private string ActionLabel((DowntimeDto Stop, string Kind) acting) => acting.Kind switch
    {
        "retime" => L["Change times"],
        "void" => L["Remove stop"],
        _ => "Undo " + (L.Of(MachineView.SourceLabel(acting.Stop.Source))?.ToLowerInvariant() ?? "adjustment"),
    };

    private string ActionHelp((DowntimeDto Stop, string Kind) acting) => acting.Kind switch
    {
        "retime" => L["It keeps its reason and coding; the new times may not overlap another stop of the machine."],
        "void" => L["It stays in the list as removed, with why; nothing replaces it."],
        _ => acting.Stop.Source == "split"
            ? L["Both parts of the split are replaced by the stop they came from, with its reason and coding. Only if neither part was adjusted since."]
            : L["This stop is replaced by the stops it came from, with their reasons and coding. Only if it wasn't adjusted since."],
    };

    private Task ActAsync()
    {
        if (_acting is not { } acting)
        {
            return Task.CompletedTask;
        }

        var stop = acting.Stop;
        return acting.Kind switch
        {
            "retime" when Display.FromSiteLocal(_newStart, Sites.Site?.TimeZone) is { } from && Display.FromSiteLocal(_newEnd, Sites.Site?.TimeZone) is { } to =>
                AdjustAsync(() => Api.RetimeStopAsync(stop.Id, new RetimeStopRequest { StartedAt = stop.StartedAt, NewStartedAt = from, NewEndedAt = to, Comment = _adjustComment })),
            "void" => AdjustAsync(() => Api.VoidStopAsync(stop.Id, new StopReasonedRequest { StartedAt = stop.StartedAt, Comment = _adjustComment })),
            "undo" => AdjustAsync(() => Api.UndoStopAdjustmentAsync(stop.Id, new StopReasonedRequest { StartedAt = stop.StartedAt, Comment = _adjustComment })),
            _ => Task.CompletedTask,
        };
    }

    private void Choose(DowntimeDto stop, bool chosen)
    {
        if (chosen)
        {
            _chosen[stop.Id] = stop;
        }
        else
        {
            _chosen.Remove(stop.Id);
        }
    }

    private Task MergeAsync() =>
        AdjustAsync(() => Api.MergeStopsAsync(new MergeStopsRequest { Stops = [.. _chosen.Values.Select(s => new StopKeyDto(s.Id, s.StartedAt))], Comment = _adjustComment }));

    private async Task AdjustAsync(Func<Task<StopsAdjustedResponse>> adjust)
    {
        _saving = true;
        _error = null;
        try
        {
            await adjust();
            (_entry, _splitting, _acting, _adjustComment) = (null, null, null, null);
            _chosen.Clear();
            await LoadStopsAsync();
            await LoadStatusAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }

    private RenderFragment Tile(MachineStatusDto m, bool isHead) =>
        @<article class="machine-tile @MachineView.CategoryClass(m.Category) @(isHead ? "is-head" : "")" aria-label="@m.Code: @(L[MachineView.CategoryLabel(m.Category)])">
            <div class="machine-tile-head">
                <span class="machine-tile-code">@m.Code</span>
                <span class="machine-tile-state">@(L[MachineView.CategoryLabel(m.Category)])</span>
            </div>
            <div class="machine-tile-line">@m.Name</div>
            @if (m.PackMlName is not null)
            {
                <div class="machine-tile-line">
                    @m.PackMlName@(m.StateSince is { } since ? L[" for {0}", MachineView.Duration(_loadedAt - since)] : "")
                    @if (m.UnitMode is { } mode && mode != 1)
                    {
                        <span class="chip ms-1">@(L[MachineView.UnitModeLabel(mode)])</span>
                    }
                </div>
            }
            @if (L.Of(MachineView.DerivationNote(m)) is { } note)
            {
                <div class="machine-tile-line">@note</div>
            }
            @if (m.OpenStop is { } stop)
            {
                <div class="machine-tile-stop">
                    Stopped @MachineView.Duration(_loadedAt - stop.StartedAt):
                    @if (stop.ReasonCode is not null)
                    {
                        <span>@stop.ReasonCode · @stop.ReasonName</span>
                    }
                    else
                    {
                        <span class="chip chip-warning">@L["uncoded"]</span>
                    }
                    @if (m.StopCodeText is not null)
                    {
                        <div class="text-muted">@m.StopCode · @m.StopCodeText</div>
                    }
                </div>
            }
            @if (m.JobNumber is not null)
            {
                <div class="machine-tile-line">@m.JobNumber@(m.MaterialCode is null ? "" : $" · {m.MaterialCode}")@(m.RunGoodCount is { } good ? $" · {L["{0} good", MachineView.Count(good)]}" : "")</div>
            }
            @if (m.MachineSpeed is { } speed && m.Category == "producing")
            {
                <div class="machine-tile-line">@L["Speed {0}", EdgeView.Reading(speed)]</div>
            }
            @if (m.EdgeQuiet)
            {
                <div class="machine-tile-line"><span class="chip chip-warning">@L["{0} quiet", m.EdgeNodeCode]</span></div>
            }
            @if (m.UncodedStops > 0)
            {
                <div class="mt-auto"><button type="button" class="btn btn-sm btn-link p-0" @onclick="() => ShowStopsOfAsync(m.EquipmentId)">@(m.UncodedStops == 1 ? L["1 stop to code"] : L["{0} stops to code", m.UncodedStops])</button></div>
            }
        </article>;
}
