@using Pulaski.Web.Services.MachineData
@inject PulaskiApiClient Api

@* A machine's definitions from a CSV file (D-050): pick a file, check it, then import it all or nothing. *@
<section class="inv-facts mb-3" aria-labelledby="profile-csv-title">
    <h2 class="h6" id="profile-csv-title">@L["Import definitions from a CSV file"]</h2>
    <p class="small text-muted mb-2">
        @L["One row per state value or code."] <code>kind</code> @L["is"] <code>state</code>, <code>stop_reason</code>, <code>alarm</code> @L["or"] <code>warning</code>;
        <code>value</code> @L["is the number the machine sends;"] <code>name</code> @L["is the state's name or the code's message. A state row also needs"]
        <code>packml_state</code> @L["(0 to 17, or a name such as Execute)."] <code>category</code> @L["is the vendor's grouping, and"] <code>reason</code> @L["the code of the utilization reason it counts as. Each kind in the file replaces that list: entries it leaves out are switched off, and kinds it doesn't mention stay as they are. Nothing is saved until every row is valid."]
    </p>
    <p class="small mb-2"><span class="text-muted">@L["Columns:"]</span> <code>@string.Join(",", MachineProfileView.CsvColumns)</code></p>

    <div class="d-flex flex-wrap gap-2 align-items-center">
        <InputFile OnChange="PickAsync" accept=".csv,text/csv,text/plain" class="form-control" style="max-width: 28rem" aria-label="@L["CSV file"]" disabled="@_busy" />
        <ActionButton Class="btn btn-primary" Busy="_busy" Reason="@ImportReadiness.Why(_result is not null, _result?.Applied == true, _result?.FileProblems.Count ?? 0, _result?.Errors ?? 0, _result is null ? 0 : Changes(_result))" OnClick="ImportAsync">
            @L["Import"]
        </ActionButton>
        <button type="button" class="btn btn-outline-secondary" @onclick="OnClose">@L["Close"]</button>
    </div>

    <ProblemAlert Error="_error" />
    @if (_readProblem is not null)
    {
        <div class="drawer-alert is-warning mt-3" role="alert"><Icon Name="alert" Size="18" /><span>@_readProblem</span></div>
    }

    @if (_busy)
    {
        <p class="text-muted small mt-3 mb-0">@L["Checking {0}…", _fileName]</p>
    }
    else if (_result is { } r)
    {
        <div class="drawer-alert @(r.Errors > 0 ? "is-warning" : "") mt-3" role="status">
            <Icon Name="@(r.Errors > 0 ? "alert" : "info")" Size="18" />
            <span>
                @if (r.FileProblems.Count > 0)
                {
                    @(L["{0} can't be imported: {1}", _fileName, string.Join(" ", r.FileProblems)])
                }
                else if (r.Errors > 0)
                {
                    @L["{0}: rows with errors: {1}. Nothing can be imported yet; fix them and pick the file again.", _fileName, r.Errors]
                }
                else if (r.Applied)
                {
                    @L["Imported {0}: {1}.", _fileName, Summary(r)]
                }
                else if (Changes(r) == 0)
                {
                    @(L["{0} matches the profile already; there is nothing to import.", _fileName])
                }
                else
                {
                    @(L["{0} is ready: {1}.", _fileName, Summary(r)])
                }
            </span>
        </div>

        @if (r.Rows.Count > 0)
        {
            <div class="table-panel mt-2" style="max-height: 24rem; overflow: auto">
                <table class="table table-sm align-middle mb-0 import-table">
                    <thead><tr><th class="inv-num">@L["Line"]</th><th>@L["Kind"]</th><th class="inv-num">@L["Value"]</th><th>@(r.Applied ? L["Done"] : L["Would"])</th><th>@L["Details"]</th></tr></thead>
                    <tbody>
                        @foreach (var row in r.Rows.Where(x => r.Errors == 0 || x.Action == "error"))
                        {
                            <tr class="@(row.Action == "error" ? "is-error" : row.Action == "unchanged" ? "text-muted" : "")">
                                <td class="inv-num">@(row.Line == 0 ? "" : row.Line)</td>
                                <td>@MachineProfileView.KindLabel(L, row.Kind)</td>
                                <td class="inv-num">@row.RawValue</td>
                                <td>@ActionLabel(row.Action, r.Applied)</td>
                                <td class="small">@row.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@code {
    private const long MaxBytes = 5 * 1024 * 1024;

    [Parameter, EditorRequired]
    public Guid ProfileId { get; set; }

    /// <summary>The profile's version as the page read it.</summary>
    [Parameter, EditorRequired]
    public long Version { get; set; }

    [Parameter]
    public EventCallback OnImported { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string? _csv;
    private string? _fileName;
    private string? _readProblem;
    private ProfileImportResponse? _result;
    private ApiException? _error;
    private bool _busy;

    private static int Changes(ProfileImportResponse r) => r.Created + r.Updated + r.SwitchedOff;

    private string Summary(ProfileImportResponse r) =>
        L["{0} new, {1} changed, {2} switched off, {3} unchanged", r.Created, r.Updated, r.SwitchedOff, r.Unchanged];

    private async Task PickAsync(InputFileChangeEventArgs e)
    {
        (_result, _error, _readProblem, _csv, _fileName) = (null, null, null, null, e.File.Name);
        if (e.File.Size > MaxBytes)
        {
            _readProblem = L["{0} is larger than 5 MB; split it into smaller files.", e.File.Name];
            return;
        }

        _busy = true;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxBytes));
            _csv = await reader.ReadToEndAsync();
            _result = await Api.ImportMachineProfileCsvAsync(ProfileId, Version, _csv, dryRun: true);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        catch (IOException ex)
        {
            _readProblem = L["{0} couldn't be read: {1}", e.File.Name, ex.Message];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync()
    {
        if (_csv is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _result = await Api.ImportMachineProfileCsvAsync(ProfileId, Version, _csv, dryRun: false);
            if (_result.Applied)
            {
                _csv = null;
                await OnImported.InvokeAsync();
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private string ActionLabel(string action, bool applied) => (action, applied) switch
    {
        ("create", false) => L["Add"],
        ("create", true) => L["Added"],
        ("update", false) => L["Change"],
        ("update", true) => L["Changed"],
        ("switch_off", false) => L["Switch off"],
        ("switch_off", true) => L["Switched off"],
        ("unchanged", _) => L["Unchanged"],
        _ => L["Error"],
    };
}
