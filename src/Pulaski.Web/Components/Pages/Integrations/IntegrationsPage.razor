@page "/integrations"
@attribute [RequiresView(PermissionCodes.IntegrationsView)]
@inject PulaskiApiClient Api
@inject CurrentUser User

@* Outbound deliveries (D-061, #78): the ERP feed and the document system's, how each is doing, what failed, and putting it right. *@
<PageTitle>Integrations · Pulaski</PageTitle>

<div class="inv-head">
    <div>
        <h1 class="mb-1">Integrations</h1>
        <p class="text-muted mb-0">
            Pulaski sends every inventory movement to the ERP's webhook, and certificates to a document system's, as they happen, in order,
            and keeps trying while the receiver is unreachable. A delivery that is refused, or runs out of attempts, stops here as failed, and
            holds back that lot's (or certificate's) later events until someone retries it or skips it. Below, material connections read items
            from your item master.
        </p>
    </div>
    <div class="inv-head-tools">
        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="LoadAsync">Refresh</button>
    </div>
</div>

<ProblemAlert Error="_error" />
<ViewOnlyNote Permission="@PermissionCodes.Integrations" What="retry or skip deliveries" />

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <div class="btn-group flex-wrap" role="group" aria-label="Feed">
        @foreach (var f in _feeds)
        {
            <button type="button" class="btn btn-sm @(_feed == f.Feed ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => SwitchAsync(f.Feed))"
                    title="@($"{(f.Kind == "mqtt" ? "MQTT broker" : "Webhook")}{(f.Enabled ? $" to {f.TargetHost}" : ", off")}")">
                @(f.Feed == "erp" ? "ERP" : f.Feed == "documents" ? "Document system" : f.Label)
            </button>
        }
    </div>
    @if (CanManage)
    {
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _adding = !_adding">Add a feed</button>
    }
</div>

@if (_adding)
{
    <form class="inv-facts mb-3 row g-2 align-items-end" @onsubmit="AddFeedAsync" @onsubmit:preventDefault>
        <div class="col-6 col-md-2">
            <label class="form-label small fw-semibold" for="new-feed-code">Code</label>
            <input id="new-feed-code" class="form-control form-control-sm" maxlength="30" placeholder="wms" @bind="_newCode" />
        </div>
        <div class="col-6 col-md-4">
            <label class="form-label small fw-semibold" for="new-feed-name">Name</label>
            <input id="new-feed-name" class="form-control form-control-sm" maxlength="100" placeholder="Warehouse system" @bind="_newName" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small fw-semibold" for="new-feed-kind">Sends to</label>
            <select id="new-feed-kind" class="form-select form-select-sm" @bind="_newKind">
                <option value="webhook">A webhook (HTTPS)</option>
                <option value="mqtt">An MQTT broker</option>
            </select>
        </div>
        <div class="col-6 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary" disabled="@_busy">Add</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _adding = false">Cancel</button>
        </div>
        <div class="col-12 small text-muted">
            The code and what it sends to can't change later. It starts switched off: set its address and what it sends under Settings. Its secret
            (and a broker's username and password) go in the API's configuration under <code>Integrations:Feeds:&lt;code&gt;</code>.
        </div>
    </form>
}

@if (_status is { } s)
{
    <div class="table-panel mb-3">
        <table class="table align-middle mb-0">
            <tbody>
                <tr>
                    <th style="width: 14rem">@(s.Feed == "documents" ? "Document system" : s.Feed == "erp" ? "ERP" : s.Label)</th>
                    <td>
                        @if (s.Enabled)
                        {
                            <span class="chip chip-strong">On</span> <span class="ms-1">to @s.TargetHost</span>
                        }
                        else
                        {
                            <span class="chip chip-muted">Off</span>
                            <span class="text-muted ms-1">Nothing is queued while it's off. @(CanManage ? "Switch it on under Settings below." : "Whoever manages integrations switches it on.")</span>
                        }
                    </td>
                </tr>
                <tr><th>Events sent</th><td>@string.Join(", ", s.EventTypes.Select(t => t.TrimEnd('.') + "…"))</td></tr>
                <tr><th>Certificate files</th><td>@(s.IncludesFiles ? "Sent with the certificate's event" : "Not sent: the event carries the reference only")</td></tr>
                <tr>
                    <th>Waiting</th>
                    <td>
                        @s.Pending queued or retrying@(s.Held > 0 ? $", {s.Held} of them held" : "")
                        @if (s.OldestPendingAt is { } oldest)
                        {
                            <span class="text-muted">· oldest from @Display.SiteTime(oldest, null) UTC</span>
                        }
                    </td>
                </tr>
                <tr>
                    <th>Failed</th>
                    <td>
                        <span class="@(s.Failed > 0 ? "chip chip-danger" : "")">@s.Failed</span>
                        @if (s.Failed > 0 && CanManage)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary ms-2" disabled="@_busy" @onclick="RetryAllAsync">Retry all failed</button>
                        }
                    </td>
                </tr>
                <tr>
                    <th>Delivered</th>
                    <td>
                        @s.DeliveredLastDay in the last 24 hours
                        @if (s.LastDeliveredAt is { } last)
                        {
                            <span class="text-muted">· last at @Display.SiteTime(last, null) UTC</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
}

@if (CanManage)
{
    <FeedSettingsPanel @key="_feed" Feed="@_feed" Saved="LoadAsync" />
}

@if (_message is not null)
{
    <p class="small text-muted">@_message</p>
}

<div class="inv-toolbar">
    <select class="form-select w-auto" aria-label="Show" value="@(_filter ?? "")" @onchange="OnFilterChangedAsync">
        <option value="failed">Failed</option>
        <option value="pending">Queued, retrying or held</option>
        <option value="delivered">Delivered</option>
        <option value="skipped">Skipped</option>
        <option value="">All</option>
    </select>
    <input class="form-control w-auto" placeholder="Lot number or subject id" aria-label="Subject" @bind="_search" />
    <input class="form-control w-auto" placeholder="Event type, e.g. consumed" aria-label="Event type" @bind="_type" />
    <input type="date" class="form-control w-auto" aria-label="From" @bind="_from" />
    <input type="date" class="form-control w-auto" aria-label="To" @bind="_to" />
    <button type="button" class="btn btn-outline-secondary" @onclick="SearchAsync">Search</button>
    <span class="text-muted small">Newest first, up to 200. Delivered rows are cleared after @RetentionNote.</span>
</div>

@if (_deliveries is null)
{
    @if (_error is null)
    {
        <p class="text-muted">Loading…</p>
    }
}
else if (_deliveries.Count == 0)
{
    <div class="empty-panel"><p class="text-muted mb-0">Nothing @(_filter is null ? "" : FilterText) to show.</p></div>
}
else
{
    var now = DateTimeOffset.UtcNow;
    <div class="table-panel">
        <table class="table align-middle">
            <thead><tr><th>Happened (UTC)</th><th>Event</th><th>Lot or certificate</th><th>Status</th><th class="inv-num">Attempts</th><th>Last answer</th>@if (CanManage) { <th></th> }</tr></thead>
            <tbody>
                @foreach (var d in _deliveries)
                {
                    var (text, css) = DeliveryView.Status(d);
                    <tr @key="d.Id">
                        <td class="text-nowrap">@Display.SiteTime(d.OccurredAt, null)</td>
                        <td>@DeliveryView.EventName(d.EventType)</td>
                        <td>
                            @if (d.EventType.StartsWith("pulaski.lot.", StringComparison.Ordinal))
                            {
                                <ScreenLink Href="@($"inventory/lots/{d.Subject}")" Permission="@PermissionCodes.InventoryView">@InventoryView.LotLabel(d.LotNumber, d.IsBulk, d.LocationCode)</ScreenLink>
                            }
                            else
                            {
                                <span class="small text-muted">@d.Subject.ToString()[..8]…</span>
                            }
                        </td>
                        <td>
                            <span class="@css">@text</span>
                            <div class="small text-muted">@DeliveryView.Next(d, now)</div>
                        </td>
                        <td class="inv-num">@d.Attempts</td>
                        <td class="small">
                            @if (d.LastStatusCode is { } answer)
                            {
                                <span class="fw-semibold">@answer</span>
                            }
                            @d.LastError
                            @if (d.AckStatus is { } ack)
                            {
                                <div title="@($"{(d.AckSource == "callback" ? "Posted back" : "In the answer")}{(d.AckAt is { } at ? $" at {Display.SiteTime(at, null)} UTC" : "")}")">
                                    <span class="chip @(ack == "rejected" ? "chip-warn" : "chip-ok")">@(ack == "rejected" ? "Rejected" : "Accepted")</span>
                                    @(d.AckReference is { } reference ? $" {reference}" : "")@(d.AckMessage is { } m && ack != "rejected" ? $" · {m}" : "")
                                </div>
                            }
                        </td>
                        @if (CanManage)
                        {
                            <td class="text-end text-nowrap">
                                @if (d.Status == "failed")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy" @onclick="() => RetryAsync(d)">Retry</button>
                                }
                                @if (d.Status is "failed" or "pending")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1" disabled="@_busy" @onclick="() => StartSkip(d)">Skip…</button>
                                }
                            </td>
                        }
                    </tr>
                    @if (_skipping?.Id == d.Id)
                    {
                        <tr>
                            <td colspan="7">
                                <form class="inv-toolbar mb-0" @onsubmit="SkipAsync" @onsubmit:preventDefault>
                                    <input class="form-control inv-grow" maxlength="500" placeholder="Why it won't be sent, e.g. booked by hand in the ERP" aria-label="Reason for skipping"
                                           @bind="_skipReason" @bind:event="oninput" />
                                    <button type="submit" class="btn btn-sm btn-danger" disabled="@(_busy || string.IsNullOrWhiteSpace(_skipReason))">Skip it</button>
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => _skipping = null">Cancel</button>
                                </form>
                                <div class="form-text">The receiver won't get this event. Put it right there by hand first; the later events of the same lot or certificate are sent next.</div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

<MaterialConnectionsPanel />

@code {
    private DeliveryStatusDto? _status;
    private IReadOnlyList<DeliveryDto>? _deliveries;
    private ApiException? _error;
    private bool _busy;
    private string? _filter = "failed";
    private string _feed = "erp";
    private IReadOnlyList<DeliveryFeedSummaryDto> _feeds = [];
    private bool _adding;
    private string? _newCode;
    private string? _newName;
    private string _newKind = "webhook";
    private string? _search;
    private string? _type;
    private DateOnly? _from;
    private DateOnly? _to;

    // What the API is configured to keep; the page only says it.
    private static string RetentionNote => "90 days unless set otherwise (Retention:DeliveredDays)";
    private string? _message;
    private DeliveryDto? _skipping;
    private string? _skipReason;

    private bool CanManage => User.Can(PermissionCodes.Integrations);

    private string FilterText => _filter switch
    {
        "pending" => "waiting",
        _ => _filter ?? "",
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _feeds = await Api.ListDeliveryFeedsAsync();
            _status = await Api.GetDeliveryStatusAsync(_feed);
            _deliveries = await Api.ListDeliveriesAsync(_feed, _filter, _search, _type,
                _from is { } from ? new DateTimeOffset(from.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero) : null,
                _to is { } to ? new DateTimeOffset(to.AddDays(1).ToDateTime(TimeOnly.MinValue), TimeSpan.Zero) : null);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task OnFilterChangedAsync(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString() is { Length: > 0 } value ? value : null;
        _deliveries = null;
        await LoadAsync();
    }

    private async Task SwitchAsync(string feed)
    {
        _feed = feed;
        (_status, _deliveries, _message, _skipping) = (null, null, null, null);
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        _deliveries = null;
        await LoadAsync();
    }

    private Task AddFeedAsync() => RunAsync(async () =>
    {
        var code = (_newCode ?? "").Trim().ToLowerInvariant();
        await Api.CreateDeliveryFeedAsync(new CreateDeliveryFeedRequest { Code = code, Name = _newName ?? "", Kind = _newKind });
        (_adding, _newCode, _newName, _feed) = (false, null, null, code);
        _message = $"Added {code}. Set its address and what it sends under Settings, then switch it on.";
    });

    private void StartSkip(DeliveryDto d)
    {
        _skipping = d;
        _skipReason = null;
    }

    private Task RetryAsync(DeliveryDto d) => RunAsync(async () =>
    {
        await Api.RetryDeliveryAsync(_feed, d.Id);
        _message = $"{DeliveryView.EventName(d.EventType)} goes again on the next round.";
    });

    private Task RetryAllAsync() => RunAsync(async () =>
    {
        var result = await Api.RetryFailedDeliveriesAsync(_feed);
        _message = result.Retried == 1 ? "1 delivery goes again on the next round." : $"{result.Retried} deliveries go again on the next round.";
    });

    private Task SkipAsync() => RunAsync(async () =>
    {
        await Api.SkipDeliveryAsync(_feed, _skipping!.Id, new SkipDeliveryRequest { Reason = _skipReason! });
        _message = $"{DeliveryView.EventName(_skipping.EventType)} skipped.";
        _skipping = null;
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }
}
