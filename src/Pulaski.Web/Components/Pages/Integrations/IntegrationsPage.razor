@page "/integrations"
@attribute [RequiresView(PermissionCodes.IntegrationsView)]
@inject PulaskiApiClient Api
@inject CurrentUser User

@* Outbound deliveries (D-061, #78): the ERP feed and the document system's, how each is doing, what failed, and putting it right. *@
<PageTitle>@L["Integrations"] · Pulaski</PageTitle>

<div class="inv-head">
    <div>
        <h1 class="mb-1">@L["Integrations"]</h1>
        <p class="text-muted mb-0">
            @L["Pulaski sends every inventory movement to the ERP's webhook, and certificates to a document system's, as they happen, in order, and keeps trying while the receiver is unreachable. A delivery that is refused, or runs out of attempts, stops here as failed, and holds back that lot's (or certificate's) later events until someone retries it or skips it. Below, material connections read items from your item master."]
        </p>
    </div>
    <div class="inv-head-tools">
        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="LoadAsync">@L["Refresh"]</button>
    </div>
</div>

<ProblemAlert Error="_error" />
<ViewOnlyNote Permission="@PermissionCodes.Integrations" What="@L["retry or skip deliveries"]" />

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <div class="btn-group flex-wrap" role="group" aria-label="@L["Feed"]">
        @foreach (var f in _feeds)
        {
            <button type="button" class="btn btn-sm @(_feed == f.Feed ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => SwitchAsync(f.Feed))"
                    title="@($"{(f.Kind == "mqtt" ? L["MQTT broker"] : L["Webhook"])}{(f.Format == "b2mml" ? ", B2MML" : "")}{(f.Enabled ? " " + L["to {0}", f.TargetHost] : ", " + L["off"])}")">
                @(f.Feed == "erp" ? "ERP" : f.Feed == "documents" ? L["Document system"] : f.Label)
            </button>
        }
    </div>
    @if (CanManage)
    {
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _adding = !_adding">@L["Add a feed"]</button>
    }
</div>

@if (_adding)
{
    <form class="inv-facts mb-3 row g-2 align-items-end" @onsubmit="AddFeedAsync" @onsubmit:preventDefault>
        <div class="col-6 col-md-2">
            <label class="form-label small fw-semibold" for="new-feed-code">@L["Code"]</label>
            <input id="new-feed-code" class="form-control form-control-sm" maxlength="30" placeholder="wms" @bind="_newCode" />
        </div>
        <div class="col-6 col-md-4">
            <label class="form-label small fw-semibold" for="new-feed-name">@L["Name"]</label>
            <input id="new-feed-name" class="form-control form-control-sm" maxlength="100" placeholder="@L["Warehouse system"]" @bind="_newName" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small fw-semibold" for="new-feed-kind">@L["Sends to"]</label>
            <select id="new-feed-kind" class="form-select form-select-sm" @bind="_newKind">
                <option value="webhook">@L["A webhook (HTTPS)"]</option>
                <option value="mqtt">@L["An MQTT broker"]</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small fw-semibold" for="new-feed-format">@L["Format"]</label>
            <select id="new-feed-format" class="form-select form-select-sm" @bind="_newFormat">
                <option value="cloudevents">@L["Events (CloudEvents JSON)"]</option>
                <option value="b2mml">@L["Production performance (B2MML)"]</option>
            </select>
        </div>
        <div class="col-6 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary" disabled="@_busy">@L["Add"]</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _adding = false">@L["Cancel"]</button>
        </div>
        <div class="col-12 small text-muted">
            @L["The code, what it sends to and its format can't change later. A B2MML feed sends a production job's totals each time they change. It starts switched off: set its address and what it sends under Settings. Its secret (and a broker's username and password) go in the API's configuration under"] <code>Integrations:Feeds:&lt;code&gt;</code>.
        </div>
    </form>
}

@if (_status is { } s)
{
    <div class="table-panel mb-3">
        <table class="table align-middle mb-0">
            <tbody>
                <tr>
                    <th style="width: 14rem">@(s.Feed == "documents" ? L["Document system"] : s.Feed == "erp" ? "ERP" : s.Label)</th>
                    <td>
                        @if (s.Enabled)
                        {
                            <span class="chip chip-strong">@L["On"]</span> <span class="ms-1">@L["to {0}", s.TargetHost]</span>
                        }
                        else
                        {
                            <span class="chip chip-muted">@L["Off"]</span>
                            <span class="text-muted ms-1">@L["Nothing is queued while it's off."] @(CanManage ? L["Switch it on under Settings below."] : L["Whoever manages integrations switches it on."])</span>
                        }
                    </td>
                </tr>
                <tr><th>@L["Events sent"]</th><td>@string.Join(", ", s.EventTypes.Select(t => t.TrimEnd('.') + "…"))</td></tr>
                <tr><th>@L["Certificate files"]</th><td>@(s.IncludesFiles ? L["Sent with the certificate's event"] : L["Not sent: the event carries the reference only"])</td></tr>
                <tr>
                    <th>@L["Waiting"]</th>
                    <td>
                        @(s.Held > 0 ? L["{0} queued or retrying, {1} of them held", s.Pending, s.Held] : L["{0} queued or retrying", s.Pending])
                        @if (s.OldestPendingAt is { } oldest)
                        {
                            <span class="text-muted">@L["· oldest from {0} UTC", Display.SiteTime(oldest, null)]</span>
                        }
                    </td>
                </tr>
                <tr>
                    <th>@L["Failed"]</th>
                    <td>
                        <span class="@(s.Failed > 0 ? "chip chip-danger" : "")">@s.Failed</span>
                        @if (s.Failed > 0 && CanManage)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary ms-2" disabled="@_busy" @onclick="RetryAllAsync">@L["Retry all failed"]</button>
                        }
                    </td>
                </tr>
                <tr>
                    <th>@L["Delivered"]</th>
                    <td>
                        @L["{0} in the last 24 hours", s.DeliveredLastDay]
                        @if (s.LastDeliveredAt is { } last)
                        {
                            <span class="text-muted">@L["· last at {0} UTC", Display.SiteTime(last, null)]</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
}

@if (CanManage)
{
    <FeedSettingsPanel @key="_feed" Feed="@_feed" Saved="LoadAsync" />
}

@if (_message is not null)
{
    <p class="small text-muted">@_message</p>
}

<div class="inv-toolbar">
    <select class="form-select w-auto" aria-label="@L["Show"]" value="@(_filter ?? "")" @onchange="OnFilterChangedAsync">
        <option value="failed">@L["Failed"]</option>
        <option value="pending">@L["Queued, retrying or held"]</option>
        <option value="delivered">@L["Delivered"]</option>
        <option value="skipped">@L["Skipped"]</option>
        <option value="">@L["All"]</option>
    </select>
    <input class="form-control w-auto" placeholder="@L["Lot or job number, or subject id"]" aria-label="@L["Subject"]" @bind="_search" />
    <input class="form-control w-auto" placeholder="@L["Event type, e.g. consumed"]" aria-label="@L["Event type"]" @bind="_type" />
    <input type="date" class="form-control w-auto" aria-label="@L["From"]" @bind="_from" />
    <input type="date" class="form-control w-auto" aria-label="@L["To"]" @bind="_to" />
    <button type="button" class="btn btn-outline-secondary" @onclick="SearchAsync">@L["Search"]</button>
    <span class="text-muted small">@L["Newest first, up to 200. Delivered rows are cleared after {0}.", RetentionNote]</span>
</div>

@if (_deliveries is null)
{
    @if (_error is null)
    {
        <p class="text-muted">@L["Loading…"]</p>
    }
}
else if (_deliveries.Count == 0)
{
    <div class="empty-panel"><p class="text-muted mb-0">@(_filter switch
        {
            "failed" => L["Nothing failed to show."],
            "pending" => L["Nothing waiting to show."],
            "delivered" => L["Nothing delivered to show."],
            "skipped" => L["Nothing skipped to show."],
            _ => L["Nothing to show."],
        })</p></div>
}
else
{
    var now = DateTimeOffset.UtcNow;
    <div class="table-panel">
        <table class="table align-middle">
            <thead><tr><th>@L["Happened (UTC)"]</th><th>@L["Event"]</th><th>@L["Lot or certificate"]</th><th>@L["Status"]</th><th class="inv-num">@L["Attempts"]</th><th>@L["Last answer"]</th>@if (CanManage) { <th></th> }</tr></thead>
            <tbody>
                @foreach (var d in _deliveries)
                {
                    var (text, css) = DeliveryView.Status(L, d);
                    <tr @key="d.Id">
                        <td class="text-nowrap">@Display.SiteTime(d.OccurredAt, null)</td>
                        <td>@DeliveryView.EventName(d.EventType)</td>
                        <td>
                            @if (d.JobNumber is { } jobNumber)
                            {
                                <ScreenLink Href="@($"jobs/{d.Subject}")" Permission="@PermissionCodes.FloorView">@L["Job {0}", jobNumber]</ScreenLink>
                            }
                            else if (d.EventType.StartsWith("pulaski.lot.", StringComparison.Ordinal))
                            {
                                <ScreenLink Href="@($"inventory/lots/{d.Subject}")" Permission="@PermissionCodes.InventoryView">@InventoryView.LotLabel(L, d.LotNumber, d.IsBulk, d.LocationCode)</ScreenLink>
                            }
                            else
                            {
                                <span class="small text-muted">@d.Subject.ToString()[..8]…</span>
                            }
                        </td>
                        <td>
                            <span class="@css">@text</span>
                            <div class="small text-muted">@DeliveryView.Next(L, d, now)</div>
                        </td>
                        <td class="inv-num">@d.Attempts</td>
                        <td class="small">
                            @if (d.LastStatusCode is { } answer)
                            {
                                <span class="fw-semibold">@answer</span>
                            }
                            @d.LastError
                            @if (d.AckStatus is { } ack)
                            {
                                <div title="@($"{(d.AckSource == "callback" ? L["Posted back"] : L["In the answer"])}{(d.AckAt is { } at ? " " + L["at {0} UTC", Display.SiteTime(at, null)] : "")}")">
                                    <span class="chip @(ack == "rejected" ? "chip-warn" : "chip-ok")">@(ack == "rejected" ? L["Rejected"] : L["Accepted"])</span>
                                    @(d.AckReference is { } reference ? $" {reference}" : "")@(d.AckMessage is { } m && ack != "rejected" ? $" · {m}" : "")
                                </div>
                            }
                        </td>
                        @if (CanManage)
                        {
                            <td class="text-end text-nowrap">
                                @if (d.Status == "failed")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy" @onclick="() => RetryAsync(d)">@L["Retry"]</button>
                                }
                                @if (d.Status is "failed" or "pending")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1" disabled="@_busy" @onclick="() => StartSkip(d)">@L["Skip…"]</button>
                                }
                            </td>
                        }
                    </tr>
                    @if (_skipping?.Id == d.Id)
                    {
                        <tr>
                            <td colspan="7">
                                <form class="inv-toolbar mb-0" @onsubmit="SkipAsync" @onsubmit:preventDefault>
                                    <input class="form-control inv-grow" maxlength="500" placeholder="@L["Why it won't be sent, e.g. booked by hand in the ERP"]" aria-label="@L["Reason for skipping"]"
                                           @bind="_skipReason" @bind:event="oninput" />
                                    <button type="submit" class="btn btn-sm btn-danger" disabled="@(_busy || string.IsNullOrWhiteSpace(_skipReason))">@L["Skip it"]</button>
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => _skipping = null">@L["Cancel"]</button>
                                </form>
                                <div class="form-text">@L["The receiver won't get this event. Put it right there by hand first; the later events of the same lot or certificate are sent next."]</div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

<MaterialConnectionsPanel />

@code {
    private DeliveryStatusDto? _status;
    private IReadOnlyList<DeliveryDto>? _deliveries;
    private ApiException? _error;
    private bool _busy;
    private string? _filter = "failed";
    private string _feed = "erp";
    private IReadOnlyList<DeliveryFeedSummaryDto> _feeds = [];
    private bool _adding;
    private string? _newCode;
    private string? _newName;
    private string _newKind = "webhook";
    private string _newFormat = "cloudevents";
    private string? _search;
    private string? _type;
    private DateOnly? _from;
    private DateOnly? _to;

    // What the API is configured to keep; the page only says it.
    private static string RetentionNote => "90 days unless set otherwise (Retention:DeliveredDays)";
    private string? _message;
    private DeliveryDto? _skipping;
    private string? _skipReason;

    private bool CanManage => User.Can(PermissionCodes.Integrations);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _feeds = await Api.ListDeliveryFeedsAsync();
            _status = await Api.GetDeliveryStatusAsync(_feed);
            _deliveries = await Api.ListDeliveriesAsync(_feed, _filter, _search, _type,
                _from is { } from ? new DateTimeOffset(from.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero) : null,
                _to is { } to ? new DateTimeOffset(to.AddDays(1).ToDateTime(TimeOnly.MinValue), TimeSpan.Zero) : null);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task OnFilterChangedAsync(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString() is { Length: > 0 } value ? value : null;
        _deliveries = null;
        await LoadAsync();
    }

    private async Task SwitchAsync(string feed)
    {
        _feed = feed;
        (_status, _deliveries, _message, _skipping) = (null, null, null, null);
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        _deliveries = null;
        await LoadAsync();
    }

    private Task AddFeedAsync() => RunAsync(async () =>
    {
        var code = (_newCode ?? "").Trim().ToLowerInvariant();
        await Api.CreateDeliveryFeedAsync(new CreateDeliveryFeedRequest { Code = code, Name = _newName ?? "", Kind = _newKind, Format = _newFormat });
        (_adding, _newCode, _newName, _feed) = (false, null, null, code);
        _message = L["Added {0}. Set its address and what it sends under Settings, then switch it on.", code];
    });

    private void StartSkip(DeliveryDto d)
    {
        _skipping = d;
        _skipReason = null;
    }

    private Task RetryAsync(DeliveryDto d) => RunAsync(async () =>
    {
        await Api.RetryDeliveryAsync(_feed, d.Id);
        _message = L["{0} goes again on the next round.", DeliveryView.EventName(d.EventType)];
    });

    private Task RetryAllAsync() => RunAsync(async () =>
    {
        var result = await Api.RetryFailedDeliveriesAsync(_feed);
        _message = result.Retried == 1 ? L["1 delivery goes again on the next round."] : L["{0} deliveries go again on the next round.", result.Retried];
    });

    private Task SkipAsync() => RunAsync(async () =>
    {
        await Api.SkipDeliveryAsync(_feed, _skipping!.Id, new SkipDeliveryRequest { Reason = _skipReason! });
        _message = L["{0} skipped.", DeliveryView.EventName(_skipping.EventType)];
        _skipping = null;
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }
}
