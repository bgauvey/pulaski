@* Create a child under Parent (or the enterprise when Parent is null), or edit Existing. *@
@inject PulaskiApiClient Api

<div class="card">
    <div class="card-body">
        <h2 class="h5 card-title">
            @if (Existing is not null)
            {
                <text>Edit @Existing.Code</text>
            }
            else if (Parent is not null)
            {
                <text>New equipment under @Parent.Code</text>
            }
            else
            {
                <text>New enterprise</text>
            }
        </h2>

        <ProblemAlert Error="_error" />

        <EditForm Model="_form" OnSubmit="SaveAsync" FormName="equipment">
            @if (Existing is null)
            {
                <div class="row g-2 mb-2">
                    <div class="col-sm-6">
                        <label class="form-label" for="level">Level</label>
                        <InputSelect id="level" class="form-select" Value="_form.Level" ValueExpression="() => _form.Level"
                                     ValueChanged="(string level) => OnLevelChanged(level)">
                            @foreach (var level in _levels)
                            {
                                <option value="@level">@Display.Label(level)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="role">Role</label>
                        <InputSelect id="role" class="form-select" Value="_form.Role" ValueExpression="() => _form.Role"
                                     ValueChanged="(string role) => OnRoleChanged(role)">
                            @foreach (var role in RolesFor(_form.Level))
                            {
                                <option value="@role">@Display.Label(role)</option>
                            }
                        </InputSelect>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="code">Code</label>
                    <InputText id="code" class="form-control" @bind-Value="_form.Code" maxlength="50" />
                </div>
            }
            else
            {
                <p class="small text-muted mb-2">@Display.Label(Existing.Level) · @Display.Label(Existing.EquipmentRole)</p>
            }

            <div class="mb-2">
                <label class="form-label" for="name">Name</label>
                <InputText id="name" class="form-control" @bind-Value="_form.Name" maxlength="200" />
            </div>
            <div class="mb-2">
                <label class="form-label" for="description">Description</label>
                <InputTextArea id="description" class="form-control" rows="2" @bind-Value="_form.Description" />
            </div>

            @if (Existing is null && _form.Level == "site")
            {
                <div class="mb-2">
                    <label class="form-label" for="tz">Time zone (IANA)</label>
                    <InputText id="tz" class="form-control" @bind-Value="_form.TimeZone" placeholder="America/Chicago" />
                </div>
            }

            <fieldset class="mb-3">
                <legend class="form-label fs-6">Capabilities</legend>
                <div class="form-check">
                    <InputCheckbox id="tracks" class="form-check-input" @bind-Value="_form.TracksState" />
                    <label class="form-check-label" for="tracks">Tracks machine state (downtime, OEE)</label>
                </div>
                <div class="form-check">
                    <InputCheckbox id="schedulable" class="form-check-input" @bind-Value="_form.IsSchedulable" />
                    <label class="form-check-label" for="schedulable">Schedulable (jobs can be placed on it)</label>
                </div>
                <div class="form-check">
                    <InputCheckbox id="inventory" class="form-check-input" @bind-Value="_form.HoldsInventory" />
                    <label class="form-check-label" for="inventory">Holds inventory (lots can be located here)</label>
                </div>
                @if (Existing is not null)
                {
                    <div class="form-check">
                        <InputCheckbox id="active" class="form-check-input" @bind-Value="_form.IsActive" />
                        <label class="form-check-label" for="active">Active</label>
                    </div>
                }
            </fieldset>

            <button type="submit" class="btn btn-primary" disabled="@_saving">Save</button>
            <button type="button" class="btn btn-link" @onclick="OnCancel">Cancel</button>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public EquipmentDto? Parent { get; set; }
    [Parameter] public EquipmentDto? Existing { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<EquipmentTypeDto> Types { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly FormModel _form = new();
    private List<string> _levels = [];
    private ApiException? _error;
    private bool _saving;

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _form.Name = Existing.Name;
            _form.Description = Existing.Description;
            _form.TracksState = Existing.TracksState;
            _form.IsSchedulable = Existing.IsSchedulable;
            _form.HoldsInventory = Existing.HoldsInventory;
            _form.IsActive = Existing.IsActive;
            return;
        }

        // Types arrive in hierarchy order, so a child may use any level after its parent's.
        var allLevels = Types.Select(t => t.Level).Distinct().ToList();
        _levels = Parent is null
            ? [allLevels[0]]
            : [.. allLevels.Skip(allLevels.IndexOf(Parent.Level) + 1)];

        OnLevelChanged(_levels.FirstOrDefault() ?? "");
    }

    private IEnumerable<string> RolesFor(string level) =>
        Types.Where(t => t.Level == level).Select(t => t.Role);

    private void OnLevelChanged(string level)
    {
        _form.Level = level;
        OnRoleChanged(RolesFor(level).FirstOrDefault() ?? "");
    }

    // Sensible capability defaults per role; the user can still change them.
    private void OnRoleChanged(string role)
    {
        _form.Role = role;
        _form.TracksState = role is "production_line" or "machine" or "unit" or "work_cell" or "process_cell";
        _form.IsSchedulable = role is "production_line" or "process_cell" or "production_unit";
        _form.HoldsInventory = role is "feed_point" or "storage_zone" or "storage_unit";
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            if (Existing is null)
            {
                await Api.CreateEquipmentAsync(new CreateEquipmentRequest
                {
                    ParentId = Parent?.Id,
                    Code = _form.Code,
                    Name = _form.Name,
                    Description = NullIfBlank(_form.Description),
                    Level = _form.Level,
                    EquipmentRole = _form.Role,
                    TracksState = _form.TracksState,
                    IsSchedulable = _form.IsSchedulable,
                    HoldsInventory = _form.HoldsInventory,
                    TimeZone = _form.Level == "site" ? NullIfBlank(_form.TimeZone) : null,
                });
            }
            else
            {
                await Api.UpdateEquipmentAsync(Existing.Id, new UpdateEquipmentRequest
                {
                    Version = Existing.Version,
                    Name = _form.Name,
                    Description = NullIfBlank(_form.Description),
                    TracksState = _form.TracksState,
                    IsSchedulable = _form.IsSchedulable,
                    HoldsInventory = _form.HoldsInventory,
                    IsActive = _form.IsActive,
                });
            }

            await OnSaved.InvokeAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class FormModel
    {
        public string Level { get; set; } = "";
        public string Role { get; set; } = "";
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string? TimeZone { get; set; }
        public bool TracksState { get; set; }
        public bool IsSchedulable { get; set; }
        public bool HoldsInventory { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
