@page "/equipment"
@inject PulaskiApiClient Api

<PageTitle>Equipment · Pulaski</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Equipment</h1>
    @if (_equipment is { Count: 0 })
    {
        <button class="btn btn-primary" @onclick="() => StartCreate(null)">Add enterprise</button>
    }
</div>

<ProblemAlert Error="_error" />

<div class="row g-4">
    <div class="@(_editorOpen ? "col-lg-7" : "col-12")">
        @if (_equipment is null)
        {
            @if (_error is null)
            {
                <p class="text-muted">Loading…</p>
            }
        }
        else if (_equipment.Count == 0)
        {
            <p class="text-muted">No equipment yet. Start with the enterprise, then add a site under it.</p>
        }
        else
        {
            <div class="table-panel">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Level · role</th>
                            <th>Capabilities</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _equipment)
                        {
                            <tr class="@(e.IsActive ? "" : "text-muted") @(e.Id == _selectedId ? "table-active" : "")">
                                <td style="padding-left: @(1 + (e.Depth * 1.25))rem">
                                    <span class="fw-semibold">@e.Code</span>
                                </td>
                                <td>@e.Name</td>
                                <td class="small">@Display.Label(e.Level) · @Display.Label(e.EquipmentRole)</td>
                                <td>
                                    @if (e.TracksState) { <span class="chip me-1">State</span> }
                                    @if (e.IsSchedulable) { <span class="chip me-1">Schedulable</span> }
                                    @if (e.HoldsInventory) { <span class="chip me-1">Inventory</span> }
                                    @if (!e.IsActive) { <span class="chip chip-muted">Inactive</span> }
                                </td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEdit(e)">Edit</button>
                                    @if (e.Level != "control_module")
                                    {
                                        <button class="btn btn-sm btn-outline-primary ms-1" @onclick="() => StartCreate(e)">Add child</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (_editorOpen && _types is not null)
    {
        <div class="col-lg-5">
            <EquipmentEditor @key="_editorKey"
                             Parent="_parent"
                             Existing="_existing"
                             Types="_types"
                             OnSaved="OnSavedAsync"
                             OnCancel="CloseEditor" />
        </div>
    }
</div>

@code {
    private IReadOnlyList<EquipmentDto>? _equipment;
    private IReadOnlyList<EquipmentTypeDto>? _types;
    private ApiException? _error;

    private bool _editorOpen;
    private int _editorKey;
    private EquipmentDto? _parent;
    private EquipmentDto? _existing;
    private Guid? _selectedId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _types = await Api.ListEquipmentTypesAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _equipment = await Api.ListEquipmentAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private void StartCreate(EquipmentDto? parent) => OpenEditor(parent, existing: null);

    private void StartEdit(EquipmentDto existing) => OpenEditor(parent: null, existing);

    private void OpenEditor(EquipmentDto? parent, EquipmentDto? existing)
    {
        _parent = parent;
        _existing = existing;
        _selectedId = (existing ?? parent)?.Id;
        _editorKey++;
        _editorOpen = true;
    }

    private void CloseEditor()
    {
        _editorOpen = false;
        _selectedId = null;
    }

    private async Task OnSavedAsync()
    {
        CloseEditor();
        await LoadAsync();
    }
}
