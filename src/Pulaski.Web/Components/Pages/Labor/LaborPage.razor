@page "/labor"
@page "/labor/review"
@page "/labor/reports"
@attribute [RequiresView(PermissionCodes.LaborView)]
@implements IDisposable
@inject PulaskiApiClient Api
@inject SiteSelection Sites
@inject NavigationManager Navigation

@* Labor (D-040): who is on each line now, a shift's labor to review and approve, and labor reports. *@
<PageTitle>@Tab · Labor · Pulaski</PageTitle>

<div class="inv-head">
    <div>
        <h1 class="mb-1">Labor</h1>
        <p class="text-muted mb-0">Who is on each line, the labor of each shift to review and approve, and hours against the standard crew.</p>
    </div>
    @if (Sites.Sites.Count > 1)
    {
        <div class="inv-head-tools">
            <select class="form-select w-auto" aria-label="Site" value="@Sites.SiteId" @onchange="OnSiteChanged">
                @foreach (var site in Sites.Sites)
                {
                    <option value="@site.Id">@site.Code · @site.Name</option>
                }
            </select>
        </div>
    }
</div>

<nav class="inv-tabs" aria-label="Labor">
    <NavLink class="inv-tab" href="labor" Match="NavLinkMatch.All">On now</NavLink>
    <NavLink class="inv-tab" href="labor/review">Shift review</NavLink>
    <NavLink class="inv-tab" href="labor/reports">Reports</NavLink>
</nav>

@if (_loaded && Sites.SiteId is { } siteId)
{
    @switch (Tab)
    {
        case "Shift review":
            <LaborReview @key="siteId" SiteId="siteId" TimeZone="@Sites.Site?.TimeZone" Day="ReviewDay" />
            break;
        case "Reports":
            <LaborReports @key="siteId" SiteId="siteId" SiteCode="@Sites.Site?.Code" TimeZone="@Sites.Site?.TimeZone" />
            break;
        default:
            <LaborOnNow @key="siteId" SiteId="siteId" TimeZone="@Sites.Site?.TimeZone" />
            break;
    }
}
else if (_loaded)
{
    <div class="empty-panel"><p class="text-muted mb-0">No site to show.</p></div>
}

@code {
    private bool _loaded;

    // The Overview's labor to approve opens Shift review on the oldest day waiting.
    [SupplyParameterFromQuery(Name = "day")]
    private string? DayQuery { get; set; }

    private DateOnly? ReviewDay =>
        DateOnly.TryParseExact(DayQuery, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var day) ? day : null;

    private string Tab => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/') switch
    {
        "labor/review" => "Shift review",
        "labor/reports" => "Reports",
        _ => "On now",
    };

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        try
        {
            await Sites.EnsureAsync(Api);
        }
        catch (ApiException)
        {
            // The tabs show their own errors.
        }

        _loaded = true;
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void OnSiteChanged(ChangeEventArgs e) => Sites.SiteId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
}
