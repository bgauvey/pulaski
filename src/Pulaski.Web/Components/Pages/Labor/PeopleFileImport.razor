@inject PulaskiApiClient Api

@* People from an HR or ERP system, or a list kept elsewhere (D-054): pick the format and the file, check it, then import it
   into the site all or nothing. Each format is a source adapter on the API; they all feed the same import. *@
<section class="inv-facts mb-3" aria-labelledby="people-import-title">
    <h2 class="h6" id="people-import-title">@L["Import people from a file"]</h2>
    <div class="row g-2 mb-2">
        <div class="col-sm-3">
            <label class="form-label small" for="people-import-format">@L["Format"]</label>
            <select id="people-import-format" class="form-select" disabled="@_busy" @bind="_sourceName" @bind:after="RecheckAsync">
                @foreach (var source in _sources)
                {
                    <option value="@source.Name">@source.DisplayName</option>
                }
            </select>
        </div>
        <div class="col-sm-3">
            <label class="form-label small" for="people-import-system">@L["External system"] <span class="text-muted">@L["(optional)"]</span></label>
            <input id="people-import-system" class="form-control" maxlength="100" placeholder="@L["e.g. HR1"]" disabled="@_busy"
                   @bind="_externalSystem" @bind:after="RecheckAsync" />
        </div>
        <div class="col-sm-6 d-flex align-items-end">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="people-import-missing" disabled="@(_busy || string.IsNullOrWhiteSpace(_externalSystem))"
                       @bind="_switchOffMissing" @bind:after="RecheckAsync" />
                <label class="form-check-label small" for="people-import-missing">
                    @L["The file is all of the system's people: switch off those it doesn't list"]
                </label>
            </div>
        </div>
    </div>

    @if (Source.Name == Csv)
    {
        <p class="small text-muted mb-2">
            @L["The first line names the columns; employee_number and name are required. A column left out keeps what each person already has. Rows with an external_key are people from the external system (named above, or in an external_system column), matched on that key; the others are matched on their employee number."] <code>qualifications</code> @L["lists the codes they hold, separated by"]
            <code>;</code>@L[", each optionally"] <code>CODE:valid-from:expires-on</code>@L["; any they aren't already granted are granted (an import never revokes one). Nothing is saved until every row is valid."]
        </p>
        <p class="small mb-2"><span class="text-muted">@L["All columns:"]</span> <code>@PeopleCsvFormat.Header</code></p>
    }
    else if (Source.Name == Scim)
    {
        <p class="small text-muted mb-2">
            @L[Source.Description] @L["Each user is one person: the enterprise extension's"] <code>employeeNumber</code> @L["is the employee number,"]
            <code>displayName</code> @L["the name and"] <code>active</code> @L["whether they work here. With an external system, the people are that system's, matched on their"] <code>externalId</code> @L["(or"] <code>id</code>@L["); without one, on their employee number. Nothing is saved until every person is valid."]
        </p>
    }
    else
    {
        <p class="small text-muted mb-2">@L[Source.Description] @L["Nothing is saved until every person is valid."]</p>
    }

    <div class="d-flex flex-wrap gap-2 align-items-center">
        <InputFile OnChange="PickAsync" accept="@string.Join(",", Source.FileTypes)" class="form-control" style="max-width: 28rem"
                   aria-label="@L["{0} file", Source.DisplayName]" disabled="@_busy" />
        <ActionButton Class="btn btn-primary" Busy="_busy" Reason="@ImportReadiness.Why(_result is not null, _result?.Applied == true, _result?.FileProblems.Count ?? 0, _result?.Errors ?? 0, _result is null ? 0 : _result.Created + _result.Updated)" OnClick="ImportAsync">
            @ImportLabel
        </ActionButton>
        <button type="button" class="btn btn-outline-secondary" @onclick="OnClose">@L["Close"]</button>
    </div>

    <ProblemAlert Error="_error" />
    @if (_readProblem is not null)
    {
        <div class="drawer-alert is-warning mt-3" role="alert"><Icon Name="alert" Size="18" /><span>@_readProblem</span></div>
    }

    @if (_busy)
    {
        <p class="text-muted small mt-3 mb-0">@L["Checking {0}…", _fileName]</p>
    }
    else if (_result is { } r)
    {
        <div class="drawer-alert @(r.Errors > 0 ? "is-warning" : "") mt-3" role="status">
            <Icon Name="@(r.Errors > 0 ? "alert" : "info")" Size="18" />
            <span>
                @if (r.Applied)
                {
                    @L["Imported {0}: {1} created, {2} updated, {3} unchanged.", _fileName, r.Created, r.Updated, r.Unchanged]
                }
                else if (r.FileProblems.Count > 0)
                {
                    @(L["{0} can't be imported: {1}", _fileName, string.Join(" ", L.Notes(r.FileProblems))])
                }
                else if (r.Errors > 0)
                {
                    @(L["{0}: rows with errors: {1}. Nothing can be imported yet; fix them and pick the file again.", _fileName, r.Errors] +
                        (r.Rows.Count > r.Errors ? L[" The other rows would give {0} created, {1} updated, {2} unchanged.", r.Created, r.Updated, r.Unchanged] : ""))
                }
                else
                {
                    @(L["{0} is ready: {1} to create, {2} to update, {3} unchanged.", _fileName, r.Created, r.Updated, r.Unchanged])
                }
            </span>
        </div>

        @if (r.Rows.Count > 0)
        {
            <div class="d-flex align-items-center gap-2 mt-2">
                @if (r.Errors > 0 && r.Rows.Count > r.Errors)
                {
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="people-import-errors" @bind="_errorsOnly" />
                        <label class="form-check-label small" for="people-import-errors">@L["Only rows with errors"]</label>
                    </div>
                }
            </div>
            <div class="table-panel mt-2" style="max-height: 24rem; overflow: auto">
                <table class="table table-sm align-middle mb-0 import-table">
                    <thead><tr><th class="inv-num">@L["Line"]</th><th>@L["Code"]</th><th>@(r.Applied ? L["Done"] : L["Would"])</th><th>@L["Details"]</th></tr></thead>
                    <tbody>
                        @foreach (var row in r.Rows.Where(x => !_errorsOnly || x.Action == "error"))
                        {
                            <tr @key="@($"{row.Line}-{row.Code}")" class="@(row.Action == "error" ? "is-error" : row.Action == "unchanged" ? "text-muted" : "")">
                                <td class="inv-num">@(row.Line == 0 ? "" : row.Line)</td>
                                <td class="fw-semibold">@row.Code</td>
                                <td>@ActionLabel(row.Action, r.Applied)</td>
                                <td class="small">
                                    @(row.Message is { } why ? L.Of(why) : (row.Changes.Count > 0 ? (r.Applied ? L["Changed {0}", string.Join(", ", row.Changes)] : L["Changes {0}", string.Join(", ", row.Changes)]) : ""))
                                    @foreach (var note in row.Notes)
                                    {
                                        <div class="text-muted">@L.Of(note)</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@code {
    /// <summary>Largest file read, matching the API's limit.</summary>
    private const long MaxBytes = 5 * 1024 * 1024;

    private const string Csv = "csv";
    private const string Scim = "scim";

    // Offered until the API's list arrives, or if it can't be read.
    private static readonly PeopleSourceDto CsvSource = new() { Name = Csv, DisplayName = "CSV", FileTypes = [".csv", "text/csv", "text/plain"] };

    [Parameter, EditorRequired]
    public Guid SiteId { get; set; }

    [Parameter]
    public EventCallback OnImported { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private IReadOnlyList<PeopleSourceDto> _sources = [CsvSource];
    private string _sourceName = Csv;
    private string? _externalSystem;
    private bool _switchOffMissing;
    private string? _text;
    private string? _fileName;
    private string? _readProblem;
    private ImportPeopleResponse? _result;
    private ApiException? _error;
    private bool _busy;
    private bool _errorsOnly;

    private PeopleSourceDto Source => _sources.FirstOrDefault(s => s.Name == _sourceName) ?? CsvSource;

    // Only with a system named: who is missing is that system's people.
    private bool SwitchOff => _switchOffMissing && !string.IsNullOrWhiteSpace(_externalSystem);

    private string MediaType => Source.FileTypes.FirstOrDefault(t => t.Contains('/')) ?? "text/plain";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await Api.ListPeopleSourcesAsync() is { Count: > 0 } sources)
            {
                _sources = sources;
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private string ImportLabel => _result is { Errors: 0, Applied: false } r && r.Created + r.Updated > 0
        ? (r.Created + r.Updated == 1 ? L["Import 1 person"] : L["Import {0} people", r.Created + r.Updated])
        : L["Import"];

    private async Task PickAsync(InputFileChangeEventArgs e)
    {
        _result = null;
        _error = null;
        _readProblem = null;
        _text = null;
        _fileName = e.File.Name;
        if (e.File.Size > MaxBytes)
        {
            _readProblem = L["{0} is larger than 5 MB; split it into smaller files.", e.File.Name];
            return;
        }

        _busy = true;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxBytes));
            _text = await reader.ReadToEndAsync();
            await CheckAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        catch (IOException ex)
        {
            _readProblem = L["{0} couldn't be read: {1}", e.File.Name, ex.Message];
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>A file already picked is checked again when its format or external system changes.</summary>
    private async Task RecheckAsync()
    {
        if (_text is null)
        {
            _result = null;
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await CheckAsync();
        }
        catch (ApiException ex)
        {
            _result = null;
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CheckAsync()
    {
        _result = await Api.ImportPeopleAsync(SiteId, Source.Name, _text!, _externalSystem, dryRun: true, MediaType, switchOffMissing: SwitchOff);
        _errorsOnly = _result.Errors > 0;
    }

    private async Task ImportAsync()
    {
        if (_text is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _result = await Api.ImportPeopleAsync(SiteId, Source.Name, _text, _externalSystem, dryRun: false, MediaType, switchOffMissing: SwitchOff);
            _errorsOnly = _result.Errors > 0;
            if (_result.Applied)
            {
                _text = null;
                await OnImported.InvokeAsync();
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private string ActionLabel(string action, bool applied) => (action, applied) switch
    {
        ("create", false) => L["Create"],
        ("create", true) => L["Created"],
        ("update", false) => L["Update"],
        ("update", true) => L["Updated"],
        ("unchanged", _) => L["Unchanged"],
        _ => L["Error"],
    };

}
