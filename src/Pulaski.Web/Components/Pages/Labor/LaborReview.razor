@using System.Globalization
@inject PulaskiApiClient Api
@inject CurrentUser User
@inject TimeProvider Clock

@* A shift's labor (D-040): fix times before approval, approve once the shift has ended, correct afterwards. *@
<div class="inv-toolbar">
    <label class="small text-muted" for="review-day">@L["Day"]</label>
    <input id="review-day" type="date" class="form-control w-auto" value="@_day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @onchange="OnDayChangedAsync" />
    @foreach (var s in _shifts ?? [])
    {
        <button type="button" class="btn btn-sm @(Selected(s) ? "btn-secondary" : "btn-outline-secondary")" @key="(s.ShiftScheduleId, s.ShiftCode)" @onclick="() => OpenAsync(s)">
            @(s.ShiftCode is null ? L["Lines without shifts"] : $"{s.ShiftCode} {s.ShiftName}") <span class="@(s.IsApproved ? "text-success" : "text-muted")">@(s.IsApproved ? "approved" : $"{s.Sessions}")</span>
        </button>
    }
</div>

<ProblemAlert Error="_error" />
@if (_message is { } message)
{
    <div class="alert alert-success d-flex align-items-center gap-2" role="status">
        <span>@message</span>
        <button type="button" class="btn btn-sm btn-link ms-auto" @onclick="() => _message = null">@L["Dismiss"]</button>
    </div>
}

@if (_shifts is { Count: 0 })
{
    <div class="empty-panel"><p class="text-muted mb-0">@L["No labor recorded on {0}.", _day.ToString("ddd d MMM yyyy", CultureInfo.CurrentCulture)]</p></div>
}
else if (_shift is { } detail)
{
    var s = detail.Shift;
    <div class="inv-facts mb-3">
        <div class="d-flex flex-wrap gap-3 align-items-center">
            <div>
                <div class="fw-semibold">@(s.ShiftCode is null ? L["{0:ddd d MMM}, lines without shifts", s.ProductionDate] : L["Shift {0} {1}, {2:ddd d MMM}", s.ShiftCode, s.ShiftName, s.ProductionDate])</div>
                <div class="small text-muted">
                    @(s.Start is { } start ? $"{Time(start)}–{Time(s.End!.Value)}" : L["The whole day"])@(s.CrewCode is { } crew ? L[" · crew {0}", crew] : "")
                    · @L["{0} hours worked", Qty(s.Hours)]@(s.PaidBreakHours + s.UnpaidBreakHours > 0 ? L[", {0} on breaks", Qty(s.PaidBreakHours + s.UnpaidBreakHours)] : "") · @(s.Sessions == 1 ? L["1 session"] : L["Sessions: {0}", s.Sessions])@(s.OpenSessions > 0 ? L[", {0} open", s.OpenSessions] : "")
                </div>
            </div>
            <div class="ms-auto">
                @if (s.IsApproved)
                {
                    <span class="chip">@L["Approved by {0}, {1}", s.ApprovedBy, Display.SiteTime(s.ApprovedAt, TimeZone)]</span>
                }
                else if (CanApprove)
                {
                    <div class="d-flex gap-2 align-items-center">
                        <input class="form-control form-control-sm" style="width: 16rem" maxlength="500" placeholder="@L["Note (optional)"]" aria-label="@L["Approval note"]" @bind="_approveNote" />
                        <ActionButton Class="btn btn-sm btn-primary" Busy="_busy" Title="@L["Lock this shift's labor"]"
                                      Reason="@(HasEnded(s) ? null : L["The shift hasn't ended yet; approve it once it has."])" OnClick="ApproveAsync">Approve shift</ActionButton>
                    </div>
                }
            </div>
        </div>
        @if (!s.IsApproved && s.OpenSessions > 0)
        {
            <div class="small text-muted mt-1">@L["Approving ends the open sessions when the shift ended."]</div>
        }
    </div>

    @if (detail.PlannedBreaks.Count > 0)
    {
        <p class="small text-muted mb-1">
            @L["Planned:"] @string.Join(", ", detail.PlannedBreaks.Select(b => $"{b.Name} {b.Start:HH:mm}–{b.End:HH:mm}{(b.IsPaid ? $" ({L["paid"]})" : "")}"))
        </p>
    }
    @if (detail.MissedBreaks.Count > 0)
    {
        @* A flag only (#84): Pulaski records no break by itself; add one on the person's row if they took it. *@
        <div class="alert alert-warning small py-2" role="status">
            @L["No break recorded during a planned one: {0}. Add the break if they took it.", string.Join("; ", detail.MissedBreaks.Select(m => $"{m.PersonName} ({m.BreakName})"))]
        </div>
    }

    <div class="table-panel">
        <table class="table table-sm align-middle">
            <thead>
                <tr><th>@L["Person"]</th><th>@L["Line"]</th><th>@L["Time on"]</th><th>@L["From"]</th><th>@L["To"]</th><th class="inv-num">@L["Share"]</th><th class="inv-num">@L["Hours"]</th><th>@L["Recorded"]</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var row in detail.Sessions)
                {
                    var faded = row.IsSuperseded || row.IsVoid;
                    <tr @key="row.Id" class="@(faded ? "text-muted text-decoration-line-through" : "")">
                        <td><span class="fw-semibold">@row.PersonName</span> <span class="small text-muted">@row.EmployeeNumber</span></td>
                        <td>@row.EquipmentCode</td>
                        @if (_edit?.Id == row.Id && !_edit.IsVoid)
                        {
                            <td class="small">
                                @* What the time was for (#84): changing it on an approved shift is a correction, a new session. *@
                                <select class="form-select form-select-sm mb-1" aria-label="@L["Kind of time"]" @bind="_edit.LaborType">
                                    <option value="direct">@L["Direct"]</option>
                                    <option value="setup">@L["Setup"]</option>
                                    <option value="indirect">@L["Indirect"]</option>
                                    <option value="training">@L["Training"]</option>
                                </select>
                                @if (_edit.LaborType == "indirect")
                                {
                                    <select class="form-select form-select-sm" aria-label="@L["Reason"]" @bind="_edit.ReasonId">
                                        <option value="@Guid.Empty">@L["Reason…"]</option>
                                        @foreach (var r in _reasons)
                                        {
                                            <option value="@r.Id">@r.Name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <select class="form-select form-select-sm" aria-label="@L["Job"]" @bind="_edit.JobId">
                                        <option value="@Guid.Empty">@(_edit.LaborType == "setup" ? L["Job…"] : L["No job"])</option>
                                        @foreach (var job in _jobs)
                                        {
                                            <option value="@job.Id">@job.JobNumber@(job.MaterialCode is { } m ? $" · {m}" : "") · @L.Label(job.Status)</option>
                                        }
                                    </select>
                                }
                            </td>
                        }
                        else
                        {
                            <td class="small">@L.Label(row.LaborType)@(row.JobNumber is { } j ? $" · {j}" : "")@(row.ReasonName is { } r ? $" · {r}" : "")</td>
                        }
                        @if (_edit?.Id == row.Id)
                        {
                            <td><input type="datetime-local" class="form-control form-control-sm" aria-label="@L["From"]" @bind="_edit.From" /></td>
                            <td><input type="datetime-local" class="form-control form-control-sm" aria-label="@L["To"]" @bind="_edit.To" /></td>
                            <td class="inv-num"><input type="number" min="1" max="100" class="form-control form-control-sm text-end" style="width: 5rem" aria-label="@L["Share"]" @bind="_edit.Share" /></td>
                        }
                        else
                        {
                            <td class="small">@Time(row.StartedAt)</td>
                            <td class="small">@(row.EndedAt is { } e ? Time(e) : "open")</td>
                            <td class="inv-num">@Qty(row.AllocationPct)%</td>
                        }
                        <td class="inv-num" title="@(row.BreakHours > 0 ? L["{0} h of breaks left out", Qty(row.BreakHours)] : null)">@Qty(row.Hours)</td>
                        <td class="small text-muted">@Source(row)@(row.Note is { } n ? $" · {n}" : "")</td>
                        <td class="text-end text-nowrap">
                            @if (_edit?.Id == row.Id)
                            {
                                @if (_edit.IsCorrection)
                                {
                                    <input class="form-control form-control-sm d-inline-block" style="width: 12rem" maxlength="500" placeholder="@L["Why (required)"]" aria-label="@L["Why"]" @bind="_edit.Note" />
                                }
                                <ActionButton Class="btn btn-sm btn-primary" Busy="_busy" Reason="@EditProblem(_edit)" OnClick="() => SaveAsync(row)">@L["Save"]</ActionButton>
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => _edit = null">@L["Cancel"]</button>
                            }
                            else if (!row.IsApproved && CanRecord && !faded)
                            {
                                <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => StartEdit(row, false)">@L["Change"]</button>
                                @if (row.EndedAt is null)
                                {
                                    <button type="button" class="btn btn-sm btn-link p-0 ms-2" disabled="@_busy" @onclick="() => EndAsync(row)">@L["End"]</button>
                                }
                            }
                            else if (row.IsApproved && CanApprove && !faded)
                            {
                                <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => StartEdit(row, true)">@L["Correct"]</button>
                                <button type="button" class="btn btn-sm btn-link p-0 ms-2 text-danger" @onclick="() => StartVoid(row)">@L["Remove"]</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="small text-muted mt-2">@L["Struck-through rows were replaced or removed by a correction after approval; the hours count the correction. Hours are worked time: breaks are left out."]</p>

    <ShiftBreaksPanel @key="(s.ProductionDate, s.ShiftScheduleId, s.ShiftCode)" Detail="detail" TimeZone="@TimeZone" CanRecord="CanRecord" CanApprove="CanApprove"
                      OnChanged="() => OpenAsync(s)" />
}

@code {
    [Parameter, EditorRequired]
    public Guid SiteId { get; set; }

    [Parameter]
    public string? TimeZone { get; set; }

    /// <summary>The day to open on; today when not given.</summary>
    [Parameter]
    public DateOnly? Day { get; set; }

    private DateOnly _day;
    private IReadOnlyList<LaborShiftDto>? _shifts;
    private ShiftLaborDto? _shift;
    private RowEdit? _edit;
    private IReadOnlyList<LineJobDto> _jobs = [];
    private IReadOnlyList<ReasonCodeDto> _reasons = [];
    private string? _approveNote;
    private ApiException? _error;
    private string? _message;
    private bool _busy;

    private bool CanRecord => User.Can(PermissionCodes.LaborRecord, SiteId);

    private bool CanApprove => User.Can(PermissionCodes.LaborApprove, SiteId);

    protected override async Task OnInitializedAsync()
    {
        _day = Day ?? DateOnly.FromDateTime(Display.ToSite(Clock.GetUtcNow(), TimeZone).DateTime);
        await LoadShiftsAsync();
    }

    private bool Selected(LaborShiftDto s) => _shift is { } d && d.Shift.ShiftScheduleId == s.ShiftScheduleId && d.Shift.ShiftCode == s.ShiftCode && d.Shift.ProductionDate == s.ProductionDate;

    private bool HasEnded(LaborShiftDto s) =>
        (s.End ?? Display.FromSiteLocal(s.ProductionDate.AddDays(1).ToDateTime(TimeOnly.MinValue), TimeZone)) <= Clock.GetUtcNow();

    private string Time(DateTimeOffset at) => Display.ToSite(at, TimeZone).ToString("ddd HH:mm", CultureInfo.CurrentCulture);

    private static string Qty(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private string Source(LaborSessionDto row) => row.Source switch
    {
        "self" => L["Clocked on by {0}", row.RecordedBy],
        "terminal" => L["Badged at {0}", row.RecordedBy.Replace("terminal:", "", StringComparison.Ordinal)],
        "crew" => L["Crew check-in by {0}", row.RecordedBy],
        "correction" => row.IsVoid ? L["Removed by {0}", row.RecordedBy] : L["Correction by {0}", row.RecordedBy],
        _ => L["By {0}", row.RecordedBy],
    };

    private async Task OnDayChangedAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var day))
        {
            _day = day;
            _shift = null;
            await LoadShiftsAsync();
        }
    }

    private async Task LoadShiftsAsync()
    {
        try
        {
            _shifts = await Api.ListLaborShiftsAsync(SiteId, _day);
            // Open the first shift waiting for approval, else the first.
            if (_shift is null && _shifts.Count > 0)
            {
                await OpenAsync(_shifts.FirstOrDefault(s => !s.IsApproved && HasEnded(s)) ?? _shifts[0]);
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task OpenAsync(LaborShiftDto s)
    {
        _edit = null;
        try
        {
            _shift = await Api.GetShiftLaborAsync(SiteId, s.ProductionDate, s.ShiftScheduleId, s.ShiftCode);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task ReloadAsync()
    {
        if (_shift is { } current)
        {
            await OpenAsync(current.Shift);
        }

        _shifts = await Api.ListLaborShiftsAsync(SiteId, _day);
    }

    private async Task StartEdit(LaborSessionDto row, bool correction)
    {
        _edit = new RowEdit
        {
            Id = row.Id,
            IsCorrection = correction,
            LaborType = row.LaborType,
            JobId = row.JobId ?? Guid.Empty,
            ReasonId = row.ReasonCodeId ?? Guid.Empty,
            From = Display.ToSite(row.StartedAt, TimeZone).DateTime,
            To = row.EndedAt is { } ended ? Display.ToSite(ended, TimeZone).DateTime : null,
            Share = row.AllocationPct,
        };
        try
        {
            _jobs = await Api.ListLineJobsAsync(row.EquipmentId);
            _reasons = _reasons.Count > 0 ? _reasons : await Api.ListReasonCodesAsync("indirect_labor", SiteId);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    // Setup is for a job and indirect time needs a reason; a correction says why.
    private string? EditProblem(RowEdit edit) =>
        edit.IsCorrection && string.IsNullOrWhiteSpace(edit.Note) ? L["Say why: the shift is approved already."]
        : edit.IsVoid ? null
        : edit.LaborType == "setup" && edit.JobId == Guid.Empty ? L["Setup time is for a job: choose it."]
        : edit.LaborType == "indirect" && edit.ReasonId == Guid.Empty ? L["Indirect time needs a reason: choose it."]
        : null;

    private void StartVoid(LaborSessionDto row) => _edit = new RowEdit
    {
        Id = row.Id,
        IsCorrection = true,
        IsVoid = true,
        From = Display.ToSite(row.StartedAt, TimeZone).DateTime,
        To = row.EndedAt is { } e ? Display.ToSite(e, TimeZone).DateTime : null,
        Share = row.AllocationPct,
    };

    private Task SaveAsync(LaborSessionDto row) => RunAsync(async () =>
    {
        var edit = _edit!;
        var from = Display.FromSiteLocal(edit.From, TimeZone) ?? row.StartedAt;
        var to = Display.FromSiteLocal(edit.To, TimeZone);
        if (edit.IsCorrection)
        {
            await Api.CorrectLaborSessionAsync(row.Id, new CorrectLaborSessionRequest
            {
                Void = edit.IsVoid,
                EquipmentId = row.EquipmentId,
                JobId = edit.IsVoid ? row.JobId : edit.Job,
                LaborType = edit.IsVoid ? row.LaborType : edit.LaborType,
                ReasonCodeId = edit.IsVoid ? row.ReasonCodeId : edit.Reason,
                StartedAt = from,
                EndedAt = to ?? from,
                AllocationPct = edit.Share,
                Note = edit.Note ?? "",
            });
            _message = edit.IsVoid ? L["Removed {0}'s time.", row.PersonName] : L["Corrected {0}'s time.", row.PersonName];
        }
        else
        {
            await Api.UpdateLaborSessionAsync(row.Id, new UpdateLaborSessionRequest
            {
                Version = row.Version,
                EquipmentId = row.EquipmentId,
                JobId = edit.Job,
                LaborType = edit.LaborType,
                ReasonCodeId = edit.Reason,
                StartedAt = from,
                EndedAt = to,
                AllocationPct = edit.Share,
                Note = row.Note,
            });
        }

        _edit = null;
    });

    private Task EndAsync(LaborSessionDto row) => RunAsync(() => Api.ClockOffAsync(row.Id, new ClockOffRequest { Version = row.Version }));

    private Task ApproveAsync() => RunAsync(async () =>
    {
        var s = _shift!.Shift;
        var result = await Api.ApproveShiftAsync(SiteId, new ApproveShiftRequest
        {
            ProductionDate = s.ProductionDate,
            ShiftScheduleId = s.ShiftScheduleId,
            ShiftCode = s.ShiftCode,
            Note = _approveNote,
        });
        _message = string.Join(" ", ["Approved.", .. result.Notes]);
        _approveNote = null;
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class RowEdit
    {
        public Guid Id { get; init; }

        public bool IsCorrection { get; init; }

        public bool IsVoid { get; init; }

        public DateTime? From { get; set; }

        public DateTime? To { get; set; }

        public decimal Share { get; set; } = 100;

        public string? Note { get; set; }

        public string LaborType { get; set; } = "direct";

        public Guid JobId { get; set; }

        public Guid ReasonId { get; set; }

        // Indirect time has a reason and no job; the others no reason.
        public Guid? Job => LaborType == "indirect" || JobId == Guid.Empty ? null : JobId;

        public Guid? Reason => LaborType == "indirect" && ReasonId != Guid.Empty ? ReasonId : null;
    }
}
