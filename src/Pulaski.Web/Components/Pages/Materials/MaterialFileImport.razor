@inject PulaskiApiClient Api
@inject CurrentUser User

@* Bulk load from a file (D-034, D-053, D-055): materials in any source adapter's format, or capabilities from CSV. Pick what and
   the file, check it, then import it all or nothing. *@
<section class="inv-facts mb-3" aria-labelledby="import-title">
    <h2 class="h6" id="import-title">@L["Import from a file"]</h2>
    <div class="row g-2 mb-2 align-items-end">
        <div class="col-sm-2">
            <label class="form-label small" for="import-kind">@L["Import"]</label>
            <select id="import-kind" class="form-select" disabled="@_busy" @bind="_kind" @bind:after="RecheckAsync">
                <option value="@Materials">@L["Materials"]</option>
                @if (User.Can(PermissionCodes.Processes))
                {
                    <option value="@Capabilities">@L["Capabilities"]</option>
                }
            </select>
        </div>
        @if (_kind == Materials)
        {
            <div class="col-sm-2">
                <label class="form-label small" for="import-format">@L["Format"]</label>
                <select id="import-format" class="form-select" disabled="@_busy" @bind="_sourceName" @bind:after="RecheckAsync">
                    @foreach (var source in _sources)
                    {
                        <option value="@source.Name">@source.DisplayName</option>
                    }
                </select>
            </div>
        }
        @if (_kind == Materials && Source.TakesExternalSystem)
        {
            <div class="col-sm-3">
                <label class="form-label small" for="import-system">@L["External system"] <span class="text-muted">@L["(optional)"]</span></label>
                <input id="import-system" class="form-control" maxlength="100" placeholder="@L["e.g. ERP1"]" disabled="@_busy"
                       @bind="_externalSystem" @bind:after="RecheckAsync" />
            </div>
        }
        @if (_kind == Materials)
        {
            <div class="col-sm-3">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="import-classes" disabled="@_busy" @bind="_createClasses" @bind:after="RecheckAsync" />
                    <label class="form-check-label small" for="import-classes">@L["Create missing classes"]</label>
                </div>
            </div>
        }
        <div class="col-sm-auto">
            <a class="btn btn-link btn-sm px-0 mb-1" href="@TemplateHref" download="@Source.TemplateFileName">@L["Download a template"]</a>
        </div>
    </div>

    @if (_kind == Capabilities)
    {
        <p class="small text-muted mb-2">
            @L["One row per material and line; material, line, ideal_rate (per hour) and rate_unit are required, and site only when the line code is used at more than one site. A row changes the capability in effect now, or adds one from now; active = no ends it."]
            @L["With effective_from (a site-local date, yyyy-MM-dd) a row is the period starting that day: an open-ended period starting earlier ends there, and any other overlap is an error. effective_to (the day after the last) ends a period."]
            @L["The planning rate follows the ideal rate as on the material page. Nothing is saved until every row is valid."]
        </p>
        <p class="small mb-2"><span class="text-muted">@L["All columns:"]</span> <code>@CapabilityCsvFormat.Header</code></p>
    }
    else if (Source.Name == Csv)
    {
        <p class="small text-muted mb-2">
            @L["The first line names the columns; code, name, type and base_unit are required. A column left out keeps what each material already has. Rows with external_system and external_key are the ERP's items; the others are matched on their code. A class that doesn't exist is an error unless Create missing classes is ticked (class_name names it). Nothing is saved until every row is valid."]
        </p>
        <p class="small mb-2"><span class="text-muted">@L["All columns:"]</span> <code>@MaterialCsvFormat.Header</code></p>
    }
    else if (Source.Name == B2mml)
    {
        <p class="small text-muted mb-2">
            @L[Source.Description] @L["Each MaterialDefinition is one material: its ID is the code, its Description the name and its MaterialClassID the class. Type, base unit, lot tracking, shelf life and active come from properties with those IDs, such as MaterialType and BaseUnit. Each MaterialClass (its ID the code, its Description the name) is added if it is new and renamed if its name differs, whatever Create missing classes says. Export B2MML on this page writes this format."]
            @(Source.TakesExternalSystem ? L["With an external system, the materials are that system's items, matched on their ID; without one, they are Pulaski materials matched on their code. "] : "")
            @L["Nothing is saved until every material is valid."]
        </p>
    }
    else
    {
        <p class="small text-muted mb-2">@L[Source.Description] @L["Nothing is saved until every material is valid."]</p>
    }

    <div class="d-flex flex-wrap gap-2 align-items-center">
        <InputFile OnChange="PickAsync" accept="@string.Join(",", Source.FileTypes)" class="form-control" style="max-width: 28rem"
                   aria-label="@L["{0} file", Source.DisplayName]" disabled="@_busy" />
        <ActionButton Class="btn btn-primary" Busy="_busy" Reason="@ImportReadiness.Why(_result is not null, _result?.Applied == true, _result?.FileProblems.Count ?? 0, _result?.Errors ?? 0, _result is null ? 0 : _result.Created + _result.Updated + _result.CreatedClasses.Count + _result.RenamedClasses.Count)" OnClick="ImportAsync">
            @ImportLabel
        </ActionButton>
        <button type="button" class="btn btn-outline-secondary" @onclick="OnClose">@L["Close"]</button>
    </div>

    <ProblemAlert Error="_error" />
    @if (_readProblem is not null)
    {
        <div class="drawer-alert is-warning mt-3" role="alert"><Icon Name="alert" Size="18" /><span>@_readProblem</span></div>
    }

    @if (_busy)
    {
        <p class="text-muted small mt-3 mb-0">@L["Checking {0}…", _fileName]</p>
    }
    else if (_result is { } r)
    {
        <div class="drawer-alert @(r.Errors > 0 ? "is-warning" : "") mt-3" role="status">
            <Icon Name="@(r.Errors > 0 ? "alert" : "info")" Size="18" />
            <span>
                @if (r.Applied)
                {
                    @(L["Imported {0}: {1} created, {2} updated, {3} unchanged.", _fileName, r.Created, r.Updated, r.Unchanged])
                }
                else if (r.FileProblems.Count > 0)
                {
                    @(L["{0} can't be imported: {1}", _fileName, string.Join(" ", L.Notes(r.FileProblems))])
                }
                else if (r.Errors > 0)
                {
                    @(L["{0}: rows with errors: {1}. Nothing can be imported yet; fix them and pick the file again.", _fileName, r.Errors] +
                        (r.Rows.Count > r.Errors ? L[" The other rows would give {0} created, {1} updated, {2} unchanged.", r.Created, r.Updated, r.Unchanged] : ""))
                }
                else
                {
                    @(L["{0} is ready: {1} to create, {2} to update, {3} unchanged.", _fileName, r.Created, r.Updated, r.Unchanged])
                }
                @if (r.CreatedClasses.Count > 0)
                {
                    @(" " + (r.Applied ? L["Classes created: {0}.", string.Join(", ", r.CreatedClasses)] : L["Classes to create: {0}.", string.Join(", ", r.CreatedClasses)]))
                }
                @if (r.RenamedClasses.Count > 0)
                {
                    @(" " + (r.Applied ? L["Classes renamed: {0}.", string.Join(", ", r.RenamedClasses)] : L["Classes to rename: {0}.", string.Join(", ", r.RenamedClasses)]))
                }
            </span>
        </div>

        @if (r.Rows.Count > 0)
        {
            <div class="d-flex align-items-center gap-2 mt-2">
                @if (r.Errors > 0 && r.Rows.Count > r.Errors)
                {
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="import-errors" @bind="_errorsOnly" />
                        <label class="form-check-label small" for="import-errors">@L["Only rows with errors"]</label>
                    </div>
                }
            </div>
            <div class="table-panel mt-2" style="max-height: 24rem; overflow: auto">
                <table class="table table-sm align-middle mb-0 import-table">
                    <thead><tr><th class="inv-num">@L["Line"]</th><th>@L["Code"]</th><th>@(r.Applied ? L["Done"] : L["Would"])</th><th>@L["Details"]</th></tr></thead>
                    <tbody>
                        @foreach (var row in r.Rows.Where(x => !_errorsOnly || x.Action == "error"))
                        {
                            <tr @key="row.Line" class="@(row.Action == "error" ? "is-error" : row.Action == "unchanged" ? "text-muted" : "")">
                                <td class="inv-num">@row.Line</td>
                                <td class="fw-semibold">@row.Code</td>
                                <td>@ActionLabel(row.Action, r.Applied)</td>
                                <td class="small">
                                    @(row.Message is { } why ? L.Of(why) : (row.Changes.Count > 0 ? (r.Applied ? L["Changed: {0}", string.Join(", ", row.Changes)] : L["Changes: {0}", string.Join(", ", row.Changes)]) : ""))
                                    @foreach (var note in row.Notes)
                                    {
                                        <div class="text-muted">@L.Of(note)</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@code {
    /// <summary>Largest file read, matching the API's limit.</summary>
    private const long MaxBytes = 5 * 1024 * 1024;

    private const string Csv = "csv";
    private const string Materials = "materials";
    private const string Capabilities = "capabilities";
    private const string B2mml = "b2mml";

    // Offered until the API's list arrives, or if it can't be read.
    private static readonly MaterialSourceDto CsvSource = new()
    {
        Name = Csv,
        DisplayName = "CSV",
        FileTypes = [".csv", "text/csv", "text/plain"],
        Template = MaterialCsvFormat.Header + "\r\n",
        TemplateFileName = "materials.csv",
    };

    // Capabilities come only from CSV (D-055), through their own import.
    private static readonly MaterialSourceDto CapabilitySource = new()
    {
        Name = Capabilities,
        DisplayName = "CSV",
        FileTypes = [".csv", "text/csv", "text/plain"],
        Template = CapabilityCsvFormat.Header + "\r\n",
        TemplateFileName = "capabilities.csv",
    };

    [Parameter]
    public EventCallback OnImported { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private IReadOnlyList<MaterialSourceDto> _sources = [CsvSource];
    private string _kind = Materials;
    private string _sourceName = Csv;
    private bool _createClasses;
    private string? _externalSystem;
    private string? _text;
    private string? _fileName;
    private string? _readProblem;
    private ImportMaterialsResponse? _result;
    private ApiException? _error;
    private bool _busy;
    private bool _errorsOnly;

    private MaterialSourceDto Source => _kind == Capabilities ? CapabilitySource : _sources.FirstOrDefault(s => s.Name == _sourceName) ?? CsvSource;

    private string TemplateHref => $"data:{MediaType};charset=utf-8,{Uri.EscapeDataString(Source.Template)}";

    private string MediaType => Source.FileTypes.FirstOrDefault(t => t.Contains('/')) ?? "text/plain";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await Api.ListMaterialSourcesAsync() is { Count: > 0 } sources)
            {
                _sources = sources;
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private string ImportLabel => _result is { Errors: 0, Applied: false } r && r.Created + r.Updated > 0
        ? (_kind == Capabilities ? L["Import capabilities: {0}", r.Created + r.Updated] : L["Import materials: {0}", r.Created + r.Updated])
        : L["Import"];

    private async Task PickAsync(InputFileChangeEventArgs e)
    {
        _result = null;
        _error = null;
        _readProblem = null;
        _text = null;
        _fileName = e.File.Name;
        if (e.File.Size > MaxBytes)
        {
            _readProblem = L["{0} is larger than 5 MB; split it into smaller files.", e.File.Name];
            return;
        }

        _busy = true;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxBytes));
            _text = await reader.ReadToEndAsync();
            await CheckAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        catch (IOException ex)
        {
            _readProblem = L["{0} couldn't be read: {1}", e.File.Name, ex.Message];
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>A file already picked is checked again when its format or external system changes.</summary>
    private async Task RecheckAsync()
    {
        if (_text is null)
        {
            _result = null;
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await CheckAsync();
        }
        catch (ApiException ex)
        {
            _result = null;
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CheckAsync()
    {
        _result = await SendAsync(dryRun: true);
        _errorsOnly = _result.Errors > 0;
    }

    private Task<ImportMaterialsResponse> SendAsync(bool dryRun) => _kind == Capabilities
        ? Api.ImportCapabilitiesCsvAsync(_text!, dryRun)
        : Api.ImportMaterialsAsync(Source.Name, _text!, Source.TakesExternalSystem ? _externalSystem : null, dryRun, MediaType, _createClasses);

    private async Task ImportAsync()
    {
        if (_text is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _result = await SendAsync(dryRun: false);
            _errorsOnly = _result.Errors > 0;
            if (_result.Applied)
            {
                _text = null;
                await OnImported.InvokeAsync();
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private string ActionLabel(string action, bool applied) => (action, applied) switch
    {
        ("create", false) => L["Create"],
        ("create", true) => L["Created"],
        ("update", false) => L["Update"],
        ("update", true) => L["Updated"],
        ("unchanged", _) => L["Unchanged"],
        _ => L["Error"],
    };

}
