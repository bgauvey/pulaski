@page "/reasons"
@attribute [RequiresView(PermissionCodes.ReasonsView)]
@inject PulaskiApiClient Api
@inject SiteSelection Sites
@inject CurrentUser User

<PageTitle>Reasons · Pulaski</PageTitle>

<div class="mb-3">
    <h1 class="mb-1">Reason codes</h1>
    <p class="text-muted mb-0">
        The reasons people choose when they write stock up or off, hold a lot, and later code downtime or scrap. A code and its kind can't change once
        created, because history refers to them; switch a reason off instead of reusing it.
    </p>
</div>

<ProblemAlert Error="_error" />
<ViewOnlyNote Permission="@PermissionCodes.Reasons" What="maintain reason codes" />

<nav class="inv-tabs" aria-label="Kind">
    @foreach (var kind in Kinds)
    {
        <button type="button" class="inv-tab btn btn-link @(kind == _kind ? "active" : "")" @onclick="() => _kind = kind">
            @Display.Label(kind) <span class="small text-muted">@(_reasons?.Count(r => r.Kind == kind) ?? 0)</span>
        </button>
    }
</nav>

@if (CanEdit)
{
<form class="inv-toolbar" @onsubmit="CreateAsync" @onsubmit:preventDefault>
    <input class="form-control" style="min-width: 8rem; width: 10rem" maxlength="30" placeholder="CODE" aria-label="Code" @bind="_newCode" />
    <input class="form-control inv-grow" maxlength="100" placeholder="Name, e.g. Damaged in handling" aria-label="Name" @bind="_newName" />
    <select class="form-select" aria-label="Where it applies" @bind="_newSiteId">
        <option value="">Every site</option>
        @foreach (var site in Sites.Sites)
        {
            <option value="@site.Id">@site.Code only</option>
        }
    </select>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="new-comment" @bind="_newRequiresComment" />
        <label class="form-check-label" for="new-comment">Needs a comment</label>
    </div>
    <button type="submit" class="btn btn-primary" disabled="@(_saving || string.IsNullOrWhiteSpace(_newCode) || string.IsNullOrWhiteSpace(_newName))">Add @Display.Label(_kind).ToLowerInvariant() reason</button>
</form>
}

@if (_reasons is null)
{
    @if (_error is null)
    {
        <p class="text-muted">Loading…</p>
    }
}
else
{
    var shown = _reasons.Where(r => r.Kind == _kind).ToList();
    @if (shown.Count == 0)
    {
        <div class="empty-panel"><p class="text-muted mb-0">No @Display.Label(_kind).ToLowerInvariant() reasons yet. Add one above.</p></div>
    }
    else
    {
        <fieldset class="view-only-scope" disabled="@(!CanEdit)">
        <div class="table-panel">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Applies to</th>
                        <th>Needs a comment</th>
                        <th class="inv-num">Order</th>
                        <th>Active</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in shown)
                    {
                        var edit = Edit(r);
                        <tr @key="r.Id" class="@(r.IsActive ? "" : "text-muted")">
                            <td class="fw-semibold">@r.Code</td>
                            <td><input class="form-control form-control-sm" maxlength="100" aria-label="Name of @r.Code" value="@edit.Name" @onchange="e => Change(r, x => x with { Name = Text(e) })" disabled="@(!r.IsSelectable)" /></td>
                            <td>@(r.SiteCode ?? "Every site")</td>
                            <td><input class="form-check-input" type="checkbox" aria-label="@r.Code needs a comment" checked="@edit.RequiresComment" @onchange="e => Change(r, x => x with { RequiresComment = e.Value is true })" /></td>
                            <td class="inv-num"><input type="number" class="form-control form-control-sm text-end" style="width: 5rem" min="0" max="10000" aria-label="Order of @r.Code" value="@edit.SortOrder" @onchange="e => Change(r, x => x with { SortOrder = int.TryParse(Text(e), out var n) ? n : x.SortOrder })" /></td>
                            <td><input class="form-check-input" type="checkbox" aria-label="@r.Code active" checked="@edit.IsActive" @onchange="e => Change(r, x => x with { IsActive = e.Value is true })" /></td>
                            <td class="text-end">
                                @if (_edits.ContainsKey(r.Id))
                                {
                                    <button type="button" class="btn btn-sm btn-primary" disabled="@_saving" @onclick="() => SaveAsync(r)">Save</button>
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => _edits.Remove(r.Id)">Undo</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </fieldset>
    }
}

@code {
    private static readonly string[] Kinds = ["inventory_adjustment", "hold", "downtime", "scrap", "indirect_labor", "run_end", "spc_cause", "sample_exclusion"];

    private IReadOnlyList<ReasonCodeAdminDto>? _reasons;
    private readonly Dictionary<Guid, ReasonCodeAdminDto> _edits = [];
    private ApiException? _error;
    private string _kind = "inventory_adjustment";
    private string? _newCode;
    private string? _newName;
    private Guid? _newSiteId;
    private bool _newRequiresComment;
    private bool _saving;

    // A reason for every site is enterprise-wide, so holding the permission at any site is enough (D-037).
    private bool CanEdit => User.Can(PermissionCodes.Reasons);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Sites.EnsureAsync(Api);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }

        await LoadAsync();
    }

    private ReasonCodeAdminDto Edit(ReasonCodeAdminDto reason) => _edits.GetValueOrDefault(reason.Id) ?? reason;

    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    // Edits are kept until saved; one that brings a reason back to how it is drops out.
    private void Change(ReasonCodeAdminDto reason, Func<ReasonCodeAdminDto, ReasonCodeAdminDto> apply)
    {
        var changed = apply(Edit(reason));
        if (changed == reason)
        {
            _edits.Remove(reason.Id);
        }
        else
        {
            _edits[reason.Id] = changed;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _reasons = await Api.ListAllReasonCodesAsync();
            _edits.Clear();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task CreateAsync()
    {
        await RunAsync(async () =>
        {
            var nextOrder = (_reasons ?? []).Where(r => r.Kind == _kind).Select(r => r.SortOrder).DefaultIfEmpty(0).Max() + 10;
            await Api.CreateReasonCodeAsync(new CreateReasonCodeRequest
            {
                SiteId = _newSiteId,
                Kind = _kind,
                Code = _newCode!,
                Name = _newName!,
                RequiresComment = _newRequiresComment,
                SortOrder = Math.Min(nextOrder, 10_000),
            });
            _newCode = _newName = null;
            _newRequiresComment = false;
        });
    }

    private async Task SaveAsync(ReasonCodeAdminDto reason)
    {
        var edit = Edit(reason);
        await RunAsync(() => Api.UpdateReasonCodeAsync(reason.Id, new UpdateReasonCodeRequest
        {
            Version = reason.Version,
            Name = edit.Name,
            RequiresComment = edit.RequiresComment,
            SortOrder = edit.SortOrder,
            IsActive = edit.IsActive,
        }));
    }

    private async Task RunAsync(Func<Task> action)
    {
        _saving = true;
        _error = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }
}
