@page "/jobs/{JobId:guid}"
@attribute [RequiresView(PermissionCodes.FloorView, PermissionCodes.InventoryView)]
@using Pulaski.Web.Services.Execution
@inject PulaskiApiClient Api
@inject TimeProvider Clock
@inject CurrentUser User

<PageTitle>@(_job?.JobNumber ?? "Job") · Pulaski</PageTitle>

<div class="inv-head">
    <div>
        <div class="small mb-1"><ScreenLink Href="floor" Permission="@PermissionCodes.FloorView">← Floor</ScreenLink></div>
        <h1 class="mb-1">
            @(_job?.JobNumber ?? "Job")
            @if (_job is { } h)
            {
                <span class="@Display.JobStatusChip(h.Status) ms-2 align-middle">@Display.Label(h.Status)</span>
            }
        </h1>
        @if (_job is { } d)
        {
            <p class="text-muted mb-0">
                @(d.MaterialCode is { } code ? $"Makes {code} · {d.MaterialName} on {d.LineCode}" : $"{Display.Label(d.JobType)} on {d.LineCode}")
                @if (d.WorkOrderNumber is { } order)
                {
                    <span> · work order @order (@Display.Label(d.WorkOrderStatus))</span>
                }
            </p>
        }
    </div>
    @if (_job is { } j)
    {
        var actions = FloorView.ActionsFor(j);
        <div class="inv-head-tools">
            @if (j.JobType == "production")
            {
                <ScreenLink Href="@($"inventory/jobs/{JobId}")" Permission="@PermissionCodes.InventoryView" Hide class="btn btn-outline-secondary">Materials and lots</ScreenLink>
            }
            @if (actions.CanStart && !j.IsOnGroup && May(PermissionCodes.JobExecute))
            {
                <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="StartAsync">@(j.Status == "paused" ? "Resume" : "Start")</button>
            }
            @if (actions.CanPause && May(PermissionCodes.JobExecute))
            {
                <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="() => _stop = StopMode.Pause">Pause</button>
            }
            @if (actions.CanComplete && May(PermissionCodes.JobExecute))
            {
                <button type="button" class="btn btn-outline-secondary" disabled="@_busy"
                        @onclick="CompleteOrStopAsync">Complete</button>
            }
            @if (actions.CanReopen && May(PermissionCodes.JobReopen))
            {
                <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="ReopenAsync">Reopen</button>
            }
            @if (actions.CanReport && !_reporting && May(PermissionCodes.ProductionReport))
            {
                <button type="button" class="btn btn-primary" @onclick="() => _reporting = true">Report production</button>
            }
        </div>
    }
</div>

<ProblemAlert Error="_error" />
@if (_notes.Count > 0)
{
    <div class="drawer-alert mb-3" role="status"><Icon Name="info" Size="18" /><span>@string.Join(" ", _notes)</span></div>
}

@if (_job is { } job)
{
    @if (!job.IsReady && job.Waiting is { } waiting)
    {
        <div class="drawer-alert is-warning mb-3" role="status">
            <Icon Name="clock" Size="18" />
            <span>@waiting@(job.ReadyAt is { } at ? $" It can start at {Display.SiteTime(at, job.SiteTimeZone)}." : "")</span>
        </div>
    }
    @if (job.IsOnGroup)
    {
        <p class="text-muted">Waiting on its department: start it from the <ScreenLink Href="floor" Permission="@PermissionCodes.FloorView">Floor</ScreenLink>, choosing the line it runs on.</p>
    }

    <div class="inv-tiles">
        @if (job.PlannedQty is { } planned)
        {
            <div class="inv-tile"><span class="metric">@FloorView.Qty(planned)</span><span class="inv-tile-label">Planned, @job.UomCode</span></div>
            <div class="inv-tile">
                <span class="metric @(job.GoodQty == 0 ? "is-zero" : "")">@FloorView.Qty(job.GoodQty)</span>
                <span class="inv-tile-label">Good, @job.UomCode · @FloorView.Progress(planned, job.GoodQty)%</span>
            </div>
            <div class="inv-tile"><span class="metric @(job.ScrapQty == 0 ? "is-zero" : "")">@FloorView.Qty(job.ScrapQty)</span><span class="inv-tile-label">Scrap, @job.UomCode</span></div>
        }
        <div class="inv-tile"><span class="metric @(job.Runs.Count == 0 ? "is-zero" : "")">@job.Runs.Count</span><span class="inv-tile-label">@(job.Runs.Count == 1 ? "Run" : "Runs")</span></div>
    </div>

    @if (_stop is { } stop)
    {
        <StopJobForm JobId="job.JobId" Version="job.Version" SiteId="job.SiteId" Complete="stop == StopMode.Complete"
                     BatchSize="job.BatchSize" BatchRule="@job.BatchRule" BaseUomCode="@job.BaseUomCode"
                     OnDone="OnStoppedAsync" OnCancel="() => _stop = null" />
    }

    @if (_reporting)
    {
        <ReportProductionForm Job="job" OnReported="OnReportedAsync" OnCancel="() => _reporting = false" />
    }

    @if (job.PartialBatches.Count > 0)
    {
        <section class="inv-section" aria-labelledby="partials-title">
            <h2 id="partials-title">Partial batches</h2>
            <div class="table-panel">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Run</th><th>Lot</th><th class="inv-num">Quantity</th><th>Status</th><th>Reported</th><th>Decision</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in job.PartialBatches)
                        {
                            <tr @key="p.Id">
                                <td>@p.RunNo</td>
                                <td><ScreenLink Href="@($"inventory/lots/{p.LotId}")" Permission="@PermissionCodes.InventoryView">@p.LotNumber</ScreenLink></td>
                                <td class="inv-num">@FloorView.Qty(p.Quantity) of @FloorView.Qty(p.BatchSize) @p.UomCode</td>
                                <td><span class="@(p.Status == "pending" ? "chip chip-warning" : "chip")">@Display.Label(p.Status)</span></td>
                                <td class="small">@Display.SiteTime(p.OccurredAt, job.SiteTimeZone)</td>
                                <td class="small">@(p.DecidedAt is { } decided ? $"{Display.SiteTime(decided, job.SiteTimeZone)} by {p.DecidedBy}{(p.DecisionComment is { } c ? ": " + c : "")}" : "")</td>
                                <td class="text-end text-nowrap">
                                    @if (p.Status == "pending" && p.ReportedBy == User.Me?.ActorId)
                                    {
                                        <span class="small text-muted" title="Whoever reports a partial batch doesn't decide on it">You reported it: someone else decides</span>
                                    }
                                    else if (p.Status == "pending" && May(PermissionCodes.PartialBatchDecide))
                                    {
                                        <button type="button" class="btn btn-sm btn-primary" disabled="@_busy" @onclick="() => ApproveAsync(p)">Approve</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => _rejecting = p.Id">Reject</button>
                                    }
                                </td>
                            </tr>
                            @if (_rejecting == p.Id)
                            {
                                <tr>
                                    <td colspan="7">
                                        <div class="d-flex flex-wrap gap-2 align-items-end">
                                            <div>
                                                <label class="form-label small" for="reject-reason">Scrap reason</label>
                                                <select id="reject-reason" class="form-select form-select-sm" @bind="_rejectReason">
                                                    <option value="@Guid.Empty">Choose a reason…</option>
                                                    @foreach (var r in _scrapReasons)
                                                    {
                                                        <option value="@r.Id">@Display.ReasonLabel(r)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="flex-grow-1">
                                                <label class="form-label small" for="reject-comment">Comment</label>
                                                <input id="reject-comment" class="form-control form-control-sm" maxlength="1000" @bind="_decisionComment" />
                                            </div>
                                            <button type="button" class="btn btn-sm btn-primary" disabled="@(_busy || _rejectReason == Guid.Empty)" @onclick="() => RejectAsync(p)">Reject and write off</button>
                                            <button type="button" class="btn btn-sm btn-link" @onclick="() => _rejecting = null">Cancel</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="small text-muted">A partial batch of a finished good waits on hold until approved: approving releases its lot; rejecting writes it off and counts it as scrap.</p>
        </section>
    }

    <section class="inv-section" aria-labelledby="runs-title">
        <div class="inv-section-head">
            <h2 id="runs-title">Runs</h2>
            @if (job.IdealRatePerHour is { } rate)
            {
                <span class="small text-muted">Ideal rate @FloorView.Qty(rate) @job.UomCode/h; a run can hold up to @FloorView.Qty(job.RateTolerancePct)% of it.</span>
            }
        </div>
        @if (job.Runs.Count == 0)
        {
            <p class="text-muted">It hasn't run yet.</p>
        }
        else
        {
            <div class="table-panel">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Run</th><th>Line</th><th>Started</th><th>Ended</th><th>Length</th><th class="inv-num">Good</th><th class="inv-num">Scrap</th><th class="inv-num">Cap</th><th>Why it ended</th></tr></thead>
                    <tbody>
                        @foreach (var r in job.Runs)
                        {
                            <tr @key="r.Id">
                                <td class="fw-semibold">@r.RunNo</td>
                                <td>@r.LineCode</td>
                                <td class="small">@Display.SiteTime(r.StartedAt, job.SiteTimeZone)</td>
                                <td class="small">@(r.EndedAt is { } end ? Display.SiteTime(end, job.SiteTimeZone) : "running")</td>
                                <td class="small">@FloorView.Elapsed(r.StartedAt, r.EndedAt ?? Clock.GetUtcNow())</td>
                                <td class="inv-num">@FloorView.Qty(r.GoodQty)</td>
                                <td class="inv-num">@FloorView.Qty(r.ScrapQty)</td>
                                <td class="inv-num">@FloorView.Qty(r.CapQty)</td>
                                <td class="small">@(r.EndReason ?? (r.EndedAt is null ? "" : "—"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="inv-section" aria-labelledby="reports-title">
        <h2 id="reports-title">Production reports</h2>
        @if (job.Reports.Count == 0)
        {
            <p class="text-muted">Nothing reported yet.</p>
        }
        else
        {
            <div class="table-panel">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Entered</th><th>Run</th><th class="inv-num">Good</th><th class="inv-num">Scrap</th><th>Scrap reason</th><th>By</th><th>Comment</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in job.Reports)
                        {
                            <tr @key="(r.RunId, r.RecordedAt)" class="@(r.IsReversed ? "text-muted" : "")">
                                <td class="small">
                                    @Display.SiteTime(r.RecordedAt, job.SiteTimeZone)
                                    @if (r.IsLate)
                                    {
                                        <span class="chip ms-1" title="Entered after the run ended; counted at the run's end">late</span>
                                    }
                                    @if (r.IsReversed)
                                    {
                                        <span class="chip chip-muted ms-1" title="Reversed: its counts are offset and its lots taken back">reversed</span>
                                    }
                                </td>
                                <td>@r.RunNo</td>
                                <td class="inv-num">@FloorView.Qty(r.GoodQty)</td>
                                <td class="inv-num">@FloorView.Qty(r.ScrapQty)</td>
                                <td class="small">@r.ScrapReason</td>
                                <td class="small">@r.ActorId</td>
                                <td class="small">@r.Comment</td>
                                <td class="text-end">
                                    @if (r.ReportId is { } reportId && !r.IsReversed && May(PermissionCodes.ProductionCorrect))
                                    {
                                        <button type="button" class="btn btn-sm btn-link p-0" disabled="@_busy" @onclick="() => StartReverseAsync(reportId)">Reverse…</button>
                                    }
                                </td>
                            </tr>
                            @if (r.ReportId is { } open && open == _reversing)
                            {
                                <tr>
                                    <td colspan="8">
                                        <form class="inv-toolbar mb-0" @onsubmit="ReverseAsync" @onsubmit:preventDefault>
                                            <select class="form-select w-auto" aria-label="Reason" @bind="_reverseReason">
                                                <option value="@Guid.Empty">Reason…</option>
                                                @foreach (var reason in _adjustReasons)
                                                {
                                                    <option value="@reason.Id">@Display.ReasonLabel(reason)</option>
                                                }
                                            </select>
                                            <input class="form-control inv-grow" maxlength="1000" placeholder="Why, e.g. reported on the wrong job (required)" aria-label="Comment"
                                                   @bind="_reverseComment" @bind:event="oninput" />
                                            <button type="submit" class="btn btn-sm btn-danger" disabled="@(_busy || _reverseReason == Guid.Empty || string.IsNullOrWhiteSpace(_reverseComment))">Reverse report</button>
                                            <button type="button" class="btn btn-sm btn-link" @onclick="() => _reversing = null">Cancel</button>
                                        </form>
                                        <div class="form-text">
                                            Its good and scrap come off the run, and every lot it made gives the quantity back. A lot that has been used, split or
                                            moved into a silo since must be put right first; Pulaski says which.
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
else if (_error is null)
{
    <p class="text-muted">Loading…</p>
}

@code {
    // At the job's site (D-037). Viewing the job is open to everyone.
    private bool May(string permission) => _job is { } job && User.Can(permission, job.SiteId);

    [Parameter]
    public Guid JobId { get; set; }

    private JobExecutionDto? _job;
    private ApiException? _error;
    private IReadOnlyList<string> _notes = [];
    private bool _busy;
    private bool _reporting;
    private StopMode? _stop;
    private Guid? _rejecting;
    private Guid _rejectReason;
    private string? _decisionComment;
    private IReadOnlyList<ReasonCodeDto> _scrapReasons = [];
    private IReadOnlyList<ReasonCodeDto> _adjustReasons = [];
    private Guid? _reversing;
    private Guid _reverseReason;
    private string? _reverseComment;

    private enum StopMode
    {
        Pause,
        Complete,
    }

    protected override async Task OnParametersSetAsync()
    {
        _notes = [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _job = await Api.GetJobExecutionAsync(JobId);
            if (_job.PartialBatches.Any(p => p.Status == "pending") && _scrapReasons.Count == 0)
            {
                _scrapReasons = await Api.ListReasonCodesAsync("scrap", _job.SiteId);
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private Task StartAsync() => RunAsync(() => Api.StartJobAsync(JobId, new StartJobRequest { Version = _job!.Version }));

    private Task CompleteAsync() => RunAsync(() => Api.CompleteJobAsync(JobId, _job!.Version));

    private Task ReopenAsync() => RunAsync(() => Api.ReopenJobAsync(JobId, _job!.Version));

    private async Task RunAsync(Func<Task<ExecutionResponse>> action)
    {
        _busy = true;
        _error = null;
        try
        {
            _notes = (await action()).Notes;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>A running batch job may have a partial batch to report, so it asks first (D-036).</summary>
    private Task CompleteOrStopAsync()
    {
        if (_job is { BatchSize: not null, Status: "running" })
        {
            _stop = StopMode.Complete;
            return Task.CompletedTask;
        }

        return CompleteAsync();
    }

    private async Task OnStoppedAsync(ExecutionResponse result)
    {
        _stop = null;
        _notes = result.Notes;
        await LoadAsync();
    }

    private async Task StartReverseAsync(Guid reportId)
    {
        _error = null;
        try
        {
            if (_adjustReasons.Count == 0)
            {
                _adjustReasons = await Api.ListReasonCodesAsync("inventory_adjustment", _job!.SiteId);
            }

            (_reversing, _reverseReason, _reverseComment) = (reportId, Guid.Empty, null);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task ReverseAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.ReverseProductionReportAsync(JobId, _reversing!.Value,
                new ReverseProductionRequest { ReasonCodeId = _reverseReason, Comment = _reverseComment!.Trim() });
            _notes = [$"Reversed: run now has {FloorView.Qty(result.RunGoodQty)} good and {FloorView.Qty(result.RunScrapQty)} scrap; {result.Lots.Count} lot(s) took the output back."];
            _reversing = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ApproveAsync(PartialBatchDto partial) => DecideAsync(() => Api.ApprovePartialBatchAsync(partial.Id, null));

    private Task RejectAsync(PartialBatchDto partial) =>
        DecideAsync(() => Api.RejectPartialBatchAsync(partial.Id, _rejectReason, string.IsNullOrWhiteSpace(_decisionComment) ? null : _decisionComment.Trim()));

    private async Task DecideAsync(Func<Task<PartialBatchDecisionResponse>> decide)
    {
        _busy = true;
        _error = null;
        try
        {
            _notes = (await decide()).Notes;
            _rejecting = null;
            _rejectReason = Guid.Empty;
            _decisionComment = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnReportedAsync(ReportProductionResponse result)
    {
        _reporting = false;
        _notes = [$"Reported: run now has {FloorView.Qty(result.RunGoodQty)} good and {FloorView.Qty(result.RunScrapQty)} scrap{(result.Lot is { } lot ? $"; good output in lot {lot.LotNumber ?? "balance"}" : "")}.",
            .. result.Warnings.Select(w => w.Message)];
        await LoadAsync();
    }
}
