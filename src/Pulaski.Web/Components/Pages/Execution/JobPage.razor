@page "/jobs/{JobId:guid}"
@attribute [RequiresView(PermissionCodes.FloorView, PermissionCodes.InventoryView)]
@using Pulaski.Web.Services.Execution
@using Pulaski.Web.Services.Quality
@inject PulaskiApiClient Api
@inject TimeProvider Clock
@inject CurrentUser User
@inject Downloads Downloads
@inject LiveFeed LiveFeed
@implements IDisposable

<PageTitle>@(_job?.JobNumber ?? L["Job"]) · Pulaski</PageTitle>

<div class="inv-head">
    <div>
        <div class="small mb-1"><ScreenLink Href="floor" Permission="@PermissionCodes.FloorView">@L["← Floor"]</ScreenLink></div>
        <h1 class="mb-1">
            @(_job?.JobNumber ?? L["Job"])
            @if (_job is { } h)
            {
                <span class="@Display.JobStatusChip(h.Status) ms-2 align-middle">@L.Label(h.Status)</span>
            }
        </h1>
        @if (_job is { } d)
        {
            <p class="text-muted mb-0">
                @(d.MaterialCode is { } code ? L["Makes {0} · {1} on {2}", code, d.MaterialName, d.LineCode] : L["{0} on {1}", L.Label(d.JobType), d.LineCode])
                @if (d.WorkOrderNumber is { } order)
                {
                    <span> @L["· work order {0} ({1})", order, L.Label(d.WorkOrderStatus)]</span>
                }
            </p>
        }
    </div>
    @if (_job is { } j)
    {
        var actions = FloorView.ActionsFor(j);
        <div class="inv-head-tools">
            @if (j.JobType == "production")
            {
                <ScreenLink Href="@($"inventory/jobs/{JobId}")" Permission="@PermissionCodes.InventoryView" Hide class="btn btn-outline-secondary">@L["Materials and lots"]</ScreenLink>
            }
            @if (j.JobType == "production" && j.WorkOrderId is not null)
            {
                <button type="button" class="btn btn-outline-secondary" title="@L["Download the job's totals as a B2MML production performance for the ERP"]"
                        @onclick="DownloadPerformanceAsync">@L["Production performance (B2MML)"]</button>
            }
            @if (j.JobType == "production" && User.Can(PermissionCodes.QualityView, j.SiteId))
            {
                <a class="btn btn-outline-secondary" href="@($"quality/results?jobId={JobId}&jobNumber={Uri.EscapeDataString(j.JobNumber)}&materialId={j.MaterialId}")">@L["Quality results"]</a>
            }
            @if (actions.CanStart && !j.IsOnGroup && May(PermissionCodes.JobExecute))
            {
                <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="StartAsync">@(j.Status == "paused" ? L["Resume"] : L["Start"])</button>
            }
            @if (actions.CanPause && May(PermissionCodes.JobExecute))
            {
                <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="() => _stop = StopMode.Pause">@L["Pause"]</button>
            }
            @if (actions.CanComplete && May(PermissionCodes.JobExecute))
            {
                <button type="button" class="btn btn-outline-secondary" disabled="@_busy"
                        @onclick="CompleteOrStopAsync">@L["Complete"]</button>
            }
            @if (actions.CanReopen && May(PermissionCodes.JobReopen))
            {
                <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="ReopenAsync">@L["Reopen"]</button>
            }
            @if (actions.CanReport && !_reporting && May(PermissionCodes.ProductionReport))
            {
                <button type="button" class="btn btn-primary" @onclick="() => _reporting = true">@L["Report production"]</button>
            }
        </div>
    }
</div>

<ProblemAlert Error="_error" />
@if (_notes.Count > 0)
{
    <div class="drawer-alert mb-3" role="status"><Icon Name="info" Size="18" /><span>@string.Join(" ", _notes)</span></div>
}

@if (_job is { } job)
{
    @if (!job.IsReady && job.Waiting is { } waiting)
    {
        <div class="drawer-alert is-warning mb-3" role="status">
            <Icon Name="clock" Size="18" />
            <span>@waiting@(job.ReadyAt is { } at ? L[" It can start at {0}.", Display.SiteTime(at, job.SiteTimeZone)] : "")</span>
        </div>
    }
    @if (job.IsOnGroup)
    {
        <p class="text-muted">@L["Waiting on its department: start it from the Floor, choosing the line it runs on."] <ScreenLink Href="floor" Permission="@PermissionCodes.FloorView">@L["Floor"]</ScreenLink></p>
    }

    <div class="inv-tiles">
        @if (job.PlannedQty is { } planned)
        {
            <div class="inv-tile"><span class="metric">@FloorView.Qty(planned)</span><span class="inv-tile-label">@L["Planned, {0}", job.UomCode]</span></div>
            <div class="inv-tile">
                <span class="metric @(job.GoodQty == 0 ? "is-zero" : "")">@FloorView.Qty(job.GoodQty)</span>
                <span class="inv-tile-label">@L["Good, {0} · {1}%", job.UomCode, FloorView.Progress(planned, job.GoodQty)]</span>
            </div>
            <div class="inv-tile"><span class="metric @(job.ScrapQty == 0 ? "is-zero" : "")">@FloorView.Qty(job.ScrapQty)</span><span class="inv-tile-label">@L["Scrap, {0}", job.UomCode]</span></div>
        }
        <div class="inv-tile"><span class="metric @(job.Runs.Count == 0 ? "is-zero" : "")">@job.Runs.Count</span><span class="inv-tile-label">@(job.Runs.Count == 1 ? L["Run"] : L["Runs"])</span></div>
    </div>

    @if (_samples.Count > 0)
    {
        @* Samples the running job owes (#136, D-121): each spec item's plan, how it stands, and where to record it. *@
        <section class="inv-section" aria-labelledby="samples-title">
            <div class="d-flex align-items-center gap-2">
                <h2 id="samples-title" class="mb-0">@L["Samples"]</h2>
                @if (User.Can(PermissionCodes.QualityRecord, job.SiteId))
                {
                    <a class="btn btn-sm btn-outline-primary ms-auto" href="@($"quality/results?jobId={JobId}&jobNumber={Uri.EscapeDataString(job.JobNumber)}&materialId={job.MaterialId}")">@L["Record a result"]</a>
                }
            </div>
            <ul class="list-unstyled mb-0 mt-2">
                @foreach (var sample in _samples)
                {
                    <li class="d-flex flex-wrap gap-2 align-items-baseline mb-1" @key="sample.CharacteristicId">
                        <span class="@SampleView.Chip(sample.Status)">@SampleView.Status(L, sample.Status)</span>
                        <span class="fw-semibold">@sample.CharacteristicCode · @sample.CharacteristicName</span>
                        <span class="small text-muted">@SampleView.Plan(L, sample).</span>
                        <span class="small">@SampleView.Detail(L, sample)</span>
                    </li>
                }
            </ul>
        </section>
    }

    @if (_instructions.Count > 0)
    {
        <section class="inv-section" aria-labelledby="instructions-title">
            <h2 id="instructions-title">@(_instructions.Count == 1 ? L["Work instruction"] : L["Work instructions"])</h2>
            <JobInstructions Instructions="_instructions" OnFile="DownloadInstructionFileAsync">
                <Answer>
                    @if (May(context.Checklist.Phase == "setup" ? PermissionCodes.JobExecute : PermissionCodes.ProductionReport))
                    {
                        var key = (context.Instruction.InstructionId, context.Checklist.Phase);
                        <form @onsubmit="() => AnswerChecklistAsync(context.Instruction, context.Checklist)" @onsubmit:preventDefault>
                            <ChecklistFields Items="context.Checklist.Items" Answers="AnswersFor(key)" IdPrefix="@($"cl-{context.Instruction.InstructionId:N}-{context.Checklist.Phase}")" />
                            <div class="form-actions">
                                <ActionButton Type="submit" Class="btn btn-sm btn-primary" Busy="_busy">@L["Save the answers"]</ActionButton>
                            </div>
                        </form>
                    }
                </Answer>
                <SignOff Context="waiting">
                    @if (May(PermissionCodes.ChecklistSignOff))
                    {
                        <form class="row g-2 align-items-end mt-1" @onsubmit:preventDefault>
                            <div class="col-md-6">
                                <label class="form-label small" for="@($"so-{waiting.Checklist.ResponseId:N}")">@L["Note"] <span class="text-muted">@L["(needed to reject)"]</span></label>
                                <input id="@($"so-{waiting.Checklist.ResponseId:N}")" class="form-control form-control-sm" maxlength="500" @bind="_signOffNote" />
                            </div>
                            <div class="col-md-6 form-actions">
                                <ActionButton Class="btn btn-sm btn-success" Busy="_busy" OnClick="() => SignOffAsync(waiting.Checklist, approve: true)">@L["Sign it off"]</ActionButton>
                                <ActionButton Class="btn btn-sm btn-outline-danger" Busy="_busy" Reason="@(string.IsNullOrWhiteSpace(_signOffNote) ? L["Say why first."] : null)"
                                              OnClick="() => SignOffAsync(waiting.Checklist, approve: false)">@L["Reject"]</ActionButton>
                            </div>
                        </form>
                    }
                </SignOff>
            </JobInstructions>
        </section>
    }

    @if (_checklistHistory.Count > 0)
    {
        <section class="inv-section" aria-labelledby="checklists-title">
            <h2 id="checklists-title">@L["Checklists answered"]</h2>
            <div class="table-panel">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>@L["Run"]</th><th>@L["Checklist"]</th><th>@L["Outcome"]</th><th>@L["Answered"]</th><th>@L["Second sign-off"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in _checklistHistory)
                        {
                            <tr @key="r.Id">
                                <td>@(r.RunNo is { } no ? L["Run {0} on {1}", no, r.LineCode] : L["Before a run, on {0}", r.LineCode])</td>
                                <td>
                                    @Services.Instructions.ChecklistView.Title(L, r.Phase) · @r.InstructionCode v@(r.VersionNumber)
                                    <details class="small">
                                        <summary>@L["Answers"]</summary>
                                        <ol class="mb-0">
                                            @foreach (var a in r.Answers)
                                            {
                                                <li value="@a.Item" class="@(a.Ok ? "" : "text-danger")">@(r.Items.ElementAtOrDefault(a.Item - 1)?.Prompt): @Services.Instructions.ChecklistView.Answer(L, a.Value)</li>
                                            }
                                        </ol>
                                    </details>
                                </td>
                                <td>@Services.Instructions.ChecklistView.Outcome(L, r)</td>
                                <td class="small">@Display.SiteTime(r.CompletedAt, job.SiteTimeZone) · @r.CompletedByName</td>
                                <td class="small">
                                    @if (r.SignedOffAt is { } at)
                                    {
                                        @Display.SiteTime(at, job.SiteTimeZone)<span> · @r.SignedOffByName</span>
                                        @if (r.SignOffNote is { } note)
                                        {
                                            <div class="text-muted">@note</div>
                                        }
                                    }
                                    else if (r.SignOff == "pending")
                                    {
                                        <span class="text-muted">@L["Waiting"]</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if ((r.Result == "failed" || r.SignOff == "rejected") && May(PermissionCodes.NcrRaise))
                                    {
                                        <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => RaiseFrom(r.Id)">@L["Raise an NCR"]</button>
                                    }
                                </td>
                            </tr>
                            @if (_ncrFrom == r.Id)
                            {
                                <tr @key="@($"{r.Id}-ncr")">
                                    <td colspan="6">
                                        <Pulaski.Web.Components.Pages.Quality.RaiseNcrForm SiteId="job.SiteId" SourceKind="checklist" SourceId="r.Id"
                                                      Title="@L["{0} of job {1} not passed", Services.Instructions.ChecklistView.Title(L, r.Phase), job.JobNumber]" Canceled="() => _ncrFrom = null" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (_stop is { } stop)
    {
        <StopJobForm JobId="job.JobId" Version="job.Version" SiteId="job.SiteId" Complete="stop == StopMode.Complete"
                     BatchSize="job.BatchSize" BatchRule="@job.BatchRule" BaseUomCode="@job.BaseUomCode"
                     OnDone="OnStoppedAsync" OnCancel="() => _stop = null" />
    }

    @if (_reporting)
    {
        <ReportProductionForm Job="job" OnReported="OnReportedAsync" OnCancel="() => _reporting = false" />
    }

    @if (LotFillingView.Rule(L, job) is { } lotRule)
    {
        <section class="inv-section" aria-labelledby="filling-title">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <h2 id="filling-title" class="mb-0">@L["Lots being filled"]</h2>
                @if (job.FillingLots.Count > 0 && May(PermissionCodes.ProductionReport))
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="StartNewLotAsync"
                            title="@L["Close the lot being filled, so the next report starts a new one"]">@L["Start a new lot"]</button>
                }
            </div>
            <p class="small text-muted mt-1">@lotRule A lot that is moved, held, split, packed or used isn't filled any more.</p>
            @if (job.FillingLots.Count == 0)
            {
                <p class="small mb-0">@L["No lot is being filled: the next report starts one."]</p>
            }
            else
            {
                <div class="table-panel">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>@L["Lot"]</th><th>@L["Location"]</th><th class="inv-num">@L["Holds"]</th><th>@L["Started"]</th></tr></thead>
                        <tbody>
                            @foreach (var lot in job.FillingLots)
                            {
                                <tr @key="lot.LotId">
                                    <td><ScreenLink Href="@($"inventory/lots/{lot.LotId}")" Permission="@PermissionCodes.InventoryView">@lot.LotNumber</ScreenLink></td>
                                    <td>@lot.LocationCode</td>
                                    <td class="inv-num">@LotFillingView.Holds(L, job, lot)</td>
                                    <td class="small">@Display.SiteTime(lot.StartedAt, job.SiteTimeZone)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (job.PartialBatches.Count > 0)
    {
        <section class="inv-section" aria-labelledby="partials-title">
            <h2 id="partials-title">@L["Partial batches"]</h2>
            <div class="table-panel">
                <table class="table table-sm align-middle">
                    <thead><tr><th>@L["Run"]</th><th>@L["Lot"]</th><th class="inv-num">@L["Quantity"]</th><th>@L["Status"]</th><th>@L["Reported"]</th><th>@L["Decision"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in job.PartialBatches)
                        {
                            <tr @key="p.Id">
                                <td>@p.RunNo</td>
                                <td><ScreenLink Href="@($"inventory/lots/{p.LotId}")" Permission="@PermissionCodes.InventoryView">@p.LotNumber</ScreenLink></td>
                                <td class="inv-num">@L["{0} of {1} {2}", FloorView.Qty(p.Quantity), FloorView.Qty(p.BatchSize), p.UomCode]</td>
                                <td><span class="@(p.Status == "pending" ? "chip chip-warning" : "chip")">@L.Label(p.Status)</span></td>
                                <td class="small">@Display.SiteTime(p.OccurredAt, job.SiteTimeZone)</td>
                                <td class="small">@(p.DecidedAt is { } decided ? L["{0} by {1}{2}", Display.SiteTime(decided, job.SiteTimeZone), p.DecidedBy, (p.DecisionComment is { } c ? ": " + c : "")] : "")</td>
                                <td class="text-end text-nowrap">
                                    @if (p.Status == "pending" && p.ReportedBy == User.Me?.ActorId)
                                    {
                                        <span class="small text-muted" title="@L["Whoever reports a partial batch doesn't decide on it"]">@L["You reported it: someone else decides"]</span>
                                    }
                                    else if (p.Status == "pending" && May(PermissionCodes.PartialBatchDecide))
                                    {
                                        <button type="button" class="btn btn-sm btn-primary" disabled="@_busy" @onclick="() => ApproveAsync(p)">@L["Approve"]</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => _rejecting = p.Id">@L["Reject"]</button>
                                    }
                                </td>
                            </tr>
                            @if (_rejecting == p.Id)
                            {
                                <tr>
                                    <td colspan="7">
                                        <div class="d-flex flex-wrap gap-2 align-items-end">
                                            <div>
                                                <label class="form-label small" for="reject-reason">@L["Scrap reason"]</label>
                                                <select id="reject-reason" class="form-select form-select-sm" @bind="_rejectReason">
                                                    <option value="@Guid.Empty">@L["Choose a reason…"]</option>
                                                    @foreach (var r in _scrapReasons)
                                                    {
                                                        <option value="@r.Id">@Display.ReasonLabel(r)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="flex-grow-1">
                                                <label class="form-label small" for="reject-comment">@L["Comment"]</label>
                                                <input id="reject-comment" class="form-control form-control-sm" maxlength="1000" @bind="_decisionComment" />
                                            </div>
                                            <button type="button" class="btn btn-sm btn-primary" disabled="@(_busy || _rejectReason == Guid.Empty)" @onclick="() => RejectAsync(p)">@L["Reject and write off"]</button>
                                            <button type="button" class="btn btn-sm btn-link" @onclick="() => _rejecting = null">@L["Cancel"]</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="small text-muted">@L["A partial batch of a finished good waits on hold until approved: approving releases its lot; rejecting writes it off and counts it as scrap."]</p>
        </section>
    }

    <section class="inv-section" aria-labelledby="runs-title">
        <div class="inv-section-head">
            <h2 id="runs-title">@L["Runs"]</h2>
            @if (job.IdealRatePerHour is { } rate)
            {
                <span class="small text-muted">@L["Ideal rate {0} {1}/h; a run can hold up to {2}% of it.", FloorView.Qty(rate), job.UomCode, FloorView.Qty(job.RateTolerancePct)]</span>
            }
        </div>
        @if (job.Runs.Count == 0)
        {
            <p class="text-muted">@L["It hasn't run yet."]</p>
        }
        else
        {
            <div class="table-panel">
                <table class="table table-sm align-middle">
                    <thead><tr><th>@L["Run"]</th><th>@L["Line"]</th><th>@L["Started"]</th><th>@L["Ended"]</th><th>@L["Length"]</th><th class="inv-num">@L["Good"]</th><th class="inv-num">@L["Scrap"]</th><th class="inv-num">@L["Cap"]</th><th>@L["Why it ended"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in job.Runs)
                        {
                            <tr @key="r.Id">
                                <td class="fw-semibold">@r.RunNo</td>
                                <td>@r.LineCode</td>
                                <td class="small">@Display.SiteTime(r.StartedAt, job.SiteTimeZone)</td>
                                <td class="small">@(r.EndedAt is { } end ? Display.SiteTime(end, job.SiteTimeZone) : "running")</td>
                                <td class="small">@FloorView.Elapsed(r.StartedAt, r.EndedAt ?? Clock.GetUtcNow())</td>
                                <td class="inv-num">@FloorView.Qty(r.GoodQty)</td>
                                <td class="inv-num">@FloorView.Qty(r.ScrapQty)</td>
                                <td class="inv-num">@FloorView.Qty(r.CapQty)</td>
                                <td class="small">@(r.EndReason ?? (r.EndedAt is null ? "" : "—"))</td>
                                <td class="text-end">
                                    @if (May(PermissionCodes.NcrRaise))
                                    {
                                        <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => RaiseFrom(r.Id)">@L["Raise an NCR"]</button>
                                    }
                                </td>
                            </tr>
                            @if (_ncrFrom == r.Id)
                            {
                                <tr @key="@($"{r.Id}-ncr")">
                                    <td colspan="10">
                                        <Pulaski.Web.Components.Pages.Quality.RaiseNcrForm SiteId="job.SiteId" SourceKind="run" SourceId="r.Id"
                                                      Title="@L["Job {0}, run {1} on {2}", job.JobNumber, r.RunNo, r.LineCode]" Canceled="() => _ncrFrom = null" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="inv-section" aria-labelledby="reports-title">
        <h2 id="reports-title">@L["Production reports"]</h2>
        @if (job.Reports.Count == 0)
        {
            <p class="text-muted">@L["Nothing reported yet."]</p>
        }
        else
        {
            <div class="table-panel">
                <table class="table table-sm align-middle">
                    <thead><tr><th>@L["Entered"]</th><th>@L["Run"]</th><th class="inv-num">@L["Good"]</th><th class="inv-num">@L["Scrap"]</th><th>@L["Scrap reason"]</th><th>@L["By"]</th><th>@L["Comment"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in job.Reports)
                        {
                            <tr @key="(r.RunId, r.RecordedAt)" class="@(r.IsReversed ? "text-muted" : "")">
                                <td class="small">
                                    @Display.SiteTime(r.RecordedAt, job.SiteTimeZone)
                                    @if (r.IsLate)
                                    {
                                        <span class="chip ms-1" title="@L["Entered after the run ended; counted at the run's end"]">@L["late"]</span>
                                    }
                                    @if (r.MachineThrough is { } through)
                                    {
                                        <span class="chip ms-1" title="@L["From the machine: its counts up to {0}", Display.SiteTime(through, job.SiteTimeZone)]">@L["machine"]</span>
                                    }
                                    @if (r.IsReversed)
                                    {
                                        <span class="chip chip-muted ms-1" title="@L["Reversed: its counts are offset and its lots taken back"]">@L["reversed"]</span>
                                    }
                                </td>
                                <td>@r.RunNo</td>
                                <td class="inv-num">@FloorView.Qty(r.GoodQty)</td>
                                <td class="inv-num">@FloorView.Qty(r.ScrapQty)</td>
                                <td class="small">@r.ScrapReason</td>
                                <td class="small">@r.ActorId</td>
                                <td class="small">@r.Comment</td>
                                <td class="text-end">
                                    @if (r.ReportId is { } reportId && !r.IsReversed && May(PermissionCodes.ProductionCorrect))
                                    {
                                        <button type="button" class="btn btn-sm btn-link p-0 me-2" disabled="@_busy" @onclick="() => StartReverseAsync(reportId, r)">@L["Correct…"]</button>
                                        <button type="button" class="btn btn-sm btn-link p-0" disabled="@_busy" @onclick="() => StartReverseAsync(reportId)">@L["Reverse…"]</button>
                                    }
                                </td>
                            </tr>
                            @if (r.ReportId is { } open && open == _reversing)
                            {
                                <tr>
                                    <td colspan="8">
                                        <form class="inv-toolbar mb-0" @onsubmit="ReverseAsync" @onsubmit:preventDefault>
                                            @if (_correcting)
                                            {
                                                @* The right figures (#80): the report is reversed and these reported in its place, in one go. *@
                                                @if (job.BatchSize is not null)
                                                {
                                                    <input class="form-control" style="width: 14rem" placeholder="@L["Good batches, each weight"]" aria-label="@L["Good batch weights, comma-separated"]" @bind="_fixBatches" />
                                                }
                                                else
                                                {
                                                    <input type="number" step="any" min="0" class="form-control" style="width: 8rem" aria-label="@L["Good"]" placeholder="@L["Good"]" @bind="_fixGood" />
                                                }
                                                <input type="number" step="any" min="0" class="form-control" style="width: 8rem" aria-label="@L["Scrap"]" placeholder="@L["Scrap"]" @bind="_fixScrap" />
                                                @if (_fixScrap > 0)
                                                {
                                                    <select class="form-select w-auto" aria-label="@L["Scrap reason"]" @bind="_fixScrapReason">
                                                        <option value="@Guid.Empty">@L["Scrap reason…"]</option>
                                                        @foreach (var reason in _scrapReasons)
                                                        {
                                                            <option value="@reason.Id">@Display.ReasonLabel(reason)</option>
                                                        }
                                                    </select>
                                                }
                                            }
                                            <select class="form-select w-auto" aria-label="@L["Reason"]" @bind="_reverseReason">
                                                <option value="@Guid.Empty">@L["Reason…"]</option>
                                                @foreach (var reason in _adjustReasons)
                                                {
                                                    <option value="@reason.Id">@Display.ReasonLabel(reason)</option>
                                                }
                                            </select>
                                            <input class="form-control inv-grow" maxlength="1000" placeholder="@L["Why, e.g. reported on the wrong job (required)"]" aria-label="@L["Comment"]"
                                                   @bind="_reverseComment" @bind:event="oninput" />
                                            <ActionButton Type="submit" Class="@(_correcting ? "btn btn-sm btn-primary" : "btn btn-sm btn-danger")" Busy="_busy"
                                                          Reason="@(_reverseReason == Guid.Empty ? L["Choose why first."] : string.IsNullOrWhiteSpace(_reverseComment) ? L["Say why first."] : null)">
                                                @(_correcting ? L["Correct report"] : L["Reverse report"])
                                            </ActionButton>
                                            <button type="button" class="btn btn-sm btn-link" @onclick="() => _reversing = null">@L["Cancel"]</button>
                                        </form>
                                        <div class="form-text">
                                            @(_correcting ? L["The report is reversed and the figures above reported in its place, at its time, in one go: its lots give their quantity back and new lots are made. "] : "")
                                            @L["Its good and scrap come off the run, and every lot it made gives the quantity back. A lot that has been used, split or moved into a silo since must be put right first; Pulaski says which."]
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
else if (_error is null)
{
    <p class="text-muted">@L["Loading…"]</p>
}

@code {
    // At the job's site (D-037). Viewing the job is open to everyone.
    private bool May(string permission) => _job is { } job && User.Can(permission, job.SiteId);

    [Parameter]
    public Guid JobId { get; set; }

    private JobExecutionDto? _job;
    private ApiException? _error;
    private IReadOnlyList<string> _notes = [];
    private bool _busy;
    private bool _reporting;
    private StopMode? _stop;
    private Guid? _rejecting;
    private Guid _rejectReason;
    private string? _decisionComment;
    private IReadOnlyList<ReasonCodeDto> _scrapReasons = [];
    private IReadOnlyList<ReasonCodeDto> _adjustReasons = [];
    private Guid? _reversing;
    private Guid _reverseReason;
    private string? _reverseComment;
    private bool _correcting;
    private decimal _fixGood;
    private decimal _fixScrap;
    private Guid _fixScrapReason;
    private string? _fixBatches;

    private IReadOnlyList<JobInstructionDto> _instructions = [];

    private readonly Dictionary<(Guid, string), Dictionary<int, string?>> _answers = [];
    private IReadOnlyList<ChecklistRecordDto> _checklistHistory = [];

    // The run or checklist answer an NCR is being raised from (#133b).
    private Guid? _ncrFrom;

    private void RaiseFrom(Guid source) => _ncrFrom = source;
    private IReadOnlyList<DueSampleDto> _samples = [];
    private string? _signOffNote;

    private async Task SignOffAsync(JobChecklistDto checklist, bool approve)
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.SignOffChecklistAsync(checklist.ResponseId!.Value, new SignOffChecklistRequest { Approve = approve, Note = _signOffNote });
            _signOffNote = null;
            _notes = [approve ? L["{0} is signed off.", Services.Instructions.ChecklistView.Title(L, checklist.Phase)]
                : L["{0} is rejected: it is to be answered again.", Services.Instructions.ChecklistView.Title(L, checklist.Phase)]];
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private Dictionary<int, string?> AnswersFor((Guid, string) key) =>
        _answers.TryGetValue(key, out var answers) ? answers : _answers[key] = [];

    private async Task AnswerChecklistAsync(JobInstructionDto instruction, JobChecklistDto checklist)
    {
        _busy = true;
        _error = null;
        try
        {
            var key = (instruction.InstructionId, checklist.Phase);
            var done = await Api.CompleteChecklistAsync(JobId, checklist.Phase, new CompleteChecklistRequest
            {
                InstructionId = instruction.InstructionId,
                Answers = Services.Instructions.ChecklistView.ToSend(checklist.Items, AnswersFor(key)),
            });
            _answers.Remove(key);
            _notes = [done.WaitsForSignOff ? L["{0} passed and waits for a second sign-off.", Services.Instructions.ChecklistView.Title(L, checklist.Phase)]
                : done.Passed ? L["{0} passed.", Services.Instructions.ChecklistView.Title(L, checklist.Phase)]
                : L["{0} failed: put it right and answer it again.", Services.Instructions.ChecklistView.Title(L, checklist.Phase)]];
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadInstructionFileAsync((JobInstructionDto Instruction, InstructionFileDto File) chosen)
    {
        try
        {
            var (content, type, name) = await Api.GetInstructionFileAsync(chosen.Instruction.InstructionId, chosen.File.Id);
            await Downloads.FileAsync(name, content, type);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private enum StopMode
    {
        Pause,
        Complete,
    }

    // Live updates (#143): a change to this job (a report, a start, a checklist) shows here within seconds, unless a form is open.
    private IDisposable? _liveFeed;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // A result recorded anywhere may be one of its samples (#136): results carry no site, so the page reads its samples again.
            var job = LiveFilters.To("job", () => JobId);
            _liveFeed = LiveFeed.Subscribe(c => job(c) || (c.Kind == "quality_result" && _samples.Count > 0), () => InvokeAsync(async () =>
            {
                if (!_busy && !_reporting && _stop is null && _reversing is null)
                {
                    await LoadAsync();
                    StateHasChanged();
                }
            }));
        }
    }

    public void Dispose() => _liveFeed?.Dispose();

    protected override async Task OnParametersSetAsync()
    {
        _notes = [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _job = await Api.GetJobExecutionAsync(JobId);
            // The released instructions for its operation, line and material (#126b).
            var mayRead = User.Can(PermissionCodes.FloorView, _job.SiteId) || User.Can(PermissionCodes.InstructionsView, _job.SiteId);
            _instructions = mayRead ? await Api.GetJobInstructionsAsync(JobId) : [];
            _checklistHistory = mayRead ? await Api.GetJobChecklistsAsync(JobId) : [];
            _samples = User.Can(PermissionCodes.FloorView, _job.SiteId) || User.Can(PermissionCodes.QualityView, _job.SiteId)
                ? await Api.ListJobDueSamplesAsync(JobId)
                : [];
            if (_job.PartialBatches.Any(p => p.Status == "pending") && _scrapReasons.Count == 0)
            {
                _scrapReasons = await Api.ListReasonCodesAsync("scrap", _job.SiteId);
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private Task StartAsync() => RunAsync(() => Api.StartJobAsync(JobId, new StartJobRequest { Version = _job!.Version }));

    private Task CompleteAsync() => RunAsync(() => Api.CompleteJobAsync(JobId, _job!.Version));

    private Task ReopenAsync() => RunAsync(() => Api.ReopenJobAsync(JobId, _job!.Version));

    private async Task StartNewLotAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var closed = await Api.StartNewLotAsync(JobId, null);
            _notes = [(closed.ClosedLots.Count == 1 ? L["Closed lot {0}; the next report starts a new lot.", closed.ClosedLots[0]] : L["Closed lots {0}; the next report starts a new lot.", string.Join(", ", closed.ClosedLots)])];
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadPerformanceAsync()
    {
        _error = null;
        try
        {
            var (content, type, name) = await Api.GetJobProductionPerformanceAsync(JobId);
            await Downloads.FileAsync(name, content, type);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task RunAsync(Func<Task<ExecutionResponse>> action)
    {
        _busy = true;
        _error = null;
        try
        {
            _notes = L.Notes((await action()).Notes);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>A running batch job may have a partial batch to report, so it asks first (D-036).</summary>
    private Task CompleteOrStopAsync()
    {
        if (_job is { BatchSize: not null, Status: "running" })
        {
            _stop = StopMode.Complete;
            return Task.CompletedTask;
        }

        return CompleteAsync();
    }

    private async Task OnStoppedAsync(ExecutionResponse result)
    {
        _stop = null;
        _notes = L.Notes(result.Notes);
        await LoadAsync();
    }

    private async Task StartReverseAsync(Guid reportId, ProductionReportDto? correct = null)
    {
        _error = null;
        try
        {
            if (_adjustReasons.Count == 0)
            {
                _adjustReasons = await Api.ListReasonCodesAsync("inventory_adjustment", _job!.SiteId);
            }

            if (correct is not null && _scrapReasons.Count == 0)
            {
                _scrapReasons = await Api.ListReasonCodesAsync("scrap", _job!.SiteId);
            }

            (_reversing, _reverseReason, _reverseComment, _correcting) = (reportId, Guid.Empty, null, correct is not null);
            if (correct is not null)
            {
                (_fixGood, _fixScrap, _fixBatches) = (correct.GoodQty, correct.ScrapQty, null);
                _fixScrapReason = _scrapReasons.FirstOrDefault(r => r.Name == correct.ScrapReason)?.Id ?? Guid.Empty;
            }
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task ReverseAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            if (_correcting)
            {
                if (FloorView.ParseQuantities(_fixBatches) is not { } batches)
                {
                    _error = new ApiException(400, L["Batches"], L["Type each good batch's weight as a number, separated by commas, such as 1000, 998.5."], null);
                    return;
                }

                var fixedReport = await Api.CorrectProductionReportAsync(JobId, _reversing!.Value, new CorrectProductionRequest
                {
                    GoodQty = _job!.BatchSize is not null ? batches.Sum() : _fixGood,
                    ScrapQty = _fixScrap,
                    ScrapReasonCodeId = _fixScrap > 0 && _fixScrapReason != Guid.Empty ? _fixScrapReason : null,
                    GoodBatches = _job.BatchSize is not null ? batches : [],
                    ReasonCodeId = _reverseReason,
                    Comment = _reverseComment!.Trim(),
                });
                _notes = [L["Corrected: run now has {0} good and {1} scrap; lots that gave their output back: {2}; new lots: {3}.", FloorView.Qty(fixedReport.RunGoodQty), FloorView.Qty(fixedReport.RunScrapQty), fixedReport.TakenBack.Count, fixedReport.Lots.Count], .. fixedReport.Warnings.Select(w => w.Message)];
                _reversing = null;
                await LoadAsync();
                return;
            }

            var result = await Api.ReverseProductionReportAsync(JobId, _reversing!.Value,
                new ReverseProductionRequest { ReasonCodeId = _reverseReason, Comment = _reverseComment!.Trim() });
            _notes = [L["Reversed: run now has {0} good and {1} scrap; {2} lot(s) took the output back.", FloorView.Qty(result.RunGoodQty), FloorView.Qty(result.RunScrapQty), result.Lots.Count]];
            _reversing = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ApproveAsync(PartialBatchDto partial) => DecideAsync(() => Api.ApprovePartialBatchAsync(partial.Id, null));

    private Task RejectAsync(PartialBatchDto partial) =>
        DecideAsync(() => Api.RejectPartialBatchAsync(partial.Id, _rejectReason, string.IsNullOrWhiteSpace(_decisionComment) ? null : _decisionComment.Trim()));

    private async Task DecideAsync(Func<Task<PartialBatchDecisionResponse>> decide)
    {
        _busy = true;
        _error = null;
        try
        {
            _notes = L.Notes((await decide()).Notes);
            _rejecting = null;
            _rejectReason = Guid.Empty;
            _decisionComment = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnReportedAsync(ReportProductionResponse result)
    {
        _reporting = false;
        _notes = [L["Reported: run now has {0} good and {1} scrap{2}.", FloorView.Qty(result.RunGoodQty), FloorView.Qty(result.RunScrapQty), (result.Lots.Count > 1 ? L["; good output in lots {0}", string.Join(", ", result.Lots.Select(l => l.LotNumber ?? L["balance"]))] : result.Lot is { } lot ? L["; good output in lot {0}", lot.LotNumber ?? L["balance"]] : "")],
            .. result.Warnings.Select(L.Of)];
        await LoadAsync();
    }
}
