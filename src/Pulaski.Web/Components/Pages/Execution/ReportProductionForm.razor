@using Pulaski.Web.Services.Inventory
@using Pulaski.Web.Services.Execution
@inject PulaskiApiClient Api

@* Reports good and scrap into one of a job's runs (D-035): its open run, or an earlier one for production found later. *@
<form class="inv-facts mb-3" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <h3 class="h6">@L["Report production for {0}", Job.JobNumber]</h3>
    <ProblemAlert Error="_error" />

    <div class="row g-2">
        <div class="col-12">
            <label class="form-label" for="rep-run-@Job.JobId">@L["Run"]</label>
            <select id="rep-run-@Job.JobId" class="form-select" @bind="_runId" @bind:after="ClearMachine">
                @foreach (var r in Job.Runs.Reverse())
                {
                    <option value="@r.Id">
                        @L["Run {0} on {1}", r.RunNo, r.LineCode] · @(r.EndedAt is { } end ? L["{0} to {1}", Display.SiteTime(r.StartedAt, Job.SiteTimeZone), Display.SiteTime(end, Job.SiteTimeZone)] : L["{0} · running now", Display.SiteTime(r.StartedAt, Job.SiteTimeZone)])
                    </option>
                }
            </select>
            @if (SelectedRun is { } run)
            {
                <div class="form-text">
                    @if (run.EndedAt is not null)
                    {
                        <span>@L["Recorded late, into a run that has ended."] </span>
                    }
                    @if (FloorView.RoomLeft(run.CapQty, run.GoodQty, run.ScrapQty) is { } room)
                    {
                        <span>@L["Up to {0} {1} more fits this run at the line's rate.", FloorView.Qty(room), Job.UomCode]</span>
                    }
                    else
                    {
                        <span>@L["The line has no ideal rate for this material, so the rate isn't checked."]</span>
                    }
                </div>
            }
        </div>
        @if (IsBatch)
        {
            <div class="col-12">
                <div class="form-label">@L["Good batches, {0} each", Job.BaseUomCode] <span class="text-muted">(@(Job.BatchRule == "exact" ? L["batch size {0} {1}, exact", FloorView.Qty(Job.BatchSize), Job.BaseUomCode] : L["batch size {0} {1}, ± {2}%", FloorView.Qty(Job.BatchSize), Job.BaseUomCode, FloorView.Qty(Job.BatchTolerancePct)]))</span></div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    @for (var i = 0; i < _goodBatches.Count; i++)
                    {
                        var index = i;
                        <input type="number" inputmode="decimal" min="0" step="any" class="form-control" style="width: 7rem" aria-label="@L["Good batch {0}", index + 1]"
                               value="@_goodBatches[index]" @oninput="e => SetBatch(_goodBatches, index, e)" />
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _goodBatches.Add(BatchSize)">@L["Add batch"]</button>
                    @if (_goodBatches.Count > 0)
                    {
                        <button type="button" class="btn btn-sm btn-link" @onclick="() => _goodBatches.RemoveAt(_goodBatches.Count - 1)">@L["Remove last"]</button>
                    }
                </div>
            </div>
            <div class="col-12">
                <div class="form-label">@L["Rejected batches"] <span class="text-muted">@L["(scrap)"]</span></div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    @for (var i = 0; i < _scrapBatches.Count; i++)
                    {
                        var index = i;
                        <input type="number" inputmode="decimal" min="0" step="any" class="form-control" style="width: 7rem" aria-label="@L["Rejected batch {0}", index + 1]"
                               value="@_scrapBatches[index]" @oninput="e => SetBatch(_scrapBatches, index, e)" />
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _scrapBatches.Add(BatchSize)">@L["Add rejected batch"]</button>
                    @if (_scrapBatches.Count > 0)
                    {
                        <button type="button" class="btn btn-sm btn-link" @onclick="() => _scrapBatches.RemoveAt(_scrapBatches.Count - 1)">@L["Remove last"]</button>
                    }
                </div>
            </div>
            @if (SelectedRun is { HasPartialBatch: false } selectedRun && (selectedRun.EndedWithReason || Job.PartialBatchPlanned))
            {
                <div class="col-6">
                    <label class="form-label" for="rep-partial-@Job.JobId">@L["Partial batch, {0}", Job.BaseUomCode]</label>
                    <input id="rep-partial-@Job.JobId" type="number" inputmode="decimal" min="0" step="any" class="form-control" placeholder="@L["None"]" @bind="_partial" @bind:event="oninput" />
                    <div class="form-text">
                        @(Job.PartialBatchPlanned ? L["This job was planned with a partial last batch; report it here when it is made."] : L["This run stopped with a reason, so the batch it was making can be added."])
                        @(Job.BatchRule == "exact" ? " It waits on hold for approval." : "")
                    </div>
                </div>
            }
        }
        else
        {
            @* From the machine (#27): the counts since the run's last report from the machine fill in good and scrap, which the operator checks. *@
            <div class="col-12">
                @if (_machine is null)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(SelectedRun is null || _loadingMachine)" @onclick="LoadMachineAsync">@L["From the machine"]</button>
                }
                else
                {
                    <div class="small" role="status">
                        <div>@MachineCountView.Since(L, _machine, Job.SiteTimeZone)</div>
                        @if (MachineCountView.Run(L, _machine) is { } runLine)
                        {
                            <div class="text-muted">@runLine</div>
                        }
                    </div>
                    <div class="d-flex gap-2 mt-1">
                        @if (MachineCountView.CanUse(_machine) && _machineThrough is null)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="UseMachine">@L["Use these figures"]</button>
                        }
                        @if (_machineThrough is not null)
                        {
                            <span class="chip chip-muted">@L["From the machine"]</span>
                            <button type="button" class="btn btn-sm btn-link" @onclick="ClearMachine">@L["Enter by hand instead"]</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-link" disabled="@_loadingMachine" @onclick="LoadMachineAsync">@L["Count again"]</button>
                        }
                    </div>
                }
            </div>
            <div class="col-6">
                <label class="form-label" for="rep-good-@Job.JobId">@L["Good, {0}", UnitCode]</label>
                <input id="rep-good-@Job.JobId" type="number" inputmode="decimal" min="0" step="any" class="form-control" @bind="_good" @bind:event="oninput" />
            </div>
            <div class="col-6">
                <label class="form-label" for="rep-scrap-@Job.JobId">@L["Scrap, {0}", UnitCode]</label>
                <input id="rep-scrap-@Job.JobId" type="number" inputmode="decimal" min="0" step="any" class="form-control" @bind="_scrap" @bind:event="oninput" />
            </div>
        }
        @if (GoodTotal > 0)
        {
            <div class="col-sm-6">
                <label class="form-label" for="rep-loc-@Job.JobId">@L["Good output goes to"]</label>
                <select id="rep-loc-@Job.JobId" class="form-select" @bind="_locationId">
                    <option value="@Guid.Empty">@L["Choose a location…"]</option>
                    @foreach (var l in _locations)
                    {
                        <option value="@l.Id">@l.Code · @l.Name</option>
                    }
                </select>
            </div>
            <div class="col-sm-6">
                <label class="form-label" for="rep-lot-@Job.JobId">@L["Lot number"]</label>
                <input id="rep-lot-@Job.JobId" class="form-control" maxlength="100" placeholder="@L["Blank: {0}-01, -02…", Job.JobNumber]" @bind="_lotNumber"
                       disabled="@(IsBatch && _goodBatches.Count + (_partial > 0 ? 1 : 0) > 1)" title="@(IsBatch ? L["Each batch is numbered after the job"] : null)"
                       aria-describedby="rep-lot-hint-@Job.JobId" />
                @if (string.IsNullOrWhiteSpace(_lotNumber) && LotFillingView.Hint(L, Job, _locations.FirstOrDefault(l => l.Id == _locationId)?.Code) is { } lotHint)
                {
                    <div id="rep-lot-hint-@Job.JobId" class="form-text">@lotHint</div>
                }
                @if (ReportDefaults.LabelHint(Job) is { } labelHint)
                {
                    <div class="form-text">@labelHint</div>
                }
            </div>
        }
        @if (GoodTotal > 0 && _used.Count > 0)
        {
            <div class="col-12">
                <div class="form-label">@L["Made from"] <span class="text-muted">@L["(optional)"]</span></div>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var u in _used)
                    {
                        <div class="form-check" @key="u.Id">
                            <input class="form-check-input" type="checkbox" id="rep-mf-@u.Id" checked="@_madeFrom.Contains(u.Id)"
                                   @onchange="e => { if ((bool)e.Value!) _madeFrom.Add(u.Id); else _madeFrom.Remove(u.Id); }" />
                            <label class="form-check-label small" for="rep-mf-@u.Id">@InventoryView.LotLabel(u.LotNumber, u.IsBulk, u.LocationCode) · @u.MaterialCode</label>
                        </div>
                    }
                </div>
                <div class="form-text">@L["Tick the lots this output was made from. Left blank, its lots are paired with what was in use by time."]</div>
            </div>
        }
        @if (ScrapTotal > 0)
        {
            <div class="col-sm-6 touch-full">
                <label class="form-label" for="rep-reason-@Job.JobId">@L["Scrap reason"]</label>
                <ReasonPicker Id="@($"rep-reason-{Job.JobId}")" Reasons="_reasons" Placeholder="@L["Choose a reason…"]" AriaLabel="@L["Scrap reason"]"
                              Value="@(_reasonId == Guid.Empty ? null : _reasonId)" ValueChanged="v => _reasonId = v ?? Guid.Empty" />
            </div>
        }
        <div class="col-12">
            <label class="form-label" for="rep-comment-@Job.JobId">@L["Comment"] @(NeedsComment ? L["(required)"] : "")</label>
            <input id="rep-comment-@Job.JobId" class="form-control" maxlength="1000" @bind="_comment" @bind:event="oninput" />
        </div>
    </div>

    <div class="d-flex gap-2 mt-3 form-actions">
        <button type="submit" class="btn btn-primary" disabled="@(!CanSubmit)">@L["Report"]</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="OnCancel">@L["Cancel"]</button>
    </div>
</form>

@code {
    [Parameter, EditorRequired]
    public JobExecutionDto Job { get; set; } = default!;

    [Parameter]
    public EventCallback<ReportProductionResponse> OnReported { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private IReadOnlyList<InventoryLocationDto> _locations = [];
    private IReadOnlyList<ReasonCodeDto> _reasons = [];
    private IReadOnlyList<LotSummaryDto> _used = [];
    private readonly HashSet<Guid> _madeFrom = [];
    private Guid _runId;
    private decimal? _good;
    private decimal? _scrap;
    private Guid _locationId;
    private Guid _reasonId;
    private string? _lotNumber;
    private string? _comment;
    private bool _saving;
    private ApiException? _error;

    private readonly List<decimal?> _goodBatches = [];
    private readonly List<decimal?> _scrapBatches = [];
    private decimal? _partial;

    // From the machine (#27): the counts read, and once used, how far they reach and their unit (the material's base unit).
    private MachineCountsDto? _machine;
    private bool _loadingMachine;
    private DateTimeOffset? _machineThrough;
    private Guid? _uomId;
    private string? _uomCode;

    private string? UnitCode => _uomCode ?? Job.UomCode;

    private JobRunDto? SelectedRun => Job.Runs.FirstOrDefault(r => r.Id == _runId);

    // A material made in batches is reported batch by batch, in its base unit (D-036).
    private bool IsBatch => Job.BatchSize is not null;

    // The batch size without the trailing zeros of its stored scale, to prefill a batch.
    private decimal? BatchSize => Job.BatchSize is { } size ? Pulaski.Web.Services.Materials.CapabilityForm.Trim(size) : null;

    private decimal GoodTotal => IsBatch ? _goodBatches.Sum(b => b ?? 0) + (_partial ?? 0) : _good ?? 0;

    private decimal ScrapTotal => IsBatch ? _scrapBatches.Sum(b => b ?? 0) : _scrap ?? 0;

    private bool NeedsComment => ScrapTotal > 0 && _reasons.FirstOrDefault(r => r.Id == _reasonId)?.RequiresComment == true;

    private bool CanSubmit =>
        !_saving && SelectedRun is not null && GoodTotal + ScrapTotal > 0 && GoodTotal >= 0 && ScrapTotal >= 0
        && (!IsBatch || (_goodBatches.All(b => b > 0) && _scrapBatches.All(b => b > 0)))
        && (GoodTotal <= 0 || _locationId != Guid.Empty)
        && (ScrapTotal <= 0 || _reasonId != Guid.Empty)
        && (!NeedsComment || !string.IsNullOrWhiteSpace(_comment));

    private static void SetBatch(List<decimal?> batches, int index, ChangeEventArgs e) =>
        batches[index] = decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null;

    protected override async Task OnInitializedAsync()
    {
        _runId = FloorView.DefaultRun(Job.Runs) ?? Guid.Empty;
        if (IsBatch)
        {
            _goodBatches.Add(BatchSize);
        }

        try
        {
            _locations = [.. (await Api.ListInventoryLocationsAsync(Job.SiteId)).Where(l => l.IsActive)];
            _locationId = ReportDefaults.Location(Job, _locations);
            _reasons = await Api.ListReasonCodesAsync("scrap", Job.SiteId);
            _used = (await Api.GetJobMaterialsAsync(Job.JobId)).Used;
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task LoadMachineAsync()
    {
        _loadingMachine = true;
        _error = null;
        try
        {
            _machine = await Api.GetMachineCountsAsync(Job.JobId, _runId == Guid.Empty ? null : _runId);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _loadingMachine = false;
        }
    }

    private void UseMachine()
    {
        if (_machine is not { } counts || !MachineCountView.CanUse(counts))
        {
            return;
        }

        (_good, _scrap) = (counts.GoodQty, counts.ScrapQty);
        (_uomId, _uomCode, _machineThrough) = (counts.UomId, counts.UomCode, counts.Through);
    }

    private void ClearMachine()
    {
        if (_machineThrough is not null)
        {
            (_good, _scrap) = (null, null);
        }

        (_machine, _machineThrough, _uomId, _uomCode) = (null, null, null, null);
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var result = await Api.ReportProductionAsync(Job.JobId, new ReportProductionRequest
            {
                RunId = _runId,
                UomId = IsBatch ? null : _uomId,
                MachineThrough = IsBatch ? null : _machineThrough,
                GoodQty = IsBatch ? 0 : _good ?? 0,
                ScrapQty = IsBatch ? 0 : _scrap ?? 0,
                GoodBatches = IsBatch ? [.. _goodBatches.Select(b => b!.Value)] : [],
                ScrapBatches = IsBatch ? [.. _scrapBatches.Select(b => b!.Value)] : [],
                PartialQty = IsBatch && _partial > 0 ? _partial : null,
                ScrapReasonCodeId = ScrapTotal > 0 ? _reasonId : null,
                LocationId = GoodTotal > 0 ? _locationId : null,
                LotNumber = string.IsNullOrWhiteSpace(_lotNumber) ? null : _lotNumber,
                MadeFromLotIds = GoodTotal > 0 ? [.. _madeFrom] : [],
                Comment = string.IsNullOrWhiteSpace(_comment) ? null : _comment,
            });
            await OnReported.InvokeAsync(result);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }
}
