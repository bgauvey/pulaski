@using Pulaski.Web.Services.Inventory
@inject PulaskiApiClient Api

@* Labels (#75): the site's label format and GS1 numbering, its label printers and how its suppliers' barcodes read. *@
<section class="inv-facts mb-3" id="labels" aria-labelledby="labels-heading">
    <h2 class="h6" id="labels-heading">@L["Labels"]</h2>
    <p class="small text-muted">
        @L["How lot and container labels are printed. A GS1 format adds a GS1 barcode for lots whose material has a GTIN and for containers with an SSCC; every label keeps Pulaski's own code, so a scan in Pulaski always finds exactly that one."]
    </p>
    <ProblemAlert Error="_error" />

    @if (_setup is null)
    {
        <p class="small text-muted mb-0">@L["Loading…"]</p>
    }
    else
    {
        <form class="row g-2 align-items-end mb-3" @onsubmit="SaveSettingsAsync" @onsubmit:preventDefault>
                <div class="col-sm-3">
                    <label class="form-label small" for="label-format">@L["Label format"]</label>
                    <select id="label-format" class="form-select form-select-sm" disabled="@(!CanManage)" @bind="_format">
                        <option value="pulaski">@L["Pulaski (Code 128)"]</option>
                        <option value="gs1_128">@L["GS1-128"]</option>
                        <option value="gs1_datamatrix">@L["GS1 DataMatrix"]</option>
                    </select>
                </div>
                <div class="col-sm-3">
                    <label class="form-label small" for="gs1-prefix">@L["GS1 company prefix"]</label>
                    <input id="gs1-prefix" class="form-control form-control-sm" disabled="@(!CanManage)" inputmode="numeric" maxlength="12" placeholder="@L["None"]" @bind="_prefix" />
                </div>
                <div class="col-sm-2">
                    <label class="form-label small" for="sscc-ext">@L["SSCC extension digit"]</label>
                    <input id="sscc-ext" type="number" min="0" max="9" class="form-control form-control-sm" disabled="@(!CanManage)" @bind="_extension" />
                </div>
                <div class="col-sm-3">
                    <label class="form-label small" for="default-printer">@L["Default printer"]</label>
                    <select id="default-printer" class="form-select form-select-sm" disabled="@(!CanManage)" @bind="_defaultPrinter">
                        <option value="@Guid.Empty">@L["None"]</option>
                        @foreach (var p in _setup.Printers.Where(p => p.IsActive))
                        {
                            <option value="@p.Id">@p.Code · @p.Name</option>
                        }
                    </select>
                </div>
            @if (CanManage)
            {
                <div class="col-sm-1"><button type="submit" class="btn btn-sm btn-primary" disabled="@_saving">@L["Save"]</button></div>
            }
            <div class="col-12 small text-muted">
                @(_setup.Gs1CompanyPrefix is null
                    ? L["Without a company prefix, containers get no SSCC."]
                    : L["New containers get SSCCs from serial {0}.", _setup.SsccNextSerial])
            </div>
        </form>

        <h3 class="h6">@L["Printers"]</h3>
        @if (_setup.Printers.Count == 0)
        {
            <p class="small text-muted">@L["No printers yet: labels print as PDF."]</p>
        }
        else
        {
            <div class="table-panel mb-2">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>@L["Printer"]</th><th>@L["Sends"]</th><th>@L["Templates"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in _setup.Printers)
                        {
                            <tr @key="p.Id" class="@(p.IsActive ? "" : "text-muted")">
                                <td><span class="fw-semibold">@p.Code</span> <div class="small">@p.Name@(p.IsActive ? "" : " · off")</div></td>
                                <td class="small">@LabelPrinterView.Sends(L, p)</td>
                                <td class="small">@LabelPrinterView.Templates(L, p)</td>
                                <td class="text-end">
                                    @if (CanManage)
                                    {
                                        <button type="button" class="btn btn-sm btn-link" @onclick="() => EditPrinter(p)">@L["Change"]</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (CanManage)
        {
            @if (_printer is null)
            {
                <button type="button" class="btn btn-sm btn-link px-0 mb-3" @onclick="() => EditPrinter(null)">@L["Add a printer"]</button>
            }
            else
            {
                <form class="row g-2 align-items-end mb-3" @onsubmit="SavePrinterAsync" @onsubmit:preventDefault>
                    <div class="col-sm-2">
                        <label class="form-label small" for="prn-code">@L["Code"]</label>
                        <input id="prn-code" class="form-control form-control-sm" maxlength="30" disabled="@(_printerId is not null)" @bind="_printer.Code" />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label small" for="prn-name">@L["Name"]</label>
                        <input id="prn-name" class="form-control form-control-sm" maxlength="100" @bind="_printer.Name" />
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label small" for="prn-method">@L["Sends"]</label>
                        <select id="prn-method" class="form-select form-select-sm" @bind="_printer.Method">
                            <option value="raw_tcp">@L["Raw TCP"]</option>
                            <option value="drop_folder">@L["Drop folder"]</option>
                            <option value="bartender">@L["BarTender (web service)"]</option>
                        </select>
                    </div>
                    @if (_printer.Method == "bartender")
                    {
                        @* BarTender (#168): a BTXML script per label, posted to a BarTender Integration web service that runs it (Print BTXML Script). *@
                        <div class="col-sm-5">
                            <label class="form-label small" for="prn-endpoint">@L["BarTender web service address"]</label>
                            <input id="prn-endpoint" type="url" class="form-control form-control-sm" maxlength="500" placeholder="https://bartender.example.com:8080/Integration/Print/Execute" @bind="_printer.EndpointUrl" />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label small" for="prn-btprinter">@L["Printer in BarTender"] <span class="text-muted">@L["(optional)"]</span></label>
                            <input id="prn-btprinter" class="form-control form-control-sm" maxlength="200" placeholder="@L["The document's own"]" @bind="_printer.BartenderPrinter" />
                        </div>
                        <div class="col-12">
                            <div class="small fw-semibold mb-1">@L["BarTender document (.btw) for each kind of label"]</div>
                            <div class="row g-2">
                                @foreach (var operation in LabelPrinterView.Operations(_options.BtwOperations, _printer.BtwFiles))
                                {
                                    <div class="col-sm-6" @key="operation">
                                        <label class="form-label small mb-0" for="@($"prn-btw-{operation}")">@LabelPrinterView.OperationName(L, operation)</label>
                                        <input id="@($"prn-btw-{operation}")" class="form-control form-control-sm" maxlength="260" placeholder="@(operation == "default" ? @"C:\Labels\Lot.btw" : L["The default document"])"
                                               value="@_printer.BtwFiles.GetValueOrDefault(operation)" @onchange="@(e => _printer.BtwFiles[operation] = e.Value?.ToString() ?? "")" />
                                    </div>
                                }
                            </div>
                            <div class="form-text">@L["A path BarTender can open. A kind without its own document uses the default."]</div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-end">
                                <label class="form-label small mb-1" for="prn-btxml">@L["BTXML template"]</label>
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => _printer.BtxmlTemplate = _options.BtxmlTemplate">@L["Use the standard template"]</button>
                            </div>
                            <textarea id="prn-btxml" class="form-control form-control-sm font-monospace" rows="12" maxlength="20000" spellcheck="false" @bind="_printer.BtxmlTemplate"></textarea>
                            <div class="form-text">
                                @L["Pulaski fills in"] <code>{{BtwPath}}</code> @L["(the document),"] <code>{{NamedSubStrings}}</code> @L["(every label value as a named data source),"]
                                <code>{{PrintSetup}}</code> @L["(the printer and copies),"] <code>{{Printer}}</code>, <code>{{Copies}}</code>, <code>{{JobName}}</code>@L[", and any label value by name, such as"] <code>{{Code}}</code>, <code>{{Title}}</code>, <code>{{Line1}}</code> @L["or"] <code>{{Gs1Hri}}</code>.
                            </div>
                        </div>
                    }
                    else if (_printer.Method == "raw_tcp")
                    {
                        <div class="col-sm-2">
                            <label class="form-label small" for="prn-host">@L["Host"]</label>
                            <input id="prn-host" class="form-control form-control-sm" maxlength="255" @bind="_printer.Host" />
                        </div>
                        <div class="col-sm-1">
                            <label class="form-label small" for="prn-port">@L["Port"]</label>
                            <input id="prn-port" type="number" min="1" max="65535" class="form-control form-control-sm" @bind="_printer.Port" />
                        </div>
                    }
                    else
                    {
                        <div class="col-sm-3">
                            <label class="form-label small" for="prn-folder">@L["Drop folder"]</label>
                            <select id="prn-folder" class="form-select form-select-sm" @bind="_printer.DropFolder">
                                <option value="">@(_options.DropFolders.Count == 0 ? L["None configured (Labels:DropFolders)"] : L["Choose…"])</option>
                                @foreach (var f in _options.DropFolders)
                                {
                                    <option value="@f">@f</option>
                                }
                            </select>
                        </div>
                    }
                    @if (_printer.Method != "bartender")
                    {
                        <div class="col-sm-2">
                            <label class="form-label small" for="prn-set">@L["Templates"]</label>
                            <select id="prn-set" class="form-select form-select-sm" @bind="_printer.TemplateSet">
                                @foreach (var t in _options.TemplateSets)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="col-12 d-flex gap-2 align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="prn-active" @bind="_printer.IsActive" />
                            <label class="form-check-label small" for="prn-active">@L["Active"]</label>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary" disabled="@_saving">@L["Save printer"]</button>
                        <button type="button" class="btn btn-sm btn-link" @onclick="() => _printer = null">@L["Cancel"]</button>
                    </div>
                </form>
            }
        }

        <h3 class="h6">@L["Supplier barcodes"]</h3>
        <p class="small text-muted">
            @L["GS1 barcodes are always read. For a supplier's own barcodes, add a pattern (a regular expression) naming its parts:"]
            <code>(?&lt;lot&gt;…)</code>, <code>(?&lt;supplier_lot&gt;…)</code>, <code>(?&lt;material&gt;…)</code>, <code>(?&lt;gtin&gt;…)</code>,
            <code>(?&lt;qty&gt;…)</code> @L["and"] <code>(?&lt;expiry&gt;…)</code>@L[". The whole scan must match; formats are tried in order."]
        </p>
        @if (_setup.SupplierFormats.Count > 0)
        {
            <div class="table-panel mb-2">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>@L["Format"]</th><th>@L["Pattern"]</th><th>@L["Expiry"]</th><th class="text-end">@L["Order"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var f in _setup.SupplierFormats)
                        {
                            <tr @key="f.Id" class="@(f.IsActive ? "" : "text-muted")">
                                <td><span class="fw-semibold">@f.Code</span> <div class="small">@f.Name@(f.IsActive ? "" : " · off")</div></td>
                                <td class="small"><code>@f.Pattern</code></td>
                                <td class="small">@(f.ExpiryFormat ?? "yyyy-MM-dd")</td>
                                <td class="text-end">@f.SortOrder</td>
                                <td class="text-end">
                                    @if (CanManage)
                                    {
                                        <button type="button" class="btn btn-sm btn-link" @onclick="() => EditFormat(f)">@L["Change"]</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (CanManage)
        {
            @if (_supplier is null)
            {
                <button type="button" class="btn btn-sm btn-link px-0" @onclick="() => EditFormat(null)">@L["Add a supplier format"]</button>
            }
            else
            {
                <form class="row g-2 align-items-end" @onsubmit="SaveFormatAsync" @onsubmit:preventDefault>
                    <div class="col-sm-2">
                        <label class="form-label small" for="fmt-code">@L["Code"]</label>
                        <input id="fmt-code" class="form-control form-control-sm" maxlength="30" disabled="@(_formatId is not null)" @bind="_supplier.Code" />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label small" for="fmt-name">@L["Name"]</label>
                        <input id="fmt-name" class="form-control form-control-sm" maxlength="100" @bind="_supplier.Name" />
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label small" for="fmt-expiry">@L["Expiry format"]</label>
                        <input id="fmt-expiry" class="form-control form-control-sm" maxlength="30" placeholder="yyyy-MM-dd" @bind="_supplier.ExpiryFormat" />
                    </div>
                    <div class="col-sm-1">
                        <label class="form-label small" for="fmt-order">@L["Order"]</label>
                        <input id="fmt-order" type="number" class="form-control form-control-sm" @bind="_supplier.SortOrder" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small" for="fmt-pattern">@L["Pattern"]</label>
                        <input id="fmt-pattern" class="form-control form-control-sm font-monospace" maxlength="500" @bind="_supplier.Pattern" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small" for="fmt-sample">@L["Try it on a scan"]</label>
                        <div class="d-flex gap-2">
                            <input id="fmt-sample" class="form-control form-control-sm" maxlength="200" placeholder="@L["Scan or type a sample barcode"]" @bind="_sample" />
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="TestAsync">@L["Try"]</button>
                        </div>
                        @if (_test is { } test)
                        {
                            <div class="small mt-1">
                                @if (test.Problems.Count > 0)
                                {
                                    <span class="text-danger">@string.Join(" ", test.Problems)</span>
                                }
                                else if (test.Read is { } read)
                                {
                                    <span>@L["Reads {0}", Read(read)]</span>
                                }
                                else
                                {
                                    <span class="text-muted">@L["The sample doesn't match the pattern."]</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="col-12 d-flex gap-2 align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="fmt-active" @bind="_supplier.IsActive" />
                            <label class="form-check-label small" for="fmt-active">@L["Active"]</label>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary" disabled="@_saving">@L["Save format"]</button>
                        <button type="button" class="btn btn-sm btn-link" @onclick="() => _supplier = null">@L["Cancel"]</button>
                    </div>
                </form>
            }
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid SiteId { get; set; }

    [Parameter] public bool CanManage { get; set; }

    /// <summary>Says what was saved, in the page's message.</summary>
    [Parameter] public EventCallback<string> Saved { get; set; }

    private LabelSetupDto? _setup;
    private LabelOptionsDto _options = new();
    private Guid? _loadedFor;
    private string _format = "pulaski";
    private string? _prefix;
    private int _extension;
    private Guid _defaultPrinter;
    private Guid? _printerId;
    private PrinterForm? _printer;
    private Guid? _formatId;
    private FormatForm? _supplier;
    private string? _sample;
    private SupplierFormatTestDto? _test;
    private bool _saving;
    private ApiException? _error;

    private sealed class PrinterForm
    {
        public long Version { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Method { get; set; } = "raw_tcp";
        public string? Host { get; set; }
        public int? Port { get; set; } = 9100;
        public string? DropFolder { get; set; }
        public string? TemplateSet { get; set; } = "zpl";
        public string? EndpointUrl { get; set; }
        public string? BartenderPrinter { get; set; }
        public string? BtxmlTemplate { get; set; }
        public Dictionary<string, string> BtwFiles { get; set; } = new(StringComparer.Ordinal);
        public bool IsActive { get; set; } = true;
    }

    private sealed class FormatForm
    {
        public long Version { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Pattern { get; set; } = "";
        public string? ExpiryFormat { get; set; }
        public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == SiteId)
        {
            return;
        }

        _loadedFor = SiteId;
        await LoadAsync();
        try
        {
            _options = await Api.GetLabelOptionsAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _setup = await Api.GetLabelSetupAsync(SiteId);
            (_format, _prefix, _extension, _defaultPrinter) = (_setup.LabelFormat, _setup.Gs1CompanyPrefix, _setup.SsccExtension, _setup.DefaultPrinterId ?? Guid.Empty);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private string Read(ScannedLotDto read) => string.Join(", ", new[]
    {
        read.LotNumber is { } lot ? L["lot {0}", lot] : null,
        read.SupplierLot is { } supplier ? L["supplier lot {0}", supplier] : null,
        read.MaterialCode is { } material ? L["material {0}", material] : null,
        read.Gtin is { } gtin ? $"GTIN {gtin}" : null,
        read.Quantity is { } qty ? L["quantity {0}", qty] : null,
        read.Expiry is { } expiry ? L["expiry {0:yyyy-MM-dd}", expiry] : null,
    }.Where(x => x is not null)) is { Length: > 0 } text ? text + "." : L["nothing Pulaski uses."];

    private void EditPrinter(LabelPrinterDto? p)
    {
        _printerId = p?.Id;
        _printer = p is null
            ? new PrinterForm { TemplateSet = _options.TemplateSets.FirstOrDefault() ?? "zpl", BtxmlTemplate = _options.BtxmlTemplate }
            : new PrinterForm
            {
                Version = p.Version,
                Code = p.Code,
                Name = p.Name,
                Method = p.Method,
                Host = p.Host,
                Port = p.Port,
                DropFolder = p.DropFolder,
                TemplateSet = p.TemplateSet ?? _options.TemplateSets.FirstOrDefault() ?? "zpl",
                EndpointUrl = p.EndpointUrl,
                BartenderPrinter = p.BartenderPrinter,
                BtxmlTemplate = p.BtxmlTemplate ?? _options.BtxmlTemplate,
                BtwFiles = new Dictionary<string, string>(p.BtwFiles, StringComparer.Ordinal),
                IsActive = p.IsActive,
            };
    }

    private void EditFormat(SupplierBarcodeFormatDto? f)
    {
        (_formatId, _sample, _test) = (f?.Id, null, null);
        _supplier = f is null
            ? new FormatForm()
            : new FormatForm { Version = f.Version, Code = f.Code, Name = f.Name, Pattern = f.Pattern, ExpiryFormat = f.ExpiryFormat, SortOrder = f.SortOrder, IsActive = f.IsActive };
    }

    private Task SaveSettingsAsync() => RunAsync(
        () => Api.SetLabelSettingsAsync(SiteId, new SetLabelSettingsRequest
        {
            Version = _setup!.Version,
            LabelFormat = _format,
            Gs1CompanyPrefix = string.IsNullOrWhiteSpace(_prefix) ? null : _prefix.Trim(),
            SsccExtension = _extension,
            DefaultPrinterId = _defaultPrinter == Guid.Empty ? null : _defaultPrinter,
        }),
        L["Label settings saved."]);

    private Task SavePrinterAsync()
    {
        var p = _printer!;
        var request = new SaveLabelPrinterRequest
        {
            Version = p.Version,
            Code = p.Code,
            Name = p.Name,
            Method = p.Method,
            Host = p.Host,
            Port = p.Port,
            DropFolder = string.IsNullOrEmpty(p.DropFolder) ? null : p.DropFolder,
            TemplateSet = p.Method == "bartender" ? null : p.TemplateSet,
            EndpointUrl = p.EndpointUrl,
            BartenderPrinter = p.BartenderPrinter,
            BtxmlTemplate = p.BtxmlTemplate,
            BtwFiles = p.BtwFiles.Where(f => !string.IsNullOrWhiteSpace(f.Value)).ToDictionary(f => f.Key, f => f.Value.Trim(), StringComparer.Ordinal),
            IsActive = p.IsActive,
        };
        return RunAsync(
            async () => { _ = _printerId is { } id ? await Api.UpdateLabelPrinterAsync(id, request) : await Api.AddLabelPrinterAsync(SiteId, request); _printer = null; },
            L["Printer {0} saved.", p.Code]);
    }

    private Task SaveFormatAsync()
    {
        var f = _supplier!;
        var request = new SaveSupplierFormatRequest
        {
            Version = f.Version,
            Code = f.Code,
            Name = f.Name,
            Pattern = f.Pattern,
            ExpiryFormat = string.IsNullOrWhiteSpace(f.ExpiryFormat) ? null : f.ExpiryFormat,
            SortOrder = f.SortOrder,
            IsActive = f.IsActive,
        };
        return RunAsync(
            async () => { _ = _formatId is { } id ? await Api.UpdateSupplierFormatAsync(id, SiteId, request) : await Api.AddSupplierFormatAsync(SiteId, request); _supplier = null; },
            L["Supplier format {0} saved.", f.Code]);
    }

    private async Task TestAsync()
    {
        _error = null;
        try
        {
            _test = await Api.TestSupplierFormatAsync(new TestSupplierFormatRequest { Pattern = _supplier!.Pattern, ExpiryFormat = _supplier.ExpiryFormat, Sample = _sample ?? "" });
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task RunAsync(Func<Task> action, string message)
    {
        _saving = true;
        _error = null;
        try
        {
            await action();
            await LoadAsync();
            await Saved.InvokeAsync(message);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }
}
