@page "/boms"
@attribute [RequiresView(PermissionCodes.ProcessesView)]
@inject PulaskiApiClient Api
@inject NavigationManager Navigation
@inject CurrentUser User

<PageTitle>@L["BOMs"] · Pulaski</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">@L["Bills of materials"]</h1>
        <p class="text-muted mb-0">@L["What each material is made from, one level deep. A BOM for a process says which operation consumes each component."]</p>
    </div>
    @if (User.Can(PermissionCodes.Processes))
    {
        <button type="button" class="btn btn-primary" @onclick="() => _adding = !_adding">@L["New BOM"]</button>
    }
</div>

<ProblemAlert Error="_error" />
<ViewOnlyNote Permission="@PermissionCodes.Processes" What="@L["maintain BOMs"]" />

@if (_adding)
{
    <form class="process-new" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <div class="flex-grow-1">
            <label class="form-label" for="new-material">@L["Material"]</label>
            <select id="new-material" class="form-select" value="@_materialId" @onchange="OnMaterialChangedAsync">
                <option value="@Guid.Empty">@L["Choose a material…"]</option>
                @foreach (var m in _materials.Where(m => m.MaterialType is not ("raw" or "consumable")))
                {
                    <option value="@m.Id">@m.Code · @m.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="new-process">@L["For process"]</label>
            <select id="new-process" class="form-select" @bind="_processId" disabled="@(_materialId == Guid.Empty)">
                <option value="">@L["Any process"]</option>
                @foreach (var p in _processes)
                {
                    <option value="@p.Id">@p.Code · @p.Name</option>
                }
            </select>
        </div>
        <div class="d-flex gap-2 align-self-end">
            <button type="submit" class="btn btn-primary" disabled="@(_saving || _materialId == Guid.Empty)">@L["Create and edit"]</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => _adding = false">@L["Cancel"]</button>
        </div>
    </form>
}

@if (_boms is null)
{
    @if (_error is null)
    {
        <p class="text-muted">@L["Loading…"]</p>
    }
}
else if (_boms.Count == 0)
{
    <div class="empty-panel">
        <h2>@L["No BOMs yet"]</h2>
        <p class="text-muted mb-0">@L["Create one to plan an order's components, for example the blend and capstock a profile is extruded from."]</p>
    </div>
}
else
{
    <div class="table-panel">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>@L["Material"]</th>
                    <th>@L["For process"]</th>
                    <th>@L["Released"]</th>
                    <th>@L["Draft"]</th>
                    <th>@L["Updated"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in _boms)
                {
                    <tr @key="b.Id" class="@(b.IsActive ? "" : "text-muted")">
                        <td>
                            <a class="fw-semibold" href="boms/@b.Id">@b.MaterialCode</a>
                            <div class="small text-muted">@b.MaterialName@(b.IsActive ? "" : " · inactive")</div>
                        </td>
                        <td>@(b.ProcessCode ?? L["Any"])</td>
                        <td>
                            @(b.ReleasedVersion is { } r ? L["Version {0} · {1} components", r, b.ReleasedItems] : "—")
                            @if (b.MissingOperations.Length > 0)
                            {
                                <div class="small text-warning-strong" title="@L["Orders for {0} made with {1} are refused until a new BOM version is released.", b.MaterialCode, b.ProcessCode]">
                                    <Icon Name="alert" Size="14" /> @L["Names operation {0}, which {1} no longer has", string.Join(", ", b.MissingOperations), b.ProcessCode]
                                </div>
                            }
                        </td>
                        <td>
                            @if (b.DraftVersion is { } d)
                            {
                                <span class="chip">@L["Version {0}", d]</span>
                            }
                        </td>
                        <td class="small text-muted text-nowrap">@b.UpdatedAt.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) UTC</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<BomSummaryDto>? _boms;
    private IReadOnlyList<MaterialDto> _materials = [];
    private IReadOnlyList<ProcessSummaryDto> _processes = [];
    private ApiException? _error;
    private bool _adding;
    private bool _saving;
    private Guid _materialId;
    private Guid? _processId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _materials = await Api.ListMaterialsAsync();
            _boms = await Api.ListBomsAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    // A BOM for a process needs the process to make the material (D-025), so offer only those.
    private async Task OnMaterialChangedAsync(ChangeEventArgs e)
    {
        _materialId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : Guid.Empty;
        _processId = null;
        _processes = [];
        if (_materialId == Guid.Empty)
        {
            return;
        }

        try
        {
            _processes = await Api.ListProcessesAsync(materialId: _materialId);
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }

    private async Task CreateAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            var created = await Api.CreateBomAsync(new CreateBomRequest { MaterialId = _materialId, ProcessId = _processId });
            Navigation.NavigateTo($"boms/{created.Id}");
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _saving = false;
        }
    }
}
