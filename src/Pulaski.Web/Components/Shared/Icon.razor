@* Line icon on a 24 px grid: 1.75 px stroke, round caps and joins, no fill, drawn in currentColor.
   Decorative by default; give the surrounding control an aria-label. *@

<svg class="icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "user":
            <circle cx="12" cy="8" r="4" />
            <path d="M4.5 20.5a7.5 7.5 0 0 1 15 0" />
            break;
        case "users":
            <circle cx="9" cy="8" r="3.5" />
            <path d="M2.5 20a6.5 6.5 0 0 1 13 0M15.5 4.8a3.5 3.5 0 0 1 0 6.4M18 14.2a6.5 6.5 0 0 1 3.5 5.8" />
            break;
        case "sign-out":
            <path d="M14 4h4.5a1.5 1.5 0 0 1 1.5 1.5v13a1.5 1.5 0 0 1-1.5 1.5H14M10 16l-4-4 4-4M6 12h10" />
            break;
        case "menu":
            <path d="M4 6h16M4 12h16M4 18h16" />
            break;
        case "overview":
            <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" />
            <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" />
            <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" />
            <rect x="13.5" y="13.5" width="7" height="7" rx="1.5" />
            break;
        case "work-orders":
            <rect x="5" y="4" width="14" height="17" rx="2" />
            <path d="M9 4V3h6v1M9 10h6M9 14h6M9 18h3" />
            break;
        case "equipment":
            <path d="M3 21V10l5 3.5V10l5 3.5V5h5v16z" />
            <path d="M3 21h18M16 17h0M12 17h0M8 17h0" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
            break;
        case "moon":
            <path d="M19.5 14.5A7.5 7.5 0 0 1 9.5 4.5a7.5 7.5 0 1 0 10 10z" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case "chevron-right":
            <path d="M9 6l6 6-6 6" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "expand-all":
            <path d="M7 6l5 5 5-5M7 13l5 5 5-5" />
            break;
        case "collapse-all":
            <path d="M7 18l5-5 5 5M7 11l5-5 5 5" />
            break;
        case "categorized":
            <path d="M3 5h7M7 9h14M3 14h7M7 18h14" />
            break;
        case "schedule":
            <rect x="3.5" y="5" width="17" height="15.5" rx="2" />
            <path d="M3.5 10h17M8 3v4M16 3v4M7.5 14h4M10 17.5h6" />
            break;
        case "gantt":
            <path d="M4 4v16h16M7 7.5h6M10 11.5h7M8 15.5h5" />
            break;
        case "calendar":
            <rect x="3.5" y="5" width="17" height="15.5" rx="2" />
            <path d="M3.5 10h17M8 3v4M16 3v4" />
            break;
        case "kanban":
            <rect x="3.5" y="4" width="5" height="16" rx="1.5" />
            <rect x="10.5" y="4" width="5" height="11" rx="1.5" />
            <rect x="17.5" y="4" width="3" height="7" rx="1" />
            break;
        case "table":
            <rect x="3.5" y="4.5" width="17" height="15" rx="2" />
            <path d="M3.5 9.5h17M3.5 14.5h17M9.5 9.5v10" />
            break;
        case "refresh":
            <path d="M20 11a8 8 0 0 0-14.3-4.9L4 8M4 4v4h4M4 13a8 8 0 0 0 14.3 4.9L20 16M20 20v-4h-4" />
            break;
        case "lock":
            <rect x="5" y="11" width="14" height="9.5" rx="2" />
            <path d="M8 11V8a4 4 0 0 1 8 0v3" />
            break;
        case "alert":
            <path d="M12 4l9 16H3z" />
            <path d="M12 10v4M12 17h0" />
            break;
        case "process":
            <rect x="3" y="4" width="6" height="6" rx="1.5" />
            <rect x="3" y="14" width="6" height="6" rx="1.5" />
            <rect x="15" y="9" width="6" height="6" rx="1.5" />
            <path d="M9 7h2.5a2 2 0 0 1 2 2v1.5M9 17h2.5a2 2 0 0 0 2-2v-1.5M13.5 12H15" />
            break;
        case "bom":
            <rect x="8" y="3" width="8" height="5" rx="1.5" />
            <rect x="3" y="16" width="7" height="5" rx="1.5" />
            <rect x="14" y="16" width="7" height="5" rx="1.5" />
            <path d="M12 8v4M6.5 16v-2a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v2" />
            break;
        case "units":
            <path d="M3 16l13-13 5 5-13 13H3z" />
            <path d="M7 12l2 2M10 9l2 2M13 6l2 2" />
            break;
        case "stop":
            <path d="M8.5 3h7L21 8.5v7L15.5 21h-7L3 15.5v-7z" />
            <path d="M12 8v5M12 16h0" />
            break;
        case "spc":
            <path d="M3 18h18M3 6h18" stroke-dasharray="2 3" />
            <path d="M3 13l4-2 3 3 3-6 3 7 3-4 2 1" />
            break;
        case "lot":
            <path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5z" />
            <path d="M3.5 7.5L12 12l8.5-4.5M12 12v9" />
            break;
        case "labor":
            <circle cx="12" cy="7.5" r="3.5" />
            <path d="M5 20.5c.8-3.8 3.6-6 7-6s6.2 2.2 7 6" />
            break;
        case "erp":
            <path d="M4 8h13l-3-3M20 16H7l3 3" />
            break;
        case "signal-off":
            <path d="M2 9.5a15 15 0 0 1 20 0M5.5 13a10 10 0 0 1 13 0M9 16.5a5 5 0 0 1 6 0M12 20h0" />
            <path d="M3 3l18 18" />
            break;
        case "signal":
            <path d="M2 9.5a15 15 0 0 1 20 0M5.5 13a10 10 0 0 1 13 0M9 16.5a5 5 0 0 1 6 0M12 20h0" />
            break;
        case "plug":
            <path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5V12l3 2" />
            break;
        case "panel-left":
            <rect x="3.5" y="4.5" width="17" height="15" rx="2" />
            <path d="M9 4.5v15" />
            break;
        case "panel-right":
            <rect x="3.5" y="4.5" width="17" height="15" rx="2" />
            <path d="M15 4.5v15" />
            break;
        case "arrange":
            <path d="M4 5h6v5H4zM14 5h6v5h-6zM9 14h6v5H9zM7 10v2h10v-2M12 12v2" />
            break;
        case "trash":
            <path d="M5 7h14M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" />
            break;
        case "chevron-down":
            <path d="M6 9l6 6 6-6" />
            break;
        case "info":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 11v5M12 8h0" />
            break;
        case "more":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M8.5 11l3.5 3.5 3.5-3.5" />
            break;
        case "arrow-up":
            <path d="M12 19V5M6 11l6-6 6 6" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6" />
            <path d="M15.5 15.5L20 20" />
            break;
        case "chevron-left":
            <path d="M15 6l-6 6 6 6" />
            break;
        case "alphabetical":
            <path d="M4 11l3-7 3 7M5.3 8h3.4M4 14h6l-6 6h6M17 4v16M14 17l3 3 3-3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter]
    public int Size { get; set; } = 20;
}
