@page "/terminal/station"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout StationLayout
@using Pulaski.Web.Services.Execution
@inject PulaskiApiClient Api
@inject NavigationManager Navigation

@* An operator station (#146) on an enrolled terminal (D-049): one line's job and what comes next, at the line. Someone badges to sign on and
   stays signed on until they sign off or leave it alone for a while (StationIdle); their ticket sits in a short-lived cookie on this device.
   ?line=CODE chooses the line when the terminal offers several. *@
<PageTitle>@(_station?.Line?.Code ?? _station?.TerminalName ?? L["Station"]) · Pulaski</PageTitle>
@* Always the touch layout (D-105): a station is worked by finger, whatever the screen says about its pointer. One HeadContent: a page keeps
   only its last. It reloads to stay current, except while a PIN is being typed. *@
<HeadContent>
    <meta name="pulaski-touch" content="always" />
    @if (!_needsPin)
    {
        <meta http-equiv="refresh" content="@RefreshSeconds" />
    }
</HeadContent>

@if (_station is null)
{
    <div class="station-panel">
        <h1 class="h3">@(_enrolled ? L["The station can't be shown"] : L["This station isn't enrolled"])</h1>
        <p>@(_error ?? L["Enrol it as a terminal, then open this page again."])</p>
        @if (!_enrolled)
        {
            <a class="btn btn-primary btn-lg" href="@TerminalCookie.EnrolPath">@L["Enrol it"]</a>
        }
    </div>
}
else if (_station.Line is null)
{
    <div class="station-panel">
        <h1 class="h3">@_station.TerminalName: which line is this station for?</h1>
        @if (_station.Lines.Count == 0)
        {
            <p>@L["No lines that run jobs are in this terminal's area. Ask a supervisor to change what it offers on Labor → Terminals."]</p>
        }
        else
        {
            @if (Line is not null)
            {
                <p class="text-warning-strong">@L["There is no line {0} here.", Line]</p>
            }
            <div class="station-actions">
                @foreach (var l in _station.Lines)
                {
                    <a class="btn btn-outline-primary" href="@($"{TerminalCookie.StationPath}?line={Uri.EscapeDataString(l.Code)}")">
                        @l.Code<span class="d-block small fw-normal">@l.Name</span>
                    </a>
                }
            </div>
            <p class="text-muted mt-3 mb-0">@L["To skip this choice, set the terminal's first line offered on Labor → Terminals."]</p>
        }
    </div>
}
else
{
    var line = _station.Line;
    var since = LineDisplayView.Duration(line.StateSince, DateTimeOffset.UtcNow);
    <header class="station-head">
        <div>
            <span class="station-line-code">@line.Code</span>
            <span class="text-muted ms-2">@line.Name</span>
        </div>
        <div class="text-end">
            <span class="station-status @LineDisplayView.StatusClass(line.Status)">@L[LineDisplayView.StatusLabel(line.Status)]</span>
            @if (since is not null && line.Status != "idle")
            {
                <div class="small text-muted">@L["for {0}", since]</div>
            }
        </div>
    </header>

    <div class="station-grid">
        <div>
            @if (_notes.Count > 0)
            {
                <div class="drawer-alert mb-3" role="status"><Icon Name="info" Size="20" /><span>@string.Join(" ", _notes)</span></div>
            }
            @if (_actionError is not null)
            {
                <div class="alert alert-danger" role="alert">@_actionError</div>
            }
            @if (line.Status is "down" or "waiting" && line.StopText is { } stop)
            {
                <div class="drawer-alert is-warning mb-3" role="status"><Icon Name="stop" Size="20" /><span>@stop</span></div>
            }
            @if (_station.StopsToCode.Count > 0)
            {
                @* Stops waiting for a reason (#149): asked for here, at the line, while it is fresh. *@
                <section class="station-panel station-stops" aria-labelledby="station-stops">
                    <h2 id="station-stops" class="h5">@StationView.StopsTitle(L, _station.StopsToCode.Count)</h2>
                    @if (_station.PersonName is null)
                    {
                        <p class="mb-0">@(_station.StopsToCode.Count == 1 ? L["Badge in to give its reason."] : L["Badge in to give their reasons."])</p>
                    }
                    else if (!_station.CanCodeStops)
                    {
                        <p class="text-muted mb-0">@L["Your role doesn't code stops; ask someone who does."]</p>
                    }
                    <ul class="station-next">
                        @foreach (var s in _station.StopsToCode.Take(5))
                        {
                            <li @key="s.Id">
                                <div class="d-flex justify-content-between gap-2">
                                    <span><span class="fw-semibold">@s.EquipmentCode</span> · @StationView.StopWhen(L, s, DateTimeOffset.UtcNow)</span>
                                    @if (s.MappedReasonName is { } mapped)
                                    {
                                        <span class="text-muted">@L["the machine says {0}", mapped]</span>
                                    }
                                    else if (s.StopCodeText is { } text)
                                    {
                                        <span class="text-muted">@text</span>
                                    }
                                </div>
                                @if (_station.CanCodeStops && _station.CodingReasons.TryGetValue(s.EquipmentId, out var choices))
                                {
                                    <EditForm Model="Input" FormName="@($"station-stop-{s.Id:N}")" OnSubmit="ActAsync" method="post" class="mt-2">
                                        <input type="hidden" name="Input.StopId" value="@s.Id" />
                                        @if (_codingStop == s.Id)
                                        {
                                            <label class="form-label" for="station-stop-comment">@L["Comment"] <span class="text-muted">@L["(reasons marked * need one)"]</span></label>
                                            <InputText id="station-stop-comment" class="form-control mb-2" maxlength="1000" @bind-Value="Input.Comment" />
                                            <div class="station-actions mb-2">
                                                @if (s.MappedReasonId is { } mappedId && choices.Any(r => r.Id == mappedId))
                                                {
                                                    <button type="submit" name="Input.Reason" value="@($"code:{mappedId}")" class="btn btn-primary">@L["Confirm {0}", s.MappedReasonName]</button>
                                                }
                                                <button type="submit" name="Input.Action" value="cancel" class="btn btn-outline-secondary">@L["Back"]</button>
                                            </div>
                                            @foreach (var group in ReasonPickerView.Groups(choices))
                                            {
                                                <div class="reason-grid-group">
                                                    @if (group.Title is { } title)
                                                    {
                                                        <div class="reason-grid-title">@title</div>
                                                    }
                                                    <div class="reason-grid">
                                                        @foreach (var reason in group.Reasons)
                                                        {
                                                            <button type="submit" name="Input.Reason" value="@($"code:{reason.Id}")" class="btn btn-outline-secondary" @key="reason.Id">
                                                                @reason.Name@(reason.RequiresComment ? " *" : "")
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="station-actions">
                                                <button type="submit" name="Input.Action" value="choose-stop" class="btn btn-primary">@L["Give the reason"]</button>
                                            </div>
                                        }
                                    </EditForm>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (_station.AndonCalls.Count > 0 || _station.AndonTypes.Count > 0)
            {
                @* Andon (#157): the line's calls waiting or being answered, escalated ones marked; whoever may calls for help or answers. *@
                <section class="station-panel station-andon" aria-labelledby="station-andon">
                    <h2 id="station-andon" class="h5">@(_station.AndonCalls.Count == 0 ? L["Need help?"] : AndonCallView.Title(L, _station.AndonCalls.Count))</h2>
                    @if (_station.AndonCalls.Count > 0)
                    {
                        @if (_station.PersonName is null)
                        {
                            <p class="mb-2">@(_station.AndonCalls.Count == 1 ? L["Badge in to answer it."] : L["Badge in to answer them."])</p>
                        }
                        <ul class="station-next">
                            @foreach (var c in _station.AndonCalls)
                            {
                                <li @key="c.Id" class="@(c.IsEscalated ? "is-escalated" : "")">
                                    <div class="d-flex justify-content-between gap-2">
                                        <span class="fw-semibold">@c.TypeName</span>
                                        <span class="@(c.IsEscalated ? "station-escalated" : "text-muted")">@AndonCallView.State(L, c, DateTimeOffset.UtcNow)</span>
                                    </div>
                                    @if (c.Note is { } note)
                                    {
                                        <div class="text-muted">@note</div>
                                    }
                                    @if (_station.CanAnswerCalls)
                                    {
                                        <EditForm Model="Input" FormName="@($"station-call-{c.Id:N}")" OnSubmit="ActAsync" method="post" class="mt-2">
                                            <input type="hidden" name="Input.CallId" value="@c.Id" />
                                            @if (_resolvingCall == c.Id)
                                            {
                                                <label class="form-label" for="station-resolution">@L["What was done"]</label>
                                                <InputText id="station-resolution" class="form-control mb-2" maxlength="1000" @bind-Value="Input.Comment" />
                                                <div class="station-actions">
                                                    <button type="submit" name="Input.Action" value="resolve" class="btn btn-primary">@L["Resolved"]</button>
                                                    <button type="submit" name="Input.Action" value="cancel" class="btn btn-outline-secondary">@L["Back"]</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="station-actions">
                                                    @if (c.AcknowledgedAt is null)
                                                    {
                                                        <button type="submit" name="Input.Action" value="acknowledge" class="btn btn-primary">@L["I'm here"]</button>
                                                    }
                                                    <button type="submit" name="Input.Action" value="choose-resolve" class="btn @(c.AcknowledgedAt is null ? "btn-outline-primary" : "btn-primary")">@L["Resolve"]</button>
                                                </div>
                                            }
                                        </EditForm>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (_station.AndonTypes.Count > 0)
                    {
                        <EditForm Model="Input" FormName="station-andon" OnSubmit="ActAsync" method="post" class="mt-2">
                            @if (_calling)
                            {
                                <label class="form-label" for="station-andon-note">@L["Note"] <span class="text-muted">@L["(optional)"]</span></label>
                                <InputText id="station-andon-note" class="form-control mb-2" maxlength="1000" @bind-Value="Input.Comment" />
                                <div class="reason-grid mb-2">
                                    @foreach (var t in _station.AndonTypes)
                                    {
                                        <button type="submit" name="Input.Reason" value="@($"call:{t.Id}")" class="btn btn-outline-danger" @key="t.Id">@t.Name</button>
                                    }
                                </div>
                                <div class="station-actions">
                                    <button type="submit" name="Input.Action" value="cancel" class="btn btn-outline-secondary">@L["Back"]</button>
                                </div>
                            }
                            else
                            {
                                <div class="station-actions">
                                    <button type="submit" name="Input.Action" value="choose-call" class="btn btn-outline-danger">@L["Call for help"]</button>
                                </div>
                            }
                        </EditForm>
                    }
                </section>
            }
            <section class="station-panel" aria-labelledby="station-job">
                @if (line.Running is { } job)
                {
                    var progress = LineDisplayView.Progress(job);
                    <h2 id="station-job" class="h4 mb-1">@job.JobNumber <span class="text-muted fw-normal">· @job.MaterialCode</span></h2>
                    <div>
                        <span class="station-big">@LineDisplayView.Qty(job.GoodQty)</span>
                        @if (job.PlannedQty is { } planned)
                        {
                            <span class="text-muted"> @L["of {0} {1} good", LineDisplayView.Qty(planned), job.UomCode]</span>
                        }
                    </div>
                    @if (progress is { } pct)
                    {
                        <div class="floor-bar mt-2" role="img" aria-label="@L["{0}% of the planned quantity", pct]"><span style="width: @pct%"></span></div>
                    }
                    @if ((_station.CanRunJobs || _station.Report is not null) && _station.RunningJob is { } running)
                    {
                        <EditForm Model="Input" FormName="station" OnSubmit="ActAsync" method="post" class="mt-3">
                            <input type="hidden" name="Input.JobId" value="@running.JobId" />
                            <input type="hidden" name="Input.Version" value="@running.Version" />
                            @if (_stopping is { } stopping)
                            {
                                @* Why it stops (#147): one tap on a reason pauses or completes it; a reason that asks for a comment needs one typed first. *@
                                <h3 class="h5">@(stopping == "complete" ? L["Complete it: why did it stop, if short?"] : L["Pause it: why is it stopping?"])</h3>
                                <label class="form-label" for="station-comment">@L["Comment"] <span class="text-muted">@L["(reasons marked * need one)"]</span></label>
                                <InputText id="station-comment" class="form-control mb-3" maxlength="1000" @bind-Value="Input.Comment" />
                                <div class="station-actions mb-3">
                                    <button type="submit" name="Input.Action" value="@stopping" class="btn btn-primary">@(stopping == "complete" ? L["Complete with no reason"] : L["Pause with no reason"])</button>
                                    <button type="submit" name="Input.Action" value="cancel" class="btn btn-outline-secondary">@L["Back"]</button>
                                </div>
                                @foreach (var group in ReasonPickerView.Groups(_station.RunEndReasons))
                                {
                                    <div class="reason-grid-group">
                                        @if (group.Title is { } title)
                                        {
                                            <div class="reason-grid-title">@title</div>
                                        }
                                        <div class="reason-grid">
                                            @foreach (var reason in group.Reasons)
                                            {
                                                <button type="submit" name="Input.Reason" value="@($"{stopping}:{reason.Id}")" class="btn btn-outline-secondary" @key="reason.Id">
                                                    @reason.Name@(reason.RequiresComment ? " *" : "")
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else if (_reporting && _station.Report is { } form)
                            {
                                var job = form.Job;
                                var machine = form.Machine;
                                <h3 class="h5">@L["Report production"]</h3>
                                @if (machine is not null)
                                {
                                    <p class="mb-2">@MachineCountView.Since(L, machine, job.SiteTimeZone)</p>
                                }
                                <div class="row g-3 mb-3">
                                    <div class="col-6">
                                        <label class="form-label" for="station-good">@L["Good, {0}", job.UomCode]</label>
                                        <InputNumber id="station-good" class="form-control" inputmode="decimal" @bind-Value="Input.Good" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label" for="station-scrap">@L["Scrap, {0}", job.UomCode]</label>
                                        <InputNumber id="station-scrap" class="form-control" inputmode="decimal" @bind-Value="Input.Scrap" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label" for="station-scrap-reason">@L["Scrap reason"] <span class="text-muted">@L["(when there is scrap)"]</span></label>
                                        <InputSelect id="station-scrap-reason" class="form-select" @bind-Value="Input.ScrapReasonId">
                                            <option value="">@L["Choose…"]</option>
                                            @foreach (var reason in form.ScrapReasons)
                                            {
                                                <option value="@reason.Id">@Display.ReasonLabel(reason)</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label" for="station-location">@L["Good output goes to"]</label>
                                        <InputSelect id="station-location" class="form-select" @bind-Value="Input.LocationId">
                                            <option value="">@L["Choose…"]</option>
                                            @foreach (var place in form.Locations)
                                            {
                                                <option value="@place.Id">@place.Code · @place.Name</option>
                                            }
                                        </InputSelect>
                                        @if (StationView.LotHint(L, job, form.Locations.FirstOrDefault(l => l.Id == Input.LocationId)?.Code) is { } hint)
                                        {
                                            <div class="form-text">@hint</div>
                                        }
                                        @if (ReportDefaults.LabelHint(job) is { } labelHint)
                                        {
                                            <div class="form-text">@labelHint</div>
                                        }
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="station-report-comment">@L["Comment"]</label>
                                        <InputText id="station-report-comment" class="form-control" maxlength="1000" @bind-Value="Input.Comment" />
                                    </div>
                                </div>
                                <div class="station-actions">
                                    @if (machine is not null && MachineCountView.CanUse(machine))
                                    {
                                        <input type="hidden" name="Input.MachineGood" value="@machine.GoodQty.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="Input.MachineScrap" value="@machine.ScrapQty.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="Input.MachineUomId" value="@machine.UomId" />
                                        <input type="hidden" name="Input.MachineThrough" value="@machine.Through!.Value.ToString("O", System.Globalization.CultureInfo.InvariantCulture)" />
                                        <button type="submit" name="Input.Action" value="report-machine" class="btn btn-primary">
                                            @L["Report the machine's count"]<span class="d-block small fw-normal">@StationView.MachineFigures(L, machine)</span>
                                        </button>
                                    }
                                    <button type="submit" name="Input.Action" value="report" class="btn @(machine is not null && MachineCountView.CanUse(machine) ? "btn-outline-primary" : "btn-primary")">@L["Report these figures"]</button>
                                    <button type="submit" name="Input.Action" value="cancel" class="btn btn-outline-secondary">@L["Back"]</button>
                                </div>
                            }
                            else
                            {
                                <div class="station-actions">
                                    @if (_station.Report is { Job.BatchSize: null })
                                    {
                                        <button type="submit" name="Input.Action" value="choose-report" class="btn btn-primary">@L["Report"]</button>
                                    }
                                    @if (_station.CanRunJobs)
                                    {
                                        <button type="submit" name="Input.Action" value="choose-pause" class="btn btn-outline-primary">@L["Pause"]</button>
                                        <button type="submit" name="Input.Action" value="choose-complete" class="btn btn-outline-primary">@L["Complete"]</button>
                                    }
                                </div>
                            }
                        </EditForm>
                    }
                }
                else
                {
                    <h2 id="station-job" class="h4 mb-0">@L["No job running"]</h2>
                }
            </section>

            <section class="station-panel" aria-labelledby="station-next">
                <h2 id="station-next" class="h5">@L["Next"]</h2>
                @if (_station.Next.Count == 0)
                {
                    <p class="text-muted mb-0">@L["Nothing planned on {0}.", line.Code]</p>
                }
                else
                {
                    <ul class="station-next">
                        @foreach (var next in _station.Next.Take(4))
                        {
                            <li @key="next.JobId">
                                <span class="fw-semibold">@next.JobNumber</span>
                                <span class="@Display.JobStatusChip(next.Status) ms-1">@L.Label(next.Status)</span>
                                <div class="text-muted">@(next.MaterialCode ?? L.Label(next.JobType))@(next.PlannedQty is { } q ? $" · {FloorView.Qty(q)} {next.UomCode}" : "")</div>
                                @if (!next.IsReady && next.Waiting is { } waiting)
                                {
                                    <div class="small text-muted">@waiting</div>
                                }
                                @if (_station.CanRunJobs && _station.RunningJob is null && next.IsReady)
                                {
                                    <EditForm Model="Input" FormName="@($"station-start-{next.JobId:N}")" OnSubmit="ActAsync" method="post" class="mt-2">
                                        <input type="hidden" name="Input.JobId" value="@next.JobId" />
                                        <input type="hidden" name="Input.Version" value="@next.Version" />
                                        <div class="station-actions">
                                            <button type="submit" name="Input.Action" value="start" class="btn btn-primary">@(next.Status == "paused" ? L["Resume"] : L["Start"]) @next.JobNumber</button>
                                        </div>
                                    </EditForm>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <section class="station-panel" aria-labelledby="station-who">
            @if (_error is not null)
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }
            @if (_station.PersonName is { } name)
            {
                <h2 id="station-who" class="h3 mb-1">@name</h2>
                <p class="text-muted">@L["Signed on at {0}. Badge again to switch person; after {1} minutes without anything done here, the station signs you off.", _station.TerminalName, _station.IdleMinutes]</p>
                @if (StationView.Limits(L, _station) is { } limits)
                {
                    <div class="drawer-alert mb-3" role="status"><Icon Name="info" Size="20" /><span>@limits</span></div>
                }
                <EditForm Model="Input" FormName="station-sign-off" OnSubmit="ActAsync" method="post">
                    <div class="station-actions">
                        <button type="submit" name="Input.Action" value="sign-off" class="btn btn-outline-secondary">@L["Sign off"]</button>
                    </div>
                </EditForm>
            }
            else
            {
                <h2 id="station-who" class="h4">@(_needsPin ? L["Your PIN"] : L["Badge in"])</h2>
            }

            @* A badge signs on, or switches person when someone is already signed on. *@
            <EditForm Model="Input" FormName="station-badge" OnSubmit="SignOnAsync" method="post" class="mt-3">
                @if (_needsPin)
                {
                    <input type="hidden" name="Input.Badge" value="@Input.Badge" />
                    <InputText id="station-pin" type="password" inputmode="numeric" class="form-control form-control-lg station-badge mb-3" autocomplete="off" autofocus
                               aria-label="@L["Your PIN"]" @bind-Value="Input.Pin" />
                    <button type="submit" class="btn btn-primary btn-lg w-100">@L["Sign on"]</button>
                }
                else
                {
                    <InputText id="station-badge" type="password" class="form-control form-control-lg station-badge" autocomplete="off" autofocus="@(_station.PersonName is null)"
                               aria-label="@(_station.PersonName is null ? L["Badge"] : L["Badge to switch person"])" @bind-Value="Input.Badge" />
                    <p class="text-muted small mt-2 mb-0">@L["Hold your badge to the reader, or type its number and press Enter."]</p>
                }
            </EditForm>
        </section>
    </div>
}

@code {
    private const int RefreshSeconds = 30;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "line")]
    private string? Line { get; set; }

    [SupplyParameterFromForm]
    private StationForm Input { get; set; } = new();

    private StationDto? _station;
    private string? _error;
    private bool _enrolled;
    private bool _needsPin;
    private string? _stopping;
    private string? _actionError;
    private bool _reporting;
    private Guid? _codingStop;
    private bool _calling;
    private Guid? _resolvingCall;
    private IReadOnlyList<string> _notes = [];

    private string? Secret => TerminalCookie.Get(HttpContext);

    private string? LineCode => string.IsNullOrWhiteSpace(Line) ? null : Line.Trim();

    protected override async Task OnInitializedAsync()
    {
        _enrolled = Secret is not null;
        if (Secret is null)
        {
            return;
        }

        await LoadAsync(TerminalCookie.GetStation(HttpContext));
    }

    private async Task LoadAsync(string? ticket)
    {
        try
        {
            var response = await Api.GetStationAsync(Secret!, ticket, LineCode);
            _station = response.Station;

            // The terminal's own language and region (#128), whoever stands at it.
            Cultures.Apply(_station?.Language, _station?.Region);
            L.Use(_station?.Language);
            await L.EnsureAsync();
            if (ticket is not null && response.Ticket is null && !HttpContext.Response.HasStarted)
            {
                TerminalCookie.ClearStation(HttpContext);
            }
        }
        catch (ApiException ex)
        {
            _enrolled = ex.Status != 401;
            _error = L.Problem(ex);
        }
    }

    private async Task SignOnAsync()
    {
        if (_station is null || string.IsNullOrWhiteSpace(Input.Badge))
        {
            return;
        }

        try
        {
            var response = await Api.StationSignOnAsync(Secret!, new StationSignOnRequest { BadgeValue = Input.Badge.Trim(), Pin = Input.Pin, Line = LineCode });
            if (response.NeedsPin)
            {
                _needsPin = true;
                return;
            }

            TerminalCookie.SetStation(HttpContext, response.Ticket!, response.TicketExpiresAt!.Value);
            Navigation.NavigateTo(Here, forceLoad: true);
        }
        catch (ApiException ex)
        {
            _error = L.Problem(ex);
            Input.Pin = null;
            _needsPin = false;
        }
    }

    /// <summary>Signing off, choosing to pause or complete, and the job actions themselves (#147), as the person signed on.</summary>
    private async Task ActAsync()
    {
        // A reason button carries what it is for and the reason: "pause:<id>", "complete:<id>", "code:<id>" (a stop's) or "call:<id>" (andon).
        var (action, reasonId) = Input.Reason?.Split(':') is [var stop, var id] && Guid.TryParse(id, out var reason) ? (stop, (Guid?)reason) : (Input.Action, null);
        switch (action)
        {
            case "choose-call":
                _calling = true;
                return;
            case "choose-resolve":
                _resolvingCall = Input.CallId;
                return;
            case "call" or "acknowledge" or "resolve":
                try
                {
                    var answered = await Api.StationAndonAsync(Secret!, action, new StationAndonRequest
                    {
                        Ticket = TerminalCookie.GetStation(HttpContext),
                        Line = LineCode,
                        TypeId = reasonId,
                        CallId = Input.CallId,
                        Text = Input.Comment,
                    });
                    TerminalCookie.SetStation(HttpContext, answered.Ticket, answered.TicketExpiresAt);
                    _station = answered.Station;
                    _notes = L.Notes(answered.Notes);
                }
                catch (ApiException ex)
                {
                    _actionError = StationView.Problem(L.Problem(ex), L.FieldErrors(ex));
                    (_calling, _resolvingCall) = ex.Status == 401 ? (false, null) : (action == "call", action == "resolve" ? Input.CallId : null);
                    if (ex.Status == 401)
                    {
                        TerminalCookie.ClearStation(HttpContext);
                        await LoadAsync(null);
                    }
                }

                return;
            case "choose-stop":
                _codingStop = Input.StopId;
                return;
            case "code" when Input.StopId is { } stopId && reasonId is { } stopReason:
                try
                {
                    var coded = await Api.StationCodeStopAsync(Secret!, new StationStopRequest
                    {
                        Ticket = TerminalCookie.GetStation(HttpContext),
                        Line = LineCode,
                        StopId = stopId,
                        ReasonCodeId = stopReason,
                        Comment = Input.Comment,
                    });
                    TerminalCookie.SetStation(HttpContext, coded.Ticket, coded.TicketExpiresAt);
                    _station = coded.Station;
                    _notes = L.Notes(coded.Notes);
                }
                catch (ApiException ex)
                {
                    _actionError = StationView.Problem(L.Problem(ex), L.FieldErrors(ex));
                    _codingStop = ex.Status == 401 ? null : stopId;
                    if (ex.Status == 401)
                    {
                        TerminalCookie.ClearStation(HttpContext);
                        await LoadAsync(null);
                    }
                }

                return;
            case "sign-off":
                TerminalCookie.ClearStation(HttpContext);
                Navigation.NavigateTo(Here, forceLoad: true);
                return;
            case "choose-pause" or "choose-complete":
                _stopping = action["choose-".Length..];
                return;
            case "cancel":
                return;
            case "choose-report":
                _reporting = true;
                Input.LocationId ??= _station?.Report?.DefaultLocationId;
                return;
            case "report" or "report-machine" when Input.JobId is { } reportJob:
                try
                {
                    // From the machine: the figures shown, counted to their time, exactly as the button said them.
                    var fromMachine = action == "report-machine";
                    var result = await Api.StationReportAsync(Secret!, new StationReportRequest
                    {
                        Ticket = TerminalCookie.GetStation(HttpContext),
                        Line = LineCode,
                        JobId = reportJob,
                        FromMachine = fromMachine,
                        UomId = fromMachine ? Input.MachineUomId : null,
                        MachineThrough = fromMachine ? Input.MachineThrough : null,
                        GoodQty = fromMachine ? Input.MachineGood ?? 0 : Input.Good ?? 0,
                        ScrapQty = fromMachine ? Input.MachineScrap ?? 0 : Input.Scrap ?? 0,
                        ScrapReasonCodeId = Input.ScrapReasonId,
                        LocationId = Input.LocationId,
                        Comment = Input.Comment,
                    });
                    TerminalCookie.SetStation(HttpContext, result.Ticket, result.TicketExpiresAt);
                    _station = result.Station;
                    _notes = L.Notes(result.Notes);
                }
                catch (ApiException ex)
                {
                    _actionError = StationView.Problem(L.Problem(ex), L.FieldErrors(ex));
                    _reporting = ex.Status != 401;
                    if (ex.Status == 401)
                    {
                        TerminalCookie.ClearStation(HttpContext);
                        await LoadAsync(null);
                    }
                }

                return;
            case "start" or "pause" or "complete" when Input.JobId is { } jobId:
                try
                {
                    var result = await Api.StationJobAsync(Secret!, action, new StationJobRequest
                    {
                        Ticket = TerminalCookie.GetStation(HttpContext),
                        Line = LineCode,
                        JobId = jobId,
                        Version = Input.Version,
                        ReasonCodeId = reasonId,
                        Comment = Input.Comment,
                    });
                    TerminalCookie.SetStation(HttpContext, result.Ticket, result.TicketExpiresAt);
                    _station = result.Station;
                    _notes = [StationView.Done(L, action, _station), .. L.Notes(result.Notes)];
                }
                catch (ApiException ex)
                {
                    _actionError = StationView.Problem(L.Problem(ex), L.FieldErrors(ex));
                    _stopping = action is "pause" or "complete" ? action : null;
                    if (ex.Status == 401)
                    {
                        TerminalCookie.ClearStation(HttpContext);
                        await LoadAsync(null);
                    }
                }

                return;
        }
    }

    private string Here => LineCode is { } code ? $"{TerminalCookie.StationPath}?line={Uri.EscapeDataString(code)}" : TerminalCookie.StationPath;

    public sealed class StationForm
    {
        public string? Badge { get; set; }
        public string? Pin { get; set; }
        public string? Action { get; set; }
        public string? Reason { get; set; }
        public Guid? JobId { get; set; }
        public long Version { get; set; }
        public string? Comment { get; set; }
        public decimal? Good { get; set; }
        public decimal? Scrap { get; set; }
        public Guid? ScrapReasonId { get; set; }
        public Guid? LocationId { get; set; }
        public Guid? StopId { get; set; }
        public Guid? CallId { get; set; }
        public decimal? MachineGood { get; set; }
        public decimal? MachineScrap { get; set; }
        public Guid? MachineUomId { get; set; }
        public DateTimeOffset? MachineThrough { get; set; }
    }
}
