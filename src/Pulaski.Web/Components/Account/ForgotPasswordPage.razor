@page "/account/forgot"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject PulaskiApiClient Api

@* Asking for a password reset link by e-mail (D-093). The answer is the same whether or not an account matches. *@
<PageTitle>Forgotten password · Pulaski</PageTitle>

<h1 class="h4 mb-3">Forgotten your password?</h1>

@if (_answer is not null)
{
    <div class="alert alert-info small" role="status">@_answer</div>
    <p class="small mb-0"><a href="account/login">Back to sign in</a></p>
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-danger small" role="alert">@_error</div>
    }

    <p class="small text-muted">Type your user name or the e-mail address Pulaski has for you. We'll send a link to choose a new password.</p>
    <EditForm Model="Input" FormName="forgot" OnSubmit="SendAsync" method="post">
        <div class="mb-3">
            <label class="form-label" for="login">User name or e-mail</label>
            <InputText id="login" class="form-control" autocomplete="username" autofocus maxlength="254" @bind-Value="Input.Login" />
        </div>
        <button type="submit" class="btn btn-primary w-100">Send the link</button>
    </EditForm>
    <p class="small mt-3 mb-0"><a href="account/login">Back to sign in</a></p>
}

@code {
    [SupplyParameterFromForm]
    private ForgotForm Input { get; set; } = new();

    private string? _answer;
    private string? _error;

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(Input.Login))
        {
            _error = "Type your user name or e-mail address.";
            return;
        }

        try
        {
            _answer = (await Api.RequestPasswordResetAsync(new RequestPasswordResetRequest { Login = Input.Login })).Message;
        }
        catch (ApiException ex)
        {
            _error = ex.Detail ?? ex.Title;
        }
    }

    private sealed class ForgotForm
    {
        public string Login { get; set; } = "";
    }
}
