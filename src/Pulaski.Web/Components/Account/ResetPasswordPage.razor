@page "/account/reset"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject PulaskiApiClient Api

@* Choosing a new password from a reset link (D-093). The token is in the address, so this page sends no referrer anywhere. *@
<PageTitle>Choose a new password · Pulaski</PageTitle>
<HeadContent><meta name="referrer" content="no-referrer" /></HeadContent>

<h1 class="h4 mb-3">Choose a new password</h1>

@if (_done)
{
    <div class="alert alert-success small" role="status">Your password is changed. Sign in with it now.</div>
    <a class="btn btn-primary w-100" href="account/login">Sign in</a>
}
else if (string.IsNullOrEmpty(Token))
{
    <div class="alert alert-warning small" role="alert">This page needs the link from the e-mail. <a href="account/forgot">Ask for a new one.</a></div>
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-danger small" role="alert">@_error</div>
    }

    <EditForm Model="Input" FormName="reset" OnSubmit="SaveAsync" method="post">
        <input type="hidden" name="Input.Token" value="@Token" />
        <div class="mb-3">
            <label class="form-label" for="new-password">New password</label>
            <InputText id="new-password" type="password" class="form-control" autocomplete="new-password" autofocus @bind-Value="Input.NewPassword" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="again">New password again</label>
            <InputText id="again" type="password" class="form-control" autocomplete="new-password" @bind-Value="Input.Again" />
        </div>
        <button type="submit" class="btn btn-primary w-100">Change password</button>
    </EditForm>
    <p class="small text-muted mt-3 mb-0">At least 10 characters, with two of: lower case, upper case, digits, symbols; not your user name.</p>
}

@code {
    [SupplyParameterFromQuery(Name = "token")]
    private string? QueryToken { get; set; }

    [SupplyParameterFromForm]
    private ResetForm Input { get; set; } = new();

    private bool _done;
    private string? _error;

    // The token arrives in the address, then rides back with the form.
    private string? Token => string.IsNullOrEmpty(Input.Token) ? QueryToken : Input.Token;

    private async Task SaveAsync()
    {
        if (Input.NewPassword != Input.Again)
        {
            _error = "The two passwords aren't the same.";
            return;
        }

        try
        {
            await Api.CompletePasswordResetAsync(new CompletePasswordResetRequest { Token = Token ?? "", NewPassword = Input.NewPassword });
            _done = true;
        }
        catch (ApiException ex)
        {
            _error = ex.Errors?.SelectMany(e => e.Value).FirstOrDefault() ?? ex.Detail ?? ex.Title;
        }
        finally
        {
            (Input.NewPassword, Input.Again) = ("", "");
        }
    }

    private sealed class ResetForm
    {
        public string? Token { get; set; }

        public string NewPassword { get; set; } = "";

        public string Again { get; set; } = "";
    }
}
