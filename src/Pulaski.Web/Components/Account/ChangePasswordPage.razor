@page "/account/password"
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject PulaskiApiClient Api
@inject NavigationManager Navigation

@* Replacing a password (D-037), also the temporary one an administrator gave. *@
<PageTitle>Change password · Pulaski</PageTitle>

<h1 class="h4 mb-2">Change your password</h1>
@if (MustChange)
{
    <p class="small text-muted">You signed in with a temporary password. Choose your own before you carry on.</p>
}

@if (_error is not null)
{
    <div class="alert alert-danger small" role="alert">@_error</div>
}

<EditForm Model="Input" FormName="change-password" OnSubmit="ChangeAsync" method="post">
    <div class="mb-3">
        <label class="form-label" for="current">Current password</label>
        <InputText id="current" type="password" class="form-control" autocomplete="current-password" @bind-Value="Input.Current" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="new">New password</label>
        <InputText id="new" type="password" class="form-control" autocomplete="new-password" aria-describedby="new-help" @bind-Value="Input.New" />
        <div id="new-help" class="form-text">At least 10 characters, with two of: lower case, upper case, digits, symbols. Not your user name.</div>
    </div>
    <div class="mb-3">
        <label class="form-label" for="confirm">New password again</label>
        <InputText id="confirm" type="password" class="form-control" autocomplete="new-password" @bind-Value="Input.Confirm" />
    </div>
    <button type="submit" class="btn btn-primary w-100">Change password</button>
</EditForm>

<form method="post" action="account/logout" class="mt-3">
    @if (MustChange)
    {
        <button type="submit" class="btn btn-link btn-sm p-0">Sign out</button>
    }
    else
    {
        <a class="btn btn-link btn-sm p-0" href="">Back to Pulaski</a>
    }
</form>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private PasswordForm Input { get; set; } = new();

    private string? _error;

    private bool MustChange => HttpContext.User.HasClaim(c => c.Type == AccountSession.MustChangeClaim);

    private async Task ChangeAsync()
    {
        if (Input.New != Input.Confirm)
        {
            _error = "The two new passwords don't match.";
            return;
        }

        try
        {
            await Api.ChangePasswordAsync(new ChangePasswordRequest { CurrentPassword = Input.Current, NewPassword = Input.New });
        }
        catch (ApiException ex)
        {
            _error = ex.Errors.Count > 0 ? string.Join(" ", ex.Errors.Values.SelectMany(v => v)) : ex.Detail ?? ex.Title;
            return;
        }

        await AccountSession.PasswordChangedAsync(HttpContext);
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private sealed class PasswordForm
    {
        public string Current { get; set; } = "";

        public string New { get; set; } = "";

        public string Confirm { get; set; } = "";
    }
}
