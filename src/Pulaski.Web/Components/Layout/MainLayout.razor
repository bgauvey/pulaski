@inherits LayoutComponentBase
@inject PulaskiApiClient Api
@inject CurrentUser User
@inject SiteSelection Sites
@inject NavigationManager Navigation

@* The first thing a keyboard reaches (#142, WCAG 2.4.1): past the header and menu, straight to the page. Focus moves by script, since a
   fragment link would be taken as navigation to the app's root. *@
<a class="skip-link visually-hidden-focusable" href="#main-content" onclick="pulaski.ui.focus('main-content'); return false;">@L["Skip to content"]</a>
<div class="shell">
    <header class="app-header">
        <button type="button" class="icon-button" aria-label="@L["Toggle navigation"]" onclick="pulaski.toggleSidebar()">
            <Icon Name="menu" />
        </button>
        <a class="brand" href="@(User.Setting<string>(UserViews.HomeKey) ?? "")">
            @* Placeholder mark: Pulaski is a working codename. *@
            <svg class="brand-mark" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="12" />
                @* A right-pointing arrow turned 30° up, so it points to 2 o'clock. *@
                <path d="M6.5 12H17M12.5 7.5L17 12l-4.5 4.5" transform="rotate(-30 12 12)" />
            </svg>
            <span>Pulaski</span>
        </a>
        <span class="chip">@L["Pre-alpha"]</span>
        <div class="header-end">
            @if (User.Me is not null)
            {
                <FavoriteStar />
            }
            <Pulaski.Web.Components.Help.HelpPanel />
            @if (User.Me is { } me)
            {
                @* Given the user, so it renders again once the layout has loaded them: a child without parameters isn't re-rendered. *@
                <UserMenu Me="me" />
            }
        </div>
    </header>

    <aside class="app-sidebar">
        @if (User.Me is not null && User.CanSeeAnything)
        {
            <NavMenu />
        }
    </aside>

    <main class="app-main" id="main-content" tabindex="-1">
        <article class="content">
            @* What the user may see and do decides the pages and actions shown (D-037, D-039), so it loads first. *@
            @if (User.Me is null)
            {
                @if (_error is not null)
                {
                    <ProblemAlert Error="_error" />
                }
                else
                {
                    <p class="text-muted">@L["Loading…"]</p>
                }
            }
            else if (!User.CanSeeAnything)
            {
                <AccessPanel Kind="locked" Title="@L["Nothing to see here yet"]"
                             Message="@L["Your roles don't let you see any screens in Pulaski yet. Ask an administrator to give you a role that does, then sign in again."]">
                    <form method="post" action="account/logout">
                        <button type="submit" class="btn btn-outline-secondary">@L["Sign out"]</button>
                    </form>
                </AccessPanel>
            }
            else if (!MaySeePage)
            {
                @* A page the user may not see answers like one that doesn't exist, so it isn't advertised. *@
                <PageTitle>@L["Not found"] · Pulaski</PageTitle>
                <AccessPanel Title="@L["Page not found"]" Message="@L["There's nothing here, or nothing you can see. Check the address, or use the menu."]">
                    <a class="btn btn-primary" href="@(User.FirstScreen ?? "")">@L["Go to the start"]</a>
                </AccessPanel>
            }
            else
            {
                @Body
            }
        </article>
    </main>

    <footer class="app-footer">
        <span>Pulaski @Version</span>
        <span>Apache 2.0</span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["An unhandled error has occurred."]
    <a href="." class="reload">@L["Reload"]</a>
    <button type="button" class="dismiss" aria-label="@L["Dismiss"]"><Icon Name="close" Size="16" /></button>
</div>

@code {
    // Whether the first arrival has been sent to the user's home page (#131): only once per visit.
    private bool _homed;

    private static readonly string Version =
        typeof(MainLayout).Assembly.GetName().Version?.ToString(3) ?? "dev";

    private ApiException? _error;

    [CascadingParameter]
    private RouteData? RouteData { get; set; }

    private RequiresViewAttribute? Required =>
        RouteData?.PageType.GetCustomAttributes(typeof(RequiresViewAttribute), inherit: false).FirstOrDefault() as RequiresViewAttribute;

    private bool MaySeePage => Required is not { } required || User.CanAny(required.AnyOf);

    // The start page is the Overview; whoever can't see it starts at the first screen they can (D-039).
    // Site pickers offer only the sites where the user holds one of the screen's views (#43).
    protected override void OnParametersSet()
    {
        Sites.ScreenViews = Required?.AnyOf;
        if (User.Me is not null && !MaySeePage && RouteData?.PageType == typeof(Pages.Home) && User.FirstScreen is { Length: > 0 } first)
        {
            Navigation.NavigateTo(first, replace: true);
        }
        else if (User.Me is not null && !_homed)
        {
            // The first page of a visit (a sign-in, or opening Pulaski) is the user's home page when they arrive at the start (#131); the
            // Overview stays a click away after that.
            _homed = true;
            if (RouteData?.PageType == typeof(Pages.Home) && User.Setting<string>(UserViews.HomeKey) is { Length: > 0 } home)
            {
                Navigation.NavigateTo(home, replace: true);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The reader's language first (#128), so nothing shows in English for a moment.
            await L.EnsureAsync();
            await User.EnsureAsync(Api);
            OnParametersSet();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }
}
