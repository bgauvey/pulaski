@inherits LayoutComponentBase
@inject PulaskiApiClient Api
@inject CurrentUser User
@inject SiteSelection Sites
@inject NavigationManager Navigation

<div class="shell">
    <header class="app-header">
        <button type="button" class="icon-button" aria-label="Toggle navigation" onclick="pulaski.toggleSidebar()">
            <Icon Name="menu" />
        </button>
        <a class="brand" href="">
            @* Placeholder mark: Pulaski is a working codename. *@
            <svg class="brand-mark" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="12" />
                @* A right-pointing arrow turned 30° up, so it points to 2 o'clock. *@
                <path d="M6.5 12H17M12.5 7.5L17 12l-4.5 4.5" transform="rotate(-30 12 12)" />
            </svg>
            <span>Pulaski</span>
        </a>
        <span class="chip">Pre-alpha</span>
        <div class="header-end">
            @if (User.Me is { } me)
            {
                <span class="header-user" title="@User.RoleSummary">
                    <Icon Name="user" Size="18" />
                    <span class="header-user-text">
                        <span class="header-user-name">@me.DisplayName</span>
                        <span class="header-user-roles">@User.RoleSummary</span>
                    </span>
                </span>
                <a class="icon-button" href="account/password" title="Change your password" aria-label="Change your password"><Icon Name="lock" /></a>
                <form method="post" action="account/logout" class="m-0">
                    <button type="submit" class="icon-button" title="Sign out" aria-label="Sign out"><Icon Name="sign-out" /></button>
                </form>
            }
            <button type="button" class="icon-button" aria-label="Switch light or dark theme" onclick="pulaski.toggleTheme()">
                <span class="when-light"><Icon Name="moon" /></span>
                <span class="when-dark"><Icon Name="sun" /></span>
            </button>
        </div>
    </header>

    <aside class="app-sidebar">
        @if (User.Me is not null && User.CanSeeAnything)
        {
            <NavMenu />
        }
    </aside>

    <main class="app-main">
        <article class="content">
            @* What the user may see and do decides the pages and actions shown (D-037, D-039), so it loads first. *@
            @if (User.Me is null)
            {
                @if (_error is not null)
                {
                    <ProblemAlert Error="_error" />
                }
                else
                {
                    <p class="text-muted">Loading…</p>
                }
            }
            else if (!User.CanSeeAnything)
            {
                <AccessPanel Kind="locked" Title="Nothing to see here yet"
                             Message="Your roles don't let you see any screens in Pulaski yet. Ask an administrator to give you a role that does, then sign in again.">
                    <form method="post" action="account/logout">
                        <button type="submit" class="btn btn-outline-secondary">Sign out</button>
                    </form>
                </AccessPanel>
            }
            else if (!MaySeePage)
            {
                @* A page the user may not see answers like one that doesn't exist, so it isn't advertised. *@
                <PageTitle>Not found · Pulaski</PageTitle>
                <AccessPanel Title="Page not found" Message="There's nothing here, or nothing you can see. Check the address, or use the menu.">
                    <a class="btn btn-primary" href="@(User.FirstScreen ?? "")">Go to the start</a>
                </AccessPanel>
            }
            else
            {
                @Body
            }
        </article>
    </main>

    <footer class="app-footer">
        <span>Pulaski @Version</span>
        <span>Apache 2.0</span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss"><Icon Name="close" Size="16" /></button>
</div>

@code {
    private static readonly string Version =
        typeof(MainLayout).Assembly.GetName().Version?.ToString(3) ?? "dev";

    private ApiException? _error;

    [CascadingParameter]
    private RouteData? RouteData { get; set; }

    private RequiresViewAttribute? Required =>
        RouteData?.PageType.GetCustomAttributes(typeof(RequiresViewAttribute), inherit: false).FirstOrDefault() as RequiresViewAttribute;

    private bool MaySeePage => Required is not { } required || User.CanAny(required.AnyOf);

    // The start page is the Overview; whoever can't see it starts at the first screen they can (D-039).
    // Site pickers offer only the sites where the user holds one of the screen's views (#43).
    protected override void OnParametersSet()
    {
        Sites.ScreenViews = Required?.AnyOf;
        if (User.Me is not null && !MaySeePage && RouteData?.PageType == typeof(Pages.Home) && User.FirstScreen is { Length: > 0 } first)
        {
            Navigation.NavigateTo(first, replace: true);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await User.EnsureAsync(Api);
            OnParametersSet();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
    }
}
