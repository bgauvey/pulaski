@* Grouped by how plants work, like screens under their main one (#199, NavTree). Each link shows only to users who may see its screen, and a
   group with none doesn't show at all, so nothing is advertised that the user can't open (D-039). *@
@implements IDisposable
@inject CurrentUser User
@inject PulaskiApiClient Api
@inject NavigationManager Navigation
@inject TimeProvider Clock
@inject IJSRuntime JS

<nav class="side-nav" aria-label="@L["Main"]">
    @if (InboxView.MayDecideAny(User))
    {
        @* What waits for this user to decide (#123), with how many, refreshed as they move around and every minute. *@
        <div class="nav-group">
            <NavLink class="nav-item" href="inbox" title="@L["Inbox: what waits for you to decide"]">
                <Icon Name="info" /><span class="nav-text">@L["Inbox"]</span>
                @if (_inbox is > 0)
                {
                    <span class="nav-badge" aria-label="@L["{0} waiting", _inbox.Value]">@InboxView.Badge(_inbox.Value)</span>
                }
            </NavLink>
        </div>
    }
    @if (User.Setting<List<FavoritePage>>(UserViews.FavoritesKey) is { Count: > 0 } favorites)
    {
        @* The user's starred pages (#131), as they named them; one they can no longer open isn't shown. *@
        <div class="nav-group">
            <div class="nav-group-label">@L["Favourites"]</div>
            @foreach (var f in favorites.Where(MayOpen))
            {
                <NavLink class="nav-item" href="@f.Href" Match="NavLinkMatch.All" title="@f.Title"><Icon Name="star" /><span class="nav-text">@f.Title</span></NavLink>
            }
        </div>
    }
    @foreach (var section in NavTree.Visible(May))
    {
        <div class="nav-group">
            <div class="nav-group-label">@L[section.Label]</div>
            @foreach (var entry in section.Entries)
            {
                @if (!entry.IsGroup)
                {
                    @Item(entry.Link!, false)
                }
                else
                {
                    var key = entry.Key!;
                    var open = IsOpen(key);
                    var label = entry.Link?.Text ?? entry.FolderText!;
                    <div class="nav-tree @(open ? "is-open" : "")" @key="key">
                        <div class="nav-tree-head">
                            @if (entry.Link is { } main)
                            {
                                <NavLink class="nav-item" href="@main.Href" Match="NavLinkMatch.Prefix" title="@L[main.Title]" @onclick="() => Remember(key)">
                                    <Icon Name="@main.Icon" /><span class="nav-text">@L[main.Text]</span>
                                </NavLink>
                            }
                            else
                            {
                                <button type="button" class="nav-item nav-folder" aria-expanded="@(open ? "true" : "false")" aria-controls="@($"nav-{key}")" @onclick="() => ToggleAsync(key)">
                                    <Icon Name="@(entry.FolderIcon ?? "categorized")" /><span class="nav-text">@L[label]</span>
                                </button>
                            }
                            @* Every group folds and unfolds, the open screen's too (#205). *@
                            @if (entry.Children.Count > 0)
                            {
                                <button type="button" class="nav-toggle" aria-expanded="@(open ? "true" : "false")" aria-controls="@($"nav-{key}")"
                                        aria-label="@(open ? L["Fold {0}", L[label]] : L["Unfold {0}", L[label]])" title="@(open ? L["Fold {0}", L[label]] : L["Unfold {0}", L[label]])"
                                        @onclick="() => ToggleAsync(key)">
                                    <Icon Name="chevron-right" Size="16" />
                                </button>
                            }
                        </div>
                        <div id="@($"nav-{key}")" class="nav-children @(open ? "" : "is-folded")" role="group" aria-label="@L[label]">
                            @foreach (var child in entry.Children)
                            {
                                @Item(child, true)
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
</nav>

@code {
    private int? _inbox;
    private DateTimeOffset _inboxAt = DateTimeOffset.MinValue;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        User.SettingsChanged += OnSettingsChanged;
        _timer = new Timer(_ => InvokeAsync(() => CountInboxAsync(force: true)), null, InboxView.Refresh, InboxView.Refresh);
        await CountInboxAsync(force: true);
    }

    // Moving to another page recounts, at most every few seconds, so deciding an item and moving on shows the new count.
    // The group of the new screen unfolds (#199).
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            _folds.At(NavTree.GroupAt(NavTree.Sections, Path));
            StateHasChanged();
            await CountInboxAsync(force: false);
        });

    private async Task CountInboxAsync(bool force)
    {
        var now = Clock.GetUtcNow();
        if (!InboxView.MayDecideAny(User) || (!force && now - _inboxAt < InboxView.MinGap))
        {
            return;
        }

        _inboxAt = now;
        try
        {
            _inbox = (await Api.GetInboxAsync()).Items.Count;
            StateHasChanged();
        }
        catch (ApiException)
        {
        }
        catch (HttpRequestException)
        {
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        User.SettingsChanged -= OnSettingsChanged;
        _timer?.Dispose();
    }

    // Grouped like screens (#199): a group unfolds while one of its screens is open; others stay as the reader left them, per browser.
    private const string OpenKey = "pulaski.nav.open";
    private readonly NavFolds _folds = new();

    // The audit trail covers every site, so only those who may see it everywhere get it (#129).
    private bool May(NavLinkItem link) =>
        link.Permission == PermissionCodes.AuditView ? User.CanEverywhere(link.Permission)
        : User.Can(link.Permission) || (link.OrPermission is { } other && User.Can(other));

    private string Path => Navigation.ToBaseRelativePath(Navigation.Uri);

    private void OnSettingsChanged() => _ = InvokeAsync(StateHasChanged);

    // A favourite under a menu screen the user may no longer open is left out; any other page checks for itself.
    private bool MayOpen(FavoritePage f) =>
        NavTree.Sections.SelectMany(s => s.Entries).SelectMany(e => e.Link is { } l ? [l, .. e.Children] : e.Children)
            .Where(l => NavTree.IsAt(l.Href, f.Href)).OrderByDescending(l => l.Href.Length).FirstOrDefault() is not { } link || May(link);

    private bool IsOpen(string key)
    {
        _folds.At(NavTree.GroupAt(NavTree.Sections, Path));
        return _folds.IsOpen(key);
    }

    private RenderFragment Item(NavLinkItem link, bool child) =>
        @<NavLink class="@(child ? "nav-item nav-child" : "nav-item")" href="@link.Href" Match="@(link.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@L[link.Title]">
            <Icon Name="@link.Icon" /><span class="nav-text">@L[link.Text]</span>
        </NavLink>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await JS.InvokeAsync<string?>("pulaski.ui.load", OpenKey) is { Length: > 0 } stored)
        {
            _folds.Restore(stored.Split(',', StringSplitOptions.RemoveEmptyEntries));
            StateHasChanged();
        }
    }

    private Task ToggleAsync(string key) => _folds.Toggle(key) ? SaveAsync() : Task.CompletedTask;

    private Task Remember(string key) => _folds.Opening(key) ? SaveAsync() : Task.CompletedTask;

    private async Task SaveAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("pulaski.ui.save", OpenKey, string.Join(",", _folds.Opened.Order(StringComparer.Ordinal)));
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
