@* Grouped by how plants work. Each link shows only to users who may see its screen, and a group with none
   doesn't show at all, so nothing is advertised that the user can't open (D-039). *@
@implements IDisposable
@inject CurrentUser User
@inject PulaskiApiClient Api
@inject NavigationManager Navigation
@inject TimeProvider Clock

<nav class="side-nav" aria-label="Main">
    @if (InboxView.MayDecideAny(User))
    {
        @* What waits for this user to decide (#123), with how many, refreshed as they move around and every minute. *@
        <div class="nav-group">
            <NavLink class="nav-item" href="inbox" title="Inbox: what waits for you to decide">
                <Icon Name="info" /><span class="nav-text">Inbox</span>
                @if (_inbox is > 0)
                {
                    <span class="nav-badge" aria-label="@_inbox waiting">@InboxView.Badge(_inbox.Value)</span>
                }
            </NavLink>
        </div>
    }
    @foreach (var group in Groups)
    {
        var links = group.Links.Where(l => User.Can(l.Permission) || (l.OrPermission is { } other && User.Can(other))).ToList();
        @if (links.Count > 0)
        {
            <div class="nav-group">
                <div class="nav-group-label">@group.Label</div>
                @foreach (var link in links)
                {
                    <NavLink class="nav-item" href="@link.Href" Match="@(link.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@link.Title">
                        <Icon Name="@link.Icon" /><span class="nav-text">@link.Text</span>
                    </NavLink>
                }
            </div>
        }
    }
</nav>

@code {
    private int? _inbox;
    private DateTimeOffset _inboxAt = DateTimeOffset.MinValue;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _timer = new Timer(_ => InvokeAsync(() => CountInboxAsync(force: true)), null, InboxView.Refresh, InboxView.Refresh);
        await CountInboxAsync(force: true);
    }

    // Moving to another page recounts, at most every few seconds, so deciding an item and moving on shows the new count.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(() => CountInboxAsync(force: false));

    private async Task CountInboxAsync(bool force)
    {
        var now = Clock.GetUtcNow();
        if (!InboxView.MayDecideAny(User) || (!force && now - _inboxAt < InboxView.MinGap))
        {
            return;
        }

        _inboxAt = now;
        try
        {
            _inbox = (await Api.GetInboxAsync()).Items.Count;
            StateHasChanged();
        }
        catch (ApiException)
        {
        }
        catch (HttpRequestException)
        {
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        _timer?.Dispose();
    }

    private sealed record Link(string Href, string Icon, string Text, string Title, string Permission, string? OrPermission = null);

    private sealed record Group(string Label, IReadOnlyList<Link> Links);

    private static readonly IReadOnlyList<Group> Groups =
    [
        new("Operate",
        [
            new("", "overview", "Overview", "Overview", PermissionCodes.OverviewView),
            new("work-orders", "work-orders", "Work orders", "Work orders", PermissionCodes.WorkOrdersView),
            new("schedule", "schedule", "Schedule", "Schedule", PermissionCodes.ScheduleView),
            new("floor", "labor", "Floor", "Floor: run jobs and report production", PermissionCodes.FloorView),
            new("machines", "gauge", "Machines", "Machines: live state and stops to code", PermissionCodes.MachinesView),
            new("andon", "alert", "Andon", "Andon: calls for help from the lines", PermissionCodes.FloorView),
            new("inventory", "lot", "Inventory", "Inventory", PermissionCodes.InventoryView),
            new("quality/results", "spc", "Quality", "Quality results: record and review what was measured or inspected", PermissionCodes.QualityView),
            new("labor", "users", "Labor", "Labor: who is on, shift review and reports", PermissionCodes.LaborView),
        ]),
        new("Configure",
        [
            new("equipment", "equipment", "Equipment", "Equipment", PermissionCodes.EquipmentView),
            new("machine-profiles", "plug", "Machine profiles", "Machine profiles: state values and stop codes", PermissionCodes.EquipmentView),
            new("edge-nodes", "signal", "Edge nodes", "Edge nodes: connections and tags that collect machine data", PermissionCodes.EquipmentView),
            new("materials", "categorized", "Materials", "Materials and classes", PermissionCodes.MaterialsView),
            new("processes", "process", "Processes", "Processes", PermissionCodes.ProcessesView),
            new("boms", "bom", "BOMs", "Bills of materials", PermissionCodes.ProcessesView),
            new("quality/specs", "spc", "Specifications", "Material specifications and quality characteristics", PermissionCodes.QualityView),
            new("units", "units", "Units", "Units and conversions", PermissionCodes.UnitsView),
            new("reasons", "info", "Reasons", "Reason codes", PermissionCodes.ReasonsView),
            new("shifts", "clock", "Shifts", "Shift schedules", PermissionCodes.ShiftsView),
            new("rate-proposals", "gauge", "Planning rates", "Planning rates from run history proposed for review", PermissionCodes.MaterialsView, PermissionCodes.ScheduleView),
            new("changeovers", "refresh", "Changeovers", "Changeover rules: how long each change of material takes", PermissionCodes.ScheduleView, PermissionCodes.MaterialsView),
            new("site-settings", "calendar", "Site settings", "Changeover mode, reporting tolerances, OEE targets, planning rates, holidays and shutdowns", PermissionCodes.SiteSettingsView),
            new("integrations", "signal", "Integrations", "Integrations: events sent to the ERP and failed deliveries", PermissionCodes.IntegrationsView),
            new("people", "user", "People", "People and crews", PermissionCodes.People),
            new("terminals", "plug", "Terminals", "Shop-floor terminals for badging", PermissionCodes.Terminals),
            new("users", "users", "Users", "Users, roles and permissions", PermissionCodes.Security),
        ]),
    ];
}
