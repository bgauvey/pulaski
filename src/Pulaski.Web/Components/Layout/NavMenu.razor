@* Grouped by how plants work. Each link shows only to users who may see its screen, and a group with none
   doesn't show at all, so nothing is advertised that the user can't open (D-039). *@
@inject CurrentUser User

<nav class="side-nav" aria-label="Main">
    @foreach (var group in Groups)
    {
        var links = group.Links.Where(l => User.Can(l.Permission)).ToList();
        @if (links.Count > 0)
        {
            <div class="nav-group">
                <div class="nav-group-label">@group.Label</div>
                @foreach (var link in links)
                {
                    <NavLink class="nav-item" href="@link.Href" Match="@(link.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@link.Title">
                        <Icon Name="@link.Icon" /><span class="nav-text">@link.Text</span>
                    </NavLink>
                }
            </div>
        }
    }
</nav>

@code {
    private sealed record Link(string Href, string Icon, string Text, string Title, string Permission);

    private sealed record Group(string Label, IReadOnlyList<Link> Links);

    private static readonly IReadOnlyList<Group> Groups =
    [
        new("Operate",
        [
            new("", "overview", "Overview", "Overview", PermissionCodes.OverviewView),
            new("work-orders", "work-orders", "Work orders", "Work orders", PermissionCodes.WorkOrdersView),
            new("schedule", "schedule", "Schedule", "Schedule", PermissionCodes.ScheduleView),
            new("floor", "labor", "Floor", "Floor: run jobs and report production", PermissionCodes.FloorView),
            new("machines", "gauge", "Machines", "Machines: live state and stops to code", PermissionCodes.MachinesView),
            new("inventory", "lot", "Inventory", "Inventory", PermissionCodes.InventoryView),
            new("labor", "users", "Labor", "Labor: who is on, shift review and reports", PermissionCodes.LaborView),
        ]),
        new("Configure",
        [
            new("equipment", "equipment", "Equipment", "Equipment", PermissionCodes.EquipmentView),
            new("machine-profiles", "plug", "Machine profiles", "Machine profiles: state values and stop codes", PermissionCodes.EquipmentView),
            new("edge-nodes", "signal", "Edge nodes", "Edge nodes: connections and tags that collect machine data", PermissionCodes.EquipmentView),
            new("materials", "categorized", "Materials", "Materials and classes", PermissionCodes.MaterialsView),
            new("processes", "process", "Processes", "Processes", PermissionCodes.ProcessesView),
            new("boms", "bom", "BOMs", "Bills of materials", PermissionCodes.ProcessesView),
            new("units", "units", "Units", "Units and conversions", PermissionCodes.UnitsView),
            new("reasons", "info", "Reasons", "Reason codes", PermissionCodes.ReasonsView),
            new("shifts", "clock", "Shifts", "Shift schedules", PermissionCodes.ShiftsView),
            new("site-settings", "calendar", "Site settings", "Changeovers, reporting tolerances, holidays and shutdowns", PermissionCodes.SiteSettingsView),
            new("people", "user", "People", "People and crews", PermissionCodes.People),
            new("terminals", "plug", "Terminals", "Shop-floor terminals for badging", PermissionCodes.Terminals),
            new("users", "users", "Users", "Users, roles and permissions", PermissionCodes.Security),
        ]),
    ];
}
